# ============================================================
# GTAngel .gitignore — AI Training Platform
# ============================================================

# --- UE5 Engine runtime (3 GB, stays local, embedded in build output only) ---
/Engine/

# --- UE5 engine directories at root (legacy layout) ---
/Binaries/
/Build/
/Config/
/Documentation/
/engines/
/Extras/
/Gameface/
/Platforms/
/Programs/
/Shaders/
/Source/
/Templates/
/tools/

# --- Build output ---
GTAngel/bin/
GTAngel/obj/

# --- Build output inside GTAngel.Tests ---
GTAngel.Tests/bin/
GTAngel.Tests/obj/

# --- Build output inside Archecho ---
Archecho/*/Binaries/
Archecho/*/Intermediate/
Archecho/*/Saved/
Archecho/*/DerivedDataCache/

# --- Large UE5 binary assets ---
*.pak
*.uasset
*.umap
*.ubulk
*.utoc
*.ucas

# --- Temp scripts and build logs ---
*.txt
*.ps1
*.py
*.bat

# --- IDE ---
.vs/
.vscode/
*.user
*.suo
*.cache
*.DotSettings.user

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
