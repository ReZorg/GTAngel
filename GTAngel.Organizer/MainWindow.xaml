<Window x:Class="GTAngel.Organizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GTAngel Repository Organizer"
        Height="900" Width="1440" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C1CBE0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                            <TextBlock Text="GT" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Repository Organizer" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="GTAngel component integration workspace" Style="{StaticResource MutedText}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="10" Margin="2,0,0,5" />
                    <TextBox Grid.Row="1" Text="{Binding WorkspacePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Repository or workspace root" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Browse" Command="{Binding BrowseCommand}" />
                    <Button Content="Scan &amp; Plan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
                    <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Rows="1" Margin="12,8">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ComponentCount, StringFormat=N0}" Style="{StaticResource Metric}" /><TextBlock Text="COMPONENTS" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding FileCount, StringFormat=N0}" Style="{StaticResource Metric}" /><TextBlock Text="FILES CATALOGED" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ProtectedCount, StringFormat=N0}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="PROTECTED" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ProposalCount, StringFormat=N0}" Style="{StaticResource Metric}" /><TextBlock Text="PROPOSALS" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding SelectedCount, StringFormat=N0}" Style="{StaticResource Metric}" Foreground="{StaticResource PrimaryHoverBrush}" /><TextBlock Text="SELECTED" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding ConflictCount, StringFormat=N0}" Style="{StaticResource Metric}" Foreground="{StaticResource WarningBrush}" /><TextBlock Text="CONFLICTS" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding DuplicateCount, StringFormat=N0}" Style="{StaticResource Metric}" Foreground="{StaticResource DangerBrush}" /><TextBlock Text="DUPLICATES" Style="{StaticResource MetricLabel}" /></StackPanel></Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Margin="16,2,16,10">
            <TabItem Header="Overview">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Component registry" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Manifest-aware inventory of nested repositories, projects, plugins, services, assets, and research collections." Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Components}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="1.4*" />
                                    <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="0.8*" />
                                    <DataGridTextColumn Header="Protected" Binding="{Binding ProtectedFileCount, StringFormat=N0}" Width="0.9*" />
                                    <DataGridCheckBoxColumn Header="Git" Binding="{Binding IsRepository}" Width="0.5*" />
                                    <DataGridTextColumn Header="Branch" Binding="{Binding GitBranch}" Width="1*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Safety contract" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Scan is read-only" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="Git roots, project manifests, Unreal boundaries, generated output, dependencies, and organizer state are protected by default." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="Moves are journaled before execution" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="Existing destinations are never overwritten. Undo validates content and stops safely if a file changed." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Plan">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Select safe" Command="{Binding SelectSafeCommand}" />
                                <Button Content="Clear" Command="{Binding ClearSelectionCommand}" />
                                <TextBlock Text="Review type, function, confidence, reason, and destination before execution." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Export JSON + CSV" Command="{Binding ExportCommand}" />
                                <Button Content="Execute selected" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PlanEntries}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Move" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2.1*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="1*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="1*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="0.65*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="0.75*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.85*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Reason / conflict" Binding="{Binding Reason}" Width="2.4*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Components">
                <Grid Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Components}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                            <DataGridTextColumn Header="Root" Binding="{Binding RootPath}" Width="3*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="1*" />
                            <DataGridTextColumn Header="Files" Binding="{Binding FileCount, StringFormat=N0}" Width="0.7*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding TotalBytes, StringFormat=N0}" Width="0.9*" />
                            <DataGridTextColumn Header="Protected" Binding="{Binding ProtectedFileCount, StringFormat=N0}" Width="0.8*" />
                            <DataGridCheckBoxColumn Header="Git" Binding="{Binding IsRepository}" Width="0.5*" />
                            <DataGridTextColumn Header="Remote" Binding="{Binding GitRemote}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Durable transaction journals support audit, recovery, and reverse-order undo." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Open state folder" Command="{Binding OpenStateFolderCommand}" />
                                <Button Content="Undo selected transaction" Style="{StaticResource DangerButton}" Command="{Binding UndoCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedJournal, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.7*" />
                            <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="1.2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="Operations" Binding="{Binding Operations}" Width="0.8*" />
                            <DataGridTextColumn Header="Completed" Binding="{Binding Completed}" Width="0.8*" />
                            <DataGridTextColumn Header="Undone" Binding="{Binding Undone}" Width="0.8*" />
                            <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Watch">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Lifecycle:" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WatchStatus}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,18,0" />
                                <TextBlock Text="Pending queue:" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WatchPendingCount}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,18,0" />
                                <TextBlock Text="Events are debounced and converted to review recommendations; watch mode never moves files automatically." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Start watch" Style="{StaticResource PrimaryButton}" Command="{Binding StartWatchCommand}" />
                                <Button Content="{Binding PauseWatchLabel}" Command="{Binding PauseWatchCommand}" />
                                <Button Content="Stop watch" Style="{StaticResource DangerButton}" Command="{Binding StopWatchCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WatchRecommendations}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Detected" Binding="{Binding DetectedAtUtc, StringFormat={}{0:HH:mm:ss}}" Width="0.75*" />
                            <DataGridTextColumn Header="Change" Binding="{Binding ChangeType}" Width="0.8*" />
                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="2.8*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Classification.FileType}" Width="1*" />
                            <DataGridTextColumn Header="Function" Binding="{Binding Classification.Function}" Width="1*" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Classification.Confidence, StringFormat=P0}" Width="0.8*" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding Classification.Risk}" Width="0.7*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*" />
                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Planning policy" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Settings are saved under .gtangel-organizer/config.json after a scan." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,14" />
                            <CheckBox Content="Propose moves for loose workspace-root files only (recommended)" IsChecked="{Binding LooseRootOnly}" />
                            <CheckBox Content="Include unknown file types in review proposals" IsChecked="{Binding IncludeUnknown}" />
                            <CheckBox Content="Include source files in proposals (high risk)" IsChecked="{Binding IncludeSource}" />
                            <CheckBox Content="Resolve destination conflicts with numeric suffixes" IsChecked="{Binding RenameConflicts}" />
                            <Border Background="#201B2F" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                <TextBlock Text="Changing policy does not move files. Run Scan &amp; Plan again to regenerate a reviewable plan." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Default destination taxonomy" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Type provides the main directory; function adds a subdirectory only when it contributes meaning." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,16" />
                            <TextBlock Text="Documentation  →  docs/general[/research]" Margin="0,5" />
                            <TextBlock Text="Reference material  →  docs/reference[/research]" Margin="0,5" />
                            <TextBlock Text="Images / media / 3D  →  assets/images | media | 3d" Margin="0,5" />
                            <TextBlock Text="Automation  →  tools/scripts" Margin="0,5" />
                            <TextBlock Text="Configuration  →  config[/build | integration | plugins]" Margin="0,5" />
                            <TextBlock Text="Data / archives / binaries  →  data | archives | artifacts/binaries" Margin="0,5" />
                            <TextBlock Text="Unknown  →  other/review (opt-in only)" Margin="0,5" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#0D1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="4" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" />
                <Grid Grid.Row="1" Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentActivity}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ScanDuration, StringFormat=Scan {0}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
