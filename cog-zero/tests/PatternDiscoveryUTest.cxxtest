#include <cxxtest/TestSuite.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/atoms/base/Node.h>
#include <opencog/atoms/base/Link.h>
#include <opencog/atoms/atom_types/atom_types.h>
#include <opencog/agentzero/knowledge/PatternDiscovery.h>

using namespace opencog;
using namespace opencog::agentzero::knowledge;

class PatternDiscoveryUTest : public CxxTest::TestSuite
{
private:
    AtomSpacePtr _atomspace;
    std::unique_ptr<PatternDiscovery> _pd;

    /**
     * Build a small synthetic episode root:
     *   AndLink(ConceptNode(A), ConceptNode(B), ConceptNode(C))
     */
    Handle makeEpisode(const std::string& a,
                       const std::string& b,
                       const std::string& c)
    {
        Handle ha = _atomspace->add_node(CONCEPT_NODE, a);
        Handle hb = _atomspace->add_node(CONCEPT_NODE, b);
        Handle hc = _atomspace->add_node(CONCEPT_NODE, c);
        return _atomspace->add_link(AND_LINK, {ha, hb, hc});
    }

public:
    void setUp()
    {
        _atomspace = std::make_shared<AtomSpace>();
        _pd = std::make_unique<PatternDiscovery>(_atomspace);
    }

    void tearDown()
    {
        if (_pd) {
            _pd->shutdown();
            _pd.reset();
        }
    }

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    void test_initialization()
    {
        TS_ASSERT(_pd != nullptr);
        TS_ASSERT(_pd->initialize());
        TS_ASSERT(_pd->isInitialized());
        TS_ASSERT(_pd->isHealthy());
    }

    void test_double_init_is_safe()
    {
        TS_ASSERT(_pd->initialize());
        TS_ASSERT(_pd->initialize());
    }

    // -------------------------------------------------------------------------
    // Episode management
    // -------------------------------------------------------------------------

    void test_record_episode()
    {
        TS_ASSERT(_pd->initialize());

        Handle root = makeEpisode("percept-A", "action-B", "outcome-C");
        TS_ASSERT(_pd->recordEpisode(root, "ep-1"));
        TS_ASSERT_EQUALS(_pd->episodeCount(), 1u);
    }

    void test_record_multiple_episodes()
    {
        TS_ASSERT(_pd->initialize());

        for (size_t i = 0; i < 5; ++i) {
            Handle root = makeEpisode("p" + std::to_string(i),
                                      "a" + std::to_string(i),
                                      "o" + std::to_string(i));
            TS_ASSERT(_pd->recordEpisode(root, "ep-" + std::to_string(i)));
        }
        TS_ASSERT_EQUALS(_pd->episodeCount(), 5u);
    }

    void test_remove_episode()
    {
        TS_ASSERT(_pd->initialize());

        Handle root = makeEpisode("x", "y", "z");
        _pd->recordEpisode(root, "ep-rem");
        TS_ASSERT_EQUALS(_pd->episodeCount(), 1u);

        TS_ASSERT(_pd->removeEpisode("ep-rem"));
        TS_ASSERT_EQUALS(_pd->episodeCount(), 0u);
    }

    void test_clear_episodes()
    {
        TS_ASSERT(_pd->initialize());

        for (size_t i = 0; i < 3; ++i) {
            Handle root = makeEpisode("a", "b", "c");
            _pd->recordEpisode(root, "ep-" + std::to_string(i));
        }
        TS_ASSERT(_pd->episodeCount() > 0u);
        _pd->clearEpisodes();
        TS_ASSERT_EQUALS(_pd->episodeCount(), 0u);
    }

    // -------------------------------------------------------------------------
    // Pattern Mining
    // -------------------------------------------------------------------------

    void test_mine_empty_corpus_returns_empty()
    {
        TS_ASSERT(_pd->initialize());
        auto patterns = _pd->minePatterns();
        TS_ASSERT(patterns.empty());
    }

    void test_mine_patterns_finds_frequent_atoms()
    {
        TS_ASSERT(_pd->initialize());

        // Add 5 episodes all containing "common-concept"
        Handle common = _atomspace->add_node(CONCEPT_NODE, "common-concept");
        for (size_t i = 0; i < 5; ++i) {
            Handle other = _atomspace->add_node(CONCEPT_NODE, "unique-" + std::to_string(i));
            Handle root = _atomspace->add_link(AND_LINK, {common, other});
            _pd->recordEpisode(root, "ep-" + std::to_string(i));
        }

        MiningConfig config;
        config.min_support = 3;
        auto patterns = _pd->minePatterns(config);

        // "common-concept" should appear in results
        bool found_common = false;
        for (auto& p : patterns) {
            if (p.pattern == common) {
                found_common = true;
                TS_ASSERT(p.support >= 3u);
                TS_ASSERT(p.frequency >= 0.6);
                break;
            }
        }
        TS_ASSERT(found_common);
    }

    void test_mine_patterns_respects_min_support()
    {
        TS_ASSERT(_pd->initialize());

        Handle rare = _atomspace->add_node(CONCEPT_NODE, "rare-atom");
        Handle root = _atomspace->add_link(AND_LINK, {rare});
        _pd->recordEpisode(root, "ep-1");

        MiningConfig config;
        config.min_support = 5; // requires 5 episodes minimum

        auto patterns = _pd->minePatterns(config);
        for (auto& p : patterns) {
            TS_ASSERT(p.support >= 5u);
        }
    }

    void test_cached_patterns_after_mining()
    {
        TS_ASSERT(_pd->initialize());

        Handle root = makeEpisode("a", "b", "c");
        _pd->recordEpisode(root, "ep-1");
        _pd->recordEpisode(root, "ep-2");

        _pd->minePatterns();
        auto cached = _pd->getCachedPatterns();
        TS_ASSERT(!cached.empty());
    }

    void test_get_patterns_by_frequency()
    {
        TS_ASSERT(_pd->initialize());

        Handle common = _atomspace->add_node(CONCEPT_NODE, "very-common");
        for (size_t i = 0; i < 4; ++i) {
            Handle other = _atomspace->add_node(CONCEPT_NODE, "ep-node-" + std::to_string(i));
            Handle root = _atomspace->add_link(AND_LINK, {common, other});
            _pd->recordEpisode(root, "ep-" + std::to_string(i));
        }

        MiningConfig config;
        config.min_support = 2;
        _pd->minePatterns(config);

        auto top3 = _pd->getPatternsByFrequency(3);
        TS_ASSERT(top3.size() <= 3u);
        if (top3.size() >= 2u) {
            TS_ASSERT(top3[0].frequency >= top3[1].frequency);
        }
    }

    // -------------------------------------------------------------------------
    // Statistics
    // -------------------------------------------------------------------------

    void test_stats_summary()
    {
        TS_ASSERT(_pd->initialize());
        std::string summary = _pd->getStatsSummary();
        TS_ASSERT(!summary.empty());
        TS_ASSERT(summary.find("PatternDiscovery") != std::string::npos);
    }
};
