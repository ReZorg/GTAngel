#include <cxxtest/TestSuite.h>
#include <opencog/atomspace/AtomSpace.h>
#include <opencog/atoms/base/Node.h>
#include <opencog/atoms/base/Link.h>
#include <opencog/atoms/atom_types/atom_types.h>
#include <opencog/agentzero/knowledge/ConceptFormation.h>

using namespace opencog;
using namespace opencog::agentzero::knowledge;

class ConceptFormationUTest : public CxxTest::TestSuite
{
private:
    AtomSpacePtr _atomspace;
    std::unique_ptr<ConceptFormation> _cf;

public:
    void setUp()
    {
        _atomspace = std::make_shared<AtomSpace>();
        _cf = std::make_unique<ConceptFormation>(_atomspace);
    }

    void tearDown()
    {
        if (_cf) {
            _cf->shutdown();
            _cf.reset();
        }
    }

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    void test_initialization()
    {
        TS_ASSERT(_cf != nullptr);
        TS_ASSERT(_cf->initialize());
        TS_ASSERT(_cf->isInitialized());
        TS_ASSERT(_cf->isHealthy());
    }

    void test_double_init_is_safe()
    {
        TS_ASSERT(_cf->initialize());
        TS_ASSERT(_cf->initialize());
    }

    void test_shutdown()
    {
        TS_ASSERT(_cf->initialize());
        TS_ASSERT(_cf->shutdown());
        TS_ASSERT(!_cf->isInitialized());
    }

    // -------------------------------------------------------------------------
    // Exemplar observation
    // -------------------------------------------------------------------------

    void test_observe_exemplar()
    {
        TS_ASSERT(_cf->initialize());

        Handle h = _atomspace->add_node(CONCEPT_NODE, "feline-1");
        TS_ASSERT(_cf->observeExemplar(h, "cat"));
        TS_ASSERT_EQUALS(_cf->exemplarCount("cat"), 1u);
    }

    void test_observe_multiple_exemplars()
    {
        TS_ASSERT(_cf->initialize());

        for (size_t i = 0; i < 4; ++i) {
            Handle h = _atomspace->add_node(CONCEPT_NODE,
                                            "feline-" + std::to_string(i));
            _cf->observeExemplar(h, "cat");
        }
        TS_ASSERT_EQUALS(_cf->exemplarCount("cat"), 4u);
    }

    void test_observe_counter_exemplar()
    {
        TS_ASSERT(_cf->initialize());

        Handle h = _atomspace->add_node(CONCEPT_NODE, "canine-1");
        TS_ASSERT(_cf->observeCounterExemplar(h, "cat"));
    }

    // -------------------------------------------------------------------------
    // Concept formation
    // -------------------------------------------------------------------------

    void test_form_concepts_promotes_concept()
    {
        TS_ASSERT(_cf->initialize());

        // Add enough exemplars to meet defaults (min_exemplars=2)
        for (size_t i = 0; i < 3; ++i) {
            Handle h = _atomspace->add_node(CONCEPT_NODE,
                                            "cat-ex-" + std::to_string(i));
            _cf->observeExemplar(h, "cat");
        }

        ConceptFormationConfig config;
        config.min_exemplars = 2;
        config.min_coherence = 0.0; // low bar so the concept is always promoted
        config.min_coverage  = 0.0;
        config.novelty_threshold = 0.0;

        size_t promoted = _cf->formConcepts(config);
        TS_ASSERT(promoted >= 1u);

        Handle cat_handle = _cf->getConceptHandle("cat");
        TS_ASSERT(cat_handle != Handle::UNDEFINED);
    }

    void test_form_concept_by_label()
    {
        TS_ASSERT(_cf->initialize());

        Handle h1 = _atomspace->add_node(CONCEPT_NODE, "dog-ex-1");
        Handle h2 = _atomspace->add_node(CONCEPT_NODE, "dog-ex-2");
        _cf->observeExemplar(h1, "dog");
        _cf->observeExemplar(h2, "dog");

        TS_ASSERT(_cf->formConcept("dog"));

        Handle dog_handle = _cf->getConceptHandle("dog");
        TS_ASSERT(dog_handle != Handle::UNDEFINED);
    }

    void test_concept_in_atomspace_after_formation()
    {
        TS_ASSERT(_cf->initialize());

        Handle h1 = _atomspace->add_node(CONCEPT_NODE, "bird-ex-1");
        Handle h2 = _atomspace->add_node(CONCEPT_NODE, "bird-ex-2");
        _cf->observeExemplar(h1, "bird");
        _cf->observeExemplar(h2, "bird");
        _cf->formConcept("bird");

        // The ConceptNode "bird" should exist in the AtomSpace
        Handle bird_in_as = _atomspace->get_node(CONCEPT_NODE, "bird");
        TS_ASSERT(bird_in_as != Handle::UNDEFINED);
    }

    void test_form_creates_inheritance_links()
    {
        TS_ASSERT(_cf->initialize());

        Handle h1 = _atomspace->add_node(CONCEPT_NODE, "sparrow");
        Handle h2 = _atomspace->add_node(CONCEPT_NODE, "robin");
        _cf->observeExemplar(h1, "bird");
        _cf->observeExemplar(h2, "bird");
        _cf->formConcept("bird");

        // There should be InheritanceLinks: sparrow isa bird, robin isa bird
        HandleSeq inh_links;
        _atomspace->get_handles_by_type(inh_links, INHERITANCE_LINK);
        TS_ASSERT(inh_links.size() >= 2u);
    }

    // -------------------------------------------------------------------------
    // Retrieval
    // -------------------------------------------------------------------------

    void test_get_all_concepts()
    {
        TS_ASSERT(_cf->initialize());

        for (const std::string& label : {"alpha", "beta", "gamma"}) {
            for (size_t i = 0; i < 2; ++i) {
                Handle h = _atomspace->add_node(CONCEPT_NODE,
                                                label + "-ex-" + std::to_string(i));
                _cf->observeExemplar(h, label);
            }
            _cf->formConcept(label);
        }

        auto all = _cf->getAllConcepts();
        TS_ASSERT(all.size() >= 3u);
    }

    void test_get_candidate_labels()
    {
        TS_ASSERT(_cf->initialize());

        Handle h = _atomspace->add_node(CONCEPT_NODE, "label-test");
        _cf->observeExemplar(h, "my-label");

        auto labels = _cf->getCandidateLabels();
        bool found = false;
        for (auto& l : labels)
            if (l == "my-label") { found = true; break; }
        TS_ASSERT(found);
    }

    void test_get_candidate_record()
    {
        TS_ASSERT(_cf->initialize());

        Handle h = _atomspace->add_node(CONCEPT_NODE, "rec-test");
        _cf->observeExemplar(h, "my-concept");

        auto candidate = _cf->getCandidate("my-concept");
        TS_ASSERT(candidate.has_value());
        TS_ASSERT_EQUALS(candidate->name, "my-concept");
        TS_ASSERT_EQUALS(candidate->exemplars.size(), 1u);
    }

    // -------------------------------------------------------------------------
    // Refinement
    // -------------------------------------------------------------------------

    void test_merge_concepts()
    {
        TS_ASSERT(_cf->initialize());

        // Create two similar concepts
        for (const std::string& label : {"feline-A", "feline-B"}) {
            for (size_t i = 0; i < 2; ++i) {
                Handle h = _atomspace->add_node(CONCEPT_NODE,
                                                label + "-ex-" + std::to_string(i));
                _cf->observeExemplar(h, label);
            }
            _cf->formConcept(label);
        }

        Handle merged = _cf->mergeConcepts("feline-A", "feline-B", "feline");
        TS_ASSERT(merged != Handle::UNDEFINED);
    }

    void test_split_concept()
    {
        TS_ASSERT(_cf->initialize());

        for (size_t i = 0; i < 4; ++i) {
            Handle h = _atomspace->add_node(CONCEPT_NODE,
                                            "big-concept-ex-" + std::to_string(i));
            _cf->observeExemplar(h, "big-concept");
        }
        _cf->formConcept("big-concept");

        TS_ASSERT(_cf->splitConcept("big-concept", "big-concept-a", "big-concept-b"));
        TS_ASSERT(_cf->exemplarCount("big-concept-a") > 0u);
        TS_ASSERT(_cf->exemplarCount("big-concept-b") > 0u);
    }

    void test_refinement_history_populated()
    {
        TS_ASSERT(_cf->initialize());

        Handle h = _atomspace->add_node(CONCEPT_NODE, "hist-test");
        Handle h2 = _atomspace->add_node(CONCEPT_NODE, "hist-test-2");
        _cf->observeExemplar(h, "hist-concept");
        _cf->observeExemplar(h2, "hist-concept");
        _cf->formConcept("hist-concept");

        auto history = _cf->getRefinementHistory();
        TS_ASSERT(!history.empty());
    }

    // -------------------------------------------------------------------------
    // Hierarchy
    // -------------------------------------------------------------------------

    void test_build_concept_hierarchy()
    {
        TS_ASSERT(_cf->initialize());

        // Animal: {cat, dog, bird}
        // Cat: {cat} (subset of Animal)
        Handle cat = _atomspace->add_node(CONCEPT_NODE, "cat");
        Handle dog = _atomspace->add_node(CONCEPT_NODE, "dog");
        Handle bird = _atomspace->add_node(CONCEPT_NODE, "bird");

        _cf->observeExemplar(cat,  "animal");
        _cf->observeExemplar(dog,  "animal");
        _cf->observeExemplar(bird, "animal");
        _cf->observeExemplar(cat,  "domestic-cat");

        ConceptFormationConfig config;
        config.min_exemplars     = 1;
        config.min_coherence     = 0.0;
        config.min_coverage      = 0.0;
        config.novelty_threshold = 0.0;
        _cf->formConcepts(config);

        // buildConceptHierarchy should add InheritanceLink(domestic-cat, animal)
        size_t added = _cf->buildConceptHierarchy();
        // Since domestic-cat's exemplar set {cat} ⊂ animal's {cat, dog, bird}
        TS_ASSERT(added >= 1u);
    }

    // -------------------------------------------------------------------------
    // Statistics
    // -------------------------------------------------------------------------

    void test_stats_summary()
    {
        TS_ASSERT(_cf->initialize());
        std::string summary = _cf->getStatsSummary();
        TS_ASSERT(!summary.empty());
        TS_ASSERT(summary.find("ConceptFormation") != std::string::npos);
    }
};
