#include <cxxtest/TestSuite.h>

#include <opencog/atomspace/AtomSpace.h>
#include <opencog/atoms/base/Handle.h>
#include <opencog/atoms/base/Node.h>
#include <opencog/atoms/atom_types/types.h>

#include "opencog/agentzero/AttentionManager.h"

using namespace opencog;
using namespace opencog::agentzero;

class AttentionManagerUTest : public CxxTest::TestSuite
{
private:
    AtomSpacePtr atomspace;
    std::unique_ptr<AttentionManager> manager;

public:
    void setUp()
    {
        atomspace = createAtomSpace();
        manager = std::make_unique<AttentionManager>(atomspace);
    }

    void tearDown()
    {
        manager.reset();
        atomspace.reset();
    }

    // -----------------------------------------------------------------------
    // Constructor tests
    // -----------------------------------------------------------------------

    void testConstructorDefault()
    {
        TS_ASSERT(manager != nullptr);
        TS_ASSERT_EQUALS(manager->trackedAtomCount(), 0U);
        const AttentionConfig& cfg = manager->getConfig();
        TS_ASSERT_DELTA(cfg.base_sti, 0.5, 1e-9);
        TS_ASSERT_DELTA(cfg.decay_rate, 0.05, 1e-9);
        TS_ASSERT_DELTA(cfg.focus_boundary, 0.7, 1e-9);
    }

    void testConstructorCustomConfig()
    {
        AttentionConfig cfg;
        cfg.base_sti = 0.3;
        cfg.decay_rate = 0.1;
        cfg.focus_boundary = 0.6;
        AttentionManager custom_mgr(atomspace, cfg);
        TS_ASSERT_DELTA(custom_mgr.getConfig().base_sti, 0.3, 1e-9);
        TS_ASSERT_DELTA(custom_mgr.getConfig().decay_rate, 0.1, 1e-9);
        TS_ASSERT_DELTA(custom_mgr.getConfig().focus_boundary, 0.6, 1e-9);
    }

    void testNullAtomSpaceThrows()
    {
        TS_ASSERT_THROWS(AttentionManager bad(nullptr), std::invalid_argument);
    }

    // -----------------------------------------------------------------------
    // Attention allocation tests
    // -----------------------------------------------------------------------

    void testAllocateAttentionBasic()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "test_percept");
        double sti = manager->allocateAttention(atom, 0.8);

        TS_ASSERT(sti > 0.0);
        TS_ASSERT(sti <= 1.0);
        TS_ASSERT_EQUALS(manager->trackedAtomCount(), 1U);
        TS_ASSERT_DELTA(manager->getSTI(atom), sti, 1e-9);
    }

    void testAllocateAttentionSalienceScaling()
    {
        Handle low  = atomspace->add_node(CONCEPT_NODE, "low_salience");
        Handle high = atomspace->add_node(CONCEPT_NODE, "high_salience");

        double sti_low  = manager->allocateAttention(low,  0.1);
        double sti_high = manager->allocateAttention(high, 0.9);

        TS_ASSERT(sti_high > sti_low);
    }

    void testAllocateAttentionUndefinedHandle()
    {
        double sti = manager->allocateAttention(Handle::UNDEFINED, 0.5);
        TS_ASSERT_DELTA(sti, 0.0, 1e-9);
        TS_ASSERT_EQUALS(manager->trackedAtomCount(), 0U);
    }

    void testAllocateAttentionSalienceClamped()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "clamped");
        // Salience above 1.0 should be clamped
        double sti = manager->allocateAttention(atom, 2.0);
        TS_ASSERT(sti >= 0.0);
        TS_ASSERT(sti <= 1.0);
    }

    // -----------------------------------------------------------------------
    // Update and get STI
    // -----------------------------------------------------------------------

    void testUpdateAttention()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "update_test");
        manager->allocateAttention(atom, 0.5);

        manager->updateAttention(atom, 0.9);
        TS_ASSERT_DELTA(manager->getSTI(atom), 0.9, 1e-9);
    }

    void testGetSTIUntracked()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "untracked");
        TS_ASSERT_DELTA(manager->getSTI(atom), 0.0, 1e-9);
    }

    // -----------------------------------------------------------------------
    // Decay tests
    // -----------------------------------------------------------------------

    void testDecayAttention()
    {
        AttentionConfig cfg;
        cfg.decay_rate = 0.5;
        cfg.base_sti   = 0.8;
        cfg.min_sti    = 0.0;
        AttentionManager decay_mgr(atomspace, cfg);

        Handle atom = atomspace->add_node(CONCEPT_NODE, "decay_atom");
        double initial_sti = decay_mgr.allocateAttention(atom, 1.0);
        TS_ASSERT(initial_sti > 0.0);

        decay_mgr.decayAttention();

        double decayed_sti = decay_mgr.getSTI(atom);
        TS_ASSERT(decayed_sti < initial_sti);
        // With 50% decay, new STI should be approx initial * 0.5
        TS_ASSERT_DELTA(decayed_sti, initial_sti * 0.5, 1e-6);
    }

    void testDecayRemovesLowSTI()
    {
        AttentionConfig cfg;
        cfg.decay_rate = 0.99;
        cfg.min_sti    = 0.0;
        AttentionManager decay_mgr(atomspace, cfg);

        Handle atom = atomspace->add_node(CONCEPT_NODE, "decayable");
        decay_mgr.allocateAttention(atom, 0.01);
        TS_ASSERT_EQUALS(decay_mgr.trackedAtomCount(), 1U);

        // After several decay cycles the atom should fall below min_sti
        for (int i = 0; i < 20; ++i) {
            decay_mgr.decayAttention();
        }
        TS_ASSERT_EQUALS(decay_mgr.trackedAtomCount(), 0U);
    }

    // -----------------------------------------------------------------------
    // Attention focus tests
    // -----------------------------------------------------------------------

    void testGetAttentionFocusEmpty()
    {
        HandleSeq focus = manager->getAttentionFocus();
        TS_ASSERT(focus.empty());
    }

    void testGetAttentionFocusFiltering()
    {
        AttentionConfig cfg;
        cfg.focus_boundary = 0.7;
        AttentionManager focus_mgr(atomspace, cfg);

        Handle above = atomspace->add_node(CONCEPT_NODE, "above_boundary");
        Handle below = atomspace->add_node(CONCEPT_NODE, "below_boundary");

        // Allocate and set STI above the focus boundary
        focus_mgr.allocateAttention(above, 1.0);
        focus_mgr.updateAttention(above, 0.9);

        // Allocate and set STI below the focus boundary
        focus_mgr.allocateAttention(below, 0.1);
        focus_mgr.updateAttention(below, 0.3);

        HandleSeq focus = focus_mgr.getAttentionFocus();
        bool found_above = false;
        bool found_below = false;
        for (const Handle& h : focus) {
            if (h == above) found_above = true;
            if (h == below) found_below = true;
        }
        TS_ASSERT(found_above);
        TS_ASSERT(!found_below);
    }

    void testIsInAttentionFocus()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "focus_check");
        manager->allocateAttention(atom, 1.0);
        manager->updateAttention(atom, 0.9);

        TS_ASSERT(manager->isInAttentionFocus(atom));

        manager->updateAttention(atom, 0.2);
        TS_ASSERT(!manager->isInAttentionFocus(atom));
    }

    // -----------------------------------------------------------------------
    // Salience calculation tests
    // -----------------------------------------------------------------------

    void testCalculateSalienceBasic()
    {
        SensoryInput input("visual", "camera", {0.1, 0.2, 0.3}, 0.8);
        SalienceScore score = manager->calculateSalience(input);

        TS_ASSERT(score.signal_quality >= 0.0 && score.signal_quality <= 1.0);
        TS_ASSERT(score.novelty >= 0.0 && score.novelty <= 1.0);
        TS_ASSERT(score.overall >= 0.0 && score.overall <= 1.0);
    }

    void testCalculateSalienceNoveltyDecays()
    {
        SensoryInput input("audio", "mic", {1.0}, 0.9);

        SalienceScore first  = manager->calculateSalience(input);
        SalienceScore second = manager->calculateSalience(input);
        SalienceScore third  = manager->calculateSalience(input);

        // Novelty should decrease as the same modality is seen more often
        TS_ASSERT(first.novelty >= second.novelty);
        TS_ASSERT(second.novelty >= third.novelty);
    }

    void testCalculateSalienceConfidenceReflected()
    {
        SensoryInput high_conf("tactile", "pressure", {0.5}, 1.0);
        SensoryInput low_conf ("tactile", "pressure", {0.5}, 0.1);

        // Reset to eliminate novelty differences
        manager->reset();
        SalienceScore high_score = manager->calculateSalience(high_conf);
        manager->reset();
        SalienceScore low_score  = manager->calculateSalience(low_conf);

        TS_ASSERT(high_score.signal_quality > low_score.signal_quality);
    }

    // -----------------------------------------------------------------------
    // Attention spreading tests
    // -----------------------------------------------------------------------

    void testSpreadAttentionBasic()
    {
        Handle src  = atomspace->add_node(CONCEPT_NODE, "source");
        Handle dst1 = atomspace->add_node(CONCEPT_NODE, "dest1");
        Handle dst2 = atomspace->add_node(CONCEPT_NODE, "dest2");

        // Create a link so src has outgoing atoms
        Handle link = atomspace->add_link(LIST_LINK, HandleSeq{dst1, dst2});

        manager->allocateAttention(src, 1.0);
        manager->updateAttention(src, 1.0);

        // Spread from the link (which has outgoing set {dst1, dst2})
        manager->spreadAttention(link, 0.2);

        // dst1 and dst2 should now have some STI
        double d1 = manager->getSTI(dst1);
        double d2 = manager->getSTI(dst2);
        TS_ASSERT(d1 > 0.0 || d2 > 0.0);
    }

    void testSpreadAttentionUndefinedHandle()
    {
        // Should not crash
        TS_ASSERT_THROWS_NOTHING(manager->spreadAttention(Handle::UNDEFINED, 0.1));
    }

    // -----------------------------------------------------------------------
    // Statistics tests
    // -----------------------------------------------------------------------

    void testGetStatsFormat()
    {
        std::string stats = manager->getStats();
        TS_ASSERT(stats.find("allocations") != std::string::npos);
        TS_ASSERT(stats.find("decay_cycles") != std::string::npos);
        TS_ASSERT(stats.find("tracked_atoms") != std::string::npos);
        TS_ASSERT(stats.find("focus_size") != std::string::npos);
    }

    void testResetClearsState()
    {
        Handle atom = atomspace->add_node(CONCEPT_NODE, "reset_test");
        manager->allocateAttention(atom, 0.8);
        TS_ASSERT_EQUALS(manager->trackedAtomCount(), 1U);

        manager->reset();
        TS_ASSERT_EQUALS(manager->trackedAtomCount(), 0U);
    }
};
