# GTAngel v27 civic producer configuration.
# Copy to ".env" next to gtangel_agi_v27.exe and fill in real values.
# Process environment variables always win over this file.
#
# ARC_ANGEL_INGEST_URL is the telemetry ingest base URL; the producer
# appends /api/telemetry/ingest automatically when missing.

ARC_ANGEL_INGEST_URL=https://ingest.example.arc-angel/api/telemetry/ingest
ARC_ANGEL_GTANGEL_TOKEN=replace-with-embodied-scoped-token
ARC_ANGEL_PURPOSE_TOKEN=replace-with-purpose-scoped-token
ARC_ANGEL_EXPRESSION_TOKEN=replace-with-expression-scoped-token