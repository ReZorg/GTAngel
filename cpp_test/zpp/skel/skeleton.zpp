  -- val(rsF8) = 1008
  -- val(rsF9) = 1009
  -- val(rsF10) = 1010
  -- val(rsF11) = 1011
  -- val(rsF12) = 1012
  -- val(rsINS) = 1013
  -- val(rsDEL) = 1014
  -- val(rsHOME) = 1015
  -- val(rsEND) = 1016
