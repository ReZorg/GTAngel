  -- val(rsLEFT) = 1021
  -- val(rsRIGHT) = 1022
  -- val(rsDIVIDE) = 1023

RsPadButtons ::= rsPADNULL | rsPADBUTTON1 | rsPADBUTTON2 | rsPADBUTTON3 | rsPADBUTTON4 | rsPADBUTTON5 | rsPADBUTTON6 | rsPADBUTTON7 | rsPADBUTTON8 | rsPADSELECT | rsPADBUTTONA1 | rsPADBUTTONA2 | rsPADSTART | rsPADDPADUP | rsPADDPADRIGHT | rsPADDPADDOWN | rsPADDPADLEFT
