--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema RsInputDevice
  inputDeviceType : RsInputDeviceType
  used : 𝔹
  inputEventHandler : RsInputEventHandler
where
  instance_addr ∈ ADDRESS
end

schema RsGlobalType
  appName : seq CHAR
  width : ℤ
  height : ℤ
  maximumWidth : ℤ
  maximumHeight : ℤ
  maxFPS : ℤ
  quit : 𝔹
  ps : ADDRESS
  keyboard : RsInputDevice
  mouse : RsInputDevice
  pad : RsInputDevice
where
  instance_addr ∈ ADDRESS
end

schema RsKeyStatus
  keyCharCode : ℤ
where
  instance_addr ∈ ADDRESS
end

schema RsPadButtonStatus
  padID : ℤ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema skeleton_RsTimer
  ΔskeletonModuleState
where
  -- Return postcondition: result! = psTimer()
  true
end

schema skeleton_RsCameraShowRaster
  ΔskeletonModuleState
  camera? : Ref[RwCamera]
where
  -- Deterministic transition preserving module invariants
  true
end

schema skeleton_RsCameraBeginUpdate
  ΔskeletonModuleState
  camera? : Ref[RwCamera]
where
  -- Return postcondition: result! = psCameraBeginUpdate(camera)
  true
end

schema skeleton_RsGrabScreen
  ΔskeletonModuleState
  camera? : Ref[RwCamera]
where
  -- Return postcondition: result! = psGrabScreen(camera)
  true
end

schema skeleton_RsRegisterImageLoader
  ΔskeletonModuleState
where
  -- Return postcondition: result! = TRUE
  true
end

schema skeleton_RsSetDebug
  ΔskeletonModuleState
where
  -- Return postcondition: result! = TRUE
  true
end

schema skeleton_RsMouseSetPos
  ΔskeletonModuleState
  pos? : Ref[RwV2d]
where
  -- Deterministic transition preserving module invariants
  true
end

schema skeleton_RsSelectDevice
  ΔskeletonModuleState
where
  -- Return postcondition: result! = psSelectDevice()
  true
end

schema skeleton_RsInputDeviceAttach
  ΔskeletonModuleState
  inputDevice? : RsInputDeviceType
  inputEventHandler? : RsInputEventHandler
where
  -- State update: RsGlobal.keyboard.inputEventHandler' = inputEventHandler
  -- State update: RsGlobal.keyboard.used' = TRUE
  -- State update: RsGlobal.mouse.inputEventHandler' = inputEventHandler
  -- State update: RsGlobal.mouse.used' = TRUE
  -- State update: RsGlobal.pad.inputEventHandler' = inputEventHandler
  -- State update: RsGlobal.pad.used' = TRUE
  -- Return postcondition: result! = FALSE
  -- Return postcondition: result! = TRUE
  true
end

schema skeleton_rsCommandLine
  ΔskeletonModuleState
  arg? : seq CHAR
where
  -- Return postcondition: result! = TRUE
  true
end

schema skeleton_rsPreInitCommandLine
  ΔskeletonModuleState
  arg? : seq CHAR
where
  -- State update: DefaultVideoMode' = FALSE
  -- State update: gbModelViewer' = TRUE
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = FALSE
  true
end

schema skeleton_RsKeyboardEventHandler
  ΔskeletonModuleState
  event? : RsEvent
  param? : ADDRESS
where
  -- Return postcondition: result! = RsGlobal.keyboard.inputEventHandler(event, param)
  -- Return postcondition: result! = rsEVENTNOTPROCESSED
  -- Invokes: keyboard.inputEventHandler
  true
end

schema skeleton_RsPadEventHandler
  ΔskeletonModuleState
  event? : RsEvent
  param? : ADDRESS
where
  -- Return postcondition: result! = RsGlobal.pad.inputEventHandler(event, param)
  -- Return postcondition: result! = rsEVENTNOTPROCESSED
  -- Invokes: pad.inputEventHandler
  true
end

schema skeleton_RsEventHandler
  ΔskeletonModuleState
  event? : RsEvent
  param? : ADDRESS
where
  -- State update: es' = AppEventHandler(event, param)
  -- State update: RsGlobal.quit' = TRUE
  -- Return postcondition: result! = result
  true
end

schema skeleton_RsRwTerminate
  ΔskeletonModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema skeleton_RsRwInitialize
  ΔskeletonModuleState
  displayID? : ADDRESS
where
  -- State update: openParams.displayID' = displayID
  -- Return postcondition: result! = (FALSE)
  -- Return postcondition: result! = (FALSE)
  -- Return postcondition: result! = (FALSE)
  true
end

schema skeleton_RsTerminate
  ΔskeletonModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema skeleton_RsInitialize
  ΔskeletonModuleState
where
  -- State update: RsGlobal.appName' = RWSTRING("GTA: Liberty City Stories")
  -- State update: RsGlobal.maximumWidth' = DEFAULT_SCREEN_WIDTH
  -- State update: RsGlobal.maximumHeight' = DEFAULT_SCREEN_HEIGHT
  -- State update: RsGlobal.width' = DEFAULT_SCREEN_WIDTH
  -- State update: RsGlobal.height' = DEFAULT_SCREEN_HEIGHT
  -- State update: RsGlobal.maxFPS' = 30
  -- Return postcondition: result! = result
  true
end
