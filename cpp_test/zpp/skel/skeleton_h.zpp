--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema RsInputDevice
  inputDeviceType : RsInputDeviceType
  used : 𝔹
  inputEventHandler : RsInputEventHandler
where
  instance_addr ∈ ADDRESS
end

schema RsGlobalType
  appName : seq CHAR
  width : ℤ
  height : ℤ
  maximumWidth : ℤ
  maximumHeight : ℤ
  maxFPS : ℤ
  quit : 𝔹
  ps : ADDRESS
  keyboard : RsInputDevice
  mouse : RsInputDevice
  pad : RsInputDevice
where
  instance_addr ∈ ADDRESS
end

schema RsKeyStatus
  keyCharCode : ℤ
where
  instance_addr ∈ ADDRESS
end

schema RsPadButtonStatus
  padID : ℤ
where
  instance_addr ∈ ADDRESS
end
