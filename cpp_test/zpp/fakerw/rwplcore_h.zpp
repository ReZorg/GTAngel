--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema RwMemoryFunctions
  instance_addr : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema RwMemoryFunctions_void
  ΔRwMemoryFunctions
  arg_1? : Ref[rwfree]
where
  -- Declared member operation RwMemoryFunctions::void(*rwfree)
  true
end

schema RwMemory
  start : ℙ ℕ
  length : ℕ
where
  #start ≤ 1
  length ≥ 0
end

schema RwEngineOpenParams
  displayID : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema RwFileFunctions
  rwfexist : rwFnFexist
  rwfopen : rwFnFopen
  rwfclose : rwFnFclose
  rwfread : rwFnFread
  rwfwrite : rwFnFwrite
  rwfgets : rwFnFgets
  rwfputs : rwFnFputs
  rwfeof : rwFnFeof
  rwfseek : rwFnFseek
  rwfflush : rwFnFflush
  rwftell : rwFnFtell
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema rwplcore_RwRGBAAssign
  ΔrwplcoreModuleState
  target? : Ref[RwRGBA]
  source? : Ref[RwRGBA]
where
  -- State update: target' = *source
  true
end
