--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: rwplcore (fakerw)
-- Source File(s): fakerw/rwplcore.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
__RWUNUSED__ : seq CHAR  -- #define __RWUNUSED__ #ifndef FALSE
FALSE : ℕ  -- #define FALSE 0
TRUE : seq CHAR  -- #define TRUE !FALSE
rwsprintf : seq CHAR  -- #define rwsprintf sprintf
rwvsprintf : seq CHAR  -- #define rwvsprintf vsprintf
rwstrcpy : seq CHAR  -- #define rwstrcpy strcpy
rwstrncpy : seq CHAR  -- #define rwstrncpy strncpy
rwstrcat : seq CHAR  -- #define rwstrcat strcat
rwstrncat : seq CHAR  -- #define rwstrncat strncat
rwstrrchr : seq CHAR  -- #define rwstrrchr strrchr
rwstrchr : seq CHAR  -- #define rwstrchr strchr
rwstrstr : seq CHAR  -- #define rwstrstr strstr
rwstrcmp : seq CHAR  -- #define rwstrcmp strcmp
rwstricmp : seq CHAR  -- #define rwstricmp stricmp
rwstrlen : seq CHAR  -- #define rwstrlen strlen
rwstrupr : seq CHAR  -- #define rwstrupr strupr
rwstrlwr : seq CHAR  -- #define rwstrlwr strlwr
rwstrtok : seq CHAR  -- #define rwstrtok strtok
rwsscanf : seq CHAR  -- #define rwsscanf sscanf

