schema CShotInfo_Initialise
  ΔCShotInfo
where
  -- State update: m_inUse' = false
  -- State update: m_weapon' = WEAPONTYPE_COLT45
  -- State update: m_startPos' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_areaAffected' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_radius' = 1.0f
  -- State update: m_sourceEntity' = ∅
  true
end

schema CShotInfo_AddShot
  ΔCShotInfo
  sourceEntity? : Ref[CEntity]
  weapon? : eWeaponType
  startPos? : CVector
  endPos? : CVector
where
  -- State update: weaponInfo' = CWeaponInfo::GetWeaponInfo(weapon)
  -- State update: slot' = 0
  -- State update: m_inUse' = true
  -- State update: m_weapon' = weapon
  -- State update: m_startPos' = startPos
  -- State update: m_areaAffected' = endPos - startPos
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CWeaponInfo::GetWeaponInfo, CGeneral::GetRandomNumber, m_areaAffected.Normalise, weaponInfo->IsFlagSet, CTimer::GetTimeInMilliseconds
  true
end

schema CShotInfo_Shutdown
  ΔCShotInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema CShotInfo_Update
  ΔCShotInfo
where
  -- State update: slot' = 0
