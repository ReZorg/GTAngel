--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CWeaponEffects
  m_bActive : 𝔹
  m_vecPos : CVector
  m_nRed : ℕ
  m_nGreen : ℕ
  m_nBlue : ℕ
  m_nAlpha : ℕ
  m_fSize : ℝ
  m_fRotation : ℝ
where
  m_nRed ≥ 0
  m_nGreen ≥ 0
  m_nBlue ≥ 0
  m_nAlpha ≥ 0
end

schema CWeaponEffects_CWeaponEffects
