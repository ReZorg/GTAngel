--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CExplosion_Initialise
  ΔCExplosion
where
  -- State update: m_ExplosionType' = EXPLOSION_GRENADE
  -- State update: m_vecPosition' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_fRadius' = 1.0f
  -- State update: m_fPropagationRate' = 0.0f
  -- State update: m_fZshift' = 0.0f
  -- State update: m_pCreatorEntity' = ∅
  -- Invokes: DMAudio.CreateEntity, DMAudio.SetEntityStatus
  true
end

schema CExplosion_ClearAllExplosions
  ΔCExplosion
where
  -- State update: m_ExplosionType' = EXPLOSION_GRENADE
  -- State update: m_vecPosition' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_fRadius' = 1.0f
  -- State update: m_fPropagationRate' = 0.0f
  -- State update: m_fZshift' = 0.0f
  -- State update: m_pCreatorEntity' = ∅
  true
end

schema CExplosion_Shutdown
  ΔCExplosion
where
  -- State update: AudioHandle' = AEHANDLE_NONE
  -- Invokes: DMAudio.DestroyEntity
  true
end

schema CExplosion_GetExplosionActiveCounter
  ΔCExplosion
