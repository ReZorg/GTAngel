--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: ShotInfo (weapons)
-- Source File(s): weapons/ShotInfo.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include WeaponType.zpp  (from "WeaponType.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CShotInfo
  m_weapon : eWeaponType
  m_startPos : CVector
  m_areaAffected : CVector
  m_radius : ℝ
  m_sourceEntity : Ref[CEntity]
  m_timeout : ℝ
  m_inUse : 𝔹
  ms_afRandTable : seq ℝ  -- bounded array [20]
where
  #m_sourceEntity ≤ 1
  #ms_afRandTable = 20
end

schema CShotInfo_Initialise
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Initialise(void)
  true
end

schema CShotInfo_AddShot_2
  ΔCShotInfo
  arg_1? : Ref[CEntity]
  arg_2? : eWeaponType
  arg_3? : CVector
  arg_4? : CVector
  result! : 𝔹
where
  -- Declared member operation CShotInfo::AddShot(CEntity*, eWeaponType, CVector, CVector)
  true
end

schema CShotInfo_Shutdown_3
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Shutdown(void)
  true
end

schema CShotInfo_Update_4
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Update(void)
  true
end
