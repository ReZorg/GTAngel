--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CWeaponInfo
  ms_aReloadSampleTime : seq ℕ  -- bounded array [WEAPONTYPE_TOTALWEAPONS]
  ms_aMaxAmmoForWeapon : seq ℤ  -- bounded array [WEAPONTYPE_TOTALWEAPONS]
  m_eWeaponFire : eWeaponFire
  m_fRange : ℝ
  m_nFiringRate : ℕ
  m_nReload : ℕ
  m_nAmountofAmmunition : ℤ
  m_nDamage : ℕ
  m_fSpeed : ℝ
  m_fRadius : ℝ
  m_fLifespan : ℝ
  m_fSpread : ℝ
  m_vecFireOffset : CVector
  m_AnimToPlay : AssocGroupId
  m_fAnimLoopStart : ℝ
  m_fAnimLoopEnd : ℝ
  m_fAnimFrameFire : ℝ
  m_fAnim2LoopStart : ℝ
  m_fAnim2LoopEnd : ℝ
  m_fAnim2FrameFire : ℝ
  m_fAnimBreakout : ℝ
  m_nModelId : ℤ
  m_nModel2Id : ℤ
  m_Flags : ℕ
  m_nWeaponSlot : ℕ
  m_Anim2ToPlay : AnimationId
where
  m_nFiringRate ≥ 0
  m_nReload ≥ 0
  m_nDamage ≥ 0
  m_Flags ≥ 0
  m_nWeaponSlot ≥ 0
end

schema CWeaponInfo_Initialise
  ΔCWeaponInfo
where
  -- Declared member operation CWeaponInfo::Initialise(void)
  true
end

