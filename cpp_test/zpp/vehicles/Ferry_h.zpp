schema Ferry_GetFerry
  ΔFerryModuleState
  i? : ℤ
  result! : Ref[CFerry]
where
  -- Return postcondition: result! = mspInst ? mspInst->m_apFerries[i] : nil
  true
end

schema Ferry_SetFerriesDisabled
  ΔFerryModuleState
  disabled? : 𝔹
where
  -- State update: mspInst.m_bFerriesDisabled' = disabled
  true
end
