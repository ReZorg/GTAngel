--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eEngineStatus ::= ENGINE_STATUS_STEAM1 | ENGINE_STATUS_STEAM2 | ENGINE_STATUS_SMOKE | ENGINE_STATUS_ON_FIRE
  -- val(ENGINE_STATUS_STEAM1) = 100
  -- val(ENGINE_STATUS_STEAM2) = 150
  -- val(ENGINE_STATUS_SMOKE) = 200
  -- val(ENGINE_STATUS_ON_FIRE) = 225

eDoorStatus ::= DOOR_STATUS_OK | DOOR_STATUS_SMASHED | DOOR_STATUS_SWINGING | DOOR_STATUS_MISSING

ePanelStatus ::= PANEL_STATUS_OK | PANEL_STATUS_SMASHED1 | PANEL_STATUS_SMASHED2 | PANEL_STATUS_MISSING

eWheelStatus ::= WHEEL_STATUS_OK | WHEEL_STATUS_BURST | WHEEL_STATUS_MISSING

eLightStatus ::= LIGHT_STATUS_OK | LIGHT_STATUS_BROKEN

tComponent ::= COMPONENT_DEFAULT | COMPONENT_WHEEL_FRONT_LEFT | COMPONENT_WHEEL_FRONT_RIGHT | COMPONENT_WHEEL_REAR_LEFT | COMPONENT_WHEEL_REAR_RIGHT | COMPONENT_DOOR_BONNET | COMPONENT_DOOR_BOOT | COMPONENT_DOOR_FRONT_LEFT | COMPONENT_DOOR_FRONT_RIGHT | COMPONENT_DOOR_REAR_LEFT | COMPONENT_DOOR_REAR_RIGHT | COMPONENT_PANEL_FRONT_LEFT | COMPONENT_PANEL_FRONT_RIGHT | COMPONENT_PANEL_REAR_LEFT | COMPONENT_PANEL_REAR_RIGHT | COMPONENT_PANEL_WINDSCREEN | COMPONENT_BUMPER_FRONT | COMPONENT_BUMPER_REAR

tComponentGroup ::= COMPGROUP_BUMPER | COMPGROUP_WHEEL | COMPGROUP_DOOR | COMPGROUP_BONNET | COMPGROUP_BOOT | COMPGROUP_PANEL | COMPGROUP_DEFAULT

