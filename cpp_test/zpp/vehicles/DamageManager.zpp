schema CDamageManager
  m_fWheelDamageEffect : ℝ
  m_bSmashedDoorDoesntClose : 𝔹
  m_engineStatus : ℕ
  m_wheelStatus : seq ℕ  -- bounded array [4]
  m_doorStatus : seq ℕ  -- bounded array [6]
  m_lightStatus : ℕ
  m_panelStatus : ℕ
  field_18 : ℕ
where
  m_engineStatus ≥ 0
  #m_wheelStatus = 4
  #m_doorStatus = 6
  m_lightStatus ≥ 0
  m_panelStatus ≥ 0
  field_18 ≥ 0
end

schema CDamageManager_CDamageManager
  ΔCDamageManager
where
  -- Declared member operation CDamageManager::CDamageManager(void)
  true
end

