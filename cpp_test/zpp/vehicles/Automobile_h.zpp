--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Automobile_Enum_1 ::= CARWHEEL_FRONT_LEFT | CARWHEEL_REAR_LEFT | CARWHEEL_FRONT_RIGHT | CARWHEEL_REAR_RIGHT

eCarNodes ::= CAR_WHEEL_RF | CAR_WHEEL_RM | CAR_WHEEL_RB | CAR_WHEEL_LF | CAR_WHEEL_LM | CAR_WHEEL_LB | CAR_BUMP_FRONT | CAR_BUMP_REAR | CAR_WING_RF | CAR_WING_RR | CAR_DOOR_RF | CAR_DOOR_RR | CAR_WING_LF | CAR_WING_LR | CAR_DOOR_LF | CAR_DOOR_LR | CAR_BONNET | CAR_BOOT | CAR_WINDSCREEN | NUM_CAR_NODES
  -- val(CAR_WHEEL_RF) = 1

eBombType ::= CARBOMB_NONE | CARBOMB_TIMED | CARBOMB_ONIGNITION | CARBOMB_REMOTE | CARBOMB_TIMEDACTIVE | CARBOMB_ONIGNITIONACTIVE

Automobile_Enum_4 ::= CAR_DOOR_FLAG_UNKNOWN | CAR_DOOR_FLAG_LF | CAR_DOOR_FLAG_LR | CAR_DOOR_FLAG_RF | CAR_DOOR_FLAG_RR
  -- val(CAR_DOOR_FLAG_UNKNOWN) = 0x0
  -- val(CAR_DOOR_FLAG_LF) = 0x1
  -- val(CAR_DOOR_FLAG_LR) = 0x2
  -- val(CAR_DOOR_FLAG_RF) = 0x4
  -- val(CAR_DOOR_FLAG_RR) = 0x8

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CAutomobile
  CVehicle  -- inherits base schema
  Damage : CDamageManager
  Doors : seq CDoor  -- bounded array [6]
  m_aCarNodes : seq Ref[RwFrame]  -- bounded array [NUM_CAR_NODES]
  m_aWheelColPoints : seq ℤ  -- bounded array [4]
  m_aSuspensionSpringRatio : seq ℝ  -- bounded array [4]
  m_aSuspensionSpringRatioPrev : seq ℝ  -- bounded array [4]
  m_aWheelTimer : seq ℝ  -- bounded array [4]
  m_auto_unused1 : ℝ
  m_fEngineInertiaVar1 : ℝ
  m_fEngineInertiaVar2 : ℝ
  m_aWheelSkidmarkType : seq eSkidmarkType  -- bounded array [4]
  m_aWheelSkidmarkBloody : seq 𝔹  -- bounded array [4]
  m_aWheelSkidmarkUnk : seq 𝔹  -- bounded array [4]
  m_aWheelRotation : seq ℝ  -- bounded array [4]
  m_aWheelPosition : seq ℝ  -- bounded array [4]
  m_aWheelSpeed : seq ℝ  -- bounded array [4]
  m_auto_unused2 : ℕ
  m_bombType : 𝔹
  bTaxiLight : 𝔹
  bDriverLastFrame : 𝔹
  bFixedColour : 𝔹
  bBigWheels : 𝔹
  bWaterTight : 𝔹
  bNotDamagedUpsideDown : 𝔹
  bMoreResistantToDamage : 𝔹
  bTankDetonateCars : 𝔹
  bStuckInSand : 𝔹
  bHeliDestroyed : 𝔹
  m_pBombRigger : Ref[CEntity]
  m_doingBurnout : ℤ
  m_hydraulicState : ℕ
  m_nBusDoorTimerEnd : ℕ
  m_nBusDoorTimerStart : ℕ
  m_aSuspensionSpringLength : seq ℝ  -- bounded array [4]
  m_aSuspensionLineLength : seq ℝ  -- bounded array [4]
  m_fHeightAboveRoad : ℝ
  m_fTraction : ℝ
  m_fTireTemperature : ℝ
  m_fOrientation : ℝ
  m_fPlaneSteer : ℝ
  m_fVelocityChangeForAudio : ℝ
  m_randomValues : seq ℝ  -- bounded array [6]
  m_fFireBlowUpTimer : ℝ
  m_aGroundPhysical : seq Ref[CPhysical]  -- bounded array [4]
  m_aGroundOffset : seq CVector  -- bounded array [4]
  m_pSetOnFireEntity : Ref[CEntity]
  m_weaponDoorTimerLeft : ℝ
  m_weaponDoorTimerRight : ℝ
  m_fCarGunLR : ℝ
  m_fCarGunUD : ℝ
  m_fHeliOrientation : ℝ
  m_fPropellerRotation : ℝ
  stuff4 : seq ℕ  -- bounded array [4]
  m_nWheelsOnGround : ℕ
  m_nDriveWheelsOnGround : ℕ
  m_nDriveWheelsOnGroundPrev : ℕ
  m_fGasPedalAudio : ℝ
  m_aWheelState : seq tWheelState  -- bounded array [4]
  m_sAllTaxiLights : 𝔹
  m_auto_unk1 : ℤ
where
  #Doors = 6
  #m_aWheelColPoints = 4
  #m_aSuspensionSpringRatio = 4
  #m_aSuspensionSpringRatioPrev = 4
  #m_aWheelTimer = 4
  #m_aWheelSkidmarkType = 4
  #m_aWheelSkidmarkBloody = 4
  #m_aWheelSkidmarkUnk = 4
  #m_aWheelRotation = 4
  #m_aWheelPosition = 4
  #m_aWheelSpeed = 4
  m_auto_unused2 ≥ 0
  #m_bombType = 3
  #bTaxiLight = 1
  #bDriverLastFrame = 1
  #bFixedColour = 1
end

