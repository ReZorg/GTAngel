schema Automobile_SetHeliOrientation
  ΔAutomobileModuleState
  orient? : ℝ
where
  -- State update: m_fHeliOrientation' = orient
  true
end

schema Automobile_ClearHeliOrientation
  ΔAutomobileModuleState
where
  -- State update: m_fHeliOrientation' = -1.0f
  true
end

schema Automobile_GetCarDoorFlag
  ΔAutomobileModuleState
  carnode? : ℤ
  result! : ℕ
where
  -- Return postcondition: result! = CAR_DOOR_FLAG_LF
  -- Return postcondition: result! = CAR_DOOR_FLAG_LR
  -- Return postcondition: result! = CAR_DOOR_FLAG_RF
  true
end
