--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Floater (vehicles)
-- Source File(s): vehicles/Floater.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
tWaterLevel ::= FLOATER_ABOVE_WATER | FLOATER_IN_WATER | FLOATER_UNDER_WATER

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema cBuoyancy
  m_position : CVector
  m_matrix : CMatrix
  m_field_54 : ℤ
  m_positionZ : CVector
  m_waterlevel : ℝ
  m_waterLevelInc : ℝ
  m_buoyancy : ℝ
  m_dimMax : CVector
  m_dimMin : CVector
  m_numPartialVolumes : ℝ
  m_field_8C : ℤ
  m_field_90 : ℤ
  m_field_94 : ℤ
  m_haveVolume : 𝔹
  m_step : CVector
  m_stepRatio : CVector
  m_numSteps : ℝ
  m_flipAverage : 𝔹
  m_field_B9 : seq CHAR
  m_isBoat : 𝔹
  m_volumeUnderWater : ℝ
  m_impulsePoint : CVector
where
  instance_addr ∈ ADDRESS
end

