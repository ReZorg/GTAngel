--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tHandlingData
  fMass : ℝ
  fTurnMass : ℝ
  fTractionMultiplier : ℝ
  fCollisionDamageMultiplier : ℝ
  nIdentifier : tVehicleType
  fInvMass : ℝ
  fDragMult : ℝ
  CentreOfMass : CVector
  nPercentSubmerged : ℤ
  fBuoyancy : ℝ
  Transmission : cTransmission
  fBrakeDeceleration : ℝ
  fBrakeBias : ℝ
  bABS : ℤ
  fSteeringLock : ℝ
  fTractionLoss : ℝ
  fTractionBias : ℝ
  fUnused : ℝ
  fSuspensionForceLevel : ℝ
  fSuspensionDampingLevel : ℝ
  fSuspensionUpperLimit : ℝ
  fSuspensionLowerLimit : ℝ
  fSuspensionBias : ℝ
  fSuspensionAntidiveMultiplier : ℝ
  Flags : ℕ
  fSeatOffsetDistance : ℝ
  nMonetaryValue : ℤ
  FrontLights : ℤ
  RearLights : ℤ
  unk : seq ℤ  -- bounded array [4]
where
  Flags ≥ 0
  #unk = 4
end

schema tHandlingData_GetMass
  ΞtHandlingData
  result! : ℝ
where
  -- Declared member operation tHandlingData::GetMass(void)
  true
end

schema tHandlingData_GetTurnMass_2
  ΞtHandlingData
  result! : ℝ
where
  -- Declared member operation tHandlingData::GetTurnMass(void)
  true
end

schema tHandlingData_GetTractionMultiplier_3
  ΞtHandlingData
  result! : ℝ
where
  -- Declared member operation tHandlingData::GetTractionMultiplier(void)
  true
end

schema tHandlingData_GetCollisionDamageMultiplier_4
  ΞtHandlingData
  result! : ℝ
where
  -- Declared member operation tHandlingData::GetCollisionDamageMultiplier(void)
  true
end

schema tBikeHandlingData
  nIdentifier : tVehicleType
  fLeanFwdCOM : ℝ
  fLeanFwdForce : ℝ
  fLeanBakCOM : ℝ
  fLeanBackForce : ℝ
  fMaxLean : ℝ
  fFullAnimLean : ℝ
  fDesLean : ℝ
  fSpeedSteer : ℝ
  fSlipSteer : ℝ
  fNoPlayerCOMz : ℝ
  fWheelieAng : ℝ
  fStoppieAng : ℝ
  fWheelieSteer : ℝ
  fWheelieStabMult : ℝ
  fStoppieStabMult : ℝ
where
  instance_addr ∈ ADDRESS
end

schema tBoatHandlingData
  nIdentifier : tVehicleType
  fThrustY : ℝ
  fThrustZ : ℝ
  fThrustAppZ : ℝ
  fAqPlaneForce : ℝ
  fAqPlaneLimit : ℝ
  fAqPlaneOffset : ℝ
  fWaveAudioMult : ℝ
  fLook_L_R_BehindCamHeight : ℝ
  vecMoveRes : CVector
  vecTurnRes : CVector
where
  instance_addr ∈ ADDRESS
end

schema tFlyingHandlingData
  nIdentifier : tVehicleType
  fThrust : ℝ
  fThrustFallOff : ℝ
  fYaw : ℝ
  fYawStab : ℝ
  fSideSlip : ℝ
  fRoll : ℝ
  fRollStab : ℝ
  fPitch : ℝ
  fPitchStab : ℝ
  fFormLift : ℝ
  fAttackLift : ℝ
  fMoveRes : ℝ
  vecTurnRes : CVector
  vecSpeedRes : CVector
where
  instance_addr ∈ ADDRESS
end

schema cHandlingDataMgr
  field_0 : ℝ
  fWheelFriction : ℝ
  field_8 : ℝ
  field_C : ℝ
  field_10 : ℝ
  HandlingData : seq tHandlingData  -- bounded array [NUMHANDLINGS]
  BikeHandlingData : seq tBikeHandlingData  -- bounded array [NUMBIKEHANDLINGS]
  FlyingHandlingData : seq tFlyingHandlingData  -- bounded array [NUMFLYINGHANDLINGS]
  BoatHandlingData : seq tBoatHandlingData  -- bounded array [NUMBOATHANDLINGS]
where
  instance_addr ∈ ADDRESS
end

schema cHandlingDataMgr_cHandlingDataMgr
  ΔcHandlingDataMgr
where
  -- Declared member operation cHandlingDataMgr::cHandlingDataMgr(void)
  true
end

