-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema HandlingMgr_GetMass
  ΞHandlingMgrModuleState
  result! : ℝ
where
  -- Return postcondition: result! = fMass
  true
end

schema HandlingMgr_GetTurnMass
  ΞHandlingMgrModuleState
  result! : ℝ
where
  -- Return postcondition: result! = fTurnMass
  true
end

schema HandlingMgr_GetTractionMultiplier
  ΞHandlingMgrModuleState
  result! : ℝ
where
  -- Return postcondition: result! = fTractionMultiplier
  true
end

schema HandlingMgr_GetCollisionDamageMultiplier
  ΞHandlingMgrModuleState
  result! : ℝ
where
  -- Return postcondition: result! = fCollisionDamageMultiplier
  true
end

schema HandlingMgr_HasRearWheelDrive
  ΔHandlingMgrModuleState
  id? : tVehicleType
  result! : 𝔹
where
  -- Return postcondition: result! = HandlingData[id].Transmission.nDriveType != 'F'
  true
end

schema HandlingMgr_HasFrontWheelDrive
  ΔHandlingMgrModuleState
  id? : tVehicleType
  result! : 𝔹
where
  -- Return postcondition: result! = HandlingData[id].Transmission.nDriveType != 'R'
  true
end
