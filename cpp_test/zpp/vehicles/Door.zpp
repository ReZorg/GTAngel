where
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

schema CTrainDoor_IsClosed
  ΔCTrainDoor
where
  -- Return postcondition: result! = m_fPosn == RetTranslationWhenClosed()
  true
end

schema CFerryDoor_IsInUse
  ΔCFerryDoor
where
  -- State update: translationDifference' = m_fPrevPosn - m_fPosn
  -- State update: m_fPrevPosn' = m_fPosn
  -- Return postcondition: result! = Abs(translationDifference) > 0.002f
  true
end

schema CFerryDoor_RetTranslationWhenClosed
  ΔCFerryDoor
where
  -- Return postcondition: result! = m_fClosedPosn
  -- Return postcondition: result! = m_fOpenPosn
  true
end

schema CFerryDoor_IsClosed
  ΔCFerryDoor
where
  -- Return postcondition: result! = m_fPosn == RetTranslationWhenClosed()
  true
end

schema CFerryDoor_RetTranslationWhenOpen
  ΔCFerryDoor
where
  -- Return postcondition: result! = m_fOpenPosn
  -- Return postcondition: result! = m_fClosedPosn
  true
end

schema CFerryDoor_IsFullyOpen
