where
  -- State update: m_fPrevPosn' = m_fPosn
  -- State update: open' = RetTranslationWhenOpen()
  -- State update: m_fPosn' = open*ratio
  -- State update: m_nDoorState' = DOORST_OPEN
  -- State update: m_fPosn' = open
  true
end

