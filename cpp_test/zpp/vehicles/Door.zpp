end

schema CTrainDoor_RetTranslationWhenOpen
  ΔCTrainDoor
where
  -- Return postcondition: result! = m_fOpenPosn
  -- Return postcondition: result! = m_fClosedPosn
  true
end

schema CTrainDoor_IsFullyOpen
