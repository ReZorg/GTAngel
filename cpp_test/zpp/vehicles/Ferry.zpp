schema CFerry_Init
  ΔCFerry
  pInstancePtr? : ADDRESS
where
  -- State update: mspInst' = (CFerryInst*)pInstancePtr
  -- State update: mspInst' = new CFerryInst()
  -- State update: aLineBits' = new CFerryInterpolationLine[NUM_FERRY_STATIONS * 4 + 2]
  -- State update: filename' = "Data\\PATHS\\FERRY1.DAT"
  -- State update: readingFile' = false
  -- State update: pPath' = mspInst.pPathData[k]
  -- Invokes: CFileMgr::LoadFile, CWorld::ProcessVerticalLine
  true
end

