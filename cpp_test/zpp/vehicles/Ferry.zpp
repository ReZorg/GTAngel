schema CFerry_ProcessControl
  ΔCFerry
where
  -- State update: pPath' = mspInst.pPathData[m_nFerryId / 2]
  -- State update: fPosition' = mspInst.m_afPositions[m_nFerryId]
  -- State update: fSpeed' = mspInst.m_afSpeeds[m_nFerryId]
  -- State update: trackNodes' = mspInst.pPathData[m_nFerryId / 2].aTrackNodes
  -- State update: numTrackNodes' = mspInst.pPathData[m_nFerryId / 2].NumTrackNodes
  -- State update: totalLengthOfTrack' = mspInst.pPathData[m_nFerryId / 2].TotalLengthOfTrack
  -- Invokes: CTimer::GetFrameCounter, fwd.Normalise, tmp.SetRotateZ, right.Normalise, m_vecMoveSpeed.MagnitudeSqr
