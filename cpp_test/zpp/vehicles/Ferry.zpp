  -- State update: vDirectionToCamera' = vVectorToCamera / fDistanceToCamera
  -- State update: dp' = DotProduct(GetForward(), vDirectionToCamera)
  -- Invokes: CGeneral::GetRandomTrueFalse, CParticle::AddParticle, TheCamera.GetPosition, vVectorToCamera.Magnitude, CCoronas::RegisterCorona
  true
end

