end

schema CFerry_OpenFerryDoor
  ΔCFerry
  ratio? : ℝ
where
  -- State update: door1' = 0
  -- State update: door2' = 1
  -- State update: door1' = 2
  -- State update: door2' = 3
  -- State update: node1' = m_bUseFrontDoor ? FERRY_DOOR_FRONT : FERRY_DOOR_BACK
  -- State update: node2' = m_bUseFrontDoor ? FERRY_RAMP_FRONT : FERRY_RAMP_BACK
  -- Invokes: doorL.GetPosition, doorR.GetPosition, doorL.SetRotateXOnly, doorR.SetRotateXOnly, doorL.UpdateRW
  true
end

schema CFerry_GetBoardingSpace
  ΔCFerry
  use? : CFerry__eSpaceUse
  style? : CFerry__eSpaceStyle
  position? : ℕ
  result! : CVector
where
  -- State update: pModelInfo' = GetModelInfo()
  -- State update: style' = FERRY_SPACE_STYLE_1
  -- State update: style' = FERRY_SPACE_STYLE_0
  -- State update: space' = pModelInfo.m_positions[FERRY_POS_PED_POINT]
  -- State update: space' = pModelInfo.m_positions[FERRY_POS_CAR1 + position]
  -- State update: space' = GetMatrix() * space
  -- Return postcondition: result! = space
  true
end

schema CFerry_GetClosestFerry
  ΔCFerry
  x? : ℝ
  y? : ℝ
  result! : Ref[CFerry]
where
  -- State update: closest' = -1
  -- State update: mindist' = 9999.9f
  -- State update: pFerry' = GetFerry(i)
  -- State update: mindist' = dist
  -- State update: closest' = i
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = GetFerry(closest)
  -- Invokes: pFerry->GetPosition
  true
end

