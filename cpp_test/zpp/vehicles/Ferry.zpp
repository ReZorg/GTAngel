--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
FERRY_SPEED : ℝ  -- #define FERRY_SPEED (0.1f)
FERRY_SLOWDOWN_DISTANCE : ℝ  -- #define FERRY_SLOWDOWN_DISTANCE (50.0f)
FERRY_TIME_STOPPED_AT_STATION : ℝ  -- #define FERRY_TIME_STOPPED_AT_STATION (10.0f)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eFerryNodes ::= FERRY_DOOR_FRONT | FERRY_RAMP_FRONT | FERRY_DOOR_BACK | FERRY_RAMP_BACK | NUM_FERRY_NODES
  -- val(FERRY_DOOR_FRONT) = 1

Ferry_Enum_2 ::= NUM_FERRY_STATIONS | NUM_FERRIES | NUM_WAKE_POINTS
  -- val(NUM_FERRY_STATIONS) = 2
  -- val(NUM_FERRIES) = NUM_FERRY_PATHS * 2
  -- val(NUM_WAKE_POINTS) = 64

Ferry_Enum_3 ::= FERRY_STOPPED | FERRY_CRUISING | FERRY_SLOWING | FERRY_ACCELERATING
  -- val(FERRY_STOPPED) = 0

Ferry_Enum_4 ::= FERRY_DOOR_CLOSED | FERRY_DOOR_OPENING | FERRY_DOOR_OPEN | FERRY_DOOR_CLOSING
  -- val(FERRY_DOOR_CLOSED) = 0

eSpaceUse ::= FERRY_SPACE_PED | FERRY_SPACE_CAR
  -- val(FERRY_SPACE_PED) = 0

eSpaceStyle ::= FERRY_SPACE_STYLE_0 | FERRY_SPACE_STYLE_1
  -- val(FERRY_SPACE_STYLE_0) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CFerryNode
  x : ℝ
  y : ℝ
  z : ℝ
  t : ℝ
where
  instance_addr ∈ ADDRESS
end

schema CFerryInterpolationLine
  type : ℕ
  time : ℝ
  position : ℝ
  speed : ℝ
  acceleration : ℝ
where
  type ≥ 0
end

schema CFerryPath
  TotalLengthOfTrack : ℝ
  TotalDurationOfTrack : ℝ
  NumTrackNodes : ℤ
  aTrackNodes : Ref[CFerryNode]
  aLineBits : ℙ ℤ
where
  #aTrackNodes ≤ 1
  #aLineBits ≤ 1
end

schema CFerryInst
  pPathData : seq Ref[CFerryPath]  -- bounded array [NUM_FERRY_PATHS]
  m_afPositions : seq ℝ  -- bounded array [NUM_FERRIES]
  m_afSpeeds : seq ℝ  -- bounded array [NUM_FERRIES]
  m_apFerries : seq Ref[CFerry]  -- bounded array [NUM_FERRIES]
  m_bFerriesDisabled : 𝔹
  m_anNumWakePoints : seq ℕ  -- bounded array [NUM_FERRIES]
where
  instance_addr ∈ ADDRESS
end

schema CFerry
  CVehicle  -- inherits base schema
  m_nFerryId : ℤ
  m_isFarAway : ℕ
  m_nCurTrackNode : ℕ
  m_fSpeed : ℝ
  m_bFerryDocked : 𝔹
  m_nDoorTimer : ℕ
  m_nTimeLeftStation : ℕ
  m_nDoorState : ℤ
  m_bApproachingDock : 𝔹
  m_nSkipFerryStatus : ℕ
  m_nTimeAlongPath : ℕ
  m_bUseFrontDoor : 𝔹
  m_vecForwardSpeed : CVector
  m_pDefaultColModel : Ref[CColModel]
  m_nCollision : ℕ
  m_doors : seq CDoor  -- bounded array [4]
  m_aFerryNodes : seq Ref[RwFrame]  -- bounded array [NUM_FERRY_NODES]
  m_bAlreadyRendered : 𝔹
  m_bPlayerArrivedHorn : 𝔹
  mspInst : Ref[CFerryInst]
where
  m_isFarAway ≥ 0
  m_nCurTrackNode ≥ 0
  m_nDoorTimer ≥ 0
  m_nTimeLeftStation ≥ 0
  m_nSkipFerryStatus ≥ 0
  m_nTimeAlongPath ≥ 0
  #m_pDefaultColModel ≤ 1
  m_nCollision ≥ 0
  #m_doors = 4
  #mspInst ≤ 1
end

schema CFerry_Render
  ΔCFerry
where
  -- Declared member operation CFerry::Render(void)
  true
end

