--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Boat (vehicles)
-- Source File(s): vehicles/Boat.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Vehicle.zpp  (from "Vehicle.h")
-- include Door.zpp  (from "Door.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eBoatNodes ::= BOAT_MOVING | BOAT_WINDSCREEN | BOAT_RUDDER | BOAT_FLAP_LEFT | BOAT_FLAP_RIGHT | BOAT_REARFLAP_LEFT | BOAT_REARFLAP_RIGHT | NUM_BOAT_NODES
  -- val(BOAT_MOVING) = 1

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CBoat
  CVehicle  -- inherits base schema
  m_fMovingRotation : ℝ
  m_fMovingSpeed : ℝ
  m_boat_unused1 : ℤ
  m_aBoatNodes : seq Ref[RwFrame]  -- bounded array [NUM_BOAT_NODES]
  m_boom : CDoor
  pBoatHandling : Ref[tBoatHandlingData]
  bBoatInWater : 𝔹
  bPropellerInWater : 𝔹
  m_bIsAnchored : 𝔹
  m_fOrientation : ℝ
  m_nPoliceShoutTimer : ℕ
  m_boat_unused2 : ℤ
  m_fDamage : ℝ
  m_pSetOnFireEntity : Ref[CEntity]
  m_skimmerThingTimer : ℝ
  m_boat_unused3 : 𝔹
  m_fAccelerate : ℝ
  m_fBrake : ℝ
  m_fSteeringLeftRight : ℝ
  m_nPadID : ℕ
  m_boat_unused4 : ℤ
  m_fVolumeUnderWater : ℝ
  m_vecBuoyancePoint : CVector
  m_fPrevVolumeUnderWater : ℝ
  m_nDeltaVolumeUnderWater : ℤ
  m_nNumWakePoints : ℕ
  m_avec2dWakePoints : seq CVector2D  -- bounded array [32]
  m_afWakePointLifeTime : seq ℝ  -- bounded array [32]
  MAX_WAKE_LENGTH : ℝ
  MIN_WAKE_INTERVAL : ℝ
  WAKE_LIFETIME : ℝ
  apFrameWakeGeneratingBoats : seq Ref[CBoat]  -- bounded array [4]
  m_fThrustZ : ℝ
  m_fThrustY : ℝ
  m_vecMoveRes : CVector
  m_vecTurnRes : CVector
where
  #pBoatHandling ≤ 1
  #bBoatInWater = 1
  #bPropellerInWater = 1
  m_nPoliceShoutTimer ≥ 0
  #m_pSetOnFireEntity ≤ 1
  m_nPadID ≥ 0
  m_nNumWakePoints ≥ 0
  #m_avec2dWakePoints = 32
  #m_afWakePointLifeTime = 32
  #apFrameWakeGeneratingBoats = 4
end

schema CBoat_CBoat
  ΔCBoat
  arg_1? : ℤ
  arg_2? : ℕ
where
  -- Declared member operation CBoat::CBoat(int, uint8)
  true
end

