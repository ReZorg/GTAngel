-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CVehicle
  CPhysical  -- inherits base schema
  pHandling : Ref[tHandlingData]
  pFlyingHandling : Ref[tFlyingHandlingData]
  AutoPilot : CAutoPilot
  m_currentColour1 : ℕ
  m_currentColour2 : ℕ
  m_aExtras : seq ℤ  -- bounded array [2]
  m_nAlarmState : ℤ
  m_nRouteSeed : ℤ
  pDriver : Ref[CPed]
  pPassengers : seq Ref[CPed]  -- bounded array [8]
  m_nNumPassengers : ℕ
  m_nNumGettingIn : ℤ
  m_nGettingInFlags : ℤ
  m_nGettingOutFlags : ℤ
  m_nNumMaxPassengers : ℕ
  m_vehLCS_230 : CVector
  m_pCurGroundEntity : Ref[CEntity]
  m_pCarFire : Ref[CFire]
  m_fSteerAngle : ℝ
  m_fGasPedal : ℝ
  m_fBrakePedal : ℝ
  VehicleCreatedBy : ℕ
  bIsLawEnforcer : 𝔹
  bIsAmbulanceOnDuty : 𝔹
  bIsFireTruckOnDuty : 𝔹
  bIsLocked : 𝔹
  bEngineOn : 𝔹
  bIsHandbrakeOn : 𝔹
  bLightsOn : 𝔹
  bFreebies : 𝔹
  bIsVan : 𝔹
  bIsBus : 𝔹
  bIsBig : 𝔹
  bLowVehicle : 𝔹
  bComedyControls : 𝔹
  bWarnedPeds : 𝔹
  bCraneMessageDone : 𝔹
  bExtendedRange : 𝔹
  bTakeLessDamage : 𝔹
  bIsDamaged : 𝔹
  bHasBeenOwnedByPlayer : 𝔹
  bFadeOut : 𝔹
  bIsBeingCarJacked : 𝔹
  bCreateRoadBlockPeds : 𝔹
  bCanBeDamaged : 𝔹
  bUsingSpecialColModel : 𝔹
  m_vehLCS_258 : 𝔹
  m_vehLCS_259 : ℤ
  bOccupantsHaveBeenGenerated : 𝔹
  bGunSwitchedOff : 𝔹
  bVehicleColProcessed : 𝔹
  bIsCarParkVehicle : 𝔹
  bHasAlreadyBeenRecorded : 𝔹
  bPartOfConvoy : 𝔹
  bHeliMinimumTilt : 𝔹
  bAudioChangingGear : 𝔹
  bIsDrowning : 𝔹
  bTyresDontBurst : 𝔹
  bCreatedAsPoliceVehicle : 𝔹
  bRestingOnPhysical : 𝔹
  bParking : 𝔹
  bCanPark : 𝔹
  bRewardVehicle : 𝔹
  m_numPedsUseItAsCover : ℤ
  m_nAmmoInClip : ℕ
  m_nPacManPickupsCarried : ℤ
  m_nRoadblockType : ℕ
  m_bGarageTurnedLightsOff : ℕ
  m_fWheelSpin : ℝ
  m_fHealth : ℝ
  m_fEngineEnergy : ℝ
  m_nCurrentGear : ℕ
  m_fChangeGearTime : ℝ
  m_nSetPieceExtendedRangeTime : ℕ
  m_nGunFiringTime : ℕ
  m_nTimeOfDeath : ℕ
  m_nTimeBlocked : ℕ
  m_nBombTimer : ℤ
  m_pBlowUpEntity : Ref[CEntity]
  m_fMapObjectHeightAhead : ℝ
  m_fMapObjectHeightBehind : ℝ
  m_nDoorLock : eCarLock
  m_pLastDamageEntity : Ref[CEntity]
  m_vehLCS_29C : ℤ
  m_vehLCS_29E : ℤ
  m_nLastWeaponDamage : ℤ
  m_nRadioStation : ℕ
  m_bRainAudioCounter : ℕ
  m_bRainSamplesCounter : ℕ
  m_vehLCS_2A3 : ℤ
  m_vehLCS_2A4 : ℕ
  m_nCarHornTimer : ℕ
  m_nCarHornPattern : ℕ
  m_bSirenOrAlarm : 𝔹
  m_nCarHornDelay : ℕ
  m_comedyControlState : ℤ
  m_vehLCS_2B0 : ℤ
  m_vehLCS_2B4 : ℤ
  m_aCollPolys : seq CStoredCollPoly  -- bounded array [2]
  m_fSteerInput : ℝ
  m_vehType : eVehicleType
  m_bSuperBrake : 𝔹
  bAllDodosCheat : 𝔹
  bCheat3 : 𝔹
  bCheat4 : 𝔹
  bCheat5 : 𝔹
  bCheat8 : 𝔹
  bCheat9 : 𝔹
  bCheat10 : 𝔹
  bHoverCheat : 𝔹
  bAllTaxisHaveNitro : 𝔹
  m_bDisableMouseSteering : 𝔹
  bDisableRemoteDetonation : 𝔹
  bDisableRemoteDetonationOnContact : 𝔹
  WHEELSPIN_FALL_RATE : ℝ
  WHEELSPIN_RISE_RATE : ℝ
  WHEELSPIN_INAIR_TARGET_RATE : ℝ
  WHEELSPIN_TARGET_RATE : ℝ
  field_1D0 : seq ℝ  -- bounded array [4]
  bDriverLastFrame : 𝔹
  m_pBombRigger : Ref[CEntity]
  m_nRoadblockNode : ℤ
where
  #pHandling ≤ 1
  #pFlyingHandling ≤ 1
  m_currentColour1 ≥ 0
  m_currentColour2 ≥ 0
  #m_aExtras = 2
  #pDriver ≤ 1
  #pPassengers = 8
  m_nNumPassengers ≥ 0
  m_nNumMaxPassengers ≥ 0
  #m_pCurGroundEntity ≤ 1
  #m_pCarFire ≤ 1
  VehicleCreatedBy ≥ 0
  #bIsLawEnforcer = 1
  #bIsAmbulanceOnDuty = 1
  #bIsFireTruckOnDuty = 1
  #bIsLocked = 1
end

