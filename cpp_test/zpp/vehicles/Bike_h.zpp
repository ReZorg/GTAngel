--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eBikeNodes ::= BIKE_NODE_NONE | BIKE_CHASSIS | BIKE_FORKS_FRONT | BIKE_FORKS_REAR | BIKE_WHEEL_FRONT | BIKE_WHEEL_REAR | BIKE_MUDGUARD | BIKE_HANDLEBARS | BIKE_NUM_NODES

Bike_Enum_2 ::= BIKEWHEEL_FRONT | BIKEWHEEL_REAR

Bike_Enum_3 ::= BIKESUSP_F1 | BIKESUSP_F2 | BIKESUSP_R1 | BIKESUSP_R2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CBike
  CVehicle  -- inherits base schema
  m_aBikeNodes : seq Ref[RwFrame]  -- bounded array [BIKE_NUM_NODES]
  bLeanMatrixClean : 𝔹
  m_leanMatrix : CMatrix
  m_vecAvgSurfaceNormal : CVector
  m_vecAvgSurfaceRight : CVector
  pBikeHandling : Ref[tBikeHandlingData]
  m_bikeAnimType : AssocGroupId
  m_wheelStatus : seq ℕ  -- bounded array [2]
  m_aWheelColPoints : seq ℤ  -- bounded array [4]
  m_aSuspensionSpringRatio : seq ℝ  -- bounded array [4]
  m_aSuspensionSpringRatioPrev : seq ℝ  -- bounded array [4]
  m_aWheelTimer : seq ℝ  -- bounded array [4]
  m_bike_unused1 : ℝ
  m_aWheelSkidmarkType : seq eSkidmarkType  -- bounded array [2]
  m_aWheelSkidmarkBloody : seq 𝔹  -- bounded array [2]
  m_aWheelSkidmarkUnk : seq 𝔹  -- bounded array [2]
  m_aWheelRotation : seq ℝ  -- bounded array [2]
  m_aWheelSpeed : seq ℝ  -- bounded array [2]
  m_aWheelPosition : seq ℝ  -- bounded array [2]
  m_aWheelBasePosition : seq ℝ  -- bounded array [2]
  m_aSuspensionSpringLength : seq ℝ  -- bounded array [4]
  m_aSuspensionLineLength : seq ℝ  -- bounded array [4]
  m_fHeightAboveRoad : ℝ
  m_fTraction : ℝ
  m_fRearForkLength : ℝ
  m_fFrontForkY : ℝ
  m_fFrontForkZ : ℝ
  m_fFrontForkSlope : ℝ
  m_fWheelAngle : ℝ
  m_fLeanLRAngle : ℝ
  m_fLeanLRAngle2 : ℝ
  m_fLeanInput : ℝ
  m_fPedLeanAmountLR : ℝ
  m_fPedLeanAmountUD : ℝ
  m_bike_unused2 : ℕ
  unused : seq ℕ  -- bounded array [3]
  m_bombType : 𝔹
  bDriverLastFrame : 𝔹
  m_bike_flag01 : 𝔹
  m_bike_flag02 : 𝔹
  bWaterTight : 𝔹
  bIsBeingPickedUp : 𝔹
  bIsStanding : 𝔹
  bExtraSpeed : 𝔹
  bIsOnFire : 𝔹
  bWheelieCam : 𝔹
  bFixedColour : 𝔹
  m_pBombRigger : Ref[CEntity]
  m_doingBurnout : ℤ
  m_fTireTemperature : ℝ
  m_fBrakeDestabilization : ℝ
  m_fVelocityChangeForAudio : ℝ
  m_fFireBlowUpTimer : ℝ
  m_aGroundPhysical : seq Ref[CPhysical]  -- bounded array [4]
  m_aGroundOffset : seq CVector  -- bounded array [4]
  m_pSetOnFireEntity : Ref[CEntity]
  m_nWheelsOnGround : ℕ
  m_nDriveWheelsOnGround : ℕ
  m_nDriveWheelsOnGroundPrev : ℕ
  m_fGasPedalAudio : ℝ
  m_aWheelState : seq tWheelState  -- bounded array [2]
  unk1 : seq ℕ  -- bounded array [96]
  m_bikeSitAnimation : AnimationId
  unk2 : seq ℕ  -- bounded array [180]
where
  #pBikeHandling ≤ 1
  #m_wheelStatus = 2
  #m_aWheelColPoints = 4
  #m_aSuspensionSpringRatio = 4
  #m_aSuspensionSpringRatioPrev = 4
  #m_aWheelTimer = 4
  #m_aWheelSkidmarkType = 2
  #m_aWheelSkidmarkBloody = 2
  #m_aWheelSkidmarkUnk = 2
  #m_aWheelRotation = 2
  #m_aWheelSpeed = 2
  #m_aWheelPosition = 2
  #m_aWheelBasePosition = 2
  #m_aSuspensionSpringLength = 4
  #m_aSuspensionLineLength = 4
  m_bike_unused2 ≥ 0
end

