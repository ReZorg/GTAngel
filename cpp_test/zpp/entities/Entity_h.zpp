--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Entity_GetType
  ΞEntityModuleState
  result! : ℕ
where
  -- Return postcondition: result! = m_type
  true
end

schema Entity_SetType
  ΔEntityModuleState
  type? : ℕ
where
  -- State update: m_type' = type
  true
end

schema Entity_GetStatus
  ΞEntityModuleState
  result! : ℕ
where
  -- Return postcondition: result! = m_status
  true
end

schema Entity_SetStatus
  ΔEntityModuleState
  status? : ℕ
where
  -- State update: m_status' = status
  true
end

schema Entity_GetIsStatic
  ΞEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = bIsStatic || bIsStaticWaitingForCollision
  true
end

schema Entity_SetIsStatic
  ΔEntityModuleState
  state? : 𝔹
where
  -- State update: bIsStatic' = state
  true
end

schema Entity_GetAddressOfEntityProperties
  ΔEntityModuleState
  result! : ℙ ℕ
where
  -- Return postcondition: result! = (uint32*)((char*)&m_rwObject + sizeof(m_rwObject))
  true
end

schema Entity_UpdatesInCutscene
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = false
  true
end

schema Entity_ProcessControl
  ΔEntityModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Entity_ProcessCollision
  ΔEntityModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Entity_ProcessShift
  ΔEntityModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Entity_Teleport
  ΔEntityModuleState
  v? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema Entity_FlagToDestroyWhenNextProcessed
  ΔEntityModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Entity_IsBuilding
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_BUILDING
  true
end

schema Entity_IsVehicle
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_VEHICLE
  true
end

schema Entity_IsPed
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_PED
  true
end

schema Entity_IsObject
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_OBJECT
  true
end

schema Entity_IsDummy
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_DUMMY
  true
end

schema Entity_IsMultiplayer
  ΔEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_type == ENTITY_TYPE_MULTIPLAYER
  true
end

schema Entity_GetModelIndex
  ΞEntityModuleState
  result! : ℤ
where
  -- Return postcondition: result! = m_modelIndex
  true
end

schema Entity_GetIsStatic_2
  ΞEntityModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = bIsStatic
  true
end
