--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Entity (entities)
-- Source File(s): entities/Entity.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include ModelInfo.zpp  (from "ModelInfo.h")
-- include Placeable.zpp  (from "Placeable.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eEntityType ::= ENTITY_TYPE_NOTHING | ENTITY_TYPE_BUILDING | ENTITY_TYPE_VEHICLE | ENTITY_TYPE_PED | ENTITY_TYPE_OBJECT | ENTITY_TYPE_DUMMY | ENTITY_TYPE_MULTIPLAYER
  -- val(ENTITY_TYPE_NOTHING) = 0

eEntityStatus ::= STATUS_PLAYER | STATUS_PLAYER_PLAYBACKFROMBUFFER | STATUS_SIMPLE | STATUS_PHYSICS | STATUS_ABANDONED | STATUS_WRECKED | STATUS_TRAIN_MOVING | STATUS_TRAIN_NOT_MOVING | STATUS_FERRY_MOVING | STATUS_FERRY_NOT_MOVING | STATUS_HELI | STATUS_PLANE | STATUS_PLAYER_REMOTE | STATUS_PLAYER_DISABLED | STATUS_GHOST

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CEntity
  CPlaceable  -- inherits base schema
  m_rwObject : Ref[RwObject]
  m_type : 𝔹
  m_status : 𝔹
  bUsesCollision : 𝔹
  bCollisionProcessed : 𝔹
  bIsStatic : 𝔹
  bHasContacted : 𝔹
  bPedPhysics : 𝔹
  bIsStuck : 𝔹
  bIsInSafePosition : 𝔹
  bUseCollisionRecords : 𝔹
  bWasPostponed : 𝔹
  bExplosionProof : 𝔹
  bIsVisible : 𝔹
  bHasCollided : 𝔹
  bRenderScorched : 𝔹
  bHasBlip : 𝔹
  bIsBIGBuilding : 𝔹
  bStreamBIGBuilding : 𝔹
  bRenderDamaged : 𝔹
  bBulletProof : 𝔹
  bFireProof : 𝔹
  bCollisionProof : 𝔹
  bMeleeProof : 𝔹
  bOnlyDamagedByPlayer : 𝔹
  bStreamingDontDelete : 𝔹
  bRemoveFromWorld : 𝔹
  bHasHitWall : 𝔹
  bImBeingRendered : 𝔹
  bTouchingWater : 𝔹
  bIsSubway : 𝔹
  bDrawLast : 𝔹
  bNoBrightHeadLights : 𝔹
  bDoNotRender : 𝔹
  bDistanceFade : 𝔹
  m_flagE1 : 𝔹
  bDontCastShadowsOn : 𝔹
  bOffscreen : 𝔹
  bIsStaticWaitingForCollision : 𝔹
  bDontStream : 𝔹
  bUnderwater : 𝔹
  bHasPreRenderEffects : 𝔹
  bIsTreeModel : 𝔹
  bIsVehicle : 𝔹
  bIsPed : 𝔹
  bMakeVisible : 𝔹
  m_scanCode : ℕ
  m_randomSeed : ℕ
  m_modelIndex : ℤ
  m_level : ℤ
  m_area : ℤ
  m_pFirstReference : Ref[CReference]
  bZoneCulled : 𝔹
  bZoneCulled2 : 𝔹
  m_flagE2 : 𝔹
where
  #m_rwObject ≤ 1
  #m_type = 3
  #m_status = 5
  #bUsesCollision = 1
  #bCollisionProcessed = 1
  #bIsStatic = 1
  #bHasContacted = 1
  #bPedPhysics = 1
  #bIsStuck = 1
  #bIsInSafePosition = 1
  #bUseCollisionRecords = 1
  #bWasPostponed = 1
  #bExplosionProof = 1
  #bIsVisible = 1
  #bHasCollided = 1
  #bRenderScorched = 1
end

schema CEntity_GetType
  ΞCEntity
  result! : ℕ
where
  -- Declared member operation CEntity::GetType()
  true
end

schema CEntity_SetType_2
  ΔCEntity
  type? : ℕ
  result! : void
where
  -- Declared member operation CEntity::SetType(uint8 type)
  true
end

