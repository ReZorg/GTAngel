-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CEntity_CEntity
  ΔCEntity
where
  -- State update: m_type' = ENTITY_TYPE_NOTHING
  -- State update: m_status' = STATUS_ABANDONED
  -- State update: bUsesCollision' = false
  -- State update: bCollisionProcessed' = false
  -- State update: bIsStatic' = false
  -- State update: bHasContacted' = false
  -- Invokes: CGeneral::GetRandomNumber
  true
end

schema CEntity_CEntity_2
  ΔCEntity
where
  -- Deterministic transition preserving module invariants
  true
end

schema CEntity_SetModelIndex
  ΔCEntity
  id? : ℕ
where
  -- State update: m_modelIndex' = id
  -- State update: bIsTreeModel' = IsTreeModel(m_modelIndex)
  -- State update: bHasPreRenderEffects' = HasPreRenderEffects()
  true
end

schema CEntity_SetModelIndexNoCreate
  ΔCEntity
  id? : ℕ
where
  -- State update: m_modelIndex' = id
  -- State update: bIsTreeModel' = IsTreeModel(m_modelIndex)
  -- State update: bHasPreRenderEffects' = HasPreRenderEffects()
  true
end

