schema CEntity_GetIsOnScreenComplex
  ΔCEntity
where
  -- State update: rect' = GetBoundRect()
  -- State update: colmodel' = CModelInfo::GetColModel(m_modelIndex)
  -- State update: z' = GetPosition().z
  -- State update: minz' = z + colmodel.boundingBox.min.z
  -- State update: maxz' = z + colmodel.boundingBox.max.z
  -- State update: x' = rect.left
  -- Return postcondition: result! = true
  -- Return postcondition: result! = TheCamera.IsBoxVisible(boundBox, &TheCamera.GetCameraMatrix())
  -- Invokes: TheCamera.IsPointVisible, TheCamera.GetCameraMatrix, CModelInfo::GetColModel, TheCamera.IsBoxVisible
  true
end

schema CEntity_Add
