where
  -- State update: bounds' = GetBoundRect()
  -- State update: xstart' = CWorld::GetSectorIndexX(bounds.left)
  -- State update: xend' = CWorld::GetSectorIndexX(bounds.right)
  -- State update: xmid' = CWorld::GetSectorIndexX((bounds.left + bounds.right)/2.0f)
  -- State update: ystart' = CWorld::GetSectorIndexY(bounds.top)
  -- State update: yend' = CWorld::GetSectorIndexY(bounds.bottom)
  -- Invokes: CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::GetSector, list->InsertItem
  true
end

