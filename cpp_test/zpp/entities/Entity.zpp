schema CEntity_ModifyMatrixForTreeInWind
  ΔCEntity
where
  -- State update: t' = m_randomSeed + 8*CTimer::GetTimeInMilliseconds()
  -- State update: f' = (t & 0xFFF)/(float)0x1000
  -- State update: strength' = -0.015f*CWeather::Wind
  -- State update: t' = (uintptr)this + CTimer::GetTimeInMilliseconds()
  -- State update: f' = (t & 0xFFF)/(float)0x1000
  -- State update: flutter' = Sin(f * 6.28f)
  -- Invokes: CTimer::GetIsPaused, CTimer::GetTimeInMilliseconds, mat.GetUp, CWindModifiers::FindWindModifier, mat.UpdateRW
  true
end

schema CEntity_ModifyMatrixForBannerInWind
  ΔCEntity
where
  -- State update: strength' = 0.2f
  -- State update: strength' = 0.43f
  -- State update: strength' = 0.66f
  -- State update: f' = (t & 0x7FF)/(float)0x800
  -- State update: right' = CrossProduct(GetForward(), GetUp())
  -- State update: right.z' = 0.0f
  -- Invokes: CTimer::GetIsPaused, CTimer::GetTimeInMilliseconds, right.Normalise
  true
end

