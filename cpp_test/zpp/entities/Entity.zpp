schema Entity_AtomicRemoveAnimFromSkinCB
  ΔEntityModuleState
  atomic? : Ref[RpAtomic]
  data? : ADDRESS
where
  -- State update: hier' = RpSkinAtomicGetHAnimHierarchy(atomic)
  -- State update: hier.interpolator.currentAnim' = ∅
  -- State update: hier.currentAnim' = ∅
  -- Return postcondition: result! = atomic
  true
end

schema CEntity_DeleteRwObject
  ΔCEntity
where
  -- State update: f' = RpAtomicGetFrame((RpAtomic*)m_rwObject)
  -- State update: m_rwObject' = ∅
