  ΔCEntity
where
  -- State update: alpha' = CVisibilityPlugins::GetObjectDistanceAlpha(m_rwObject)
  -- State update: alpha' = 255
  -- State update: alpha' = Max(alpha-16, 0)
  -- State update: alpha' = Min(alpha+32, 255)
  -- Invokes: CVisibilityPlugins::GetObjectDistanceAlpha, CCutsceneMgr::IsRunning, CVisibilityPlugins::SetObjectDistanceAlpha
  true
end

