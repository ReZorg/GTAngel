schema CVisibilityPlugins
  atomic : Ref[RpAtomic]
  sort : ℝ
  m_alphaList : CLinkList_AlphaObjectInfo
  m_alphaEntityList : CLinkList_AlphaObjectInfo
  ms_pCameraPosn : Ref[RwV3d]
  ms_cullCompsDist : ℝ
  ms_vehicleLod0Dist : ℝ
  ms_vehicleLod1Dist : ℝ
  ms_vehicleFadeDist : ℝ
  ms_bigVehicleLod0Dist : ℝ
  ms_bigVehicleLod1Dist : ℝ
  ms_pedLodDist : ℝ
  ms_pedFadeDist : ℝ
  flags : ℕ
  ms_atomicPluginOffset : ℤ
  ms_framePluginOffset : ℤ
  alpha : ℤ
  ms_clumpPluginOffset : ℤ
  m_alphaBoatAtomicList : CLinkList_AlphaObjectInfo
  m_alphaUnderwaterEntityList : CLinkList_AlphaObjectInfo
  ms_pedLod1Dist : ℝ
  modelInfo : Ref[union_AtomicExt_CSimpleModelInfo]
  ms_pedLod0Dist : ℝ
where
  #atomic ≤ 1
  #ms_pCameraPosn ≤ 1
  flags ≥ 0
  #modelInfo ≤ 1
end

