schema CTxdStore_LoadTxd
  ΔCTxdStore
  slot? : ℤ
  stream? : Ref[RwStream]
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = RwTexDictionaryGtaStreamRead(stream)
  -- Return postcondition: result! = def->texDict != nil
  -- Return postcondition: result! = false
  true
end

schema CTxdStore_LoadTxd_2
  ΔCTxdStore
  slot? : ℤ
  data? : ADDRESS
  chunk? : ADDRESS
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = (RwTexDictionary*)data
  -- State update: def.refCount' = 0
  -- State update: def.refCountGu' = 0
  -- Return postcondition: result! = def->texDict != nil
  -- Invokes: CStreaming::RegisterPointer
  true
end

schema CTxdStore_LoadTxd_3
  ΔCTxdStore
  slot? : ℤ
  filename? : seq CHAR
where
  -- State update: stream' = RwStreamOpen(rwSTREAMFILENAME, rwSTREAMREAD, filename)
  -- Return postcondition: result! = ret
