schema CTxdStore_StartLoadTxd
  ΔCTxdStore
  slot? : ℤ
  stream? : Ref[RwStream]
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = RwTexDictionaryGtaStreamRead1(stream)
  -- Return postcondition: result! = def->texDict != nil
  -- Return postcondition: result! = false
  true
end

schema CTxdStore_FinishLoadTxd
  ΔCTxdStore
  slot? : ℤ
  stream? : Ref[RwStream]
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = RwTexDictionaryGtaStreamRead2(stream, def.texDict)
  -- Return postcondition: result! = def->texDict != nil
  true
end

schema CTxdStore_RemoveTxd
  ΔCTxdStore
  slot? : ℤ
  notChunk? : 𝔹
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = ∅
  -- State update: def.refCount' = 0
  -- State update: def.refCountGu' = 0
  -- Invokes: CStreaming::UnregisterPointer, msInstance.Free
  true
end

schema CTxdStore_Load
  ΔCTxdStore
  stored? : Ref[RwTexDictionary]
  pool? : Ref[CPool_TxdDef]
where
  -- State update: ms_pTxdPool' = pool
  -- State update: ms_pStoredTxd' = stored
  -- State update: def' = GetSlot(i)
  true
end

