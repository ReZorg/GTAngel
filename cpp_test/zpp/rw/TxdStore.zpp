schema TxdDef
  texDict : Ref[RwTexDictionary]
  refCount : ℤ
  refCountGu : ℤ
  name : seq CHAR
where
  #texDict ≤ 1
  #name = 20
end

schema CTxdStore
  ms_pTxdPool : Ref[CPool_TxdDef_TxdDef]
  ms_pStoredTxd : Ref[RwTexDictionary]
where
  #ms_pTxdPool ≤ 1
  #ms_pStoredTxd ≤ 1
end

