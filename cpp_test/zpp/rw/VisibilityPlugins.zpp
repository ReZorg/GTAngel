  atomicMat? : Ref[RwMatrix]
  clumpMat? : Ref[RwMatrix]
  flags? : ℕ
where
  -- State update: dot' = RwV3dDotProduct(&dist, RwMatrixGetUp(clumpMat))
  -- State update: dot' = RwV3dDotProduct(&dist, RwMatrixGetRight(clumpMat))
  -- State update: dot' = 0.0f
  -- State update: dot' = -dot
  -- State update: dotdoor' = -RwV3dDotProduct(&dist, RwMatrixGetUp(clumpMat))
  -- State update: dotdoor' = RwV3dDotProduct(&dist, RwMatrixGetUp(clumpMat))
  -- Return postcondition: result! = dot
  true
end

