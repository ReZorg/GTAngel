schema CVisibilityPlugins_FrustumSphereCB
  ΔCVisibilityPlugins
  clump? : Ref[RpClump]
where
  -- State update: frame' = RpClumpGetFrame(clump)
  -- State update: modelInfo' = (CClumpModelInfo*)GetFrameHierarchyId(frame)
  -- State update: sphere.radius' = modelInfo.GetColModel().boundingSphere.radius
  -- State update: sphere.center.x' = modelInfo.GetColModel().boundingSphere.center.x
  -- State update: sphere.center.y' = modelInfo.GetColModel().boundingSphere.center.y
  -- State update: sphere.center.z' = modelInfo.GetColModel().boundingSphere.center.z
  -- Return postcondition: result! = RwCameraFrustumTestSphere(ms_pCamera, &sphere) != rwSPHEREOUTSIDE
  -- Invokes: modelInfo->GetColModel
  true
end

