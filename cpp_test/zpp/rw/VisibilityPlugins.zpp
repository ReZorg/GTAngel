schema CVisibilityPlugins_Initialise
  ΔCVisibilityPlugins
where
  -- State update: m_alphaList.head.item.sort' = 0.0f
  -- State update: m_alphaList.tail.item.sort' = 100000000.0f
  -- State update: m_alphaEntityList.head.item.sort' = 0.0f
  -- State update: m_alphaEntityList.tail.item.sort' = 100000000.0f
  -- State update: m_alphaBuildingList.head.item.sort' = 0.0f
  -- State update: m_alphaBuildingList.tail.item.sort' = 100000000.0f
  -- Invokes: m_alphaList.Init, m_alphaEntityList.Init, m_alphaBuildingList.Init, base::RegisterRelocatableChunkFunc
  true
end

schema CVisibilityPlugins_Shutdown
  ΔCVisibilityPlugins
where
  -- Invokes: m_alphaList.Shutdown, m_alphaEntityList.Shutdown, m_alphaBuildingList.Shutdown
  true
end

schema CVisibilityPlugins_InitAlphaEntityList
  ΔCVisibilityPlugins
where
  -- Invokes: m_alphaEntityList.Clear, m_alphaBuildingList.Clear
  true
end

schema CVisibilityPlugins_InsertEntityIntoSortedList
  ΔCVisibilityPlugins
  e? : Ref[CEntity]
  dist? : ℝ
where
  -- State update: item.entity' = e
  -- State update: item.sort' = dist
  -- Return postcondition: result! = true
  -- Return postcondition: result! = !!m_alphaBuildingList.InsertSorted(item)
  -- Return postcondition: result! = !!m_alphaEntityList.InsertSorted(item)
  -- Invokes: e->IsBuilding, m_alphaBuildingList.InsertSorted, m_alphaEntityList.InsertSorted
  true
end

schema CVisibilityPlugins_InitAlphaAtomicList
  ΔCVisibilityPlugins
where
  -- Invokes: m_alphaList.Clear
  true
end

schema CVisibilityPlugins_InsertAtomicIntoSortedList
  ΔCVisibilityPlugins
  a? : Ref[RpAtomic]
  dist? : ℝ
where
  -- State update: item.atomic' = a
  -- State update: item.sort' = dist
  -- Return postcondition: result! = ret
  -- Invokes: m_alphaList.InsertSorted
  true
end

schema CVisibilityPlugins_SetRenderWareCamera
  ΔCVisibilityPlugins
  camera? : Ref[RwCamera]
where
  -- State update: ms_pCamera' = camera
  -- State update: ms_pCameraPosn' = RwMatrixGetPos(RwFrameGetMatrix(RwCameraGetFrame(camera)))
  -- State update: ms_cullCompsDist' = 1000000.0f
  -- State update: ms_cullCompsDist' = sq(TheCamera.LODDistMultiplier * 20.0f)
  -- State update: ms_vehicleLod0Dist' = sq(70.0f * VEHICLE_LODDIST_MULTIPLIER)
  -- State update: ms_vehicleLod1Dist' = sq(90.0f * VEHICLE_LODDIST_MULTIPLIER)
  true
end

schema CVisibilityPlugins_SetupVehicleVariables
  ΔCVisibilityPlugins
  vehicle? : Ref[RpClump]
where
  -- State update: DistToCameraSq' = GetDistanceSquaredFromCamera(RpClumpGetFrame(vehicle))
  -- State update: dist2d' = Sqrt(SQR(distToCam.x) + SQR(distToCam.y))
  -- State update: PitchToCamera' = 0.0f
  -- State update: PitchToCamera' = Atan2(distToCam.z, dist2d)
  true
end

