schema CVisibilityPlugins_RenderFadingAtomic
  ΔCVisibilityPlugins
  atomic? : Ref[RpAtomic]
  camdist? : ℝ
where
  -- State update: mi' = GetAtomicModelInfo(atomic)
  -- State update: lodatm' = mi.GetAtomicFromDistance(camdist - FADE_DISTANCE)
  -- State update: fadefactor' = 1.0f
  -- State update: alpha' = mi.m_alpha * fadefactor
  -- State update: geo' = RpAtomicGetGeometry(lodatm)
  -- State update: flags' = RpGeometryGetFlags(geo)
  -- Return postcondition: result! = atomic
  -- Invokes: mi->GetAtomicFromDistance, mi->GetLargestLodDistance
  true
end

