schema CTexturePool_Create
  ΔCTexturePool
  _Format? : D3DFORMAT
  _size? : ℤ
  mipmapLevels? : ℕ
  numTextures? : ℤ
where
  -- State update: Format' = _Format
  -- State update: size' = _size
  -- State update: levels' = mipmapLevels
  -- State update: pTextures' = new IDirect3DTexture8 *[numTextures]
  -- State update: texturesMax' = numTextures
  -- State update: texturesNum' = 0
  true
end

schema CTexturePool_Release
  ΔCTexturePool
where
  -- State update: pTextures' = ∅
  -- State update: texturesNum' = 0
  -- State update: texturesUsed' = 0
  true
end

schema CTexturePool_FindTexture
  ΔCTexturePool
where
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = pTextures[--texturesNum]
  true
end

schema CTexturePool_AddTexture
  ΔCTexturePool
  texture? : Ref[IDirect3DTexture8]
where
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

schema CTexturePool_Resize
  ΔCTexturePool
  numTextures? : ℤ
where
  -- State update: newTextures' = new IDirect3DTexture8 *[numTextures]
  -- State update: pTextures' = newTextures
  -- State update: texturesMax' = numTextures
  true
end

schema CPaletteList_Alloc
  ΔCPaletteList
  max? : ℤ
where
  -- State update: Data' = new int[max]
  -- State update: Max' = max
  -- State update: Num' = 0
  true
end

schema CPaletteList_Free
  ΔCPaletteList
where
  -- State update: Data' = ∅
  -- State update: Num' = 0
  true
end

schema CPaletteList_Find
  ΔCPaletteList
where
  -- Return postcondition: result! = -1
  -- Return postcondition: result! = Data[--Num]
  true
end

schema CPaletteList_Add
