MemoryHeap_Enum_2 ::= MEMID_FREE | MEMID_GAME | MEMID_WORLD | MEMID_ANIMATION | MEMID_POOLS | MEMID_DEF_MODELS | MEMID_STREAM | MEMID_STREAM_MODELS | MEMID_STREAM_TEXUTRES | MEMID_TEXTURES | MEMID_COLLISION | MEMID_RENDERLIST | MEMID_GAME_PROCESS | MEMID_SCRIPT | MEMID_CARS | MEMID_RENDER | MEMID_FRONTEND | NUM_MEMIDS | NUM_FIXED_MEMBLOCKS
