--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: MemoryHeap (rw)
-- Source File(s): rw/MemoryHeap.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
MemoryHeap_Enum_1 ::= MEMID_FREE | MEMID_GAME | MEMID_WORLD | MEMID_ANIMATION | MEMID_POOLS | MEMID_DEF_MODELS | MEMID_STREAM | MEMID_STREAM_MODELS | MEMID_STREAM_LODS | MEMID_STREAM_TEXUTRES | MEMID_STREAM_COLLISION | MEMID_STREAM_ANIMATION | MEMID_TEXTURES | MEMID_COLLISION | MEMID_PRE_ALLOC | MEMID_GAME_PROCESS | MEMID_SCRIPT | MEMID_CARS | MEMID_RENDER | MEMID_PED_ATTR | NUM_MEMIDS | NUM_FIXED_MEMBLOCKS
