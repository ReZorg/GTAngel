--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema MemoryHeap_push
  ΔMemoryHeapModuleState
  val? : T
where
  -- Deterministic transition preserving module invariants
  true
end

schema MemoryHeap_pop
  ΔMemoryHeapModuleState
  result! : T
where
  -- Return postcondition: result! = values[--sp]
  true
end

schema MemoryHeap_RemoveHeapFreeBlock
  ΔMemoryHeapModuleState
where
  -- State update: m_next.m_prev' = m_prev
  -- State update: m_prev.m_next' = m_next
  true
end

schema MemoryHeap_InsertHeapFreeBlock
  ΔMemoryHeapModuleState
  node? : Ref[HeapBlockDesc]
where
  -- State update: m_next' = node.m_next
  -- State update: node.m_next.m_prev' = this
  -- State update: m_prev' = node
  -- State update: node.m_next' = this
  true
end

schema MemoryHeap_Init
  ΔMemoryHeapModuleState
where
  -- State update: m_first.m_next' = &m_last
  -- State update: m_last.m_prev' = &m_first
  true
end

schema MemoryHeap_Insert
  ΔMemoryHeapModuleState
  node? : Ref[HeapBlockDesc]
where
  -- Invokes: node->InsertHeapFreeBlock
  true
end

schema MemoryHeap_Free
  ΔMemoryHeapModuleState
  node? : Ref[HeapBlockDesc]
where
  -- Invokes: m_freeList.Insert
  true
end

schema MemoryHeap_GetLargestFreeBlock
  ΔMemoryHeapModuleState
  result! : ℤ
where
  -- Return postcondition: result! = m_freeList.m_last.m_prev->m_size
  true
end

schema MemoryHeap_GetSizeBetweenBlocks
  ΔMemoryHeapModuleState
  first? : Ref[HeapBlockDesc]
  second? : Ref[HeapBlockDesc]
  result! : ℕ
where
  -- Return postcondition: result! = (uintptr)second - (uintptr)first - sizeof(HeapBlockDesc)
  true
end

schema MemoryHeap_FreeBlock
  ΔMemoryHeapModuleState
  block? : Ref[HeapBlockDesc]
where
  -- State update: b' = m_freeList.m_first.FindSmallestFreeBlock(block.m_size)
  -- Invokes: m_first.FindSmallestFreeBlock, block->InsertHeapFreeBlock
  true
end
