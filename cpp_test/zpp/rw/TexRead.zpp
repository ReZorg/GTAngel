-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema GPUcaps
  version : ℕ
  platform : ℕ
  subplatform : ℕ
  dxtSupport : ℕ
where
  version ≥ 0
  platform ≥ 0
  subplatform ≥ 0
  dxtSupport ≥ 0
end

