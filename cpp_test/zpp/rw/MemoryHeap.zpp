--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CStack
  values : seq T  -- bounded array [N]
  sp : ℕ
where
  sp ≥ 0
end

schema CStack_CStack
  ΔCStack
where
  -- Declared member operation CStack::CStack()
  true
end

schema CStack_pop_2
  ΔCStack
  result! : T
where
  -- Declared member operation CStack::pop()
  true
end

schema HeapBlockDesc
  m_size : ℕ
  m_memId : ℤ
  m_ptrListIndex : ℤ
  m_next : Ref[HeapBlockDesc]
  m_prev : Ref[HeapBlockDesc]
  b : return
where
  m_size ≥ 0
  #m_next ≤ 1
  #m_prev ≤ 1
end

schema HeapBlockDesc_GetNextConsecutive
  ΔHeapBlockDesc
  result! : Ref[HeapBlockDesc]
where
  -- Declared member operation HeapBlockDesc::GetNextConsecutive(void)
  true
end

schema HeapBlockDesc_GetDataPointer_2
  ΔHeapBlockDesc
  result! : Ref[void]
where
  -- Declared member operation HeapBlockDesc::GetDataPointer(void)
  true
end

schema HeapBlockDesc_RemoveHeapFreeBlock_3
  ΔHeapBlockDesc
  result! : void
where
  -- Declared member operation HeapBlockDesc::RemoveHeapFreeBlock(void)
  true
end

schema HeapBlockDesc_InsertHeapFreeBlock_4
  ΔHeapBlockDesc
  node? : Ref[HeapBlockDesc]
  result! : void
where
  -- Declared member operation HeapBlockDesc::InsertHeapFreeBlock(HeapBlockDesc *node)
  true
end

schema HeapBlockDesc_FindSmallestFreeBlock_5
  ΔHeapBlockDesc
  size? : ℕ
  result! : Ref[HeapBlockDesc]
where
  -- Declared member operation HeapBlockDesc::FindSmallestFreeBlock(uint32 size)
  true
end

schema HeapBlockList
  m_first : HeapBlockDesc
  m_last : HeapBlockDesc
where
  instance_addr ∈ ADDRESS
end

schema HeapBlockList_Init
  ΔHeapBlockList
where
  -- Declared member operation HeapBlockList::Init(void)
  true
end

schema HeapBlockList_Insert_2
  ΔHeapBlockList
  node? : Ref[HeapBlockDesc]
  result! : void
where
  -- Declared member operation HeapBlockList::Insert(HeapBlockDesc *node)
  true
end

schema CommonSize
  m_freeList : HeapBlockList
  m_size : ℕ
  m_failed : ℕ
  m_remaining : ℕ
  nil : return
  block : return
where
  m_size ≥ 0
  m_failed ≥ 0
  m_remaining ≥ 0
end

schema CommonSize_Init
  ΔCommonSize
  size? : ℕ
where
  -- Declared member operation CommonSize::Init(uint32 size)
  true
end

schema CommonSize_Free_2
  ΔCommonSize
  node? : Ref[HeapBlockDesc]
where
  -- Declared member operation CommonSize::Free(HeapBlockDesc *node)
  true
end

schema CommonSize_Malloc_3
  ΔCommonSize
  result! : Ref[HeapBlockDesc]
where
  -- Declared member operation CommonSize::Malloc(void)
  true
end

schema CommonSize_RemoveHeapFreeBlock_4
  ΔCommonSize
  result! : block
where
  -- Declared member operation CommonSize::RemoveHeapFreeBlock()
  true
end

schema CMemoryHeap
  m_start : Ref[HeapBlockDesc]
  m_end : Ref[HeapBlockDesc]
  m_freeList : HeapBlockList
  m_fixedSize : seq CommonSize  -- bounded array [NUM_FIXED_MEMBLOCKS]
  m_totalMemUsed : ℕ
  m_idStack : ℤ
  m_currentMemID : ℕ
  m_memUsed : ℙ ℕ
  m_totalBlocksUsed : ℕ
  m_blocksUsed : ℙ ℕ
  m_unkMemId : ℕ
  NUM_FIXED_MEMBLOCKS : i
where
  #m_start ≤ 1
  #m_end ≤ 1
  m_totalMemUsed ≥ 0
  m_currentMemID ≥ 0
  #m_memUsed ≤ 1
  m_totalBlocksUsed ≥ 0
  #m_blocksUsed ≤ 1
  m_unkMemId ≥ 0
end

