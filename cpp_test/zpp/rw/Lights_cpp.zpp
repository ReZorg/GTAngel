schema Lights_SetLightsWithTimeOfDayColour
  ΔLightsModuleState
  arg_1? : Ref[RpWorld]
where
  -- State update: AmbientLightColourForFrame.red' = CTimeCycle::GetAmbientRed_Bl() * CCoronas::LightsMult
  -- State update: AmbientLightColourForFrame.green' = CTimeCycle::GetAmbientGreen_Bl() * CCoronas::LightsMult
  -- State update: AmbientLightColourForFrame.blue' = CTimeCycle::GetAmbientBlue_Bl() * CCoronas::LightsMult
  -- State update: AmbientLightColourForFrame.red' = CTimeCycle::GetAmbientRed() * CCoronas::LightsMult
  -- State update: AmbientLightColourForFrame.green' = CTimeCycle::GetAmbientGreen() * CCoronas::LightsMult
  -- State update: AmbientLightColourForFrame.blue' = CTimeCycle::GetAmbientBlue() * CCoronas::LightsMult
  -- Invokes: CTimeCycle::GetAmbientRed_Bl, CTimeCycle::GetAmbientGreen_Bl, CTimeCycle::GetAmbientBlue_Bl, CTimeCycle::GetAmbientRed, CTimeCycle::GetAmbientGreen
  true
end

