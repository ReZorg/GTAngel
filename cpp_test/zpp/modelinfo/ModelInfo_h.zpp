schema CModelInfo
  ms_modelInfoPtrs : Ref[CBaseModelInfo]
  msNumModelInfos : ℤ
  ms_simpleModelStore : CStore_CSimpleModelInfo__SIMPLEMODELSIZE
  ms_timeModelStore : CStore_CTimeModelInfo__TIMEMODELSIZE
  ms_weaponModelStore : CStore_CWeaponModelInfo__WEAPONMODELSIZE
  ms_clumpModelStore : CStore_CClumpModelInfo__CLUMPMODELSIZE
  ms_pedModelStore : CStore_CPedModelInfo__PEDMODELSIZE
  ms_vehicleModelStore : CStore_CVehicleModelInfo__VEHICLEMODELSIZE
  ms_2dEffectStore : CStore_C2dEffect__TWODFXSIZE
  resNumModelInfos : ℤ
  resModelInfoPtrs : Ref[CBaseModelInfo]
  ms_mloModelStore : CStore_CMloModelInfo__MLOMODELSIZE
  ms_mloInstanceStore : CStore_CInstance__MLOINSTANCESIZE
  ms_xtraCompsModelStore : CStore_CXtraCompsModelInfo__XTRACOMPSMODELSIZE
where
  #ms_modelInfoPtrs ≤ 1
  #resModelInfoPtrs ≤ 1
end

