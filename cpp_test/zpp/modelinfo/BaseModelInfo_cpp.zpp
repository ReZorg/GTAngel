schema CBaseModelInfo_CBaseModelInfo
  ΔCBaseModelInfo
  type? : ModelInfoType
where
  -- State update: m_colModel' = ∅
  -- State update: m_2dEffectsID' = -1
  -- State update: m_objectId' = -1
  -- State update: m_refCount' = 0
  -- State update: m_txdSlot' = -1
  -- State update: m_type' = type
  true
end

schema CBaseModelInfo_Shutdown
  ΔCBaseModelInfo
where
  -- State update: m_2dEffectsID' = -1
  -- State update: m_num2dEffects' = 0
  -- State update: m_txdSlot' = -1
  -- State update: m_objectId' = -1
  true
end

schema CBaseModelInfo_DeleteCollisionModel
  ΔCBaseModelInfo
where
  -- State update: m_colModel' = ∅
  true
end

schema CBaseModelInfo_AddRef
  ΔCBaseModelInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema CBaseModelInfo_RemoveRef
  ΔCBaseModelInfo
where
  -- Deterministic transition preserving module invariants
  true
end

