-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
VehicleModelInfo_Enum_1 ::= VEHICLE_FLAG_COLLAPSE | VEHICLE_FLAG_ADD_WHEEL | VEHICLE_FLAG_POS | VEHICLE_FLAG_DOOR | VEHICLE_FLAG_LEFT | VEHICLE_FLAG_RIGHT | VEHICLE_FLAG_FRONT | VEHICLE_FLAG_REAR | VEHICLE_FLAG_COMP | VEHICLE_FLAG_DRAWLAST | VEHICLE_FLAG_WINDSCREEN | VEHICLE_FLAG_ANGLECULL | VEHICLE_FLAG_REARDOOR | VEHICLE_FLAG_FRONTDOOR
  -- val(VEHICLE_FLAG_COLLAPSE) = 0x2
  -- val(VEHICLE_FLAG_ADD_WHEEL) = 0x4
  -- val(VEHICLE_FLAG_POS) = 0x8
  -- val(VEHICLE_FLAG_DOOR) = 0x10
  -- val(VEHICLE_FLAG_LEFT) = 0x20
  -- val(VEHICLE_FLAG_RIGHT) = 0x40
  -- val(VEHICLE_FLAG_FRONT) = 0x80
  -- val(VEHICLE_FLAG_REAR) = 0x100
  -- val(VEHICLE_FLAG_COMP) = 0x200
  -- val(VEHICLE_FLAG_DRAWLAST) = 0x400
  -- val(VEHICLE_FLAG_WINDSCREEN) = 0x800
  -- val(VEHICLE_FLAG_ANGLECULL) = 0x1000
  -- val(VEHICLE_FLAG_REARDOOR) = 0x2000
  -- val(VEHICLE_FLAG_FRONTDOOR) = 0x4000

VehicleModelInfo_Enum_2 ::= NONE | COLOURS | CARS

eVehicleType ::= VEHICLE_TYPE_CAR | VEHICLE_TYPE_BOAT | VEHICLE_TYPE_TRAIN | VEHICLE_TYPE_HELI | VEHICLE_TYPE_PLANE | VEHICLE_TYPE_BIKE | VEHICLE_TYPE_FERRY | NUM_VEHICLE_TYPES

eCarPositions ::= CAR_POS_HEADLIGHTS | CAR_POS_TAILLIGHTS | CAR_POS_FRONTSEAT | CAR_POS_BACKSEAT | CAR_POS_BRAKELIGHTS | CAR_POS_INDICATORS_FRONT | CAR_POS_INDICATORS_BACK | CAR_POS_STEERWHEEL

eBoatPositions ::= BOAT_POS_FRONTSEAT

eFerryPositions ::= FERRY_POS_LIGHT_FRONT | FERRY_POS_LIGHT_REAR | FERRY_POS_CHIM_LEFT | FERRY_POS_PED_POINT | FERRY_POS_CAR1 | FERRY_POS_CAR2 | FERRY_POS_CAR3 | FERRY_POS_CAR4

eTrainPositions ::= TRAIN_POS_LIGHT_FRONT | TRAIN_POS_LIGHT_REAR | TRAIN_POS_LEFT_ENTRY | TRAIN_POS_MID_ENTRY | TRAIN_POS_RIGHT_ENTRY

ePlanePositions ::= PLANE_POS_LIGHT_LEFT | PLANE_POS_LIGHT_RIGHT | PLANE_POS_LIGHT_TAIL

VehicleModelInfo_Enum_9 ::= NUM_VEHICLE_POSITIONS
  -- val(NUM_VEHICLE_POSITIONS) = 5

VehicleModelInfo_Enum_10 ::= NUM_FIRST_MATERIALS | NUM_SECOND_MATERIALS | NUM_VEHICLE_COLOURS
  -- val(NUM_FIRST_MATERIALS) = 24
  -- val(NUM_SECOND_MATERIALS) = 20
  -- val(NUM_VEHICLE_COLOURS) = 8

VehicleModelInfo_Enum_11 ::= NUM_FIRST_MATERIALS | NUM_SECOND_MATERIALS | NUM_VEHICLE_COLOURS | NUM_VEHICLE_ENVMAPS
  -- val(NUM_FIRST_MATERIALS) = 26
  -- val(NUM_SECOND_MATERIALS) = 26
  -- val(NUM_VEHICLE_COLOURS) = 8
  -- val(NUM_VEHICLE_ENVMAPS) = 1

VehicleModelInfo_Enum_12 ::= NUM_VEHICLE_POSITIONS
  -- val(NUM_VEHICLE_POSITIONS) = 10

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema editableMatCBData
  vehicle : Ref[CVehicleModelInfo]
  numMats1 : ℤ
  numMats2 : ℤ
where
  #vehicle ≤ 1
end

schema VehicleChunk
  clump : Ref[RpClump]
  numComps : ℤ
  comp : Ref[RpAtomic]
  materials1 : seq Ref[RpMaterial]  -- bounded array [NUM_FIRST_MATERIALS]
  materials2 : seq Ref[RpMaterial]  -- bounded array [NUM_SECOND_MATERIALS]
where
  #clump ≤ 1
  #comp ≤ 1
end

schema CVehicleModelInfo
  CClumpModelInfo  -- inherits base schema
  m_lastColour1 : ℕ
  m_lastColour2 : ℕ
  m_gameName : seq CHAR
  m_vehicleType : ℤ
  m_wheelScale : ℝ
  m_planeLodId : ℤ
  m_handlingId : ℤ
  m_numDoors : ℤ
  m_vehicleClass : ℤ
  m_level : ℤ
  m_numComps : ℤ
  m_frequency : ℤ
  m_positions : seq CVector  -- bounded array [NUM_VEHICLE_POSITIONS]
  m_compRules : ℕ
  m_bikeSteerAngle : ℝ
  m_materials1 : seq Ref[RpMaterial]  -- bounded array [NUM_FIRST_MATERIALS]
  m_materials2 : seq Ref[RpMaterial]  -- bounded array [NUM_SECOND_MATERIALS]
  m_colours1 : seq ℕ  -- bounded array [NUM_VEHICLE_COLOURS]
  m_colours2 : seq ℕ  -- bounded array [NUM_VEHICLE_COLOURS]
  m_numColours : ℕ
  m_lastColorVariation : ℕ
  m_currentColour1 : ℕ
  m_currentColour2 : ℕ
  m_comps : Ref[RpAtomic]
  m_normalSplay : ℝ
  m_animFileName : seq CHAR
  msClassInfo : base__cRelocatableChunkClassInfo
  msClassInstance : CVehicleModelInfo
  ms_vehicleColourTable : seq RwRGBA  -- bounded array [256]
  ms_compsUsed : seq ℤ  -- bounded array [2]
  ms_compsToUse : seq ℤ  -- bounded array [2]
  mspInfo : Ref[Statics]
  ms_vehicleDescs : seq Ref[RwObjectNameIdAssocation]  -- bounded array [NUM_VEHICLE_TYPES]
  ms_colourTextureTable : seq Ref[RwTexture]  -- bounded array [256]
  m_wheelId : ℤ
  m_envMap : Ref[RwTexture]
  ms_pEnvironmentMaps : seq Ref[RwTexture]  -- bounded array [NUM_VEHICLE_ENVMAPS]
where
  m_lastColour1 ≥ 0
  m_lastColour2 ≥ 0
  #m_gameName = 10
  m_compRules ≥ 0
  m_numColours ≥ 0
  m_lastColorVariation ≥ 0
  m_currentColour1 ≥ 0
  m_currentColour2 ≥ 0
  #m_comps ≤ 1
  #ms_vehicleColourTable = 256
  #ms_compsUsed = 2
  #ms_compsToUse = 2
  #mspInfo ≤ 1
  #ms_colourTextureTable = 256
  #m_envMap ≤ 1
end

