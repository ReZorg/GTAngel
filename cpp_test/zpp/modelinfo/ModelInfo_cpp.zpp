  writer? : base__cRelocatableChunkWriter
where
  -- State update: numModelInfos' = msNumModelInfos
  -- State update: resNumModelInfos' = numModelInfos
  -- State update: resModelInfoPtrs' = ms_modelInfoPtrs
  -- Return postcondition: result! = this
  -- Invokes: writer.AllocateRaw, writer.AddPatch
