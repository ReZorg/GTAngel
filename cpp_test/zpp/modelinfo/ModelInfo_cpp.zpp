  -- State update: modelinfo.m_wheelId' = -1
  -- State update: modelinfo.m_bikeSteerAngle' = 999.99f
  -- Return postcondition: result! = modelinfo
  -- Invokes: ms_vehicleModelStore.Alloc
  true
