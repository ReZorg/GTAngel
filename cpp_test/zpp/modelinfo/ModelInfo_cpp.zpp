schema CModelInfo_GetModelInfo
  ΔCModelInfo
  name? : seq CHAR
  id? : ℙ ℤ
where
  -- State update: hashKey' = CKeyGen::GetUppercaseKey(name)
  -- State update: modelinfo' = CModelInfo::ms_modelInfoPtrs[i]
  -- State update: id' = i
  -- Return postcondition: result! = modelinfo
  -- Return postcondition: result! = nil
  -- Invokes: CKeyGen::GetUppercaseKey, modelinfo->GetNameHashKey
  true
end

schema CModelInfo_GetModelInfo_2
  ΔCModelInfo
  name? : seq CHAR
  minIndex? : ℤ
  maxIndex? : ℤ
where
  -- State update: hashKey' = CKeyGen::GetUppercaseKey(name)
  -- State update: modelinfo' = CModelInfo::ms_modelInfoPtrs[i]
  -- Return postcondition: result! = 0
  -- Return postcondition: result! = modelinfo
  -- Return postcondition: result! = nil
  -- Invokes: CKeyGen::GetUppercaseKey, modelinfo->GetNameHashKey
  true
end

schema CModelInfo_GetModelInfoFromHashKey
