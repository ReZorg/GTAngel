schema CModelInfo_AddVehicleModel
  ΔCModelInfo
  id? : ℤ
where
  -- State update: modelinfo' = CModelInfo::ms_vehicleModelStore.Alloc()
  -- State update: modelinfo.m_clump' = ∅
  -- State update: modelinfo.m_vehicleType' = -1
  -- State update: modelinfo.m_wheelId' = -1
  -- State update: modelinfo.m_bikeSteerAngle' = 999.99f
  -- Return postcondition: result! = modelinfo
  -- Invokes: ms_vehicleModelStore.Alloc
  true
end

schema CModelInfo_GetModelInfo
  ΔCModelInfo
  name? : seq CHAR
  id? : ℙ ℤ
where
  -- State update: hashKey' = CKeyGen::GetUppercaseKey(name)
  -- State update: modelinfo' = CModelInfo::ms_modelInfoPtrs[i]
  -- State update: id' = i
  -- Return postcondition: result! = modelinfo
  -- Return postcondition: result! = nil
  -- Invokes: CKeyGen::GetUppercaseKey, modelinfo->GetNameHashKey
  true
end

schema CModelInfo_GetModelInfo_2
  ΔCModelInfo
  name? : seq CHAR
  minIndex? : ℤ
  maxIndex? : ℤ
where
  -- State update: hashKey' = CKeyGen::GetUppercaseKey(name)
  -- State update: modelinfo' = CModelInfo::ms_modelInfoPtrs[i]
  -- Return postcondition: result! = 0
  -- Return postcondition: result! = modelinfo
  -- Return postcondition: result! = nil
  -- Invokes: CKeyGen::GetUppercaseKey, modelinfo->GetNameHashKey
  true
end

