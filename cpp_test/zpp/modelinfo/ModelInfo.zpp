--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CModelInfo_Initialise
  ΔCModelInfo
where
  -- State update: ms_modelInfoPtrs' = new CBaseModelInfo*[MODELINFOSIZE]
  -- State update: msNumModelInfos' = MODELINFOSIZE
  -- State update: gp2dEffects' = ms_2dEffectStore.store
  -- State update: m' = AddSimpleModel(MI_CAR_DOOR)
  -- State update: m' = AddSimpleModel(MI_CAR_BUMPER)
  -- State update: m' = AddSimpleModel(MI_CAR_PANEL)
  -- Invokes: ms_2dEffectStore.Clear, ms_simpleModelStore.Clear, ms_timeModelStore.Clear, ms_weaponModelStore.Clear, ms_clumpModelStore.Clear
  true
end

schema CModelInfo_ShutDown
  ΔCModelInfo
where
  -- Invokes: ms_2dEffectStore.Clear, ms_simpleModelStore.Clear, ms_mloInstanceStore.Clear, ms_mloModelStore.Clear, ms_xtraCompsModelStore.Clear
  true
end

schema CModelInfo_AddSimpleModel
  ΔCModelInfo
  id? : ℤ
where
  -- State update: modelinfo' = CModelInfo::ms_simpleModelStore.Alloc()
  -- Return postcondition: result! = modelinfo
  -- Invokes: ms_simpleModelStore.Alloc, modelinfo->Init
  true
end

schema CModelInfo_AddTimeModel
  ΔCModelInfo
  id? : ℤ
where
  -- State update: modelinfo' = CModelInfo::ms_timeModelStore.Alloc()
  -- Return postcondition: result! = modelinfo
