  -- State update: modelinfo' = CModelInfo::ms_modelInfoPtrs[i]
  -- State update: id' = i
  -- Return postcondition: result! = modelinfo
  -- Return postcondition: result! = nil
  -- Invokes: modelinfo->GetNameHashKey
  true
end

