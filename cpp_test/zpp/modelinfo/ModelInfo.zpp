schema CModelInfo_AddClumpModel
  ΔCModelInfo
  id? : ℤ
where
  -- State update: modelinfo' = CModelInfo::ms_clumpModelStore.Alloc()
  -- State update: modelinfo.m_clump' = ∅
  -- Return postcondition: result! = modelinfo
  -- Invokes: ms_clumpModelStore.Alloc
  true
end

schema CModelInfo_AddPedModel
  ΔCModelInfo
