schema CModelInfo_ReInit2dEffects
  ΔCModelInfo
where
  -- Invokes: ms_2dEffectStore.Clear
  true
end

schema CModelInfo_Load
  ΔCModelInfo
  numModelInfos? : ℕ
  modelInfos? : Ref[CBaseModelInfo]
where
  -- State update: msNumModelInfos' = numModelInfos
  -- State update: ms_modelInfoPtrs' = modelInfos
  true
end

schema CModelInfo_Load2dEffects
  ΔCModelInfo
  numEffects? : ℕ
  effects? : Ref[C2dEffect]
where
  -- State update: ms_2dEffectStore.allocPtr' = numEffects
  -- State update: gp2dEffects' = effects
  true
end

schema CModelInfo_Write
  ΔCModelInfo
  writer? : base__cRelocatableChunkWriter
where
  -- State update: numModelInfos' = msNumModelInfos
  -- State update: resNumModelInfos' = numModelInfos
  -- State update: resModelInfoPtrs' = ms_modelInfoPtrs
  -- Return postcondition: result! = this
  -- Invokes: writer.AllocateRaw, writer.AddPatch
  true
end

schema CModelInfo_AddMloModel
  ΔCModelInfo
  id? : ℤ
where
  -- State update: modelinfo' = CModelInfo::ms_mloModelStore.Alloc()
  -- State update: modelinfo.m_clump' = ∅
  -- State update: modelinfo.firstInstance' = 0
  -- State update: modelinfo.lastInstance' = 0
  -- Return postcondition: result! = modelinfo
  -- Invokes: ms_mloModelStore.Alloc
  true
end

schema CModelInfo_RemoveColModelsFromOtherLevels
  ΔCModelInfo
  level? : eLevelName
where
  -- State update: mi' = GetModelInfo(i)
  -- State update: colmodel' = mi.GetColModel()
  -- Invokes: mi->GetColModel, colmodel->RemoveCollisionVolumes
  true
end

schema CModelInfo_ConstructMloClumps
  ΔCModelInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema ModelInfo_Get2dEffectIndex
  ΔModelInfoModuleState
  effect? : Ref[C2dEffect]
  result! : ℤ
where
  -- Return postcondition: result! = effect - gp2dEffects
  true
end

schema ModelInfo_GetNumModelInfos
  ΔModelInfoModuleState
  result! : ℤ
where
  -- Return postcondition: result! = msNumModelInfos
  true
end
