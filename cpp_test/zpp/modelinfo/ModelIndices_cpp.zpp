--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ModelIndices_InitModelIndices
  ΔModelIndicesModuleState
where
  -- State update: gpModelIndices' = new CModelIndices
  true
end

schema ModelIndices_MatchModelString
  ΔModelIndicesModuleState
  modelname? : seq CHAR
  id? : ℤ
where
  -- State update: var' = id
  -- Invokes: CGeneral::faststrcmp
  true
end

schema ModelIndices_TestModelIndices
  ΔModelIndicesModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema ModelIndicesModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 55
end
