schema C_PcSave_SetSaveDirectory
  ΔC_PcSave
  path? : seq CHAR
where
  -- Deterministic transition preserving module invariants
  true
end

schema C_PcSave_DeleteSlot
  ΔC_PcSave
  slot? : ℤ
where
  -- State update: PcSaveHelper.nErrorCode' = SAVESTATUS_SUCCESSFUL
  -- Return postcondition: result! = true
  true
end

schema C_PcSave_SaveSlot
  ΔC_PcSave
  slot? : ℤ
where
  -- State update: PcSaveHelper.nErrorCode' = SAVESTATUS_SUCCESSFUL
  -- State update: file' = CFileMgr::OpenFile(ValidSaveName, "wb")
  -- State update: nErrorCode' = SAVESTATUS_ERR_SAVE_CLOSE
  -- State update: PcSaveHelper.nErrorCode' = SAVESTATUS_ERR_SAVE_CREATE
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Invokes: CFileMgr::OpenFile, CFileMgr::CloseFile
  true
end

schema C_PcSave_PcClassSaveRoutine
  ΔC_PcSave
  file? : ℤ
  data? : ℙ ℕ
  size? : ℕ
where
  -- State update: nErrorCode' = SAVESTATUS_ERR_SAVE_WRITE
  -- State update: nErrorCode' = SAVESTATUS_ERR_SAVE_WRITE
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CFileMgr::Write, CFileMgr::GetErrorReadWrite
  true
end

schema C_PcSave_PopulateSlotInfo
