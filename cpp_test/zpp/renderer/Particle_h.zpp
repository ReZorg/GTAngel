--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Particle_Enum_1 ::= RAND_TABLE_SIZE | SIN_COS_TABLE_SIZE
  -- val(RAND_TABLE_SIZE) = 20
  -- val(SIN_COS_TABLE_SIZE) = 1024

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CParticle
  m_vecPosition : CVector
  m_vecVelocity : CVector
  m_nTimeWhenWillBeDestroyed : ℕ
  m_nTimeWhenColorWillBeChanged : ℕ
  m_fZGround : ℝ
  m_vecParticleMovementOffset : CVector
  m_nCurrentZRotation : ℤ
  m_nZRotationTimer : ℕ
  m_fCurrentZRadius : ℝ
  m_nZRadiusTimer : ℕ
  m_nColorIntensity : ℕ
  m_nAlpha : ℕ
  m_fSize : ℝ
  m_fExpansionRate : ℝ
  m_nFadeToBlackTimer : ℤ
  m_nFadeAlphaTimer : ℤ
  m_nAnimationSpeedTimer : ℤ
  m_nRotationStep : ℤ
  m_nRotation : ℤ
  m_nCurrentFrame : ℕ
  m_Color : RwRGBA
  m_pNext : Ref[CParticle]
  m_pUnusedListHead : Ref[CParticle]
  m_SinTable : seq ℝ  -- bounded array [SIN_COS_TABLE_SIZE]
  m_CosTable : seq ℝ  -- bounded array [SIN_COS_TABLE_SIZE]
  field_4C : ℤ
  m_vecScreenPosition : CVector
where
  m_nTimeWhenWillBeDestroyed ≥ 0
  m_nTimeWhenColorWillBeChanged ≥ 0
  m_nZRotationTimer ≥ 0
  m_nZRadiusTimer ≥ 0
  m_nColorIntensity ≥ 0
  m_nAlpha ≥ 0
  m_nCurrentFrame ≥ 0
  #m_pNext ≤ 1
  #m_pUnusedListHead ≤ 1
end

schema CParticle_CParticle
  ΔCParticle
where
  -- Declared member operation CParticle::CParticle()
  true
end

