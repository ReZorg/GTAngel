--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Particle_CParticle
  ΔParticleModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Particle_CParticle_2
  ΔParticleModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Particle_Sin
  ΔParticleModuleState
  value? : ℤ
  result! : ℝ
where
  -- Return postcondition: result! = m_SinTable[value]
  true
end

schema Particle_Cos
  ΔParticleModuleState
  value? : ℤ
  result! : ℝ
where
  -- Return postcondition: result! = m_CosTable[value]
  true
end

schema Particle_Next
  ΔParticleModuleState
  pParticle? : Ref[CParticle]
  pPrevParticle? : Ref[CParticle]
  pPSystemData? : Ref[tParticleSystemData]
  bRemoveParticle? : 𝔹
where
  -- State update: pParticle' = pPrevParticle.m_pNext
  -- State update: pParticle' = pPSystemData.m_pParticles
  -- State update: pPrevParticle' = pParticle
  -- State update: pParticle' = pParticle.m_pNext
  true
end
