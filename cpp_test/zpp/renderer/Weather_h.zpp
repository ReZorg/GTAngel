  ΔCWeather
where
  -- Declared member operation CWeather::Init(void)
  true
end

schema CWeather_ReleaseWeather_4
  ΔCWeather
where
  -- Declared member operation CWeather::ReleaseWeather()
  true
end

schema CWeather_ForceWeather_5
  ΔCWeather
  arg_1? : ℤ
where
  -- Declared member operation CWeather::ForceWeather(int16)
  true
end

schema CWeather_ForceWeatherNow_6
  ΔCWeather
  arg_1? : ℤ
where
  -- Declared member operation CWeather::ForceWeatherNow(int16)
  true
