  h? : ℝ
  r? : ℕ
  g? : ℕ
  b? : ℕ
  intens? : ℤ
  recipz? : ℝ
  rotation? : ℝ
  a? : ℕ
where
  -- State update: m_bFlushSpriteBufferSwitchZTest' = 0
  -- State update: c' = Cos(DEGTORAD(rotation))
  -- State update: s' = Sin(DEGTORAD(rotation))
  -- State update: vert' = &SpriteBufferVerts[nSpriteBufferIndex*6]
  -- Invokes: CDraw::GetNearClipZ, CDraw::GetFarClipZ
  true
end

