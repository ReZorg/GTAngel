  ΔCSkidmarks
  id? : ℕ
  pos? : CVector
  fwdX? : ℝ
  fwdY? : ℝ
  isMuddy? : ℙ 𝔹
  isBloody? : ℙ 𝔹
where
  -- State update: type' = SKIDMARK_BLOODY
  -- State update: type' = SKIDMARK_MUDDY
  -- State update: type' = SKIDMARK_NORMAL
  true
end

schema CSkidmarks_RegisterOne_2
  ΔCSkidmarks
  id? : ℕ
