  useNearDist? : 𝔹
  nearDist? : ℝ
where
  -- Declared member operation CCoronas::RegisterCorona(uint32 id, uint8 red, uint8 green, uint8 blue, uint8 alpha, const CVector &coors, float size, float drawDist, uint8 type, int8 flareType, uint8 reflection, uint8 LOScheck, uint8 drawStreak, float someAngle, bool useNearDist = false, float nearDist = 1.5f)
  true
end

schema CCoronas_UpdateCoronaCoors_6
  ΔCCoronas
  id? : ℕ
  coors? : CVector
  drawDist? : ℝ
  someAngle? : ℝ
where
  -- Declared member operation CCoronas::UpdateCoronaCoors(uint32 id, const CVector &coors, float drawDist, float someAngle)
  true
