schema CCutsceneShadow_IsInitialized
  ΔCCutsceneShadow
where
  -- Return postcondition: result! = m_pObject != nil
  true
end

schema CCutsceneShadow_Destroy
  ΔCCutsceneShadow
where
  -- State update: m_pAtomic' = ∅
  -- State update: m_nRwObjectType' = -1
  -- State update: frame' = RpLightGetFrame(m_pLight)
  -- State update: m_pLight' = ∅
  -- Invokes: m_Camera.Destroy, m_ResampleCamera.Destroy, m_BlurCamera.Destroy, m_GradientCamera.Destroy
  true
end

schema CCutsceneShadow_Update
  ΔCCutsceneShadow
where
  -- State update: raster' = m_Camera.GetRwRenderRaster()
  -- Return postcondition: result! = m_ResampleCamera.RasterResample(raster)
  -- Return postcondition: result! = m_BlurCamera.RasterBlur(raster, m_nBlurPasses)
  -- Return postcondition: result! = m_GradientCamera.RasterGradient(raster)
  -- Invokes: m_Camera.SetCenter, m_Camera.Update, m_Camera.GetRwRenderRaster, m_ResampleCamera.RasterResample, m_BlurCamera.RasterBlur
  true
end

schema CCutsceneShadow_UpdateForCutscene
  ΔCCutsceneShadow
where
  -- Return postcondition: result! = GetShadowRwTexture()
  true
end

schema CCutsceneShadow_GetShadowCamera
  ΔCCutsceneShadow
  camType? : ℤ
where
  -- Return postcondition: result! = &m_ResampleCamera
  -- Return postcondition: result! = &m_BlurCamera
  -- Return postcondition: result! = &m_GradientCamera
  true
end

schema CCutsceneShadow_GetShadowRwTexture
  ΔCCutsceneShadow
where
  -- Return postcondition: result! = m_ResampleCamera.GetRwRenderTexture()
  -- Return postcondition: result! = m_Camera.GetRwRenderTexture()
  -- Invokes: m_ResampleCamera.GetRwRenderTexture, m_Camera.GetRwRenderTexture
  true
end

schema CCutsceneShadow_DrawBorderAroundTexture
