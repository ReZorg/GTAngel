-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CWeather
  SoundHandle : ℤ
  WeatherTypeInList : ℤ
  OldWeatherType : ℤ
  NewWeatherType : ℤ
  ForcedWeatherType : ℤ
  LightningFlash : 𝔹
  LightningBurst : 𝔹
  LightningStart : ℕ
  LightningFlashLastChange : ℕ
  WhenToPlayLightningSound : ℕ
  LightningDuration : ℕ
  StreamAfterRainTimer : ℤ
  ExtraSunnyness : ℝ
  Foggyness : ℝ
  CloudCoverage : ℝ
  Wind : ℝ
  Rain : ℝ
  InterpolationValue : ℝ
  WetRoads : ℝ
  Rainbow : ℝ
  SunGlare : ℝ
  WindClipped : ℝ
  TrafficLightBrightness : ℝ
  bScriptsForceRain : 𝔹
  Stored_StateStored : 𝔹
  Stored_InterpolationValue : ℝ
  Stored_OldWeatherType : ℤ
  Stored_NewWeatherType : ℤ
  Stored_Rain : ℝ
where
  LightningStart ≥ 0
  LightningFlashLastChange ≥ 0
  WhenToPlayLightningSound ≥ 0
  LightningDuration ≥ 0
end

schema CWeather_RenderRainStreaks
  ΔCWeather
where
  -- Declared member operation CWeather::RenderRainStreaks(void)
  true
end

