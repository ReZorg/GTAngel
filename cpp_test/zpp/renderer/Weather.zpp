Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MIN_TIME_BETWEEN_LIGHTNING_FLASH_CHANGES : seq CHAR  -- #define MIN_TIME_BETWEEN_LIGHTNING_FLASH_CHANGES (50)
RAIN_CHANGE_SPEED : ℝ  -- #define RAIN_CHANGE_SPEED (0.003f)
DROPLETS_LEFT_OFFSET : ℝ  -- #define DROPLETS_LEFT_OFFSET (10.0f)
DROPLETS_RIGHT_OFFSET : ℝ  -- #define DROPLETS_RIGHT_OFFSET (10.0f)
DROPLETS_TOP_OFFSET : ℝ  -- #define DROPLETS_TOP_OFFSET (10.0f)
DROPLETS_BOTTOM_OFFSET : ℝ  -- #define DROPLETS_BOTTOM_OFFSET (10.0f)
STREAK_U : ℝ  -- #define STREAK_U (10.0f)
STREAK_V : ℝ  -- #define STREAK_V (18.0f)
LARGE_STREAK_COEFFICIENT : ℝ  -- #define LARGE_STREAK_COEFFICIENT (1.23f)
STREAK_MIN_DISTANCE : ℝ  -- #define STREAK_MIN_DISTANCE (8.0f)
STREAK_MAX_DISTANCE : ℝ  -- #define STREAK_MAX_DISTANCE (16.0f)
SPLASH_CHECK_RADIUS : ℝ  -- #define SPLASH_CHECK_RADIUS (7.0f)
SPLASH_OFFSET_RADIUS : ℝ  -- #define SPLASH_OFFSET_RADIUS (2.0f)
STREAK_LIFETIME : ℝ  -- #define STREAK_LIFETIME (4.0f)
STREAK_INTEROLATION_TIME : ℝ  -- #define STREAK_INTEROLATION_TIME (0.3f)
RAIN_COLOUR_R : seq CHAR  -- #define RAIN_COLOUR_R (200)
RAIN_COLOUR_G : seq CHAR  -- #define RAIN_COLOUR_G (200)
RAIN_COLOUR_B : seq CHAR  -- #define RAIN_COLOUR_B (256)
RAIN_ALPHA : seq CHAR  -- #define RAIN_ALPHA (255)

