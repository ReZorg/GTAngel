schema CRenderer_RenderRoads
  ΔCRenderer
where
  -- State update: t' = (CTreadable*)ms_aVisibleEntityPtrs[i]
  -- State update: ind' = 0
  true
end

schema Renderer_PutIntoSortedVehicleList
  ΔRendererModuleState
  veh? : Ref[CVehicle]
  result! : 𝔹
where
  -- State update: mode' = TheCamera.Cams[TheCamera.ActiveCam].Mode
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Return postcondition: result! = veh->bTouchingWater
  -- Invokes: veh->IsBoat, TheCamera.GetLookDirection, CVisibilityPlugins::GetClumpAlpha, veh->GetClump
  true
end

schema CRenderer_RenderEverythingBarRoads
  ΔCRenderer
where
  -- State update: e' = ms_aVisibleEntityPtrs[i]
  -- State update: distAlpha' = CVisibilityPlugins::GetObjectDistanceAlpha(e.m_rwObject)
  -- State update: gbLighting' = true
  -- State update: e' = ms_aVisibleVehiclePtrs[i]
  -- State update: ei.ent' = e
  -- State update: ei.sort' = (ms_vecCameraPosition - e.GetPosition()).MagnitudeSqr()
  -- Return postcondition: result! = VIS_INVISIBLE
  -- Return postcondition: result! = VIS_OFFSCREEN
  -- Return postcondition: result! = VIS_OFFSCREEN
  -- Invokes: e->IsPed, e->IsVehicle, CVisibilityPlugins::GetObjectDistanceAlpha, CVisibilityPlugins::GetClumpAlpha, CVisibilityPlugins::InsertEntityIntoSortedList
  true
end
