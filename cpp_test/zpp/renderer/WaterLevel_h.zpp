--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: WaterLevel (renderer)
-- Source File(s): renderer/WaterLevel.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WATER_X_OFFSET : ℝ  -- #define WATER_X_OFFSET (400.0f)
WATER_Z_OFFSET : ℝ  -- #define WATER_Z_OFFSET (0.5f)
NO_WATER : seq CHAR  -- #define NO_WATER -128
MAX_SMALL_SECTORS : ℕ  -- #define MAX_SMALL_SECTORS 128
MAX_LARGE_SECTORS : ℕ  -- #define MAX_LARGE_SECTORS 64
MAX_HUGE_SECTORS : ℕ  -- #define MAX_HUGE_SECTORS 32
MAX_EXTRAHUGE_SECTORS : ℕ  -- #define MAX_EXTRAHUGE_SECTORS 16
SMALL_SECTOR_SIZE : ℕ  -- #define SMALL_SECTOR_SIZE 32
LARGE_SECTOR_SIZE : ℕ  -- #define LARGE_SECTOR_SIZE 64
HUGE_SECTOR_SIZE : ℕ  -- #define HUGE_SECTOR_SIZE 128
EXTRAHUGE_SECTOR_SIZE : ℕ  -- #define EXTRAHUGE_SECTOR_SIZE 256
WATER_START_X : ℝ  -- #define WATER_START_X -2048.0f
WATER_END_X : ℝ  -- #define WATER_END_X 2048.0f
WATER_START_Y : ℝ  -- #define WATER_START_Y -2048.0f
WATER_END_Y : ℝ  -- #define WATER_END_Y 2048.0f
WATER_WIDTH : seq CHAR  -- #define WATER_WIDTH ((WATER_END_X - WATER_START_X))
WATER_HEIGHT : seq CHAR  -- #define WATER_HEIGHT ((WATER_END_Y - WATER_START_Y))
MAX_BOAT_WAKES : ℕ  -- #define MAX_BOAT_WAKES 8

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eBeachToy ::= BEACHTOY_0 | BEACHTOY_BALL | BEACHTOY_LOUNGE_WOOD_UP | BEACHTOY_LOUNGE_TOWEL_UP | BEACHTOY_LOUNGE_WOOD_ON | BEACHTOY_ANY_LOUNGE | BEACHTOY_LOTION | BEACHTOY_TOWEL1 | BEACHTOY_TOWEL2 | BEACHTOY_TOWEL3 | BEACHTOY_TOWEL4 | BEACHTOY_ANY_TOWEL
  -- val(BEACHTOY_0) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema ColData
  SurfaceType : ℕ
  PieceType : ℕ
where
  SurfaceType ≥ 0
  PieceType ≥ 0
end

schema CWaterLevel
  ms_nNoOfWaterLevels : ℤ
  ms_aWaterZs : seq ℝ  -- bounded array [48]
  ms_aWaterRects : seq CRect  -- bounded array [48]
  WavesCalculatedThisFrame : 𝔹
  RequireWavySector : 𝔹
  MaskCalculatedThisFrame : 𝔹
  PreCalculatedMaskPosn : CVector
  m_bRenderSeaBed : 𝔹
  m_nRenderWaterLayers : ℤ
  ms_pWavyAtomic : Ref[RpAtomic]
  ms_pMaskAtomic : Ref[RpAtomic]
  apGeomArray : seq Ref[RpGeometry]  -- bounded array [MAX_BOAT_WAKES]
  nGeomUsed : ℤ
where
  #ms_aWaterZs = 48
  #ms_aWaterRects = 48
  #ms_pWavyAtomic ≤ 1
  #ms_pMaskAtomic ≤ 1
end

