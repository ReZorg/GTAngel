--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tParticleSystemData
  m_Type : tParticleType
  m_aName : seq CHAR
  m_fCreateRange : ℝ
  m_fDefaultInitialRadius : ℝ
  m_fExpansionRate : ℝ
  m_nZRotationInitialAngle : ℕ
  m_nZRotationAngleChangeAmount : ℤ
  m_nZRotationChangeTime : ℕ
  m_nZRadiusChangeTime : ℕ
  m_fInitialZRadius : ℝ
  m_fZRadiusChangeAmount : ℝ
  m_nFadeToBlackTime : ℤ
  m_nFadeToBlackInitialIntensity : ℕ
  m_nFadeToBlackAmount : ℤ
  m_nFadeAlphaInitialIntensity : ℕ
  m_nFadeAlphaTime : ℤ
  m_nFadeAlphaAmount : ℤ
  m_nStartAnimationFrame : ℕ
  m_nFinalAnimationFrame : ℕ
  m_nAnimationSpeed : ℕ
  m_nRotationSpeed : ℕ
  m_fGravitationalAcceleration : ℝ
  m_nFrictionDecceleration : ℤ
  m_nLifeSpan : ℤ
  m_fPositionRandomError : ℝ
  m_fVelocityRandomError : ℝ
  m_fExpansionRateError : ℝ
  m_nRotationRateError : ℤ
  m_nLifeSpanErrorShape : ℕ
  m_fTrailLengthMultiplier : ℝ
  Flags : ℕ
  m_RenderColouring : CRGBA
  m_InitialColorVariation : ℕ
  m_FadeDestinationColor : CRGBA
  m_ColorFadeTime : ℕ
  m_vecTextureStretch : CVector2D
  m_fWindFactor : ℝ
  m_ppRaster : Ref[RwRaster]
  m_pParticles : Ref[CParticle]
where
  #m_aName = 20
  m_nZRotationInitialAngle ≥ 0
  m_nZRotationChangeTime ≥ 0
  m_nZRadiusChangeTime ≥ 0
  m_nFadeToBlackInitialIntensity ≥ 0
  m_nFadeAlphaInitialIntensity ≥ 0
  m_nStartAnimationFrame ≥ 0
  m_nFinalAnimationFrame ≥ 0
  m_nAnimationSpeed ≥ 0
  m_nRotationSpeed ≥ 0
  m_nLifeSpanErrorShape ≥ 0
  Flags ≥ 0
  m_InitialColorVariation ≥ 0
  m_ColorFadeTime ≥ 0
  #m_ppRaster ≤ 1
  #m_pParticles ≤ 1
end

schema cParticleSystemMgr
  m_aParticles : Ref[tParticleSystemData]
where
  #m_aParticles ≤ 1
end

schema cParticleSystemMgr_cParticleSystemMgr
  ΔcParticleSystemMgr
where
  -- Declared member operation cParticleSystemMgr::cParticleSystemMgr()
  true
end

schema cParticleSystemMgr_LoadParticleData_2
  ΔcParticleSystemMgr
where
  -- Declared member operation cParticleSystemMgr::LoadParticleData()
  true
end

schema cParticleSystemMgr_RangeCheck_3
  ΔcParticleSystemMgr
  pData? : Ref[tParticleSystemData]
where
  -- Declared member operation cParticleSystemMgr::RangeCheck(tParticleSystemData *pData)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ParticleMgr_RangeCheck
  ΔParticleMgrModuleState
  pData? : Ref[tParticleSystemData]
where
  -- Deterministic transition preserving module invariants
  true
end
