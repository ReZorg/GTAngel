OTHERUNAVAILABLE : seq CHAR  -- #define OTHERUNAVAILABLE (other != -1 && CModelInfo::GetModelInfo(other)->GetRwObject() == nil)
CANTIMECULL : seq CHAR  -- #define CANTIMECULL (!OTHERUNAVAILABLE)

