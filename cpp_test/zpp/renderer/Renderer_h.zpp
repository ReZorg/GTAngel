--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Renderer (renderer)
-- Source File(s): renderer/Renderer.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
LOD_DISTANCE : ℝ  -- #define LOD_DISTANCE (300.0f*TheCamera.LODDistMultiplier)
FADE_DISTANCE : ℝ  -- #define FADE_DISTANCE 20.0f
STREAM_DISTANCE : ℝ  -- #define STREAM_DISTANCE 30.0f
BACKFACE_CULLING_ON : seq CHAR  -- #define BACKFACE_CULLING_ON SetCullMode(rwCULLMODECULLBACK)
BACKFACE_CULLING_OFF : seq CHAR  -- #define BACKFACE_CULLING_OFF SetCullMode(rwCULLMODECULLNONE)

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema BlockedRange
  b : ℝ
  next : Ref[BlockedRange_prev]
where
  #next ≤ 1
end

schema CRenderer
  ms_nNoOfVisibleEntities : ℤ
  ms_aVisibleEntityPtrs : seq Ref[CEntity]  -- bounded array [NUMVISIBLEENTITIES]
  ms_nNoOfInVisibleEntities : ℤ
  ms_aInVisibleEntityPtrs : seq Ref[CEntity]  -- bounded array [NUMINVISIBLEENTITIES]
  ms_aVisibleVehiclePtrs : seq Ref[CEntity]  -- bounded array [NUMVISIBLEENTITIES]
  ms_nNoOfVisibleBuildings : ℤ
  ms_aVisibleBuildingPtrs : seq Ref[CEntity]  -- bounded array [NUMVISIBLEENTITIES]
  m_pFirstPersonVehicle : Ref[CVehicle]
  aBlockedRanges : seq BlockedRange  -- bounded array [16]
  pFullBlockedRanges : Ref[BlockedRange]
  pEmptyBlockedRanges : Ref[BlockedRange]
  ms_lodDistScale : ℝ
  m_loadingPriority : 𝔹
where
  #m_pFirstPersonVehicle ≤ 1
  #aBlockedRanges = 16
  #pFullBlockedRanges ≤ 1
  #pEmptyBlockedRanges ≤ 1
end

