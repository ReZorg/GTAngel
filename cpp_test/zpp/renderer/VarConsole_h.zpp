--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: VarConsole (renderer)
-- Source File(s): renderer/VarConsole.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eVarConsoleEntryType ::= VCE_TYPE_INT8 | VCE_TYPE_INT16 | VCE_TYPE_INT32 | VCE_TYPE_INT64 | VCE_TYPE_UINT8 | VCE_TYPE_UINT16 | VCE_TYPE_UINT32 | VCE_TYPE_UINT64 | VCE_TYPE_FLOAT | VCE_TYPE_BOOL | VCE_TYPE_BOOL8 | VCE_TYPE_BOOL16 | VCE_TYPE_BOOL32 | VCE_TYPE_FUNCTION

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CVarConsoleEntry
  text : seq CHAR
  pInt8Value : ℙ ℤ
  pInt16Value : ℙ ℤ
  pInt32Value : ℙ ℤ
  pInt64Value : ℙ ℤ
  pUint8Value : ℙ ℕ
  pUint16Value : ℙ ℕ
  pUint32Value : ℙ ℕ
  pUint64Value : ℙ ℕ
  pFloatValue : ℙ ℝ
  pBoolValue : ℙ 𝔹
  I8_min : ℤ
  I16_min : ℤ
  I32_min : ℤ
  I64_min : ℤ
  F_min : ℝ
  bAllowExceedBounds : bool8
  VarType : ℕ
where
  #pInt8Value ≤ 1
  #pInt16Value ≤ 1
  #pInt32Value ≤ 1
  #pInt64Value ≤ 1
  #pUint8Value ≤ 1
  #pUint16Value ≤ 1
  #pUint32Value ≤ 1
  #pUint64Value ≤ 1
  #pFloatValue ≤ 1
  #pBoolValue ≤ 1
  VarType ≥ 0
end

schema CVarConsoleEntry_void
  ΔCVarConsoleEntry
  arg_1? : Ref[pCallback]
where
  -- Declared member operation CVarConsoleEntry::void(*pCallback)
  true
end

schema CVarConsole
  m_nCountEntries : ℤ
  m_bIsOpen : bool8
  m_nCurEntry : ℤ
  m_nFirstEntryOnPage : ℤ
  m_nCurPage : ℤ
  m_nNumPages : ℤ
  m_aEntries : seq CVarConsoleEntry  -- bounded array [91]
where
  #m_aEntries = 91
end

schema CVarConsole_CVarConsole
  ΔCVarConsole
  result! : ifdef_FIX_BUGS
where
  -- Declared member operation CVarConsole::CVarConsole()
  true
end

