schema CSkidmarks_Init
  ΔCSkidmarks
where
  -- State update: slot' = CTxdStore::FindTxdSlot("particle")
  -- State update: gpSkidTex' = RwTextureRead("particleskid", ∅)
  -- State update: gpSkidBloodTex' = RwTextureRead("particleskidblood", ∅)
  -- State update: gpSkidMudTex' = RwTextureRead("particleskidmud", ∅)
  -- State update: m_state' = 0
  -- State update: m_wasUpdated' = false
  -- Invokes: CTxdStore::PushCurrentTxd, CTxdStore::FindTxdSlot, CTxdStore::SetCurrentTxd, CTxdStore::PopCurrentTxd
  true
end

schema CSkidmarks_Shutdown
  ΔCSkidmarks
where
  -- State update: gpSkidTex' = ∅
  -- State update: gpSkidBloodTex' = ∅
  -- State update: gpSkidMudTex' = ∅
  true
end

schema CSkidmarks_Clear
  ΔCSkidmarks
where
  -- State update: m_state' = 0
  -- State update: m_wasUpdated' = false
  true
end

schema CSkidmarks_Update
  ΔCSkidmarks
where
  -- State update: t1' = CTimer::GetTimeInMilliseconds() + 2500
  -- State update: t2' = CTimer::GetTimeInMilliseconds() + 5000
  -- State update: t3' = CTimer::GetTimeInMilliseconds() + 10000
  -- State update: t4' = CTimer::GetTimeInMilliseconds() + 20000
  -- State update: m_state' = 2
  -- State update: m_fadeStart' = t1
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CSkidmarks_Render
  ΔCSkidmarks
where
  -- State update: color' = CRGBA(0, 0, 0, 255)
  -- State update: color' = CRGBA(90, 62, 9, 255)
  -- State update: color' = CRGBA(108, 108, 96, 255)
  -- State update: color' = CRGBA(132, 34, 11, 255)
  -- State update: fade' = 255
  -- State update: alpha' = 128
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

