--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CShadowCamera_CShadowCamera
  ΔCShadowCamera
where
  -- State update: m_pCamera' = ∅
  -- State update: m_pTexture' = ∅
  true
end

schema CShadowCamera_CShadowCamera_2
  ΔCShadowCamera
where
  -- Deterministic transition preserving module invariants
  true
end

schema CShadowCamera_Destroy
  ΔCShadowCamera
where
  -- State update: frame' = RwCameraGetFrame(m_pCamera)
  -- State update: raster' = RwCameraGetZRaster(m_pCamera)
  -- State update: raster' = RwCameraGetRaster(m_pCamera)
  -- State update: m_pTexture' = ∅
  -- State update: m_pCamera' = ∅
  true
end

schema CShadowCamera_Create
  ΔCShadowCamera
  rasterSize? : ℤ
where
  -- State update: size' = 1 << rasterSize
  -- State update: m_pCamera' = RwCameraCreate()
  -- State update: zRaster' = RwRasterCreate(size, size, 0, rwRASTERTYPEZBUFFER)
  -- State update: raster' = RwRasterCreate(size, size, 0, rwRASTERTYPECAMERATEXTURE)
  -- State update: m_pTexture' = RwTextureCreate(raster)
  -- Return postcondition: result! = (m_pCamera)
  -- Return postcondition: result! = (nil)
  true
end

schema CShadowCamera_SetFrustum
  ΔCShadowCamera
  objectRadius? : ℝ
where
  -- State update: vw.x' = objectRadius
  -- State update: vw.y' = objectRadius
  -- Return postcondition: result! = m_pCamera
