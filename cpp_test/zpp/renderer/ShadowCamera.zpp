schema CShadowCamera_InvertRaster
  ΔCShadowCamera
where
  -- State update: raster' = RwCameraGetRaster(m_pCamera)
  -- State update: crw' = (float)RwRasterGetWidth(raster)
  -- State update: crh' = (float)RwRasterGetHeight(raster)
  -- State update: recipZ' = 1.0f / RwCameraGetNearClipPlane(m_pCamera)
  true
end

schema CShadowCamera_MakeGradientRaster
  ΔCShadowCamera
where
  -- State update: recipCamZ' = 1.0f / RwCameraGetNearClipPlane(m_pCamera)
  -- State update: raster' = RwCameraGetRaster(m_pCamera)
  -- State update: width' = (float)RwRasterGetWidth(raster)
  -- State update: height' = (float)RwRasterGetHeight(raster)
  -- State update: color' = 255.0f
  -- State update: step' = (-191.0f / height)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = raster
  true
end

schema CShadowCamera_RasterResample
