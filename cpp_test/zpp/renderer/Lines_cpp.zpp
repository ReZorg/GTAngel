--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CLines_RenderLineWithClipping
  ΔCLines
  x1? : ℝ
  y1? : ℝ
  z1? : ℝ
  x2? : ℝ
  y2? : ℝ
  z2? : ℝ
  c1? : ℕ
  c2? : ℕ
where
  -- State update: len' = sqrt(sq(x1-x2) + sq(y1-y2) + sq(z1-z2))
  -- State update: numsegs' = len/1.5f + 1.0f
  -- State update: col1.red' = c1>>24
  -- State update: col1.green' = c1>>16
  -- State update: col1.blue' = c1>>8
  -- State update: col1.alpha' = c1
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema LinesModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 74
end
