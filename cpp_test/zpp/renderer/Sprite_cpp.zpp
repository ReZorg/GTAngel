schema CSprite_RenderOneXLUSprite_Rotate_Aspect
  ΔCSprite
  x? : ℝ
  y? : ℝ
  z? : ℝ
  w? : ℝ
  h? : ℝ
  r? : ℕ
  g? : ℕ
  b? : ℕ
  intens? : ℤ
  recipz? : ℝ
  rotation? : ℝ
  a? : ℕ
where
  -- State update: c' = Cos(rotation)
  -- State update: s' = Sin(rotation)
  -- State update: f' = (z - 1.3f)/(2.3f-1.3f) * 255
  -- State update: r' = f*r >> 8
  -- State update: g' = f*g >> 8
  -- State update: b' = f*b >> 8
  -- Invokes: CDraw::GetNearClipZ, CDraw::GetFarClipZ
  true
end

