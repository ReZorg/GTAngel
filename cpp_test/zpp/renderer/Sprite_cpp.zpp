schema Sprite_CalcScreenZ
  ΔSpriteModuleState
  z? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = CSprite::GetNearScreenZ()
  -- Invokes: CSprite::GetNearScreenZ, CDraw::GetNearClipZ, CSprite::GetFarScreenZ, CDraw::GetFarClipZ
  true
end

schema CSprite_CalcHorizonCoors
  ΔCSprite
where
  -- State update: p.z' = 0.0f
  -- State update: p' = TheCamera.m_viewMatrix * p
  -- Return postcondition: result! = p.y * SCREEN_HEIGHT / p.z
  -- Invokes: TheCamera.GetPosition
  true
end

schema CSprite_CalcScreenCoors
  ΔCSprite
  in? : RwV3d
  out? : Ref[RwV3d]
  outw? : ℙ ℝ
  outh? : ℙ ℝ
  farclip? : 𝔹
where
  -- State update: viewvec' = TheCamera.m_viewMatrix * in
  -- State update: out' = viewvec
  -- State update: recip' = 1.0f/out.z
  -- State update: fov' = DefaultFOV
  -- State update: fovScale' = fov / CDraw::GetFOV()
  -- State update: outw' = fovScale * SCREEN_SCALE_AR(recip) * SCREEN_WIDTH
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CDraw::GetNearClipZ, CDraw::GetFarClipZ, CDraw::GetFOV
  true
end

