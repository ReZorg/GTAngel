end

schema CTimeCycle_Interpolate_3
  ΔCTimeCycle
  a? : ℙ ℤ
  b? : ℙ ℤ
  result! : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CTimeCycle_StartExtraColour
  ΔCTimeCycle
  c? : ℤ
  fade? : 𝔹
where
  -- State update: m_bExtraColourOn' = true
  -- State update: m_ExtraColour' = c
  -- State update: m_ExtraColourInter' = 0.0f
  -- State update: m_ExtraColourInter' = 1.0f
  true
end

schema CTimeCycle_StopExtraColour
  ΔCTimeCycle
  fade? : 𝔹
where
  -- State update: m_bExtraColourOn' = false
  -- State update: m_ExtraColourInter' = 0.0f
  true
end

schema CTimeCycle_Update
  ΔCTimeCycle
where
  -- State update: h1' = CClock::GetHours()
  -- State update: h2' = (h1+1)%24
  -- State update: w1' = CWeather::OldWeatherType
  -- State update: w2' = CWeather::NewWeatherType
  -- State update: timeInterp' = (CClock::GetMinutes() + CClock::GetSeconds()/60.0f)/60.0f
  -- State update: interp_c0' = (1.0f-timeInterp) * (1.0f-CWeather::InterpolationValue)
  -- Invokes: CClock::GetHours, CClock::GetMinutes, CClock::GetSeconds, sunPos.Normalise, CTimer::GetTimeStep
  true
end

