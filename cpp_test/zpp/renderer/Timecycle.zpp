schema CTimeCycle_Initialise
  ΔCTimeCycle
where
  -- State update: bi' = 0
  -- State update: w' = 0
  -- State update: h' = 0
  -- State update: li' = 0
  -- State update: m_FogReduction' = 0
  -- Invokes: CFileMgr::SetDir, CFileMgr::LoadFile
  true
end

schema CTimeCycle_UpdateArrays
  ΔCTimeCycle
where
  -- Deterministic transition preserving module invariants
  true
end

schema CTimeCycle_Interpolate
  ΔCTimeCycle
  a? : ℙ ℤ
  b? : ℙ ℤ
  result! : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CTimeCycle_Interpolate_2
