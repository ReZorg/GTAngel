--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_DIST : ℝ  -- #define MAX_DIST 22.0f
FOG_AREA_LENGTH : ℝ  -- #define FOG_AREA_LENGTH 12.0f
FOG_AREA_WIDTH : ℝ  -- #define FOG_AREA_WIDTH 5.0f
FOG_AREA_RADIUS : ℝ  -- #define FOG_AREA_RADIUS 9.0f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
PointLights_Enum_1 ::= LIGHT_POINT | LIGHT_DIRECTIONAL | LIGHT_DARKEN | LIGHT_FOGONLY_ALWAYS | LIGHT_FOGONLY

PointLights_Enum_2 ::= FOG_NONE | FOG_NORMAL | FOG_ALWAYS

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CRegisteredPointLight
  coors : CVector
  dir : CVector
  radius : ℝ
  red : ℝ
  green : ℝ
  blue : ℝ
  type : ℤ
  fogType : ℤ
  castExtraShadows : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CPointLights
  NumLights : ℤ
  aLights : seq ℤ  -- bounded array [NUMPOINTLIGHTS]
  aCachedMapReads : seq CVector  -- bounded array [32]
  aCachedMapReadResults : seq ℝ  -- bounded array [32]
  NextCachedValue : ℤ
where
  #aCachedMapReads = 32
  #aCachedMapReadResults = 32
end

schema CPointLights_Init
  ΔCPointLights
where
  -- Declared member operation CPointLights::Init(void)
  true
end

schema CPointLights_InitPerFrame_2
  ΔCPointLights
where
  -- Declared member operation CPointLights::InitPerFrame(void)
  true
end

schema CPointLights_AddLight_3
