where
  -- Deterministic transition preserving module invariants
  true
end

schema CPointLights_RenderFogEffect
  ΔCPointLights
where
  -- State update: coors2X' = aLights[i].coors.x + FOG_AREA_LENGTH*aLights[i].dir.x
  -- State update: coors2Y' = aLights[i].coors.y + FOG_AREA_LENGTH*aLights[i].dir.y
  -- State update: xmin' = coors2X
  -- State update: xmax' = aLights[i].coors.x
  -- State update: xmax' = coors2X
  -- State update: xmin' = aLights[i].coors.x
  -- Invokes: CCutsceneMgr::IsRunning, CSprite::InitSpriteBuffer, CWorld::ProcessVerticalLine, CSprite::CalcScreenCoors, CTimer::GetTimeInMilliseconds
  true
end

