  type? : ℕ
  coors? : CVector
  dir? : CVector
  radius? : ℝ
  red? : ℝ
  green? : ℝ
  blue? : ℝ
  fogType? : ℕ
  castExtraShadows? : 𝔹
where
  -- Declared member operation CPointLights::AddLight(uint8 type, CVector coors, CVector dir, float radius, float red, float green, float blue, uint8 fogType, bool castExtraShadows)
  true
end

schema CPointLights_GenerateLightsAffectingObject_4
  ΔCPointLights
  objCoors? : Ref[Const_CVector]
  result! : ℝ
where
  -- Declared member operation CPointLights::GenerateLightsAffectingObject(Const CVector *objCoors)
  true
end

schema CPointLights_RemoveLightsAffectingObject_5
  ΔCPointLights
where
  -- Declared member operation CPointLights::RemoveLightsAffectingObject(void)
  true
end

schema CPointLights_RenderFogEffect_6
  ΔCPointLights
where
  -- Declared member operation CPointLights::RenderFogEffect(void)
  true
end

schema CPointLights_ProcessVerticalLineUsingCache_7
  ΔCPointLights
  coors? : CVector
  groundZ? : ℙ ℝ
  result! : 𝔹
where
  -- Declared member operation CPointLights::ProcessVerticalLineUsingCache(CVector coors, float *groundZ)
  true
end

