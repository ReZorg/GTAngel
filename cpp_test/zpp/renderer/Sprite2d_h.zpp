--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Sprite2d (renderer)
-- Source File(s): renderer/Sprite2d.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CSprite2d
  RecipNearClip : ℝ
  NearScreenZ : ℝ
  NearCamZ : ℝ
  nextBufferVertex : ℤ
  nextBufferIndex : ℤ
  maVertices : seq RwIm2DVertex  -- bounded array [8]
  m_pTexture : Ref[RwTexture]
  mCurrentBank : ℤ
  mpBankTextures : seq Ref[RwTexture]  -- bounded array [10]
  mCurrentSprite : seq ℤ  -- bounded array [10]
  mBankStart : seq ℤ  -- bounded array [10]
  maBankVertices : seq RwIm2DVertex  -- bounded array [500]
where
  #maVertices = 8
  #m_pTexture ≤ 1
  #mpBankTextures = 10
  #mCurrentSprite = 10
  #mBankStart = 10
  #maBankVertices = 500
end

