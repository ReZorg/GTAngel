schema CGlass_RenderEntityInGlass
  ΔCGlass
  entity? : Ref[CEntity]
where
  -- State update: object' = (CObject *)entity
  -- State update: fwdNorm' = object.GetForward()
  -- State update: alpha' = CalcAlphaWithNormal(&fwdNorm)
  -- State update: col' = object.GetColModel()
  -- State update: a' = object.GetMatrix() * col.vertices[0].Get()
  -- State update: b' = object.GetMatrix() * col.vertices[1].Get()
  -- Invokes: TheCamera.GetPosition, object->GetPosition, object->GetForward, fwdNorm.Normalise, object->GetColModel
  true
end

schema CGlass_CalcAlphaWithNormal
  ΔCGlass
  normal? : Ref[CVector]
where
  -- State update: fwdDir' = 2.0f * DotProduct(*normal, TheCamera.GetForward())
  -- Return postcondition: result! = int32(lerp(fwdDot*fwdDot*fwdDot*fwdDot*fwdDot*fwdDot, 20.0f, 255.0f))
  -- Invokes: TheCamera.GetForward
  true
end

