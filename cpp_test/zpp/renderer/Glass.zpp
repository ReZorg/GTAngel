  -- State update: object' = CPools::GetObjectPool().GetSlot(i)
  -- State update: col' = object.GetColModel()
  -- Invokes: CTimer::GetTimeInMilliseconds, CPools::GetObjectPool, object->GetModelIndex, object->GetColModel, object->GetPosition
  true
end

