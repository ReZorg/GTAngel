  -- State update: object.bGlassCracked' = true
  -- Invokes: object->GetPosition, distToGlass.Magnitude
  true
end

schema CGlass_CarWindscreenShatters
  ΔCGlass
  vehicle? : Ref[CVehicle]
  unk? : 𝔹
where
  -- State update: col' = vehicle.GetColModel()
  -- State update: tria' = ∅
  -- State update: triIndex' = -1
  -- State update: trib' = ∅
  -- State update: tri' = &col.triangles[i]
  -- State update: trib' = tri
  -- Invokes: vehicle->GetColModel, CCollision::CalculateTrianglePlanes, vehicle->GetMatrix, vehicle->GetRight, vec1.Normalise
  true
end

schema CGlass_HasGlassBeenShatteredAtCoors
  ΔCGlass
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: entity' = ∅
  -- State update: dist' = 20.0f
  -- State update: nStartX' = Max(CWorld::GetSectorIndexX(x - 30.0f), 0)
  -- State update: nStartY' = Max(CWorld::GetSectorIndexY(y - 30.0f), 0)
  -- State update: nEndX' = Min(CWorld::GetSectorIndexX(x + 30.0f), NUMSECTORS_X-1)
  -- State update: nEndY' = Min(CWorld::GetSectorIndexY(y + 30.0f), NUMSECTORS_Y-1)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = !!((CObject*)entity)->bGlassBroken
  -- Return postcondition: result! = false
  -- Invokes: CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::AdvanceCurrentScanCode, CWorld::GetSector, entity->GetType
  true
end

schema CGlass_FindWindowSectorList
  ΔCGlass
  list? : CPtrList
  dist? : ℙ ℝ
  entity? : Ref[CEntity]
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: node' = list.first
  -- State update: ent' = (CEntity *)node.item
  -- State update: scanCode' = ent.m_scanCode
  -- State update: node' = node.next
  -- State update: ent.m_scanCode' = CWorld::GetCurrentScanCode()
  -- State update: dst' = (CVector(x,y,z) - ent.GetPosition()).Magnitude()
  -- Invokes: ent->GetModelIndex, CWorld::GetCurrentScanCode, ent->GetPosition
  true
end

