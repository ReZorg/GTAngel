  carGlass? : 𝔹
where
  -- State update: upLen' = up.Magnitude()
  -- State update: rightLen' = right.Magnitude()
  -- State update: upSteps' = upLen + 0.75f
  -- State update: upSteps' = 1.0f
  -- State update: rightSteps' = rightLen + 0.75f
  -- State update: rightSteps' = 1.0f
  -- Invokes: up.Magnitude, right.Magnitude, CWorld::FindGroundZFor3DCoord, pane->GetRight, pane->GetUp
  true
end

