  explosion? : 𝔹
where
  -- State update: object' = (CObject *)entity
  -- State update: object.bGlassCracked' = true
  -- State update: col' = object.GetColModel()
  -- State update: a' = col.vertices[0].Get()
  -- State update: b' = col.vertices[1].Get()
  -- State update: c' = col.vertices[2].Get()
  -- Invokes: object->GetColModel, object->GetMatrix, object->GetPosition
