schema CFallingGlassPane
  CMatrix  -- inherits base schema
  m_vecMoveSpeed : CVector
  m_vecTurn : CVector
  m_nTimer : ℕ
  m_fGroundZ : ℝ
  m_fStep : ℝ
  m_nTriIndex : ℕ
  m_bActive : 𝔹
  m_bShattered : 𝔹
  m_bCarGlass : 𝔹
where
  m_nTimer ≥ 0
  m_nTriIndex ≥ 0
end

schema CFallingGlassPane_CFallingGlassPane
