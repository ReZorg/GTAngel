-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CFallingGlassPane_Update
  ΔCFallingGlassPane
where
  -- State update: m_bActive' = false
  -- State update: pos' = CVector(GetPosition().x, GetPosition().y, m_fGroundZ)
  -- State update: color' = { 255, 255, 255, 255 }
  -- State update: nFrameGen' = 0
  -- State update: dir.x' = CGeneral::GetRandomNumberInRange(-0.35f, 0.35f)
  -- State update: dir.y' = CGeneral::GetRandomNumberInRange(-0.35f, 0.35f)
  -- Invokes: CTimer::GetTimeInMilliseconds, CTimer::GetTimeStep, CGeneral::GetRandomNumberInRange, CParticle::AddParticle
  true
end

schema CFallingGlassPane_Render
  ΔCFallingGlassPane
where
  -- State update: distToCamera' = (TheCamera.GetPosition() - GetPosition()).Magnitude()
  -- State update: fwdNorm' = GetForward()
  -- State update: alpha' = CGlass::CalcAlphaWithNormal(&fwdNorm)
  -- State update: time' = Clamp(CTimer::GetTimeInMilliseconds() - m_nTimer, 0, 500)
  -- State update: color' = int32( float(alpha) * (float(time) / 500) )
  -- State update: color' = 64
  -- Invokes: TheCamera.GetPosition, fwdNorm.Normalise, CGlass::CalcAlphaWithNormal, CTimer::GetTimeInMilliseconds, CGlass::RenderHiLightPolys
  true
end

