schema CGlass_Render
  ΔCGlass
where
  -- State update: TempBufferVerticesStoredHiLight' = 0
  -- State update: TempBufferIndicesStoredHiLight' = 0
  -- State update: TempBufferVerticesStoredShattered' = TEMPBUFFERVERTSHATTEREDOFFSET
  -- State update: TempBufferIndicesStoredShattered' = TEMPBUFFERINDEXSHATTEREDOFFSET
  -- State update: TempBufferVerticesStoredReflection' = TEMPBUFFERVERTREFLECTIONOFFSET
  -- State update: TempBufferIndicesStoredReflection' = TEMPBUFFERINDEXREFLECTIONOFFSET
  -- Invokes: CTimeCycle::GetFogRed, CTimeCycle::GetFogGreen, CTimeCycle::GetFogBlue
  true
end

