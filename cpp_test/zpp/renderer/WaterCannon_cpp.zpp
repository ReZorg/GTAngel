  -- State update: m_nId' = 0
  -- Invokes: CTimer::GetTimeInMilliseconds, CTimer::GetTimeStep, CGeneral::GetRandomNumber, gFireManager.ExtinguishPoint, CTimer::GetFrameCounter
  true
end

