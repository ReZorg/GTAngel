--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
SMALLSTRIPHEIGHT : ℝ  -- #define SMALLSTRIPHEIGHT 4.0f
HORIZSTRIPHEIGHT : ℝ  -- #define HORIZSTRIPHEIGHT 48.0f

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CClouds
  CloudRotation : ℝ
  IndividualRotation : ℕ
  ms_cameraRoll : ℝ
  ms_horizonZ : ℝ
  ms_HorizonTilt : ℝ
  ms_colourTop : CRGBA
  ms_colourBottom : CRGBA
  ms_colourBkGrd : CRGBA
where
  IndividualRotation ≥ 0
end

schema CClouds_Init
  ΔCClouds
where
  -- Declared member operation CClouds::Init(void)
  true
end

schema CClouds_Shutdown_2
  ΔCClouds
where
  -- Declared member operation CClouds::Shutdown(void)
  true
end

schema CClouds_Update_3
  ΔCClouds
where
  -- Declared member operation CClouds::Update(void)
  true
end

schema CClouds_Render_4
  ΔCClouds
where
  -- Declared member operation CClouds::Render(void)
  true
end

schema CClouds_RenderBackground_5
  ΔCClouds
  topred? : ℤ
  topgreen? : ℤ
  topblue? : ℤ
  botred? : ℤ
  botgreen? : ℤ
  botblue? : ℤ
  alpha? : ℤ
where
  -- Declared member operation CClouds::RenderBackground(int16 topred, int16 topgreen, int16 topblue, int16 botred, int16 botgreen, int16 botblue, int16 alpha)
  true
end

schema CClouds_RenderHorizon_6
  ΔCClouds
where
  -- Declared member operation CClouds::RenderHorizon(void)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CClouds_Init
  ΔCClouds
where
  -- State update: CloudRotation' = 0.0f
  -- Invokes: CTxdStore::PushCurrentTxd, CTxdStore::SetCurrentTxd, CTxdStore::FindTxdSlot, CTxdStore::PopCurrentTxd
  true
end

schema CClouds_Shutdown
  ΔCClouds
where
  -- Deterministic transition preserving module invariants
  true
end

schema CClouds_Update
  ΔCClouds
where
  -- State update: s' = Sin(TheCamera.Orientation - 0.85f)
  -- Invokes: CTimer::GetTimeStepFix, CTimer::GetTimeStep
  true
end

schema CClouds_Render
  ΔCClouds
where
  -- State update: SunBlockedByClouds' = false
  -- State update: campos' = TheCamera.GetPosition()
  -- State update: moonfadeout' = Abs(minute - 180.0f)
  -- State update: coverage' = Max(CWeather::Foggyness, CWeather::CloudCoverage)
  -- State update: brightness' = (1.0f - coverage) * (180 - (int)moonfadeout)
  -- State update: pos' = { 0.0f, -100.0f, 15.0f }
  -- Invokes: CGame::CanSeeOutSideFromCurrArea, CSprite::InitSpriteBuffer, CClock::GetHours, CClock::GetMinutes, CClock::GetSeconds
  true
end

schema Clouds_UseDarkBackground
  ΔCloudsModuleState
where
  -- Return postcondition: result! = TheCamera.GetForward().z < -0.9f || gbShowCollisionPolys
  -- Invokes: TheCamera.GetForward
  true
end

schema CClouds_RenderBackground
  ΔCClouds
  topred? : ℤ
  topgreen? : ℤ
  topblue? : ℤ
  botred? : ℤ
  botgreen? : ℤ
  botblue? : ℤ
  alpha? : ℤ
where
  -- State update: right' = CrossProduct(TheCamera.GetUp(), TheCamera.GetForward())
  -- State update: c' = right.Magnitude2D()
  -- State update: c' = 1.0f
  -- State update: ms_cameraRoll' = Acos(c)
  -- State update: ms_cameraRoll' = -ms_cameraRoll
  -- State update: ms_HorizonTilt' = SCREEN_WIDTH/2.0f * Tan(ms_cameraRoll)
  -- Invokes: TheCamera.GetUp, TheCamera.GetForward, right.Normalise, right.Magnitude2D, CTimer::GetFrameCounter
  true
end

schema CClouds_RenderHorizon
  ΔCClouds
where
  -- State update: ms_colourBottom.a' = 230
  -- State update: ms_colourTop.a' = 80
  -- State update: topright' = ms_horizonZ - ms_HorizonTilt
  -- State update: topleft' = ms_horizonZ + ms_HorizonTilt
  -- State update: botright' = topright + SMALLSTRIPHEIGHT
  -- State update: botleft' = topleft + SMALLSTRIPHEIGHT
  -- Invokes: CSprite2d::DrawAnyRect, CTimeCycle::GetAmbientRed, CTimeCycle::GetAmbientGreen, CTimeCycle::GetAmbientBlue
  true
end
