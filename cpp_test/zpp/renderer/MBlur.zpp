schema CMBlur_MotionBlurOpen
  ΔCMBlur
  cam? : Ref[RwCamera]
where
  -- State update: rect' = {0, 0, 0, 0}
  -- State update: BlurOn' = true
  -- State update: rect.w' = RwRasterGetWidth(RwCameraGetRaster(cam))
  -- State update: rect.h' = RwRasterGetHeight(RwCameraGetRaster(cam))
  -- State update: pFrontBuffer' = ∅
  -- State update: rect' = { 0, 0, 0, 0 }
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = FALSE
  -- Invokes: CPostFX::Open
  true
end

schema CMBlur_MotionBlurClose
  ΔCMBlur
where
  -- State update: pFrontBuffer' = ∅
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = FALSE
  -- Invokes: CPostFX::Close
  true
end

