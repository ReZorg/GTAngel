schema CCutsceneShadow_CCutsceneShadow
  ΔCCutsceneShadow
where
  -- State update: m_pAtomic' = ∅
  -- State update: m_nRwObjectType' = -1
  -- State update: m_pLight' = ∅
  -- State update: m_nBlurPasses' = 0
  -- State update: m_bResample' = false
  -- State update: m_bGradient' = false
  true
end

schema CCutsceneShadow_CCutsceneShadow_2
  ΔCCutsceneShadow
where
  -- Deterministic transition preserving module invariants
  true
end

schema CCutsceneShadow_Create
  ΔCCutsceneShadow
  object? : Ref[RwObject]
  rasterSize? : ℤ
  resample? : 𝔹
  blurPasses? : ℤ
  gradient? : 𝔹
where
  -- State update: m_pLight' = RpLightCreate(rpLIGHTDIRECTIONAL)
  -- State update: color.blue' = DLIGHT_VALUE
  -- State update: color.alpha' = 0.0f
  -- State update: frame' = RwFrameCreate()
  -- State update: m_pObject' = object
  -- State update: m_nRwObjectType' = RwObjectGetType(m_pObject)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Invokes: m_Camera.Create, m_ResampleCamera.Create, m_BlurCamera.Create, m_GradientCamera.Create, m_GradientCamera.MakeGradientRaster
  true
end

schema CCutsceneShadow_SetLightProperties
  ΔCCutsceneShadow
  angleY? : ℝ
  angleX? : ℝ
  setLight? : 𝔹
where
  -- State update: Xaxis' = { 1.0f, 0.0f, 0.0f }
  -- State update: Yaxis' = { 0.0f, 1.0f, 0.0f }
  -- State update: frame' = RpLightGetFrame(m_pLight)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = frame
  -- Invokes: m_Camera.SetLight
  true
end

schema CCutsceneShadow_IsInitialized
  ΔCCutsceneShadow
