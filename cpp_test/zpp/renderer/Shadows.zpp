--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CShadows_Init
  ΔCShadows
where
  -- State update: slut' = CTxdStore::FindTxdSlot("particle")
  -- State update: gpShadowCarTex' = RwTextureRead("shad_car",     ∅)
  -- State update: gpShadowPedTex' = RwTextureRead("shad_ped",     ∅)
  -- State update: gpShadowHeliTex' = RwTextureRead("shad_heli",    ∅)
  -- State update: gpShadowBikeTex' = RwTextureRead("shad_bike",    ∅)
  -- State update: gpShadowBaronTex' = RwTextureRead("shad_rcbaron", ∅)
  -- Invokes: CTxdStore::PushCurrentTxd, CTxdStore::FindTxdSlot, CTxdStore::SetCurrentTxd, CTxdStore::PopCurrentTxd, VarConsole.Add
  true
end

schema CShadows_Shutdown
  ΔCShadows
where
  -- Deterministic transition preserving module invariants
  true
end

schema CShadows_AddPermanentShadow
  ΔCShadows
  ShadowType? : ℕ
  pTexture? : Ref[RwTexture]
  pPosn? : Ref[CVector]
  fFrontX? : ℝ
  fFrontY? : ℝ
  fSideX? : ℝ
  fSideY? : ℝ
  nIntensity? : ℤ
  nRed? : ℕ
  nGreen? : ℕ
  nBlue? : ℕ
  fZDistance? : ℝ
  nTime? : ℕ
  fScale? : ℝ
where
  -- State update: nSlot' = 0
  -- State update: m_nType' = ShadowType
  -- State update: m_pTexture' = pTexture
