schema CShadows_CalcPedShadowValues
  ΔCShadows
  vecLightDir? : CVector
  pfFrontX? : ℙ ℝ
  pfFrontY? : ℙ ℝ
  pfSideX? : ℙ ℝ
  pfSideY? : ℙ ℝ
  pfDisplacementX? : ℙ ℝ
  pfDisplacementY? : ℙ ℝ
where
  -- State update: pfFrontX' = -vecLightDir.x
  -- State update: pfFrontY' = -vecLightDir.y
  -- State update: fDist' = Sqrt(*pfFrontY * *pfFrontY + *pfFrontX * *pfFrontX)
  -- State update: fMult' = (fDist + 1.0f) / fDist
  -- State update: pfSideX' = -vecLightDir.y / fDist
  -- State update: pfSideY' = vecLightDir.x / fDist
  true
end

schema CShadows_RenderExtraPlayerShadows
  ΔCShadows
where
  -- State update: pCar' = FindPlayerVehicle()
  -- State update: vecLight' = CPointLights::aLights[i].coors - FindPlayerCoors()
  -- State update: fLightDist' = vecLight.Magnitude()
  -- State update: fRadius' = CPointLights::aLights[i].radius
  -- State update: fMult' = (1.0f - (2.0f * fLightDist - fRadius) / fRadius)
  -- State update: nColorStrength' = (5*CTimeCycle::GetLightShadowStrength()/8)
  -- Invokes: CReplay::IsPlayingBack, CTimeCycle::GetLightShadowStrength, vecLight.Magnitude, pCar->GetModelIndex, pCar->GetPosition
  true
end

