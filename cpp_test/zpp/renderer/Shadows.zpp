schema CShadows_CastShadowEntityXY
  ΔCShadows
  pEntity? : Ref[CEntity]
  fStartX? : ℝ
  fStartY? : ℝ
  fEndX? : ℝ
  fEndY? : ℝ
  pPosn? : Ref[CVector]
  fFrontX? : ℝ
  fFrontY? : ℝ
  fSideX? : ℝ
  fSideY? : ℝ
  nIntensity? : ℤ
  nRed? : ℕ
  nGreen? : ℕ
  nBlue? : ℕ
  fZDistance? : ℝ
  fScale? : ℝ
  ppPolyBunch? : Ref[CPolyBunch]
where
  -- State update: pCol' = pEntity.GetColModel()
  -- State update: x' = (fLengthRight   + fFrontRight  )  - fSideRight
  -- State update: y' = (fLengthForward + fFrontForward)  - fSideForward
  -- State update: x' = fSideRight      + (fLengthRight   + fFrontRight)
  -- State update: y' = fSideForward    + (fLengthForward + fFrontForward)
  -- State update: x' = fSideRight      + (fLengthRight   - fFrontRight)
  -- Invokes: pEntity->GetColModel, pEntity->GetModelIndex, pEntity->GetPosition, boundingBox.GetSize, CCollision::CalculateTrianglePlanes
  true
end

