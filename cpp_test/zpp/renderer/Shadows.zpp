  m_vecSide : CVector2D
  m_fZDistance : ℝ
  m_fScale : ℝ
  m_nTimeCreated : ℕ
  m_nLifeTime : ℕ
  m_pTexture : Ref[RwTexture]
  m_nIntensity : ℤ
  m_nType : ℕ
  m_nRed : ℕ
  m_nGreen : ℕ
  m_nBlue : ℕ
where
  m_nTimeCreated ≥ 0
  m_nLifeTime ≥ 0
  #m_pTexture ≤ 1
  m_nType ≥ 0
  m_nRed ≥ 0
  m_nGreen ≥ 0
  m_nBlue ≥ 0
end

schema CPermanentShadow_CPermanentShadow
