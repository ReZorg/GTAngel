schema CWaterLevel_CalcDistanceToWater
  ΔCWaterLevel
  fX? : ℝ
  fY? : ℝ
where
  -- State update: fSectorMaxRenderDist' = 250.0f
  -- State update: nStartY' = WATER_TO_SMALL_SECTOR_Y(fY - fSectorMaxRenderDist) - 1
  -- State update: nEndY' = WATER_TO_SMALL_SECTOR_Y(fY + fSectorMaxRenderDist) + 1
  -- State update: nStartX' = Clamp(nStartX, 0, MAX_SMALL_SECTORS - 1)
  -- State update: nEndX' = Clamp(nEndX,   0, MAX_SMALL_SECTORS - 1)
  -- State update: nStartY' = Clamp(nStartY, 0, MAX_SMALL_SECTORS - 1)
  -- Return postcondition: result! = Clamp(Sqrt(fDistSqr) - 23.0f, 0.0f, fSectorMaxRenderDist)
  -- Invokes: vecDist.MagnitudeSqr
  true
end

