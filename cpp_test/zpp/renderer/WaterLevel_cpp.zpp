schema CWaterLevel_RenderOneWavySector_2
  ΔCWaterLevel
  fX? : ℝ
  fY? : ℝ
  fZ? : ℝ
  color? : RwRGBA
  bUnk? : 𝔹
where
  -- State update: nGeomUsed' = 0
  -- State update: WavesCalculatedThisFrame' = true
  -- State update: geometry' = RpAtomicGetGeometry(ms_pWavyAtomic)
  -- State update: wavyPreLights' = RpGeometryGetPreLightColors(geometry)
  -- State update: u' = float(i) / 8 + TEXTURE_ADDV
  -- State update: v' = float(j) / 8 + TEXTURE_ADDU
  -- Invokes: CTimer::GetTimeInMilliseconds, CBoat::FillBoatList, CBoat::IsSectorAffectedByWake, CBoat::IsVertexAffectedByWake
  true
end

schema CWaterLevel_AllocateBoatWakeArray
  ΔCWaterLevel
where
  -- State update: wavyGeometry' = RpAtomicGetGeometry(ms_pWavyAtomic)
  -- State update: wavyMorphTarget' = RpGeometryGetMorphTarget(wavyGeometry, 0)
  -- State update: wavyMaterial' = RpGeometryGetMaterial(wavyGeometry, 0)
  -- State update: geom' = 0
  -- State update: geomTriangles' = RpGeometryGetTriangles(apGeomArray[geom])
  -- State update: geomMorphTarget' = RpGeometryGetMorphTarget(apGeomArray[geom], 0)
  -- Invokes: CStreaming::MakeSpaceFor
  true
end

schema CWaterLevel_FreeBoatWakeArray
  ΔCWaterLevel
where
  -- State update: nGeomUsed' = 0
  true
end

