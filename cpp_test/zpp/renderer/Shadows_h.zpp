--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Shadows (renderer)
-- Source File(s): renderer/Shadows.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_STOREDSHADOWS : ℕ  -- #define MAX_STOREDSHADOWS 48
MAX_POLYBUNCHES : ℕ  -- #define MAX_POLYBUNCHES 380
MAX_STATICSHADOWS : ℕ  -- #define MAX_STATICSHADOWS 48
MAX_PERMAMENTSHADOWS : ℕ  -- #define MAX_PERMAMENTSHADOWS 48

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eShadowType ::= SHADOWTYPE_NONE | SHADOWTYPE_DARK | SHADOWTYPE_ADDITIVE | SHADOWTYPE_INVCOLOR
  -- val(SHADOWTYPE_NONE) = 0

eShadowTextureType ::= SHADOWTEX_NONE | SHADOWTEX_CAR | SHADOWTEX_PED | SHADOWTEX_EXPLOSION | SHADOWTEX_HELI | SHADOWTEX_HEADLIGHTS | SHADOWTEX_BLOOD
  -- val(SHADOWTEX_NONE) = 0

VEH_SHD_TYPE ::= VEH_SHD_TYPE_CAR | VEH_SHD_TYPE_BIKE | VEH_SHD_TYPE_HELI | VEH_SHD_TYPE_SEAPLANE | VEH_SHD_TYPE_RCPLANE
  -- val(VEH_SHD_TYPE_CAR) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CStoredShadow
  m_vecPos : CVector
  m_vecFront : CVector2D
  m_vecSide : CVector2D
  m_fZDistance : ℝ
  m_fScale : ℝ
  m_pTexture : Ref[RwTexture]
  m_pCutsceneShadow : Ref[CCutsceneShadow]
  m_nIntensity : ℤ
  m_ShadowType : ℕ
  m_nRed : ℕ
  m_nGreen : ℕ
  m_nBlue : ℕ
  bRendered : 𝔹
  bDrawOnBuildings : 𝔹
where
  #m_pTexture ≤ 1
  #m_pCutsceneShadow ≤ 1
  m_ShadowType ≥ 0
  m_nRed ≥ 0
  m_nGreen ≥ 0
  m_nBlue ≥ 0
  #bRendered = 1
  #bDrawOnBuildings = 1
end

schema CStoredShadow_CStoredShadow
  ΔCStoredShadow
where
  -- Declared member operation CStoredShadow::CStoredShadow()
  true
end

schema CPolyBunch
  m_aVerts : seq CVector  -- bounded array [7]
  m_pNext : Ref[CPolyBunch]
  m_nNumVerts : ℤ
  m_aU : seq ℕ  -- bounded array [7]
  m_aV : seq ℕ  -- bounded array [7]
where
  #m_aVerts = 7
  #m_pNext ≤ 1
  #m_aU = 7
  #m_aV = 7
end

schema CPolyBunch_CPolyBunch
  ΔCPolyBunch
where
  -- Declared member operation CPolyBunch::CPolyBunch()
  true
end

schema CStaticShadow
  m_nId : ℕ
  m_pPolyBunch : Ref[CPolyBunch]
  m_nTimeCreated : ℕ
  m_vecPosn : CVector
  m_vecFront : CVector2D
  m_vecSide : CVector2D
  m_fZDistance : ℝ
  m_fScale : ℝ
  m_pTexture : Ref[RwTexture]
  m_nIntensity : ℤ
  m_nType : ℕ
  m_nRed : ℕ
  m_nGreen : ℕ
  m_nBlue : ℕ
  m_bJustCreated : 𝔹
  m_bRendered : 𝔹
  m_bTemp : 𝔹
where
  m_nId ≥ 0
  #m_pPolyBunch ≤ 1
  m_nTimeCreated ≥ 0
  #m_pTexture ≤ 1
  m_nType ≥ 0
  m_nRed ≥ 0
  m_nGreen ≥ 0
  m_nBlue ≥ 0
end

schema CStaticShadow_CStaticShadow
  ΔCStaticShadow
where
  -- Declared member operation CStaticShadow::CStaticShadow()
  true
end

schema CPermanentShadow
  m_vecPos : CVector
  m_vecFront : CVector2D
  m_vecSide : CVector2D
  m_fZDistance : ℝ
  m_fScale : ℝ
  m_nTimeCreated : ℕ
  m_nLifeTime : ℕ
  m_pTexture : Ref[RwTexture]
  m_nIntensity : ℤ
  m_nType : ℕ
  m_nRed : ℕ
  m_nGreen : ℕ
  m_nBlue : ℕ
where
  m_nTimeCreated ≥ 0
  m_nLifeTime ≥ 0
  #m_pTexture ≤ 1
  m_nType ≥ 0
  m_nRed ≥ 0
  m_nGreen ≥ 0
  m_nBlue ≥ 0
end

schema CPermanentShadow_CPermanentShadow
  ΔCPermanentShadow
where
  -- Declared member operation CPermanentShadow::CPermanentShadow()
  true
end

schema CShadows
  ShadowsStoredToBeRendered : ℤ
  pEmptyBunchList : Ref[CPolyBunch]
  aPermanentShadows : seq CPermanentShadow  -- bounded array [MAX_PERMAMENTSHADOWS]
where
  #pEmptyBunchList ≤ 1
end

schema CShadows_Init
  ΔCShadows
where
  -- Declared member operation CShadows::Init(void)
  true
end

