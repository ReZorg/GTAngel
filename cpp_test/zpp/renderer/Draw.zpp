-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eAspectRatio ::= AR_AUTO | AR_4_3 | AR_5_4 | AR_16_10 | AR_16_9 | AR_21_9 | AR_MAX

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CDraw
  ms_fNearClipZ : ℝ
  ms_fFarClipZ : ℝ
  ms_fFOV : ℝ
  ms_fScaledFOV : ℝ
  FadeValue : ℕ
  FadeRed : ℕ
  FadeGreen : ℕ
  FadeBlue : ℕ
where
  FadeValue ≥ 0
  FadeRed ≥ 0
  FadeGreen ≥ 0
  FadeBlue ≥ 0
end

schema CDraw_GetNearClipZ
  ΔCDraw
  result! : ℝ
where
  -- Declared member operation CDraw::GetNearClipZ(void)
  true
end

schema CDraw_SetFarClipZ_2
  ΔCDraw
  farclip? : ℝ
  result! : void
where
  -- Declared member operation CDraw::SetFarClipZ(float farclip)
  true
end

