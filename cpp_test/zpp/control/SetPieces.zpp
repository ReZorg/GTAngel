schema CSetPieces_Init
  ΔCSetPieces
where
  -- State update: bDebug' = false
  -- State update: NumSetPieces' = 0
  -- Invokes: VarConsole.Add
  true
end

schema CSetPieces_AddOne
  ΔCSetPieces
  type? : ℕ
  vTriggerInf? : CVector2D
  vTriggerSup? : CVector2D
  vSpawn1? : CVector2D
  vTarget1? : CVector2D
  vSpawn2? : CVector2D
  vTarget2? : CVector2D
where
  -- State update: m_nType' = type
  -- State update: m_vTriggerInf.x' = Min(vTriggerInf.x, vTriggerSup.x)
  -- State update: m_vTriggerInf.y' = Min(vTriggerInf.y, vTriggerSup.y)
  -- State update: m_vTriggerSup.x' = Max(vTriggerInf.x, vTriggerSup.x)
  -- State update: m_vTriggerSup.y' = Max(vTriggerInf.y, vTriggerSup.y)
  -- State update: m_vSpawn1' = vSpawn1
  true
end

schema CSetPieces_Update
  ΔCSetPieces
where
  -- State update: nFirst' = NumSetPieces * (CTimer::GetFrameCounter() % 8) / 8
  -- State update: nLast' = NumSetPieces * (CTimer::GetFrameCounter() % 8 + 1) / 8
  -- Invokes: CTimer::GetFrameCounter
  true
end

schema CSetPieces_Save
  ΔCSetPieces
  buf? : ℙ ℕ
  size? : ℙ ℕ
where
  -- State update: size' = sizeof(NumSetPieces) + NUM_SETPIECES * sizeof(CSetPiece)
  true
end

schema CSetPieces_Load
  ΔCSetPieces
  buf? : ℙ ℕ
  size? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

