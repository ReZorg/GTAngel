  m_nLastTimeCreated : ℕ
  m_vTriggerInf : CVector2D
  m_vTriggerSup : CVector2D
  m_vSpawn1 : CVector2D
  m_vSpawn2 : CVector2D
  m_vTarget1 : CVector2D
  m_vTarget2 : CVector2D
where
  m_nType ≥ 0
  m_nLastTimeCreated ≥ 0
end

