--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NUM_RESTART_POINTS : ℕ  -- #define NUM_RESTART_POINTS 8

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CRestart
  OverrideHospitalLevel : ℕ
  OverridePoliceStationLevel : ℕ
  bFadeInAfterNextArrest : 𝔹
  bFadeInAfterNextDeath : 𝔹
  bOverrideRestart : 𝔹
  OverridePosition : CVector
  OverrideHeading : ℝ
  HospitalRestartPoints : seq CVector  -- bounded array [NUM_RESTART_POINTS]
  HospitalRestartHeadings : seq ℝ  -- bounded array [NUM_RESTART_POINTS]
  NumberOfHospitalRestarts : ℕ
  PoliceRestartPoints : seq CVector  -- bounded array [NUM_RESTART_POINTS]
  PoliceRestartHeadings : seq ℝ  -- bounded array [NUM_RESTART_POINTS]
  NumberOfPoliceRestarts : ℕ
where
  OverrideHospitalLevel ≥ 0
  OverridePoliceStationLevel ≥ 0
  NumberOfHospitalRestarts ≥ 0
  NumberOfPoliceRestarts ≥ 0
end

schema CRestart_AddPoliceRestartPoint
  ΔCRestart
  arg_1? : CVector
  arg_2? : ℝ
where
  -- Declared member operation CRestart::AddPoliceRestartPoint(const CVector&, float)
  true
end

