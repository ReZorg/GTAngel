schema CRestart_FindClosestHospitalRestartPoint
  ΔCRestart
  pos? : CVector
  outPos? : Ref[CVector]
  outHeading? : ℙ ℝ
where
  -- State update: outPos' = OverridePosition
  -- State update: outHeading' = OverrideHeading
  -- State update: curlevel' = CTheZones::GetLevelFromPosition(&pos)
  -- State update: fMinDist' = SQR(4000.0f)
  -- State update: closestPoint' = NUM_RESTART_POINTS
  -- State update: dist' = (pos - HospitalRestartPoints[i]).MagnitudeSqr()
  -- Invokes: CTheZones::GetLevelFromPosition, ThePaths.FindNodeClosestToCoors
  true
end

