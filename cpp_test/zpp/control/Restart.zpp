schema CRestart_Initialise
  ΔCRestart
where
  -- State update: OverridePoliceStationLevel' = LEVEL_GENERIC
  -- State update: OverrideHospitalLevel' = LEVEL_GENERIC
  -- State update: bFadeInAfterNextArrest' = true
  -- State update: bFadeInAfterNextDeath' = true
  -- State update: OverrideHeading' = 0.0f
  -- State update: OverridePosition' = CVector(0.0f, 0.0f, 0.0f)
  true
end

schema CRestart_AddHospitalRestartPoint
  ΔCRestart
  pos? : CVector
