--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
FIX_REPLAY_BUGS : seq CHAR  -- #define FIX_REPLAY_BUGS #endif
REPLAY_STUB : seq CHAR  -- #define REPLAY_STUB #else

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Replay_Enum_1 ::= NUM_MAIN_ANIMS_IN_REPLAY | NUM_PARTIAL_ANIMS_IN_REPLAY
  -- val(NUM_MAIN_ANIMS_IN_REPLAY) = 3
  -- val(NUM_PARTIAL_ANIMS_IN_REPLAY) = 6

Replay_Enum_2 ::= MODE_RECORD | MODE_PLAYBACK
  -- val(MODE_RECORD) = 0
  -- val(MODE_PLAYBACK) = 1

Replay_Enum_3 ::= REPLAYCAMMODE_ASSTORED | REPLAYCAMMODE_TOPDOWN | REPLAYCAMMODE_FIXED
  -- val(REPLAYCAMMODE_ASSTORED) = 0

Replay_Enum_4 ::= REPLAYPACKET_END | REPLAYPACKET_VEHICLE | REPLAYPACKET_BIKE | REPLAYPACKET_PED_HEADER | REPLAYPACKET_PED_UPDATE | REPLAYPACKET_GENERAL | REPLAYPACKET_CLOCK | REPLAYPACKET_WEATHER | REPLAYPACKET_ENDOFFRAME | REPLAYPACKET_TIMER | REPLAYPACKET_BULLET_TRACES | REPLAYPACKET_PARTICLE | REPLAYPACKET_MISC
  -- val(REPLAYPACKET_END) = 0

Replay_Enum_5 ::= REPLAYBUFFER_UNUSED | REPLAYBUFFER_PLAYBACK | REPLAYBUFFER_RECORD
  -- val(REPLAYBUFFER_UNUSED) = 0
  -- val(REPLAYBUFFER_PLAYBACK) = 1
  -- val(REPLAYBUFFER_RECORD) = 2

Replay_Enum_6 ::= NUM_REPLAYBUFFERS | REPLAYBUFFERSIZE
  -- val(NUM_REPLAYBUFFERS) = 8
  -- val(REPLAYBUFFERSIZE) = 100000

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CAddressInReplayBuffer
  m_nOffset : ℕ
  m_pBase : ℙ ℕ
  m_bSlot : ℕ
where
  m_nOffset ≥ 0
  #m_pBase ≤ 1
  m_bSlot ≥ 0
end

schema CStoredAnimationState
  animId : ℕ
  time : ℕ
  speed : ℕ
  groupId : ℕ
  secAnimId : ℕ
  secTime : ℕ
  secSpeed : ℕ
  secGroupId : ℕ
  blendAmount : ℕ
  partAnimId : ℕ
  partAnimTime : ℕ
  partAnimSpeed : ℕ
  partBlendAmount : ℕ
  partGroupId : ℕ
where
  animId ≥ 0
  time ≥ 0
  speed ≥ 0
  groupId ≥ 0
  secAnimId ≥ 0
  secTime ≥ 0
  secSpeed ≥ 0
  secGroupId ≥ 0
  blendAmount ≥ 0
  partAnimId ≥ 0
  partAnimTime ≥ 0
  partAnimSpeed ≥ 0
  partBlendAmount ≥ 0
  partGroupId ≥ 0
end

schema CStoredDetailedAnimationState
  aAnimId : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aCurTime : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aSpeed : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aBlendAmount : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aBlendDelta : seq ℤ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aFunctionCallbackID : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aFlags : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aGroupId : seq ℕ  -- bounded array [NUM_MAIN_ANIMS_IN_REPLAY]
  aAnimId2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aCurTime2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aSpeed2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aBlendAmount2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aBlendDelta2 : seq ℤ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aFunctionCallbackID2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aFlags2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
  aGroupId2 : seq ℕ  -- bounded array [NUM_PARTIAL_ANIMS_IN_REPLAY]
where
  instance_addr ∈ ADDRESS
end

