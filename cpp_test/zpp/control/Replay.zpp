schema tGeneralPacket
  type : ℕ
  in_rcvehicle : 𝔹
  camera_pos : CMatrix
  player_pos : CVector
where
  type ≥ 0
end

schema tClockPacket
  type : ℕ
  hours : ℕ
  minutes : ℕ
  __align : ℕ
where
  type ≥ 0
  hours ≥ 0
  minutes ≥ 0
  __align ≥ 0
end

schema tWeatherPacket
  type : ℕ
  old_weather : ℕ
  new_weather : ℕ
  interpolation : ℝ
where
  type ≥ 0
  old_weather ≥ 0
  new_weather ≥ 0
end

schema tTimerPacket
  type : ℕ
  timer : ℕ
where
  type ≥ 0
  timer ≥ 0
end

schema tPedHeaderPacket
  type : ℕ
  index : ℕ
  mi : ℕ
  pedtype : ℕ
  __align : seq ℕ  -- bounded array [3]
where
  type ≥ 0
  index ≥ 0
  mi ≥ 0
  pedtype ≥ 0
  #__align = 3
end

schema tBulletTracePacket
  type : ℕ
  frames : ℕ
  lifetime : ℕ
  index : ℕ
  inf : CVector
  sup : CVector
where
  type ≥ 0
  frames ≥ 0
  lifetime ≥ 0
  index ≥ 0
end

schema tEndOfFramePacket
  type : ℕ
  __align : seq ℕ  -- bounded array [3]
where
  type ≥ 0
  #__align = 3
end

schema tPedUpdatePacket
  type : ℕ
  index : ℕ
  heading : ℤ
  vehicle_index : ℤ
  anim_state : CStoredAnimationState
  matrix : CCompressedMatrixNotAligned
  weapon_model : ℕ
  assoc_group_id : ℤ
  is_visible : 𝔹
where
  type ≥ 0
  index ≥ 0
  weapon_model ≥ 0
end

schema tVehicleUpdatePacket
  type : ℕ
  index : ℕ
  health : ℕ
  acceleration : ℕ
  matrix : CCompressedMatrixNotAligned
  door_angles : seq ℤ  -- bounded array [2]
  mi : ℕ
  panels : ℕ
  velocityX : ℤ
  velocityY : ℤ
  velocityZ : ℤ
  wheel_state : ℤ
  wheel_susp_dist : seq ℕ  -- bounded array [4]
  wheel_rotation : seq ℕ  -- bounded array [4]
  door_status : ℕ
  primary_color : ℕ
  secondary_color : ℕ
  render_scorched : 𝔹
  skimmer_speed : ℤ
  vehicle_type : ℤ
where
  type ≥ 0
  index ≥ 0
  health ≥ 0
  acceleration ≥ 0
  #door_angles = 2
  mi ≥ 0
  panels ≥ 0
  #wheel_susp_dist = 4
  #wheel_rotation = 4
  door_status ≥ 0
  primary_color ≥ 0
  secondary_color ≥ 0
end

schema tBikeUpdatePacket
  type : ℕ
  index : ℕ
  health : ℕ
  acceleration : ℕ
  matrix : CCompressedMatrixNotAligned
  door_angles : seq ℤ  -- bounded array [2]
  mi : ℕ
  velocityX : ℤ
  velocityY : ℤ
  velocityZ : ℤ
  wheel_state : ℤ
  wheel_susp_dist : seq ℕ  -- bounded array [4]
  wheel_rotation : seq ℕ  -- bounded array [4]
  primary_color : ℕ
  secondary_color : ℕ
  lean_angle : ℤ
  wheel_angle : ℤ
where
  type ≥ 0
  index ≥ 0
  health ≥ 0
  acceleration ≥ 0
  #door_angles = 2
  mi ≥ 0
  #wheel_susp_dist = 4
  #wheel_rotation = 4
  primary_color ≥ 0
  secondary_color ≥ 0
end

schema tParticlePacket
  type : ℕ
  particle_type : ℕ
  dir_x : ℤ
  dir_y : ℤ
  dir_z : ℤ
  r : ℕ
  g : ℕ
  b : ℕ
  a : ℕ
  pos_x : ℤ
  pos_y : ℤ
  pos_z : ℤ
  size : ℝ
where
  type ≥ 0
  particle_type ≥ 0
  r ≥ 0
  g ≥ 0
  b ≥ 0
  a ≥ 0
end

schema tMiscPacket
  type : ℕ
  cam_shake_start : ℕ
  cam_shake_strength : ℝ
  cur_area : ℕ
  video_cam : 𝔹
  lift_cam : 𝔹
where
  type ≥ 0
  cam_shake_start ≥ 0
  cur_area ≥ 0
  #video_cam = 1
  #lift_cam = 1
end

