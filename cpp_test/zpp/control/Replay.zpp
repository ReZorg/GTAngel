  ms_nTotalCarPassengerPeds_Stored : ℤ
  ms_nTotalCivPeds_Stored : ℤ
  ms_nTotalGangPeds_Stored : ℤ
  ms_nTotalPeds_Stored : ℤ
  ms_nTotalMissionPeds_Stored : ℤ
  pGarages : ℙ ℕ
  FireArray : Ref[CFire]
  NumOfFires : ℕ
  paProjectileInfo : ℙ ℕ
  paProjectiles : ℙ ℕ
  CurrArea : ℕ
where
  hours ≥ 0
  minutes ≥ 0
  __align ≥ 0
  old_weather ≥ 0
  new_weather ≥ 0
  timer ≥ 0
  index ≥ 0
  mi ≥ 0
  pedtype ≥ 0
  frames ≥ 0
  lifetime ≥ 0
  weapon_model ≥ 0
  health ≥ 0
  acceleration ≥ 0
  #door_angles = 2
  panels ≥ 0
end

