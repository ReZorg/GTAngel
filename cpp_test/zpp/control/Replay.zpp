  dir_x : ℤ
  dir_y : ℤ
  dir_z : ℤ
  r : ℕ
  g : ℕ
  b : ℕ
  a : ℕ
  pos_x : ℤ
  pos_y : ℤ
  pos_z : ℤ
  size : ℝ
  cam_shake_start : ℕ
  cam_shake_strength : ℝ
  cur_area : ℕ
  video_cam : 𝔹
  lift_cam : 𝔹
  Mode : ℕ
  Record : CAddressInReplayBuffer
  Playback : CAddressInReplayBuffer
  pBuf0 : ℙ ℕ
  pBuf1 : Ref[CAutomobile]
  pBuf2 : ℙ ℕ
