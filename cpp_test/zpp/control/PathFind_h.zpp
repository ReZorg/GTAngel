end

schema CPathFind
  m_pathNodes : seq CPathNode  -- bounded array [NUM_PATHNODES]
  m_carPathLinks : seq CCarPathLink  -- bounded array [NUM_CARPATHLINKS]
  m_mapObjects : seq Ref[CTreadable]  -- bounded array [NUM_MAPOBJECTS]
  m_connections : seq ℕ  -- bounded array [NUM_PATHCONNECTIONS]
  m_distances : seq ℕ  -- bounded array [NUM_PATHCONNECTIONS]
  m_carPathConnections : seq ℤ  -- bounded array [NUM_PATHCONNECTIONS]
  m_numPathNodes : ℤ
  m_numCarPathNodes : ℤ
  m_numPedPathNodes : ℤ
  m_numMapObjects : ℤ
  m_numConnections : ℤ
  m_numCarPathLinks : ℤ
  unk : ℤ
  m_numGroups : seq ℕ  -- bounded array [2]
  m_searchNodes : seq CPathNode  -- bounded array [512]
  m_objectFlags : seq ℕ  -- bounded array [NUM_MAPOBJECTS]
  m_connectionFlags : seq CConnectionFlags  -- bounded array [NUM_PATHCONNECTIONS]
where
  #m_numGroups = 2
  #m_searchNodes = 512
end

