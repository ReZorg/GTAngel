--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: PathFind (control)
-- Source File(s): control/PathFind.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Treadable.zpp  (from "Treadable.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
LANE_WIDTH : ℝ  -- #define LANE_WIDTH 5.0f
WIDTH_TO_PED_NODE_WIDTH : ℝ  -- #define WIDTH_TO_PED_NODE_WIDTH (31.f/(500.f * 8.f))

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
PathFind_Enum_1 ::= NodeTypeExtern | NodeTypeIntern
  -- val(NodeTypeExtern) = 1
  -- val(NodeTypeIntern) = 2

PathFind_Enum_2 ::= PATH_CAR | PATH_PED
  -- val(PATH_CAR) = 0
  -- val(PATH_PED) = 1

PathFind_Enum_3 ::= SWITCH_OFF | SWITCH_ON
  -- val(SWITCH_OFF) = 0
  -- val(SWITCH_ON) = 1

PathFind_Enum_4 ::= ROUTE_ADD_BLOCKADE | ROUTE_NO_BLOCKADE
  -- val(ROUTE_ADD_BLOCKADE) = 0
  -- val(ROUTE_NO_BLOCKADE) = 1

PathFind_Enum_5 ::= NodeTypeExtern | NodeTypeIntern | UseInRoadBlock | ObjectEastWest
  -- val(NodeTypeExtern) = 1
  -- val(NodeTypeIntern) = 2
  -- val(UseInRoadBlock) = 1
  -- val(ObjectEastWest) = 2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPedPathNode
  bBlockade : 𝔹
  nodeIdX : ℕ
  nodeIdY : ℕ
  id : ℤ
  prev : Ref[CPedPathNode]
  next : Ref[CPedPathNode]
where
  nodeIdX ≥ 0
  nodeIdY ≥ 0
  #prev ≤ 1
  #next ≤ 1
end

schema CPedPath
  instance_addr : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema CPedPath_CalcPedRoute
