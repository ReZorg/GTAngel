  pRadarBlips : ℙ ℕ
  pStoredCam : ℙ ℕ
  pWorld1 : ℙ ℕ
  pEmptyReferences : Ref[CReference]
  pPedAnims : Ref[CStoredDetailedAnimationState]
  pPickups : ℙ ℕ
  pReferences : ℙ ℕ
  BufferStatus : seq ℕ  -- bounded array [NUM_REPLAYBUFFERS]
  bPlayingBackFromFile : 𝔹
  bReplayEnabled : 𝔹
  SlowMotion : ℕ
  FramesActiveLookAroundCam : ℕ
  bDoLoadSceneWhenDone : 𝔹
  WorldPtrList : Ref[CPtrNode]
  BigBuildingPtrList : Ref[CPtrNode]
  PlayerWanted : CWanted
  PlayerInfo : CPlayerInfo
  Time1 : ℕ
  Time2 : ℕ
  Time3 : ℕ
  Time4 : ℕ
  Frame : ℕ
  ClockHours : ℕ
  ClockMinutes : ℕ
  OldWeatherType : ℕ
  NewWeatherType : ℕ
  WeatherInterpolationValue : ℝ
  TimeStepNonClipped : ℝ
  TimeStep : ℝ
  TimeScale : ℝ
  CameraFixedX : ℝ
  CameraFixedY : ℝ
  CameraFixedZ : ℝ
  OldRadioStation : ℤ
  CameraMode : ℤ
  bAllowLookAroundCam : 𝔹
  LoadSceneX : ℝ
  LoadSceneY : ℝ
  LoadSceneZ : ℝ
  CameraFocusX : ℝ
  CameraFocusY : ℝ
  CameraFocusZ : ℝ
  bPlayerInRCBuggy : 𝔹
  fDistanceLookAroundCam : ℝ
  fAlphaAngleLookAroundCam : ℝ
  fBetaAngleLookAroundCam : ℝ
  ms_nNumCivMale_Stored : ℤ
  ms_nNumCivFemale_Stored : ℤ
  ms_nNumCop_Stored : ℤ
  ms_nNumEmergency_Stored : ℤ
  ms_nNumGang1_Stored : ℤ
  ms_nNumGang2_Stored : ℤ
  ms_nNumGang3_Stored : ℤ
  ms_nNumGang4_Stored : ℤ
  ms_nNumGang5_Stored : ℤ
  ms_nNumGang6_Stored : ℤ
  ms_nNumGang7_Stored : ℤ
  ms_nNumGang8_Stored : ℤ
  ms_nNumGang9_Stored : ℤ
  ms_nNumDummy_Stored : ℤ
  ms_nTotalCarPassengerPeds_Stored : ℤ
  ms_nTotalCivPeds_Stored : ℤ
  ms_nTotalGangPeds_Stored : ℤ
  ms_nTotalPeds_Stored : ℤ
  ms_nTotalMissionPeds_Stored : ℤ
  pGarages : ℙ ℕ
  FireArray : Ref[CFire]
  NumOfFires : ℕ
  paProjectileInfo : ℙ ℕ
  paProjectiles : ℙ ℕ
  CurrArea : ℕ
where
  hours ≥ 0
  minutes ≥ 0
  __align ≥ 0
  old_weather ≥ 0
  new_weather ≥ 0
  timer ≥ 0
  index ≥ 0
  mi ≥ 0
  pedtype ≥ 0
  frames ≥ 0
  lifetime ≥ 0
  weapon_model ≥ 0
  health ≥ 0
  acceleration ≥ 0
  #door_angles = 2
  panels ≥ 0
end

