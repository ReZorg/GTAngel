--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CCarAI_FindSwitchDistanceClose
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  result! : ℝ
where
  -- Return postcondition: result! = pVehicle->AutoPilot.m_nSwitchDistance
  true
end

schema CCarAI_FindSwitchDistanceFarNormalVehicle
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  result! : ℝ
where
  -- Return postcondition: result! = FindSwitchDistanceClose(pVehicle) + 5.0f
  true
end

schema CCarAI_FindSwitchDistanceFar
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  result! : ℝ
where
  -- Return postcondition: result! = 50.0f
  -- Return postcondition: result! = FindSwitchDistanceFarNormalVehicle(pVehicle)
  true
end

schema CCarAI_BackToCruisingIfNoWantedLevel
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_nCarMission' = MISSION_CRUISE
  -- State update: pVehicle.AutoPilot.m_nDrivingStyle' = DRIVINGSTYLE_STOP_FOR_CARS
  -- State update: pVehicle.m_bSirenOrAlarm' = false
  -- State update: pVehicle.AutoPilot.m_nCarMission' = MISSION_NONE
  -- Invokes: m_pWanted->GetWantedLevel, CCullZones::NoPolice, CCarCtrl::JoinCarWithRoadSystem
  true
end

schema CCarAI_UpdateCarAI
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = FindPoliceCarSpeedForWantedLevel(pVehicle)
  -- State update: pVehicle.AutoPilot.m_nCarMission' = MISSION_RAMPLAYER_CLOSE
  -- State update: pVehicle.m_bSirenOrAlarm' = true
  -- State update: pVehicle.AutoPilot.m_nTempAction' = TEMPACT_REVERSE
  -- State update: pVehicle.AutoPilot.m_nTimeTempAction' = CTimer::GetTimeInMilliseconds() + 800
  -- State update: pVehicle.AutoPilot.m_nTempAction' = TEMPACT_REVERSE
  -- Invokes: pVehicle->GetStatus, CBridge::ThisIsABridgeObjectMovingUp, m_pCurGroundEntity->GetModelIndex, pVehicle->SetStatus, CTimer::GetFrameCounter
  true
end

schema CCarAI_CarHasReasonToStop
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_nAntiReverseTimer' = CTimer::GetTimeInMilliseconds()
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CCarAI_GetCarToGoToCoors
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  pTarget? : Ref[CVector]
  result! : ℝ
where
  -- State update: pVehicle.AutoPilot.m_nDrivingStyle' = DRIVINGSTYLE_AVOID_CARS
  -- State update: pVehicle.AutoPilot.m_nTempAction' = TEMPACT_NONE
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 20
  -- State update: pVehicle.AutoPilot.m_nAntiReverseTimer' = CTimer::GetTimeInMilliseconds()
  -- Return postcondition: result! = (pVehicle->GetPosition() - *pTarget).Magnitude2D()
  -- Invokes: CTimer::GetTimeInMilliseconds, pVehicle->SetStatus, CCarCtrl::JoinCarWithRoadSystemGotoCoors, pVehicle->GetPosition
  true
end

schema CCarAI_GetCarToParkAtCoors
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  pTarget? : Ref[CVector]
  result! : ℝ
where
  -- State update: pVehicle.bParking' = true
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 10
  -- Return postcondition: result! = (pVehicle->GetPosition() - *pTarget).Magnitude2D()
  -- Invokes: pVehicle->GetPosition
  true
end

schema CCarAI_AddPoliceCarOccupants
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.bOccupantsHaveBeenGenerated' = true
  -- State update: bMiamiViceCop' = true
  -- State update: bMiamiViceCop' = true
  -- State update: MiamiViceCycle' = (CCarCtrl::MiamiViceCycle + 1) % 4
  -- State update: LastTimeMiamiViceGenerated' = CTimer::GetTimeInMilliseconds()
  -- Invokes: pVehicle->GetModelIndex, pVehicle->SetUpDriver, pVehicle->SetupPassenger, m_pWanted->GetWantedLevel, CTimer::GetTimeInMilliseconds
  true
end

schema CCarAI_AddAmbulanceOccupants
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- Invokes: pVehicle->SetUpDriver, pVehicle->SetupPassenger
  true
end

schema CCarAI_AddFiretruckOccupants
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- Invokes: pVehicle->SetUpDriver, pVehicle->SetupPassenger
  true
end

schema CCarAI_TellOccupantsToLeaveCar
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: timer' = 100
  -- State update: m_leaveCarTimer' = timer
  -- Invokes: pDriver->SetObjective, pVehicle->GetModelIndex, pDriver->Say, CGeneral::GetRandomNumberInRange
  true
end

schema CCarAI_TellOccupantsToFleeCar
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: timer' = 100
  -- State update: m_leaveCarTimer' = timer
  -- Invokes: pDriver->IsPlayer, pDriver->SetObjective, pVehicle->GetModelIndex, pDriver->Say, CGeneral::GetRandomNumberInRange
  true
end

schema CCarAI_TellCarToRamOtherCar
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  pTarget? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_pTargetCar' = pTarget
  -- State update: pVehicle.AutoPilot.m_nCarMission' = MISSION_RAMCAR_FARAWAY
  -- State update: pVehicle.bEngineOn' = true
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = Max(6, pVehicle.AutoPilot.m_nCruiseSpeed)
  -- Invokes: pTarget->RegisterReference
  true
end

schema CCarAI_TellCarToBlockOtherCar
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  pTarget? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_pTargetCar' = pTarget
  -- State update: pVehicle.AutoPilot.m_nCarMission' = MISSION_BLOCKCAR_FARAWAY
  -- State update: pVehicle.bEngineOn' = true
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = Max(6, pVehicle.AutoPilot.m_nCruiseSpeed)
  -- Invokes: pTarget->RegisterReference
  true
end

schema CCarAI_FindPoliceCarMissionForWantedLevel
  ΔCCarAI
  result! : ℕ
where
  -- Return postcondition: result! = MISSION_BLOCKPLAYER_FARAWAY
  -- Invokes: m_pWanted->GetWantedLevel, CGeneral::GetRandomNumber
  true
end

schema CCarAI_FindPoliceBoatMissionForWantedLevel
  ΔCCarAI
  result! : ℕ
where
  -- Return postcondition: result! = MISSION_BLOCKPLAYER_FARAWAY
  -- Return postcondition: result! = MISSION_ATTACKPLAYER
  -- Return postcondition: result! = MISSION_BLOCKPLAYER_FARAWAY
  -- Invokes: m_pWanted->GetWantedLevel
  true
end

schema CCarAI_FindPoliceCarSpeedForWantedLevel
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
  result! : ℤ
where
  -- Return postcondition: result! = CGeneral::GetRandomNumberInRange(12, 16)
  -- Return postcondition: result! = 25
  -- Return postcondition: result! = 34
  -- Invokes: m_pWanted->GetWantedLevel, CGeneral::GetRandomNumberInRange
  true
end

schema CCarAI_MellowOutChaseSpeed
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: distanceToPlayer' = (pVehicle.GetPosition() - FindPlayerCoors()).Magnitude()
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 15
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 22
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 25
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 5
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 13
  -- Invokes: m_pWanted->GetWantedLevel, pVehicle->GetPosition
  true
end

schema CCarAI_MellowOutChaseSpeedBoat
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 8
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 10
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 15
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 20
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 25
  -- State update: pVehicle.AutoPilot.m_nCruiseSpeed' = 30
  -- Invokes: m_pWanted->GetWantedLevel
  true
end

schema CCarAI_MakeWayForCarWithSiren
  ΔCCarAI
  pVehicle? : Ref[CVehicle]
where
  -- State update: flatSpeed' = pVehicle.GetMoveSpeed().Magnitude2D()
  -- State update: forward' = pVehicle.GetMoveSpeed() / flatSpeed
  -- State update: projection' = flatSpeed * 45 + 20
  -- State update: vehicle' = CPools::GetVehiclePool().GetSlot(i)
  -- State update: distance' = vehicle.GetPosition() - pVehicle.GetPosition()
  -- State update: correlation' = DotProduct2D(forward, distance) / distance.Magnitude()
  -- Invokes: pVehicle->GetMoveSpeed, CPools::GetVehiclePool, vehicle->IsCar, vehicle->IsBike, vehicle->GetStatus
  true
end
