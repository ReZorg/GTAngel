  -- State update: m_nVehicle' = -1
  -- State update: m_nVehicle2' = -1
  -- State update: m_nCurrentCommand' = MOVIE_NEW_ACTOR
  -- State update: m_nVehiclemodelId' = MI_INFERNUS
  true
end

schema CSceneEdit_InitPlayback
  ΔCSceneEdit
where
  -- State update: m_nVehiclemodelId' = MI_INFERNUS
  -- State update: m_nPedmodelId' = MI_MALE01
  -- State update: m_bCommandActive' = false
  -- State update: m_nNumActors' = 0
  -- State update: m_nNumVehicles' = 0
  -- State update: m_nActor' = -1
