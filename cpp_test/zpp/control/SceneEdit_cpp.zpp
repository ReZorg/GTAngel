  -- State update: m_bEditOn' = true
  -- State update: m_bRecording' = true
  -- State update: m_bCommandActive' = false
  -- Invokes: CPopulation::RemovePed, CWorld::Remove
  true
end

schema CSceneEdit_Update
  ΔCSceneEdit
where
  -- Invokes: TheCamera.TakeControl
  true
end

schema CSceneEdit_Draw
  ΔCSceneEdit
where
  -- State update: nCommandDrawn' = m_nCurrentCommand + i - NUM_COMMANDS_TO_DRAW / 2
  -- Invokes: CFont::SetPropOff, CFont::SetBackgroundOff, CFont::SetScale, CFont::SetCentreOn, CFont::SetRightJustifyOn
  true
end

schema CSceneEdit_ProcessCommand
  ΔCSceneEdit
where
  -- State update: m_nCurrentCommand' = MOVIE_END
  -- State update: m_nCurrentCommand' = MOVIE_NEW_ACTOR
  -- State update: m_bCommandActive' = true
  -- State update: m_bCommandActive' = false
  -- State update: pPed' = new CCivilianPed(PEDTYPE_SPECIAL, m_nPedmodelId)
  -- State update: pPed.CharCreatedBy' = MISSION_CHAR
  -- Invokes: CPad::GetPad, CStreaming::HasModelLoaded, CStreaming::RequestModel, CStreaming::LoadAllRequestedModels, pPed->SetPosition
  true
end

