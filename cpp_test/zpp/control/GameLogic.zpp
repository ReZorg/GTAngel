--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CGameLogic_InitAtStartOfGame
  ΔCGameLogic
where
  -- State update: ActivePlayers' = 1
  -- State update: ShortCutState' = SHORTCUT_NONE
  -- State update: pShortCutTaxi' = ∅
  -- State update: NumAfterDeathStartPoints' = 0
  true
end

schema CGameLogic_PassTime
  ΔCGameLogic
  time? : ℕ
where
  -- State update: minutes' = time + CClock::GetMinutes()
  -- State update: hours' = CClock::GetHours()
  -- State update: days' = CStats::DaysPassed
  -- State update: DaysPassed' = days
  -- Invokes: CClock::GetMinutes, CClock::GetHours, CClock::SetGameClock, CPickups::PassTime
  true
end

schema CGameLogic_SortOutStreamingAndMemory
  ΔCGameLogic
  pos? : CVector
where
  -- Invokes: CTimer::Stop, CStreaming::FlushRequestList, CStreaming::DeleteRwObjectsAfterDeath, CStreaming::RemoveUnusedModelsInLoadedList, CGame::DrasticTidyUpMemory
  true
end

schema CGameLogic_Update
  ΔCGameLogic
where
  -- State update: pScript' = CTheScripts::pActiveScripts
  -- State update: gbTryingPorn4Again' = false
  -- State update: pPlayerInfo' = CWorld::Players[CWorld::PlayerInFocus]
  -- State update: pPlayerInfo.m_WBState' = WBSTATE_PLAYING
  -- State update: pPlayerInfo.m_bGetOutOfHospitalFree' = false
  -- State update: pPlayerInfo.m_nMoney' = Max(0, pPlayerInfo.m_nMoney - 100)
  -- Invokes: CGeneral::faststricmp, CCutsceneMgr::IsCutsceneProcessing, m_pPed->ClearAdrenaline, pPlayerInfo.KillPlayer, pPlayerInfo.ArrestPlayer
  true
end
