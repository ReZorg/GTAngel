  field_2 : 𝔹
  m_bClosingWithoutTargetCar : 𝔹
  m_bDeactivated : 𝔹
  m_bResprayHappened : 𝔹
  m_nTargetModelIndex : ℤ
  m_pDoor1 : Ref[CEntity]
  m_pDoor2 : Ref[CEntity]
  m_bDoor1PoolIndex : ℕ
  m_bDoor2PoolIndex : ℕ
  m_bDoor1IsDummy : 𝔹
  m_bDoor2IsDummy : 𝔹
  m_bRecreateDoorOnNextRefresh : 𝔹
  m_bRotatedDoor : 𝔹
  m_bCameraFollowsPlayer : 𝔹
  m_vecCorner1 : CVector2D
  m_fInfZ : ℝ
  m_vDir1 : CVector2D
  m_vDir2 : CVector2D
  m_fSupZ : ℝ
  m_vecSSGaragePos : CVector
  m_fSSGarageAngle : ℝ
  m_fDir1Len : ℝ
  m_fDir2Len : ℝ
  m_fInfX : ℝ
  m_fSupX : ℝ
  m_fInfY : ℝ
  m_fSupY : ℝ
  m_nTimeCrusherCraneActivated : ℕ
  m_pSSTargetCar : Ref[CVehicle]
  m_fDoorPos : ℝ
  m_fDoorHeight : ℝ
  m_fDoor1X : ℝ
  m_fDoor1Y : ℝ
  m_fDoor2X : ℝ
  m_fDoor2Y : ℝ
  m_fDoor1Z : ℝ
  m_fDoor2Z : ℝ
  m_nTimeToStartAction : ℕ
  m_bCollectedCarsState : ℕ
  m_pTarget : Ref[CVehicle]
  m_sStoredCar : CStoredCar
  m_bInitialized : 𝔹
  m_bLocked : 𝔹
  m_nSSGarageState : 𝔹
  m_bSSGarageStateChanging : 𝔹
  m_fX2 : ℝ
  m_fY1 : ℝ
  m_fY2 : ℝ
  m_fZ1 : ℝ
  m_fZ2 : ℝ
  field_96 : ADDRESS
where
  m_eGarageType ≥ 0
  m_eGarageState ≥ 0
  m_nMaxStoredCars ≥ 0
  #m_pDoor1 ≤ 1
  #m_pDoor2 ≤ 1
  m_bDoor1PoolIndex ≥ 0
  m_bDoor2PoolIndex ≥ 0
  m_nTimeCrusherCraneActivated ≥ 0
  #m_pSSTargetCar ≤ 1
  m_nTimeToStartAction ≥ 0
  m_bCollectedCarsState ≥ 0
  #m_pTarget ≤ 1
end

