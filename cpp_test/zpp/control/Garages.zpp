Garages_Enum_4 ::= FLAG_BULLETPROOF | FLAG_FIREPROOF | FLAG_EXPLOSIONPROOF | FLAG_COLLISIONPROOF | FLAG_MELEEPROOF | FLAG_TIRES_INVULNERABLE | FLAG_STRONG | FLAG_HEAVY | FLAG_PERMANENT_COLOUR | FLAG_BOMB | FLAG_NOT_DAMAGED_UPSIDEDOWN | FLAG_REWARD_VEHICLE
  -- val(FLAG_BULLETPROOF) = 0x1
