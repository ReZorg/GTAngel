schema CSceneEdit_SelectActor
  ΔCSceneEdit
where
  -- State update: m_bActorSelected' = false
  -- State update: m_nActor' = NUM_ACTORS_IN_MOVIE - 1
  -- State update: pPed' = pActors[m_nActor]
  -- State update: Source' = pPed.GetPosition() - m_vecCamHeading
  -- State update: m_nActor' = 0
  -- State update: pPed' = pActors[m_nActor]
  -- Invokes: CPad::GetPad, pPed->GetPosition
  true
end

