-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema SceneEdit_NextValidModelId
  ΔSceneEditModuleState
  mi? : ℤ
  step? : ℤ
  result! : ℤ
where
  -- State update: step' = -step
  -- State update: pInfo' = CModelInfo::GetModelInfo(i)
  -- State update: pVehicleInfo' = (CVehicleModelInfo*)pInfo
  -- Return postcondition: result! = result
  -- Invokes: CModelInfo::GetModelInfo, pInfo->GetModelType
  true
end

schema CSceneEdit_LoadMovie
  ΔCSceneEdit
where
  -- State update: fid' = CFileMgr::OpenFile("movie.dat", "r")
  -- State update: m_bCommandActive' = false
  -- Invokes: CFileMgr::SetDir, CFileMgr::OpenFile, CFileMgr::Read, CFileMgr::CloseFile
  true
end

schema CSceneEdit_SaveMovie
  ΔCSceneEdit
where
  -- State update: fid' = CFileMgr::OpenFileForWriting("movie.dat")
  -- State update: m_bCommandActive' = false
  -- Invokes: CFileMgr::SetDir, CFileMgr::OpenFileForWriting, CFileMgr::Write, CFileMgr::CloseFile
  true
end

