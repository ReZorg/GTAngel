  -- State update: dist2' = Distance2D(m_pathNodes[node2].GetPosition(), x, y)
  -- State update: f2' = Abs(d1)/(Abs(d1) + Abs(d2))
  -- State update: f1' = 1.0f - f2
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  -- Invokes: CGeneral::GetRandomNumber, dist2d.Normalise
  true
end

