schema CPedPath_CalcPedRoute
  ΔCPedPath
  pathType? : ℤ
  position? : CVector
  destination? : CVector
  pointPoses? : Ref[CVector]
  pointsFound? : ℙ ℤ
  maxPoints? : ℤ
where
  -- State update: pointsFound' = 0
  -- State update: vecDistance' = destination - position
  -- State update: vecPos' = (position + destination) * 0.5f
  -- State update: nodeStartX' = (position.x - vecSectorStartPos.x) / 0.7f
  -- State update: nodeStartY' = (position.y - vecSectorStartPos.y) / 0.7f
  -- State update: nodeEndX' = (destination.x - vecSectorStartPos.x) / 0.7f
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Invokes: CWorld::AdvanceCurrentScanCode, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::GetSector
  true
end

