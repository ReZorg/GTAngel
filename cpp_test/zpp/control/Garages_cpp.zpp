--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CGarages_Init
  ΔCGarages
where
  -- State update: CrushedCarId' = -1
  -- State update: NumGarages' = 0
  -- State update: MessageEndTime' = 0
  -- State update: MessageStartTime' = 0
  -- State update: PlayerInGarage' = false
  -- State update: BombsAreFree' = false
  -- Invokes: DMAudio.CreateEntity, DMAudio.SetEntityStatus
  true
end

schema CGarages_Shutdown
  ΔCGarages
where
  -- State update: NumGarages' = 0
  -- State update: hGarages' = AEHANDLE_NONE
  -- Invokes: DMAudio.DestroyEntity
  true
end

schema CGarages_Update
  ΔCGarages
where
  -- State update: GarageToBeTidied' = 0
  -- State update: bCamShouldBeOutisde' = false
  -- State update: TheCamera.pToGarageWeAreIn' = ∅
  -- State update: GarageToBeTidied' = 0
  -- State update: pGarage' = &aGarages[NumGarages]
  -- State update: pGarage.m_fInfX' = Min(Min(Min(X1, X2), X3), X2 + X3 - X1)
  -- Return postcondition: result! = NumGarages++
  -- Return postcondition: result! = NumGarages++
  -- Return postcondition: result! = pGarage->m_fDoorHeight > 0.0f
  -- Invokes: CReplay::IsPlayingBack, CTimer::GetFrameCounter, CGarages::AddOne, m_vDir1.Magnitude, m_vDir2.Magnitude
  true
end

