where
  -- Declared member operation CPhoneInfo::SetPhoneMessage_Repeatedly(int phoneId, wchar *msg1, wchar *msg2, wchar *msg3, wchar *msg4, wchar *msg5, wchar *msg6)
  true
end

schema CPhoneInfo_GrabPhone_9
  ΔCPhoneInfo
  arg_1? : ℝ
  arg_2? : ℝ
  result! : ℤ
where
  -- Declared member operation CPhoneInfo::GrabPhone(float, float)
  true
