--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Phones_isPhoneAvailable
  ΔPhonesModuleState
  m_phoneId? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPhoneInfo_Update
  ΔCPhoneInfo
where
  -- State update: player' = FindPlayerPed()
  -- State update: playerInfo' = &CWorld::Players[CWorld::PlayerInFocus]
  -- State update: pPhoneDisplayingMessages' = ∅
  -- State update: bDisplayingPhoneMessage' = false
  -- State update: notInCar' = false
  -- State update: playerPos' = FindPlayerVehicle().GetPosition()
  -- Invokes: CReplay::IsPlayingBack, CTimer::GetTimeInMilliseconds, playerInfo->MakePlayerSafe, TheCamera.SetWideScreenOff, player->GetClump
  true
end

schema CPhoneInfo_FindNearestFreePhone
  ΔCPhoneInfo
  pos? : Ref[CVector]
where
  -- State update: nearestPhoneId' = -1
  -- State update: nearestPhoneDist' = 60.0f
  -- State update: phoneId' = 0
  -- State update: phoneDist' = (m_aPhones[phoneId].m_vecPos - *pos).Magnitude2D()
  -- State update: nearestPhoneDist' = phoneDist
  -- State update: nearestPhoneId' = phoneId
  -- Return postcondition: result! = nearestPhoneId
  true
end

schema CPhoneInfo_PhoneAtThisPosition
  ΔCPhoneInfo
  pos? : CVector
where
  -- State update: phoneId' = 0
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  true
end

schema CPhoneInfo_HasMessageBeenDisplayed
  ΔCPhoneInfo
  phoneId? : ℤ
where
  -- State update: state' = m_aPhones[phoneId].m_nState
  -- Return postcondition: result! = false
  true
end

schema CPhoneInfo_IsMessageBeingDisplayed
  ΔCPhoneInfo
  phoneId? : ℤ
where
  -- Return postcondition: result! = pPhoneDisplayingMessages == &m_aPhones[phoneId]
  true
end

schema Phones_LoadPhone
  ΔPhonesModuleState
  phone? : CPhone
  buf? : ℙ ℕ
where
  -- State update: phone.m_pEntity' = (CEntity*)(uintptr)tmp
  true
end

schema CPhoneInfo_Load
  ΔCPhoneInfo
  buf? : ℙ ℕ
  size? : ℕ
where
  -- State update: m_nMax' = Min(NUMPHONES, max)
  -- State update: m_nScriptPhonesMax' = 0
  -- State update: ignoreOtherPhones' = false
  -- State update: ignoreOtherPhones' = true
  -- State update: ignoreOtherPhones' = true
  -- State update: m_nMax' = max
  -- Invokes: CPools::GetBuildingPool
  true
end

schema CPhoneInfo_SetPhoneMessage_JustOnce
  ΔCPhoneInfo
  phoneId? : ℤ
  msg1? : seq CHAR
  msg2? : seq CHAR
  msg3? : seq CHAR
  msg4? : seq CHAR
  msg5? : seq CHAR
  msg6? : seq CHAR
where
  -- State update: m_nState' = PHONE_STATE_ONETIME_MESSAGE_SET
  -- State update: m_nState' = PHONE_STATE_MESSAGE_REMOVED
  true
end

schema CPhoneInfo_SetPhoneMessage_Repeatedly
  ΔCPhoneInfo
  phoneId? : ℤ
  msg1? : seq CHAR
  msg2? : seq CHAR
  msg3? : seq CHAR
  msg4? : seq CHAR
  msg5? : seq CHAR
  msg6? : seq CHAR
where
  -- State update: m_nState' = PHONE_STATE_REPEATED_MESSAGE_SET
  -- State update: m_nState' = PHONE_STATE_MESSAGE_REMOVED
  true
end

schema CPhoneInfo_SwapPhone
  ΔCPhoneInfo
  xPos? : ℝ
  yPos? : ℝ
  into? : ℤ
where
  -- State update: nearestPhoneId' = -1
  -- State update: nearestPhoneDist' = 1.0f
  -- State update: phoneId' = m_nScriptPhonesMax
  -- State update: phoneDistance' = (m_aPhones[phoneId].m_vecPos - pos).Magnitude2D()
  -- State update: nearestPhoneDist' = phoneDistance
  -- State update: nearestPhoneId' = phoneId
  true
end

schema CPhoneInfo_GrabPhone
  ΔCPhoneInfo
  xPos? : ℝ
  yPos? : ℝ
where
  -- State update: nearestPhoneId' = -1
  -- State update: nearestPhoneDist' = 100.0f
  -- State update: phoneId' = m_nScriptPhonesMax
  -- State update: phoneDistance' = (m_aPhones[phoneId].m_vecPos - pos).Magnitude2D()
  -- State update: nearestPhoneDist' = phoneDistance
  -- State update: nearestPhoneId' = phoneId
  -- Return postcondition: result! = m_nScriptPhonesMax - 1
  true
end

schema CPhoneInfo_Initialise
  ΔCPhoneInfo
where
  -- State update: pool' = CPools::GetBuildingPool()
  -- State update: pCallBackPed' = ∅
  -- State update: bDisplayingPhoneMessage' = false
  -- State update: bPickingUpPhone' = false
  -- State update: pPhoneDisplayingMessages' = ∅
  -- State update: m_nMax' = 0
  -- Invokes: CPools::GetBuildingPool, pool->GetSize, pool->GetSlot, building->GetModelIndex, building->GetPosition
  true
end

schema CPhoneInfo_Save
  ΔCPhoneInfo
  buf? : ℙ ℕ
  size? : ℙ ℕ
where
  -- State update: size' = PHONEINFO_SAVE_SIZE
  -- State update: phoneId' = 0
  -- State update: phoneId' = 0
  -- State update: phone' = WriteSaveBuf(buf, m_aPhones[phoneId])
  -- State update: m_nMax' = 0
  -- State update: m_nScriptPhonesMax' = 0
  -- Invokes: CPools::GetBuildingPool, CPhoneInfo::Shutdown, CPad::GetPad, ped->SetPedState, CMessages::AddMessage
  true
end

schema Phones_CPhone
  ΔPhonesModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

