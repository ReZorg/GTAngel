--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: GameLogic (control)
-- Source File(s): control/GameLogic.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
GameLogic_Enum_1 ::= SHORTCUT_NONE | SHORTCUT_INIT | SHORTCUT_IDLE | SHORTCUT_GETTING_IN | SHORTCUT_TRANSITION | SHORTCUT_ARRIVING | SHORTCUT_GETTING_OUT
  -- val(SHORTCUT_NONE) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CGameLogic
  ActivePlayers : ℕ
  ShortCutState : ℕ
  pShortCutTaxi : Ref[CAutomobile]
  NumAfterDeathStartPoints : ℕ
  ShortCutStart : CVector
  ShortCutStartOrientation : ℝ
  ShortCutDestination : CVector
  ShortCutDestinationOrientation : ℝ
  ShortCutTimer : ℕ
  AfterDeathStartPoints : seq CVector  -- bounded array [NUM_SHORTCUT_START_POINTS]
  AfterDeathStartPointOrientation : seq ℝ  -- bounded array [NUM_SHORTCUT_START_POINTS]
  ShortCutDropOffForMission : CVector
  ShortCutDropOffOrientationForMission : ℝ
  MissionDropOffReadyToBeUsed : 𝔹
  mStoredPlayerOutfit : seq CHAR
where
  ActivePlayers ≥ 0
  ShortCutState ≥ 0
  #pShortCutTaxi ≤ 1
  NumAfterDeathStartPoints ≥ 0
  ShortCutTimer ≥ 0
  #mStoredPlayerOutfit = 8
end

schema CGameLogic_InitAtStartOfGame
  ΔCGameLogic
where
  -- Declared member operation CGameLogic::InitAtStartOfGame()
  true
end

