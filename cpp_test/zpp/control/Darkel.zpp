--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
FRENZY_ANY_PED : seq CHAR  -- #define FRENZY_ANY_PED -1
FRENZY_ANY_CAR : seq CHAR  -- #define FRENZY_ANY_CAR -2
DARKEL_COUNTER_HEIGHT : ℝ  -- #define DARKEL_COUNTER_HEIGHT 143.0f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Darkel_Enum_1 ::= KILLFRENZY_NONE | KILLFRENZY_ONGOING | KILLFRENZY_PASSED | KILLFRENZY_FAILED

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CDarkel
  TimeLimit : ℤ
  PreviousTime : ℤ
  TimeOfFrenzyStart : ℤ
  WeaponType : ℤ
  AmmoInterruptedWeapon : ℤ
  KillsNeeded : ℤ
  InterruptedWeaponType : ℤ
  InterruptedWeaponSelected : ℤ
  bStandardSoundAndMessages : 𝔹
  bNeedHeadShot : 𝔹
  bProperKillFrenzy : 𝔹
  Status : ℕ
  RegisteredKills : seq ℕ  -- bounded array [NUM_DEFAULT_MODELS]
  ModelToKill : ℤ
  ModelToKill2 : ℤ
  ModelToKill3 : ℤ
  ModelToKill4 : ℤ
  pStartMessage : seq CHAR
  InterruptedWeapon : ℤ
where
  Status ≥ 0
end

schema CDarkel_CalcFade
  ΔCDarkel
  time? : ℕ
  min? : ℕ
  max? : ℕ
  result! : ℕ
where
  -- Declared member operation CDarkel::CalcFade(uint32 time, uint32 min, uint32 max)
  true
end

