schema CTheScripts
  ScriptSpace : ℙ ℕ
  ScriptsArray : seq CRunningScript  -- bounded array [MAX_NUM_SCRIPTS]
  IntroTextLines : seq ℤ  -- bounded array [MAX_NUM_INTRO_TEXT_LINES]
  IntroRectangles : seq ℤ  -- bounded array [MAX_NUM_INTRO_RECTANGLES]
  ScriptSprites : seq CSprite2d  -- bounded array [MAX_NUM_SCRIPT_SRPITES]
  ScriptSphereArray : seq script_sphere_struct  -- bounded array [MAX_NUM_SCRIPT_SPHERES]
  CollectiveArray : seq tCollectiveData  -- bounded array [MAX_NUM_COLLECTIVES]
  UsedObjectArray : seq tUsedObject  -- bounded array [MAX_NUM_USED_OBJECTS]
  MultiScriptArray : seq ℤ  -- bounded array [MAX_NUM_MISSION_SCRIPTS]
  BuildingSwapArray : seq tBuildingSwap  -- bounded array [MAX_NUM_BUILDING_SWAPS]
  InvisibilitySettingArray : seq Ref[CEntity]  -- bounded array [MAX_NUM_INVISIBILITY_SETTINGS]
  aStoredLines : seq CStoredLine  -- bounded array [MAX_NUM_STORED_LINES]
  DbgFlag : 𝔹
  OnAMissionFlag : ℕ
  MissionCleanUp : CMissionCleanup
  StuckCars : CStuckCarCheck
  UpsideDownCars : CUpsideDownCarCheck
  StoreVehicleIndex : ℤ
  StoreVehicleWasRandom : 𝔹
  pIdleScripts : Ref[CRunningScript]
  pActiveScripts : Ref[CRunningScript]
  NextFreeCollectiveIndex : ℤ
  LastRandomPedId : ℤ
  NumberOfUsedObjects : ℕ
  bAlreadyRunningAMissionScript : 𝔹
  bUsingAMultiScriptFile : 𝔹
  NumberOfMissionScripts : ℕ
  LargestMissionScriptSize : ℕ
  MainScriptSize : ℕ
  FailCurrentMission : ℕ
  NumScriptDebugLines : ℕ
  NumberOfIntroRectanglesThisFrame : ℕ
  NumberOfIntroTextLinesThisFrame : ℕ
  UseTextCommands : ℕ
  CommandsExecuted : ℕ
  ScriptsUpdated : ℕ
  LastMissionPassedTime : ℕ
  NumberOfExclusiveMissionScripts : ℕ
  bPlayerIsInTheStatium : 𝔹
  RiotIntensity : ℕ
  bPlayerHasMetDebbieHarry : 𝔹
  AllowedCollision : seq ℤ  -- bounded array [MAX_ALLOWED_COLLISIONS]
  SavedVarIndices : ℙ ℕ
  NumSaveVars : ℤ
  FSDestroyedFlag : ℤ
  NextProcessId : ℤ
  InTheScripts : 𝔹
  pCurrent : Ref[CRunningScript]
  NumTrueGlobals : ℕ
  MostGlobals : ℕ
  mCoronas : base__cSList_script_corona
  NextScriptCoronaID : ℤ
  retval : return
  text : return
  CardStackPosition : ℤ
  BaseBriefIdForContact : seq ℤ  -- bounded array [MAX_NUM_CONTACTS]
  OnAMissionForContactFlag : seq ℤ  -- bounded array [MAX_NUM_CONTACTS]
  CountdownToMakePlayerUnsafe : ℕ
  DelayMakingPlayerUnsafeThisTime : ℕ
where
  #ScriptSpace ≤ 1
  OnAMissionFlag ≥ 0
  #pIdleScripts ≤ 1
  #pActiveScripts ≤ 1
  NumberOfUsedObjects ≥ 0
  NumberOfMissionScripts ≥ 0
  LargestMissionScriptSize ≥ 0
  MainScriptSize ≥ 0
  FailCurrentMission ≥ 0
  NumScriptDebugLines ≥ 0
  NumberOfIntroRectanglesThisFrame ≥ 0
  NumberOfIntroTextLinesThisFrame ≥ 0
  UseTextCommands ≥ 0
  CommandsExecuted ≥ 0
  ScriptsUpdated ≥ 0
  LastMissionPassedTime ≥ 0
end

