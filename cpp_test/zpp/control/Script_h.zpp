--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
PICKUP_PLACEMENT_OFFSET : ℝ  -- #define PICKUP_PLACEMENT_OFFSET (0.5f)
PED_FIND_Z_OFFSET : ℝ  -- #define PED_FIND_Z_OFFSET (5.0f)
COP_PED_FIND_Z_OFFSET : ℝ  -- #define COP_PED_FIND_Z_OFFSET (10.0f)
UPSIDEDOWN_UP_THRESHOLD : ℝ  -- #define UPSIDEDOWN_UP_THRESHOLD (-0.97f)
UPSIDEDOWN_MOVE_SPEED_THRESHOLD : ℝ  -- #define UPSIDEDOWN_MOVE_SPEED_THRESHOLD (0.01f)
UPSIDEDOWN_TURN_SPEED_THRESHOLD : ℝ  -- #define UPSIDEDOWN_TURN_SPEED_THRESHOLD (0.02f)
UPSIDEDOWN_TIMER_THRESHOLD : seq CHAR  -- #define UPSIDEDOWN_TIMER_THRESHOLD (1000)
SPHERE_MARKER_R : seq CHAR  -- #define SPHERE_MARKER_R (255)
SPHERE_MARKER_G : seq CHAR  -- #define SPHERE_MARKER_G (255)
SPHERE_MARKER_B : seq CHAR  -- #define SPHERE_MARKER_B (128)
SPHERE_MARKER_A : seq CHAR  -- #define SPHERE_MARKER_A (228)
SPHERE_MARKER_PULSE_PERIOD : ℕ  -- #define SPHERE_MARKER_PULSE_PERIOD 2048
SPHERE_MARKER_PULSE_FRACTION : ℝ  -- #define SPHERE_MARKER_PULSE_FRACTION 0.1f
MILES_IN_METER : ℝ  -- #define MILES_IN_METER (0.000621371192f)
METERS_IN_FOOT : ℝ  -- #define METERS_IN_FOOT (0.3048f)
FEET_IN_METER : ℝ  -- #define FEET_IN_METER (3.28084f)
KEY_LENGTH_IN_SCRIPT : seq CHAR  -- #define KEY_LENGTH_IN_SCRIPT (8)
GTA_SCRIPT_COLLECTIVE : seq CHAR  -- #define GTA_SCRIPT_COLLECTIVE struct intro_script_rectangle
CARDS_IN_SUIT : seq CHAR  -- #define CARDS_IN_SUIT (13)
NUM_SUITS : seq CHAR  -- #define NUM_SUITS (4)
MAX_DECKS : seq CHAR  -- #define MAX_DECKS (6)
CARDS_IN_DECK : seq CHAR  -- #define CARDS_IN_DECK (CARDS_IN_SUIT * NUM_SUITS)
CARDS_IN_STACK : seq CHAR  -- #define CARDS_IN_STACK (CARDS_IN_DECK * MAX_DECKS)

