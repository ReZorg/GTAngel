schema Script_UpdateCompareFlag
  ΔScriptModuleState
  flag? : 𝔹
where
  -- State update: flag' = !flag
  -- State update: m_bCondResult' = flag
  -- State update: m_nAndOrState' = ANDOR_NONE
  -- State update: m_nAndOrState' = ANDOR_NONE
  true
end

schema Script_LimitAngleOnCircle
  ΔScriptModuleState
  angle? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = angle < 0.0f ? angle + 360.0f : angle
  true
end

schema Script_ThisIsAValidRandomPed
  ΔScriptModuleState
  pedtype? : ℕ
  result! : 𝔹
where
  -- State update: loaddata' = false)
  -- State update: DbgFlag' = !DbgFlag
  -- State update: retval' = ScriptSpace[*pIp + 1] << 8 | ScriptSpace[*pIp]
  -- State update: retval' = ScriptSpace[*pIp]
  -- State update: text' = TheText.Get((const char*)&CTheScripts::ScriptSpace[*pIp])
  -- State update: tmp' = 3
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Return postcondition: result! = DbgFlag
  -- Invokes: CTheScripts::GetSizeOfVariableSpace, TheText.Get
  true
end
