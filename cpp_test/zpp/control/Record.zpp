--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MEMORY_FOR_GAME_RECORD : seq CHAR  -- #define MEMORY_FOR_GAME_RECORD (150000)
CHASE_SCENE_LENGTH_IN_SECONDS : seq CHAR  -- #define CHASE_SCENE_LENGTH_IN_SECONDS (80)
CHASE_SCENE_FRAMES_PER_SECOND : seq CHAR  -- #define CHASE_SCENE_FRAMES_PER_SECOND (15)
CHASE_SCENE_FRAMES_IN_RECORDING : seq CHAR  -- #define CHASE_SCENE_FRAMES_IN_RECORDING (CHASE_SCENE_LENGTH_IN_SECONDS * CHASE_SCENE_FRAMES_PER_SECOND)
CHASE_SCENE_LENGTH_IN_FRAMES : seq CHAR  -- #define CHASE_SCENE_LENGTH_IN_FRAMES (CHASE_SCENE_FRAMES_IN_RECORDING * 2)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Record_Enum_1 ::= NUM_CHASE_CARS
  -- val(NUM_CHASE_CARS) = 20

Record_Enum_2 ::= STATE_NONE | STATE_RECORD | STATE_PLAYBACK_INIT | STATE_PLAYBACK | STATE_PLAYBACK_BEFORE_RECORDING
  -- val(STATE_NONE) = 0
  -- val(STATE_RECORD) = 1
  -- val(STATE_PLAYBACK_INIT) = 2
  -- val(STATE_PLAYBACK) = 3
  -- val(STATE_PLAYBACK_BEFORE_RECORDING) = 4

Record_Enum_3 ::= STATE_NONE | STATE_RECORD | STATE_PLAYBACK
  -- val(STATE_NONE) = 0
  -- val(STATE_RECORD) = 1
  -- val(STATE_PLAYBACK) = 2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tCoors
  pos : CVector
  angle : ℝ
where
  instance_addr ∈ ADDRESS
end

schema CCarStateEachFrame
  velX : ℤ
  velY : ℤ
  velZ : ℤ
  rightX : ℤ
  rightY : ℤ
  rightZ : ℤ
  forwardX : ℤ
  forwardY : ℤ
  forwardZ : ℤ
  wheel : ℤ
  gas : ℤ
  brake : ℤ
  handbrake : 𝔹
  pos : CVector
where
  instance_addr ∈ ADDRESS
end

schema CRecordDataForChase
  Status : ℕ
  PositionChanges : ℤ
  CurrentCar : ℕ
  AnimTime : ℝ
  AnimStartTime : ℕ
  pBaseMemForCar : seq Ref[CCarStateEachFrame]  -- bounded array [NUM_CHASE_CARS]
  TimeMultiplier : ℝ
  FId2 : ℤ
where
  Status ≥ 0
  CurrentCar ≥ 0
  AnimStartTime ≥ 0
end

