schema tGameBuffer
  m_fTimeStep : ℝ
  m_nTimeInMilliseconds : ℕ
  m_nSizeOfPads : seq ℕ  -- bounded array [2]
  m_nChecksum : ℕ
  m_ControllerBuffer : seq ℕ  -- bounded array [116]
where
  m_nTimeInMilliseconds ≥ 0
  #m_nSizeOfPads = 2
  m_nChecksum ≥ 0
  #m_ControllerBuffer = 116
end

schema CRecordDataForGame
  RecordingState : ℕ
  pDataBuffer : ℙ ℕ
  pDataBufferPointer : ℙ ℕ
  FId : ℤ
  pDataBufferForFrame : tGameBuffer
where
  RecordingState ≥ 0
  #pDataBuffer ≤ 1
  #pDataBufferPointer ≤ 1
end

