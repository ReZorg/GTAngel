--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CRecordDataForGame_Init
  ΔCRecordDataForGame
where
  -- State update: RecordingState' = STATE_NONE
  -- State update: pDataBufferPointer' = ∅
  -- State update: pDataBuffer' = ∅
  -- State update: FId' = CFileMgr::OpenFile("playback.dat", "r")
  -- State update: RecordingState' = STATE_NONE
  -- State update: FId' = CFileMgr::OpenFileForWriting("record.dat")
  -- Invokes: CFileMgr::OpenFile, CFileMgr::CloseFile, CFileMgr::OpenFileForWriting, CFileMgr::Read
  true
end

schema CRecordDataForGame_SaveOrRetrieveDataForThisFrame
  ΔCRecordDataForGame
where
  -- State update: pDataBufferForFrame.m_fTimeStep' = CTimer::GetTimeStep()
  -- State update: pDataBufferForFrame.m_nChecksum' = CalcGameChecksum()
  -- State update: pEndPtr' = pController2
  -- State update: pData' = (tGameBuffer*)pDataBufferPointer
  -- State update: size1' = pData.m_nSizeOfPads[0]
  -- State update: size2' = pData.m_nSizeOfPads[1]
  -- Invokes: CTimer::GetTimeStep, CTimer::GetTimeInMilliseconds, CPad::GetPad, CFileMgr::Write, NewState.Clear
  true
end

schema CRecordDataForGame_PackCurrentPadValues
  ΔCRecordDataForGame
  buf? : ℙ ℕ
  os? : Ref[CControllerState]
  ns? : Ref[CControllerState]
  result! : ℙ ℕ
where
  -- Return postcondition: result! = buf
  true
end

schema CRecordDataForGame_UnPackCurrentPadValues
  ΔCRecordDataForGame
  buf? : ℙ ℕ
  total? : ℕ
  state? : Ref[CControllerState]
  result! : ℙ ℕ
where
  -- Return postcondition: result! = buf
  true
end

schema CRecordDataForGame_CalcGameChecksum
  ΔCRecordDataForGame
  result! : ℕ
where
  -- State update: checksum' = 0
  -- State update: pPed' = CPools::GetPedPool().GetSlot(i)
  -- State update: pVehicle' = CPools::GetVehiclePool().GetSlot(i)
  -- Return postcondition: result! = checksum ^ checksum >> 16
  -- Invokes: CPools::GetPedPool, pPed->GetModelIndex, pPed->GetPosition, CPools::GetVehiclePool, pVehicle->GetModelIndex
  true
end

schema CRecordDataForChase_Init
  ΔCRecordDataForChase
where
  -- State update: Status' = STATE_NONE
