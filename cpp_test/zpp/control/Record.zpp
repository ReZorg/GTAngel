schema CRecordDataForChase_SaveOrRetrieveDataForThisFrame
  ΔCRecordDataForChase
where
  -- State update: fid' = CFileMgr::OpenFileForWriting(gString)
  -- State update: fs' = CHASE_SCENE_LENGTH_IN_FRAMES * sizeof(CCarStateEachFrame)
  -- State update: fid2' = CFileMgr::OpenFileForWriting(gString)
  -- State update: pState' = pBaseMemForCar[CurrentCar]
  -- State update: pState' = (CCarStateEachFrame*)pChaseCars[CurrentCar]
  -- State update: up' = CrossProduct(right, forward)
  -- Invokes: CTimer::GetFrameCounter, CFileMgr::SetDir, CFileMgr::OpenFileForWriting, CFileMgr::Write, CFileMgr::CloseFile
  true
end

schema CRecordDataForChase_SaveOrRetrieveCarPositions
  ΔCRecordDataForChase
where
  -- State update: Status' = STATE_RECORD
  -- State update: Status' = STATE_PLAYBACK
  -- State update: FlooredEOFTime' = EndOfFrameTime
  -- State update: dp' = EndOfFrameTime - FlooredEOFTime
  -- Invokes: CTimer::GetFrameCounter, CPad::GetPad, CTimer::GetTimeStepNonClippedInSeconds, tmp.GetRight, tmp.GetForward
  true
end

schema CRecordDataForChase_StoreInfoForCar
  ΔCRecordDataForChase
  pCar? : Ref[CAutomobile]
  pState? : Ref[CCarStateEachFrame]
where
  -- State update: pState.rightX' = INT8_MAX * pCar.GetRight().x
  -- State update: pState.rightY' = INT8_MAX * pCar.GetRight().y
  -- State update: pState.rightZ' = INT8_MAX * pCar.GetRight().z
  -- State update: pState.forwardX' = INT8_MAX * pCar.GetForward().x
  -- State update: pState.forwardY' = INT8_MAX * pCar.GetForward().y
  -- State update: pState.forwardZ' = INT8_MAX * pCar.GetForward().z
  -- Invokes: pCar->GetRight, pCar->GetForward, pCar->GetPosition, pCar->GetMoveSpeed
  true
end

