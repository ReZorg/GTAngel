  phoneId? : ℤ
  msg1? : seq CHAR
  msg2? : seq CHAR
  msg3? : seq CHAR
  msg4? : seq CHAR
  msg5? : seq CHAR
  msg6? : seq CHAR
where
  -- Declared member operation CPhoneInfo::SetPhoneMessage_JustOnce(int phoneId, wchar *msg1, wchar *msg2, wchar *msg3, wchar *msg4, wchar *msg5, wchar *msg6)
  true
