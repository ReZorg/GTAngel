--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
PhoneState ::= PHONE_STATE_FREE | PHONE_STATE_REPORTING_CRIME | PHONE_STATE_2 | PHONE_STATE_MESSAGE_REMOVED | PHONE_STATE_ONETIME_MESSAGE_SET | PHONE_STATE_REPEATED_MESSAGE_SET | PHONE_STATE_REPEATED_MESSAGE_SHOWN_ONCE | PHONE_STATE_ONETIME_MESSAGE_STARTED | PHONE_STATE_REPEATED_MESSAGE_STARTED | PHONE_STATE_9

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPhone
  m_vecPos : CVector
  m_apMessages : seq CHAR
  m_repeatedMessagePickupStart : ℕ
  m_pEntity : Ref[CEntity]
  m_nState : PhoneState
  m_visibleToCam : 𝔹
where
  #m_apMessages = 6
  m_repeatedMessagePickupStart ≥ 0
  #m_pEntity ≤ 1
end

schema CPhone_CPhone
  ΔCPhone
where
  -- Declared member operation CPhone::CPhone()
  true
end

schema CPhoneInfo
  bDisplayingPhoneMessage : 𝔹
  PhoneEnableControlsTimer : ℕ
  pPhoneDisplayingMessages : Ref[CPhone]
  bPickingUpPhone : 𝔹
  pCallBackPed : Ref[CPed]
  m_nMax : ℤ
  m_nScriptPhonesMax : ℤ
  m_aPhones : seq CPhone  -- bounded array [NUMPHONES]
where
  PhoneEnableControlsTimer ≥ 0
  #pPhoneDisplayingMessages ≤ 1
  #pCallBackPed ≤ 1
end

schema CPhoneInfo_CPhoneInfo
  ΔCPhoneInfo
where
  -- Declared member operation CPhoneInfo::CPhoneInfo()
  true
end

schema CPhoneInfo_PhoneAtThisPosition_2
  ΔCPhoneInfo
  arg_1? : CVector
  result! : 𝔹
where
  -- Declared member operation CPhoneInfo::PhoneAtThisPosition(CVector)
  true
end

