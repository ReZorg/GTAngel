--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
GAME_SPEED_TO_METERS_PER_SECOND : ℝ  -- #define GAME_SPEED_TO_METERS_PER_SECOND 50.0f
METERS_PER_SECOND_TO_GAME_SPEED : ℝ  -- #define METERS_PER_SECOND_TO_GAME_SPEED (1.0f / GAME_SPEED_TO_METERS_PER_SECOND)
GAME_SPEED_TO_CARAI_SPEED : ℝ  -- #define GAME_SPEED_TO_CARAI_SPEED 60.0f
TIME_COPS_WAIT_TO_EXIT_AFTER_STOPPING : ℕ  -- #define TIME_COPS_WAIT_TO_EXIT_AFTER_STOPPING 2500
FIX_PATHFIND_BUG : seq CHAR  -- #define FIX_PATHFIND_BUG class CCarCtrl
LANE_WIDTH : ℝ  -- #define LANE_WIDTH 5.0f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
CarCtrl_Enum_1 ::= MAX_CARS_TO_KEEP | MAX_CAR_MODELS_IN_ARRAY
  -- val(MAX_CARS_TO_KEEP) = 2
  -- val(MAX_CAR_MODELS_IN_ARRAY) = 25

CarCtrl_Enum_2 ::= TOTAL_MULTIPLAYER_CAR_BANKS | CARS_IN_MULTIPLAYER_BANK
  -- val(TOTAL_MULTIPLAYER_CAR_BANKS) = 3
  -- val(CARS_IN_MULTIPLAYER_BANK) = 8

eCarClass ::= NORMAL | POOR | RICH | EXEC | WORKER | BIG | TAXI | MOPED | MOTORBIKE | LEISUREBOAT | WORKERBOAT | COPS | CUBAN | HAITIAN | STREET | DIAZ | BIKER | SECURITY | PLAYER | GOLFERS | GANG9 | COPS_BOAT | FIRST_CAR_RATING | FIRST_BOAT_RATING | FIRST_GANG_CAR_RATING | NUM_CAR_CLASSES | NUM_BOAT_CLASSES | NUM_GANG_CAR_CLASSES | TOTAL_CUSTOM_CLASSES
  -- val(NORMAL) = 0
  -- val(FIRST_CAR_RATING) = NORMAL
  -- val(FIRST_BOAT_RATING) = LEISUREBOAT

CarCtrl_Enum_4 ::= MAX_CARS_TO_KEEP | MAX_CAR_MODELS_IN_ARRAY
  -- val(MAX_CARS_TO_KEEP) = 2
  -- val(MAX_CAR_MODELS_IN_ARRAY) = 256

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CCarCtrl
  NumLawEnforcerCars : ℤ
  NumAmbulancesOnDuty : ℤ
  NumFiretrucksOnDuty : ℤ
  NumRandomCars : ℤ
  NumMissionCars : ℤ
  NumParkedCars : ℤ
  NumPermanentCars : ℤ
  bCarsGeneratedAroundCamera : 𝔹
  CarDensityMultiplier : ℝ
  CountDownToCarsAtStart : ℤ
  MaxNumberOfCarsInUse : ℤ
  LastTimeLawEnforcerCreated : ℕ
  LastTimeFireTruckCreated : ℕ
  LastTimeAmbulanceCreated : ℕ
  TotalNumOfCarsOfRating : seq ℤ  -- bounded array [TOTAL_CUSTOM_CLASSES]
  MiamiViceCycle : ℤ
  LastTimeMiamiViceGenerated : ℕ
  NumRequestsOfCarRating : seq ℤ  -- bounded array [TOTAL_CUSTOM_CLASSES]
  NumOfLoadedCarsOfRating : seq ℤ  -- bounded array [TOTAL_CUSTOM_CLASSES]
  scriptControlsMpCarLimit : 𝔹
  angle : return
  NextCarOfRating : seq ℤ  -- bounded array [TOTAL_CUSTOM_CLASSES]
where
  LastTimeLawEnforcerCreated ≥ 0
  LastTimeFireTruckCreated ≥ 0
  LastTimeAmbulanceCreated ≥ 0
  LastTimeMiamiViceGenerated ≥ 0
end

