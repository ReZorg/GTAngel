schema CarCtrl_GetPositionAlongCurrentCurve
  ΔCarCtrlModuleState
  pVehicle? : Ref[CVehicle]
  result! : ℝ
where
  -- Return postcondition: result! = (float)timeInCurve / pVehicle->AutoPilot.m_nTimeToSpendOnCurrentCurve
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

