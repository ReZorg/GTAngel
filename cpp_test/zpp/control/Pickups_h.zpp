schema tPickupMessage
  m_pos : CVector2D
  m_weaponType : eWeaponType
  m_dist : CVector2D
  m_color : CRGBA
  m_bOutOfStock : ℕ
  m_quantity : ℕ
  money : ℕ
where
  m_bOutOfStock ≥ 0
  m_quantity ≥ 0
  money ≥ 0
end

schema CPickups
  aPickUpsCollected : seq ℤ  -- bounded array [NUMCOLLECTEDPICKUPS]
  CollectedPickUpIndex : ℤ
  NumMessages : ℤ
  aMessages : seq tPickupMessage  -- bounded array [NUMPICKUPMESSAGES]
  PlayerOnWeaponPickup : ℤ
  aPickUps : seq CPickup  -- bounded array [NUMPICKUPS]
  bPickUpcamActivated : 𝔹
  pPlayerVehicle : Ref[CVehicle]
  StaticCamCoors : CVector
  StaticCamStartTime : ℕ
where
  #pPlayerVehicle ≤ 1
  StaticCamStartTime ≥ 0
end

