--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
ePickupType ::= PICKUP_NONE | PICKUP_IN_SHOP | PICKUP_ON_STREET | PICKUP_ONCE | PICKUP_ONCE_TIMEOUT | PICKUP_ONCE_TIMEOUT_SLOW | PICKUP_COLLECTABLE1 | PICKUP_IN_SHOP_OUT_OF_STOCK | PICKUP_MONEY | PICKUP_MINE_INACTIVE | PICKUP_MINE_ARMED | PICKUP_NAUTICAL_MINE_INACTIVE | PICKUP_NAUTICAL_MINE_ARMED | PICKUP_FLOATINGPACKAGE | PICKUP_FLOATINGPACKAGE_FLOATING | PICKUP_ON_STREET_SLOW | PICKUP_ASSET_REVENUE | PICKUP_PROPERTY_LOCKED | PICKUP_PROPERTY_FORSALE | PICKUP_NUMOFTYPES
  -- val(PICKUP_NONE) = 0

ePacmanPickupType ::= PACMAN_NONE | PACMAN_SCRAMBLE | PACMAN_RACE

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPickup
  m_vecPos : CVector
  m_fRevenue : ℝ
  m_pObject : Ref[CObject]
  m_pExtraObject : Ref[CObject]
  m_nQuantity : ℕ
  m_nTimer : ℕ
  m_nMoneySpeed : ℕ
  m_eModelIndex : ℤ
  m_nIndex : ℕ
  m_sTextKey : seq CHAR
  m_eType : ℕ
  m_bRemoved : 𝔹
  m_bWasAmmoCollected : 𝔹
  m_bWasControlMessageShown : 𝔹
where
  #m_pObject ≤ 1
  #m_pExtraObject ≤ 1
  m_nQuantity ≥ 0
  m_nTimer ≥ 0
  m_nMoneySpeed ≥ 0
  m_nIndex ≥ 0
  #m_sTextKey = 8
  m_eType ≥ 0
  #m_bWasAmmoCollected = 1
  #m_bWasControlMessageShown = 1
end

