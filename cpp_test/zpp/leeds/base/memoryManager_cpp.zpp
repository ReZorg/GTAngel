--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema cMemoryManager_cMemoryManager
  ΔcMemoryManager
where
  -- Deterministic transition preserving module invariants
  true
end

schema cMemoryManager_Allocate
  ΔcMemoryManager
  size? : ℕ
  result! : ADDRESS
where
  -- State update: buf' = malloc(size)
  -- Return postcondition: result! = buf
  true
end

schema cMemoryManager_AllocateAligned
  ΔcMemoryManager
  size? : ℕ
  result! : ADDRESS
where
  -- State update: buf' = malloc(size)
  -- Return postcondition: result! = buf
  true
end

schema cMemoryManager_Realloc
  ΔcMemoryManager
  buf? : ADDRESS
  newSize? : ℕ
  unk? : 𝔹
  result! : ADDRESS
where
  -- Return postcondition: result! = realloc(buf, newSize)
  true
end

schema cMemoryManager_Free
  ΔcMemoryManager
  buf? : ADDRESS
where
  -- Deterministic transition preserving module invariants
  true
end

schema cMemoryManager_IsFree
  ΔcMemoryManager
  buf? : ADDRESS
  result! : 𝔹
where
  -- Return postcondition: result! = buf == nil
  true
end

schema cMainMemoryManager_cMainMemoryManager
  ΔcMainMemoryManager
where
  -- State update: m_pInstance' = this
  true
end

schema cMainMemoryManager_Init
  ΔcMainMemoryManager
  arg_1? : ADDRESS
  arg_2? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema memoryManager_operator_new
  ΔmemoryManagerModuleState
  size? : ℕ
  result! : ADDRESS
where
  -- Return postcondition: result! = base::cMainMemoryManager::Instance()->Allocate(size)
  -- Invokes: cMainMemoryManager::Instance
  true
end

schema memoryManager_operator_new_2
  ΔmemoryManagerModuleState
  size? : ℕ
  result! : ADDRESS
where
  -- Return postcondition: result! = base::cMainMemoryManager::Instance()->Allocate(size)
  -- Invokes: cMainMemoryManager::Instance
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema memoryManagerModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 75
end
