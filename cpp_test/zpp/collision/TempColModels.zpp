schema CTempColModels
  ms_colModelPed1 : CColModel
  ms_colModelBBox : CColModel
  ms_colModelWeapon : CColModel
  ms_colModelPed2 : CColModel
  ms_colModelBumper1 : CColModel
  ms_colModelWheel1 : CColModel
  ms_colModelPanel1 : CColModel
  ms_colModelBodyPart2 : CColModel
  ms_colModelBodyPart1 : CColModel
  ms_colModelCutObj : seq CColModel  -- bounded array [10]
  ms_colModelPedGroundHit : CColModel
  ms_colModelBoot1 : CColModel
  ms_colModelDoor1 : CColModel
  ms_colModelBonnet1 : CColModel
  ms_colModelFerryDocked : CColModel
where
  #ms_colModelCutObj = 10
end

schema CTempColModels_Initialise
  ΔCTempColModels
where
  -- Declared member operation CTempColModels::Initialise(void)
  true
end

