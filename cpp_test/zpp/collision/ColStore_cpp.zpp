--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema ColChunkEntry
  modelId : ℤ
  colModel : Ref[CColModel]
where
  #colModel ≤ 1
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ColStore_LevelPos
  ΔColStoreModuleState
  level? : eLevelName
where
  -- Return postcondition: result! = pos[level]
  true
end

schema ColStore_PosLevel
  ΔColStoreModuleState
  pos? : CVector
where
  -- State update: lastPlayerLevel' = LEVEL_INDUSTRIAL
  -- State update: lastOtherLevel' = LEVEL_INDUSTRIAL
  -- State update: lastPlayerLevel' = CGame::currLevel
  -- State update: lvl' = CTheZones::GetLevelFromPosition(&pos)
  -- State update: lastOtherLevel' = lvl
  -- Return postcondition: result! = lastPlayerLevel
  -- Return postcondition: result! = lastOtherLevel
  -- Invokes: CTheZones::GetLevelFromPosition
  true
end

schema CColStore_Initialise
  ΔCColStore
where
  -- State update: ms_pColPool' = new CPool<ColDef,ColDef>(COLSTORESIZE, "CollisionFiles")
  -- Invokes: VarConsole.Add
  true
end

schema CColStore_Shutdown
  ΔCColStore
where
  -- State update: ms_pColPool' = ∅
  true
end

schema CColStore_AddColSlot
  ΔCColStore
  name? : seq CHAR
where
  -- State update: def' = ms_pColPool.New()
  -- State update: def.isLoaded' = false
  -- State update: def.unused' = 0
  -- State update: def.bounds.left' = 1000000.0f
  -- State update: def.bounds.top' = 1000000.0f
  -- State update: def.bounds.right' = -1000000.0f
  -- Return postcondition: result! = ms_pColPool->GetJustIndex(def)
  -- Invokes: ms_pColPool->New, ms_pColPool->GetJustIndex
  true
end

schema CColStore_RemoveColSlot
  ΔCColStore
  slot? : ℤ
where
  -- Invokes: ms_pColPool->Delete
  true
end

schema CColStore_FindColSlot
  ΔCColStore
  name? : seq CHAR
where
  -- State update: size' = ms_pColPool.GetSize()
  -- State update: def' = GetSlot(i)
  -- Return postcondition: result! = i
  -- Return postcondition: result! = -1
  -- Invokes: ms_pColPool->GetSize, CGeneral::faststricmp
  true
end

schema CColStore_GetColName
  ΔCColStore
  slot? : ℤ
where
  -- Return postcondition: result! = GetSlot(slot)->name
  true
end

