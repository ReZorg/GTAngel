schema CColSphere_IntersectRay
  ΔCColSphere
  from? : CVector
  dir? : CVector
  entry? : CVector
  exit? : CVector
where
  -- State update: distToCenter' = from - center
  -- State update: distToTouchSqr' = distToCenter.MagnitudeSqr() - sq(radius)
  -- State update: entry' = from + dir * root1
  -- State update: exit' = from + dir * root2
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: distToCenter.MagnitudeSqr, CGeneral::SolveQuadratic
  true
end

