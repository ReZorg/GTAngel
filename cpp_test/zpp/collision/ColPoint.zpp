schema CColPoint_operator
  ΔCColPoint
  other? : ℤ
where
  -- State update: point' = other.point
  -- State update: normal' = other.normal
  -- State update: surfaceA' = other.surfaceA
  -- State update: pieceA' = other.pieceA
  -- State update: surfaceB' = other.surfaceB
  -- State update: pieceB' = other.pieceB
  -- Return postcondition: result! = *this
  true
end

schema ColPoint_GetDepth
  ΔColPointModuleState
  result! : ℝ
where
  -- Return postcondition: result! = depth
  true
end

schema ColPoint_Set
  ΔColPointModuleState
  depth? : ℝ
  surfA? : ℕ
  pieceA? : ℕ
  surfB? : ℕ
  pieceB? : ℕ
where
  -- State update: depth' = depth
  -- State update: surfaceA' = surfA
  -- State update: pieceA' = pieceA
  -- State update: surfaceB' = surfB
  -- State update: pieceB' = pieceB
  true
end

schema ColPoint_Set_2
  ΔColPointModuleState
