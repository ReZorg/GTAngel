schema CColPoint
  point : CVector
  pad1 : ℤ
  normal : CVector
  pad2 : ℤ
  surfaceA : ℕ
  pieceA : ℕ
  surfaceB : ℕ
  pieceB : ℕ
  depth : ℝ
where
  surfaceA ≥ 0
  pieceA ≥ 0
  surfaceB ≥ 0
  pieceB ≥ 0
end

schema CColPoint_GetNormal
  ΔCColPoint
  result! : CVector
where
  -- Declared member operation CColPoint::GetNormal()
  true
end

schema CColPoint_GetDepth_2
  ΔCColPoint
  result! : ℝ
where
  -- Declared member operation CColPoint::GetDepth()
  true
end

