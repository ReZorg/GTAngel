schema CCollision_DistToLine
  ΔCCollision
  l0? : Ref[CVector]
  l1? : Ref[CVector]
  point? : Ref[CVector]
where
  -- State update: lensq' = (*l1 - *l0).MagnitudeSqr()
  -- State update: dot' = DotProduct(*point - *l0, *l1 - *l0)
  -- State update: distSqr' = (*point - *l0).MagnitudeSqr() - dot * dot / lensq
  -- Return postcondition: result! = (*point - *l0).Magnitude()
  -- Return postcondition: result! = (*point - *l1).Magnitude()
  -- Return postcondition: result! = 0.f
  true
end

schema CCollision_DistToLine_2
  ΔCCollision
  l0? : Ref[CVector]
  l1? : Ref[CVector]
  point? : Ref[CVector]
  closest? : CVector
where
  -- State update: lensq' = (*l1 - *l0).MagnitudeSqr()
  -- State update: dot' = DotProduct(*point - *l0, *l1 - *l0)
  -- State update: closest' = *l0
  -- State update: closest' = *l1
  -- State update: closest' = *l0 + (*l1 - *l0)*(dot/lensq)
  -- Return postcondition: result! = (*point - closest).Magnitude()
  true
end

