schema CCollision_TestLineSphere
  ΔCCollision
  line? : CColLine
  sph? : CColSphere
where
  -- State update: v01' = line.p1 - line.p0
  -- State update: v0c' = sph.center - line.p0
  -- State update: linesq' = v01.MagnitudeSqr()
  -- State update: projline' = -2.0f * DotProduct(v01, v0c)
  -- State update: diffsq' = projline*projline - tansq
  -- State update: f' = (-projline - Sqrt(diffsq)) / (2.0f*linesq)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = f >= 0.0f && f <= 1.0f
  -- Invokes: v01.MagnitudeSqr, p0.MagnitudeSqr
  true
end

