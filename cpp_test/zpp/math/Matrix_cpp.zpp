where
  -- State update: this' = *this * rhs
  -- Return postcondition: result! = *this
  true
end

schema CMatrix_Reorthogonalise
  ΔCMatrix
where
  -- State update: r' = GetRight()
  -- State update: f' = GetForward()
  -- State update: u' = GetUp()
  -- State update: u' = CrossProduct(r, f)
  -- State update: r' = CrossProduct(f, u)
  -- State update: f' = CrossProduct(u, r)
  -- Invokes: u.Normalise, r.Normalise
  true
end

schema Matrix_operator
  ΔMatrixModuleState
  m1? : CMatrix
  m2? : CMatrix
where
  -- State update: out.rx' = m1.rx * m2.rx + m1.fx * m2.ry + m1.ux * m2.rz
  -- State update: out.ry' = m1.ry * m2.rx + m1.fy * m2.ry + m1.uy * m2.rz
  -- State update: out.rz' = m1.rz * m2.rx + m1.fz * m2.ry + m1.uz * m2.rz
  -- State update: out.fx' = m1.rx * m2.fx + m1.fx * m2.fy + m1.ux * m2.fz
  -- State update: out.fy' = m1.ry * m2.fx + m1.fy * m2.fy + m1.uy * m2.fz
  -- State update: out.fz' = m1.rz * m2.fx + m1.fz * m2.fy + m1.uz * m2.fz
  -- Return postcondition: result! = out
  true
end

schema Matrix_Invert
  ΔMatrixModuleState
  src? : CMatrix
  dst? : CMatrix
where
  -- Return postcondition: result! = dst
  true
end

schema Matrix_Invert_2
  ΔMatrixModuleState
  matrix? : CMatrix
where
  -- Return postcondition: result! = Invert(matrix, inv)
  true
end

schema CCompressedMatrixNotAligned_CompressFromFullMatrix
  ΔCCompressedMatrixNotAligned
  other? : CMatrix
where
  -- State update: m_rightX' = 127.0f * other.GetRight().x
  -- State update: m_rightY' = 127.0f * other.GetRight().y
  -- State update: m_rightZ' = 127.0f * other.GetRight().z
  -- State update: m_upX' = 127.0f * other.GetForward().x
  -- State update: m_upY' = 127.0f * other.GetForward().y
  -- State update: m_upZ' = 127.0f * other.GetForward().z
  -- Invokes: other.GetRight, other.GetForward, other.GetPosition
  true
end

schema CCompressedMatrixNotAligned_DecompressIntoFullMatrix
  ΔCCompressedMatrixNotAligned
  other? : CMatrix
where
  -- State update: x' = m_rightX / 127.0f
  -- State update: y' = m_rightY / 127.0f
  -- State update: z' = m_rightZ / 127.0f
  -- State update: x' = m_upX / 127.0f
  -- State update: y' = m_upY / 127.0f
  -- State update: z' = m_upZ / 127.0f
  -- Invokes: other.GetRight, other.GetForward, other.GetUp, other.GetPosition, other.Reorthogonalise
  true
end

schema CMatrix_CopyToRwMatrix
  ΔCMatrix
  matrix? : Ref[RwMatrix]
where
  -- State update: matrix.right' = GetRight()
  -- State update: matrix.up' = GetForward()
  -- State update: matrix.at' = GetUp()
  -- State update: matrix.pos' = GetPosition()
  true
end

