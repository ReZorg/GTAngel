--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Vector_CVector
  ΔVectorModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Vector_CVector_2
  ΔVectorModuleState
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: x' = x
  -- State update: y' = y
  -- State update: z' = z
  true
end

schema Vector_CVector_3
  ΔVectorModuleState
  v? : RwV3d
where
  -- State update: x' = v.x
  -- State update: y' = v.y
  -- State update: z' = v.z
  true
end

schema Vector_Heading
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = x == 0.0f && y == 0.0f ? 0.0f : Atan2(-x, y)
  true
end

schema Vector_Magnitude
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = Sqrt(x*x + y*y + z*z)
  true
end

schema Vector_MagnitudeSqr
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = x*x + y*y + z*z
  true
end

schema Vector_Magnitude2D
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = Sqrt(x*x + y*y)
  true
end

schema Vector_MagnitudeSqr2D
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = x*x + y*y
  true
end

schema Vector_Normalise2D
  ΔVectorModuleState
where
  -- State update: sq' = MagnitudeSqr2D()
  -- State update: invsqrt' = RecipSqrt(sq)
  true
end

schema Vector_operator
  ΞVectorModuleState
  result! : CVector
where
  -- Return postcondition: result! = CVector(-x, -y, -z)
  true
end

schema Vector_operator_2
  ΞVectorModuleState
  right? : CVector
  result! : 𝔹
where
  -- Return postcondition: result! = x == right.x && y == right.y && z == right.z
  true
end

schema Vector_operator_3
  ΞVectorModuleState
  right? : CVector
  result! : 𝔹
where
  -- Return postcondition: result! = x != right.x || y != right.y || z != right.z
  true
end

schema Vector_IsZero
  ΞVectorModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = x == 0.0f && y == 0.0f && z == 0.0f
  true
end

schema Vector_Heading_2
  ΞVectorModuleState
  result! : ℝ
where
  -- Return postcondition: result! = Atan2(-x, y)
  true
end

schema Vector_operator_4
  ΔVectorModuleState
  right? : CVector
  result! : 𝔹
where
  -- State update: x' = v2.x - v1.x
  -- State update: y' = v2.y - v1.y
  -- Return postcondition: result! = CVector(left.x + right.x, left.y + right.y, left.z + right.z)
  -- Return postcondition: result! = CVector(left.x - right.x, left.y - right.y, left.z - right.z)
  -- Return postcondition: result! = CVector(left.x * right, left.y * right, left.z * right)
  true
end
