schema CCompressedMatrix
  CCompressedMatrixNotAligned  -- inherits base schema
  _alignment : ℤ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Matrix_CMatrix
  ΔMatrixModuleState
  scale? : ℝ
where
  -- State update: m_attachment' = ∅
  -- State update: m_hasRwMatrix' = false
  true
end

schema Matrix_SetTranslate
  ΔMatrixModuleState
  trans? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_Translate
  ΔMatrixModuleState
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_Translate_2
  ΔMatrixModuleState
  trans? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_Scale
  ΔMatrixModuleState
  scale? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_Scale_2
  ΔMatrixModuleState
  sx? : ℝ
  sy? : ℝ
  sz? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_SetTranslateOnly
  ΔMatrixModuleState
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: px' = x
  -- State update: py' = y
  -- State update: pz' = z
  true
end

schema Matrix_SetTranslateOnly_2
  ΔMatrixModuleState
  pos? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_CheckIntegrity
  ΔMatrixModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Matrix_MultiplyInverse
  ΔMatrixModuleState
  mat? : CMatrix
  vec? : CVector
  result! : CVector
where
  -- Deterministic transition preserving module invariants
  true
end
