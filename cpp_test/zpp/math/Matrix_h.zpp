schema CCompressedMatrixNotAligned
  m_vecPos : CVector
  m_rightX : ℤ
  m_rightY : ℤ
  m_rightZ : ℤ
  m_upX : ℤ
  m_upY : ℤ
  m_upZ : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CCompressedMatrixNotAligned_CompressFromFullMatrix
  ΔCCompressedMatrixNotAligned
  other? : CMatrix
where
  -- Declared member operation CCompressedMatrixNotAligned::CompressFromFullMatrix(CMatrix &other)
  true
end

