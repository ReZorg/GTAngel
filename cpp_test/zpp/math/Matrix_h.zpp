--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Matrix (math)
-- Source File(s): math/Matrix.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CMatrix
  m_attachment : Ref[RwMatrix]
  fz : ℝ
  m_hasRwMatrix : 𝔹
  uw : ℝ
  pw : ℝ
  fw : ℝ
where
  #m_attachment ≤ 1
end

schema CMatrix_CMatrix
  ΔCMatrix
  m? : CMatrix
where
  -- Declared member operation CMatrix::CMatrix(CMatrix const &m)
  true
end

schema CMatrix_CMatrix_2
  ΔCMatrix
  matrix? : Ref[RwMatrix]
  owner? : 𝔹
where
  -- Declared member operation CMatrix::CMatrix(RwMatrix *matrix, bool owner = false)
  true
end

