--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: screendroplets (extras)
-- Source File(s): extras/screendroplets.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
screendroplets_Enum_1 ::= MAXDROPS | MAXDROPSMOVING
  -- val(MAXDROPS) = 2000
  -- val(MAXDROPSMOVING) = 700

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema ScreenDroplets
  lifetime : ℝ
  color : CRGBA
  active : 𝔹
  fades : 𝔹
  dist : ℝ
  ms_initialised : ℤ
  ms_maskTex : Ref[RwTexture]
  ms_screenTex : Ref[RwTexture]
  ms_enabled : 𝔹
  ms_movingEnabled : 𝔹
  ms_drops : seq ScreenDrop  -- bounded array [MAXDROPS]
  ms_numDrops : ℤ
  ms_dropsMoving : seq ScreenDropMoving  -- bounded array [MAXDROPSMOVING]
  ms_numDropsMoving : ℤ
  ms_prevCamUp : CVector
  ms_prevCamPos : CVector
  ms_camMoveDelta : CVector
  ms_camMoveDist : ℝ
  ms_screenMoveDelta : CVector
  ms_screenMoveDist : ℝ
  ms_camUpAngle : ℝ
  ms_splashDuration : ℤ
  ms_splashObject : Ref[CParticleObject]
where
  #ms_maskTex ≤ 1
  #ms_screenTex ≤ 1
  #ms_splashObject ≤ 1
end

schema ScreenDroplets_Fade
  ΔScreenDroplets
where
  -- Declared member operation ScreenDroplets::Fade(void)
  true
end

schema ScreenDroplets_Initialise_2
  ΔScreenDroplets
where
  -- Declared member operation ScreenDroplets::Initialise(void)
  true
end

