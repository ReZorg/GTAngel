  ΔScreenDroplets
  x? : ℝ
  y? : ℝ
  size? : ℝ
  lifetime? : ℝ
  fades? : 𝔹
  r? : ℤ
  g? : ℤ
  b? : ℤ
  result! : Ref[ScreenDrop]
where
  -- Declared member operation ScreenDroplets::NewDrop(float x, float y, float size, float lifetime, bool fades, int r = 255, int g = 255, int b = 255)
  true
end

schema ScreenDroplets_SetMoving_10
  ΔScreenDroplets
  drop? : Ref[ScreenDroplets__ScreenDrop]
where
  -- Declared member operation ScreenDroplets::SetMoving(ScreenDroplets::ScreenDrop *drop)
  true
