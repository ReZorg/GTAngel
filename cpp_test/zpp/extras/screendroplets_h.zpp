schema ScreenDrop
  time : ℝ
  lifetime : ℝ
  color : CRGBA
  active : 𝔹
  fades : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema ScreenDrop_Fade
  ΔScreenDrop
where
  -- Declared member operation ScreenDrop::Fade(void)
  true
end

schema ScreenDropMoving
  drop : Ref[ScreenDrop]
  dist : ℝ
where
  #drop ≤ 1
end
