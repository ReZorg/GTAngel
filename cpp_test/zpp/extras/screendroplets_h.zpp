  ΔScreenDroplets
  drop? : Ref[ScreenDrop]
where
  -- Declared member operation ScreenDroplets::AddToRenderList(ScreenDrop *drop)
  true
end

schema ScreenDroplets_Clear_8
  ΔScreenDroplets
where
  -- Declared member operation ScreenDroplets::Clear(void)
  true
