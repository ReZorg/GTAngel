[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
glossMult : seq CHAR  -- #define glossMult (u_reflProps.x)

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema neoGloss_main
  ΔneoGlossModuleState
where
  -- State update: color' = texture(tex0, vec2(v_tex0.x, 1.0-v_tex0.y))
  -- State update: v' = 2.0*v_light-1.0
  -- State update: s' = dot(n, v)
  -- State update: color' = s*s*s*s*s*s*s*s*color*v_fog*glossMult
  true
end

schema neoGloss_main_2
  ΔneoGlossModuleState
where
  -- State update: Vertex' = u_world * vec4(in_pos, 1.0)
  -- State update: gl_Position' = u_proj * u_view * Vertex
  -- State update: Normal' = mat3(u_world) * in_normal
  -- State update: v_tex0' = in_tex0
  -- State update: viewVec' = normalize(u_eye - Vertex.xyz)
  -- State update: Light' = normalize(viewVec - u_lightDirection[0].xyz)
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema neoGlossModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 51
end
