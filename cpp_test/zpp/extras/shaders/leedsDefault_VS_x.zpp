--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include standardConstants.zpp  (from "standardConstants.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema VS_in
  POSITION : ℝ
  NORMAL : ℝ
  TEXCOORD0 : ℝ
  COLOR0 : ℝ
  BLENDINDICES : ℤ
where
  instance_addr ∈ ADDRESS
end

schema VS_out
  POSITION : ℝ
  TEXCOORD0 : ℝ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema leedsDefault_VS_x_main
  ΔleedsDefault_VS_xModuleState
  input? : in_VS_in
  result! : VS_out
where
  -- State update: SkinVertex' = float3(0.0, 0.0, 0.0)
  -- State update: SkinNormal' = float3(0.0, 0.0, 0.0)
  -- State update: output.Position' = mul(combinedMat, SkinVertex)
  -- State update: N' = mul(normalMat, SkinNormal)
  -- State update: output.Position' = mul(combinedMat, input.Position)
  -- State update: N' = mul(normalMat, input.Normal)
  -- Return postcondition: result! = output
  true
end
