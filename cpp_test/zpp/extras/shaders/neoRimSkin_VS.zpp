--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include standardConstants.zpp  (from "standardConstants.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema VS_in
  POSITION : ℝ
  NORMAL : ℝ
  TEXCOORD0 : ℝ
  COLOR0 : ℝ
  BLENDWEIGHT : ℝ
  BLENDINDICES : ℤ
where
  instance_addr ∈ ADDRESS
end

schema VS_out
  POSITION : ℝ
  TEXCOORD0 : ℝ
  COLOR0 : ℝ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema neoRimSkin_VS_main
  ΔneoRimSkin_VSModuleState
  input? : in_VS_in
  result! : VS_out
where
  -- State update: SkinVertex' = float3(0.0, 0.0, 0.0)
  -- State update: SkinNormal' = float3(0.0, 0.0, 0.0)
  -- State update: output.Position' = mul(combinedMat, float4(SkinVertex, 1.0))
  -- State update: Vertex' = mul(worldMat, float4(SkinVertex, 1.0)).xyz
  -- State update: Normal' = mul(normalMat, SkinNormal)
  -- State update: output.TexCoord0.xy' = input.TexCoord
  -- Return postcondition: result! = output
  true
end
