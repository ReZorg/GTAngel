schema frontendoption_FrontendOptionAddSelect
  ΔfrontendoptionModuleState
  gxtKey? : seq CHAR
  rightTexts? : seq CHAR
  numRightTexts? : ℤ
  var? : ℙ ℤ
  onlyApplyOnEnter? : 𝔹
  changeFunc? : ChangeFunc
  saveCat? : seq CHAR
  saveKey? : seq CHAR
  disableIfGameLoaded? : 𝔹
where
  -- State update: screenOptionOrder' = RegisterNewOption()
  -- State update: option' = aScreens[currentMenu].m_aEntries[screenOptionOrder]
  -- State update: option.m_Action' = MENUACTION_CFO_SELECT
  -- State update: option.m_CFOSelect' = new CCFOSelect()
  -- State update: option.m_CFOSelect.rightTexts' = (char**)malloc(numRightTexts * sizeof(char*))
  -- State update: option.m_CFOSelect.numRightTexts' = numRightTexts
  true
end

