-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema frontendoption_ChangeScreen
  ΔfrontendoptionModuleState
  screen? : ℤ
  option? : ℤ
  fadeIn? : 𝔹
where
  -- State update: FrontEndMenuManager.m_nPrevScreen' = FrontEndMenuManager.m_nCurrScreen
  -- State update: FrontEndMenuManager.m_nCurrScreen' = screen
  -- State update: FrontEndMenuManager.m_nCurrOption' = option
  -- State update: FrontEndMenuManager.m_nMenuFadeAlpha' = 0
  true
end

schema frontendoption_GoBack
  ΔfrontendoptionModuleState
  fadeIn? : 𝔹
where
  -- State update: option' = FrontEndMenuManager.GetPreviousPageOption()
  -- Invokes: FrontEndMenuManager.GetPreviousPageOption, FrontEndMenuManager.ThingsToDoBeforeGoingBack
  true
end

schema frontendoption_GetNumberOfMenuOptions
  ΔfrontendoptionModuleState
  screen? : ℤ
where
  -- State update: Rows' = 0
  -- Return postcondition: result! = Rows
  true
end

schema frontendoption_GetLastMenuScreen
  ΔfrontendoptionModuleState
where
  -- State update: page' = -1
  -- Return postcondition: result! = page
  true
end

schema frontendoption_RegisterNewScreen
  ΔfrontendoptionModuleState
  name? : seq CHAR
  prevPage? : ℤ
  returnPrevPageFunc? : ReturnPrevPageFunc
  result! : ℤ
where
  -- State update: lastOgScreen' = GetLastMenuScreen()
  -- State update: id' = lastOgScreen + numCustomFrontendScreens
  -- State update: returnPrevPageFunc' = returnPrevPageFunc
  -- Return postcondition: result! = id
  true
end

schema frontendoption_RegisterNewOption
  ΔfrontendoptionModuleState
  result! : ℤ
where
  -- State update: numOptions' = GetNumberOfMenuOptions(currentMenu)
  -- State update: curIdx' = numOptions + optionCursor + 1
  -- State update: curIdx' = optionCursor
  -- Return postcondition: result! = curIdx
  true
end

schema frontendoption_FrontendOptionSetCursor
  ΔfrontendoptionModuleState
  screen? : ℤ
  option? : ℤ
  overwrite? : 𝔹
where
  -- State update: currentMenu' = screen
  -- State update: optionCursor' = option
  -- State update: optionOverwrite' = overwrite
  true
end

