schema VsLight
  color : rw__RGBAf
  pos : seq ℝ  -- bounded array [4]
  dir : rw__V3d
  power : ℝ
where
  #pos = 4
end

schema BuildingInst
  combinedMat : rw__RawMatrix
  instHeader : Ref[rw__d3d9__InstanceDataHeader]
  fadeAlpha : ℕ
  lighting : 𝔹
where
  #instHeader ≤ 1
  fadeAlpha ≥ 0
end

