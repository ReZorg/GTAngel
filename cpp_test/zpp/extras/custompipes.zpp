--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema custompipes_CustomMatCtor
  ΔcustompipesModuleState
  object? : ADDRESS
  arg_2? : ℤ
  arg_3? : ℤ
where
  -- State update: ext' = GetCustomMatExt((rw::Material*)object)
  -- State update: ext.glossTex' = ∅
  -- State update: ext.haveGloss' = false
  -- Return postcondition: result! = object
  true
end

schema custompipes_CustomMatCopy
  ΔcustompipesModuleState
  dst? : ADDRESS
  src? : ADDRESS
  arg_3? : ℤ
  arg_4? : ℤ
where
  -- State update: srcext' = GetCustomMatExt((rw::Material*)src)
  -- State update: dstext' = GetCustomMatExt((rw::Material*)dst)
  -- State update: dstext.glossTex' = srcext.glossTex
  -- State update: dstext.haveGloss' = srcext.haveGloss
  -- Return postcondition: result! = dst
  true
end

schema custompipes_CreateEnvMapCam
  ΔcustompipesModuleState
  world? : Ref[rw__World]
where
  -- State update: frame' = rw::Frame::create()
  -- State update: cam' = rw::Camera::create()
  -- State update: cam.frameBuffer' = fbuf
  -- State update: cam.zBuffer' = zbuf
  -- State update: vw' = { 2.0f, 2.0f }
  -- State update: EnvMapTex' = rw::Texture::create(fbuf)
  -- Return postcondition: result! = cam
  -- Return postcondition: result! = nil
  -- Invokes: Raster::create, Frame::create, Camera::create, cam->setFrame, cam->setNearPlane
  true
end

schema custompipes_DestroyCam
  ΔcustompipesModuleState
  cam? : Ref[rw__Camera]
where
  -- State update: cam.frameBuffer' = ∅
  -- State update: cam.zBuffer' = ∅
  -- State update: f' = cam.getFrame()
  -- Invokes: frameBuffer->destroy, zBuffer->destroy, cam->getFrame, cam->setFrame, f->destroy
  true
end

schema custompipes_RenderEnvMapScene
  ΔcustompipesModuleState
where
  -- Invokes: CRenderer::RenderRoads, CRenderer::RenderEverythingBarRoads, CRenderer::RenderFadingInEntities
  true
end

schema custompipes_EnvMapRender
  ΔcustompipesModuleState
where
  -- State update: camPos' = FindPlayerCoors()
  -- State update: matrix.pos' = camPos
  -- State update: skycol.red' = CTimeCycle::GetSkyBottomRed()
  -- State update: skycol.green' = CTimeCycle::GetSkyBottomGreen()
  -- State update: skycol.blue' = CTimeCycle::GetSkyBottomBlue()
  -- State update: skycol.alpha' = 255
  -- Invokes: EnvMapCam->getFrame, CTimeCycle::GetSkyBottomRed, CTimeCycle::GetSkyBottomGreen, CTimeCycle::GetSkyBottomBlue, EnvMapCam->clear
  true
end

schema custompipes_EnvMapInit
  ΔcustompipesModuleState
where
  -- State update: EnvMaskTex' = neoTxd.find("CarReflectionMask")
  -- State update: EnvMapCam' = CreateEnvMapCam(Scene.world)
  -- State update: width' = EnvMapCam.frameBuffer.width
  -- State update: height' = EnvMapCam.frameBuffer.height
  -- State update: screenZ' = RwIm2DGetNearScreenZ()
  -- State update: recipZ' = 1.0f/EnvMapCam.nearPlane
  -- Invokes: neoTxd->find
  true
end

schema custompipes_EnvMapShutdown
  ΔcustompipesModuleState
where
  -- State update: EnvMapTex.raster' = ∅
  -- State update: EnvMapTex' = ∅
  -- State update: EnvMapCam' = ∅
  -- Invokes: EnvMapTex->destroy
  true
end

