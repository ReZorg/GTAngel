--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ini_trim
  ΔiniModuleState
  str? : std__string
where
  -- Invokes: str.erase, str.find_last_not_of, str.find_first_not_of
  true
end

schema ini_toLower
  ΔiniModuleState
  str? : std__string
where
  -- Return postcondition: result! = static_cast<const char>(std::tolower(c))
  -- Invokes: std::transform, str.begin, str.end, std::tolower
  true
end

schema ini_replace
  ΔiniModuleState
  str? : std__string
  a? : std__string
  b? : std__string
where
  -- State update: pos' = 0
  -- Invokes: a.empty, str.find, str.replace, a.size, b.size
  true
end

schema ini_setEmpty
  ΔiniModuleState
  key? : std__string
  result! : ℕ
where
  -- State update: index' = data.size()
  -- Return postcondition: result! = index
  -- Invokes: data.size, data.emplace_back
  true
end

schema ini_INIMap
  ΔiniModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema ini_INIMap_2
  ΔiniModuleState
  other? : INIMap
where
  -- State update: data_size' = other.data.size()
  -- State update: key' = other.data[i].first
  -- State update: obj' = other.data[i].second
  -- State update: dataIndexMap' = T_DataIndexMap(other.dataIndexMap)
  -- Invokes: data.size, data.emplace_back
  true
end

schema ini_operator
  ΔiniModuleState
  key? : std__string
  result! : T
where
  -- State update: it' = dataIndexMap.find(key)
  -- State update: index' = (hasIt) ? it.second : setEmpty(key)
  -- Return postcondition: result! = data[index].second
  -- Invokes: INIStringUtil::trim, INIStringUtil::toLower, dataIndexMap.find, dataIndexMap.end
  true
end

schema ini_get
  ΞiniModuleState
  key? : std__string
  result! : T
where
  -- State update: it' = dataIndexMap.find(key)
  -- Return postcondition: result! = T()
  -- Return postcondition: result! = T(data[it->second].second)
  -- Invokes: INIStringUtil::trim, INIStringUtil::toLower, dataIndexMap.find, dataIndexMap.end
  true
end

schema ini_has
  ΞiniModuleState
  key? : std__string
  result! : 𝔹
where
  -- Return postcondition: result! = (dataIndexMap.count(key) == 1)
  -- Invokes: INIStringUtil::trim, INIStringUtil::toLower, dataIndexMap.count
  true
end

schema ini_set
  ΔiniModuleState
  key? : std__string
  obj? : T
where
  -- State update: it' = dataIndexMap.find(key)
  -- State update: second' = obj
  -- Invokes: INIStringUtil::trim, INIStringUtil::toLower, dataIndexMap.find, dataIndexMap.end, data.size
  true
end

