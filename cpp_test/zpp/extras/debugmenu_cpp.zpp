--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
snprintf : seq CHAR  -- #define snprintf _snprintf
strdup : seq CHAR  -- #define strdup _strdup
REPEATDELAY : ℕ  -- #define REPEATDELAY 700
REPEATINTERVAL : ℕ  -- #define REPEATINTERVAL 50

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
MenuFontStyle ::= MENUFONT_NORMAL | MENUFONT_SEL_ACTIVE | MENUFONT_SEL_INACTIVE | MENUFONT_MOUSE

EntryType ::= MENUEMPTY | MENUSUB | MENUVAR | MENUVAR_INT | MENUVAR_FLOAT | MENUVAR_CMD | MENUSCROLL
  -- val(MENUEMPTY) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema Pt
  y : ℤ
where
  instance_addr ∈ ADDRESS
end

schema Menu
  parent : Ref[Menu]
  r : RwRect
  entries : Ref[MenuEntry]
  numEntries : ℤ
  maxValWidth : ℤ
  isScrollingDown : bool_isScrollingUp
  scrollStart : ℤ
  numVisible : ℤ
  scrollDownR : RwRect_scrollUpR
  selection : ℤ
  selectedEntry : Ref[MenuEntry]
where
  #parent ≤ 1
  #entries ≤ 1
  #selectedEntry ≤ 1
end

schema Menu_findEntry
  ΔMenu
  entryname? : seq CHAR
  result! : Ref[MenuEntry]
where
  -- Declared member operation Menu::findEntry(const char *entryname)
  true
end

schema Menu_insertEntrySorted_2
  ΔMenu
  entry? : Ref[MenuEntry]
where
  -- Declared member operation Menu::insertEntrySorted(MenuEntry *entry)
  true
end

schema Menu_appendEntry_3
  ΔMenu
  entry? : Ref[MenuEntry]
where
  -- Declared member operation Menu::appendEntry(MenuEntry *entry)
  true
end

schema Menu_scroll_4
  ΔMenu
  off? : ℤ
where
  -- Declared member operation Menu::scroll(int off)
  true
end

schema Menu_changeSelection_5
  ΔMenu
  newsel? : ℤ
where
  -- Declared member operation Menu::changeSelection(int newsel)
  true
end

schema Menu_changeSelection_6
  ΔMenu
  e? : Ref[MenuEntry]
where
  -- Declared member operation Menu::changeSelection(MenuEntry *e)
  true
end

schema Menu_update_7
  ΔMenu
where
  -- Declared member operation Menu::update(void)
  true
end

schema Menu_draw_8
  ΔMenu
where
  -- Declared member operation Menu::draw(void)
  true
end

schema Menu_Menu_9
  ΔMenu
where
  -- Declared member operation Menu::Menu(void)
  true
end

schema Menu_Menu_10
  ΔMenu
  result! : ANY
where
  -- Declared member operation Menu::Menu(void)
  true
end

schema MenuEntry_Sub
  MenuEntry  -- inherits base schema
  submenu : Ref[Menu]
where
  #submenu ≤ 1
end

schema MenuEntry_Sub_MenuEntry_Sub
  ΔMenuEntry_Sub
  name? : seq CHAR
  menu? : Ref[Menu]
where
  -- Declared member operation MenuEntry_Sub::MenuEntry_Sub(const char *name, Menu *menu)
  true
end

schema MenuEntry_Sub_MenuEntry_Sub_2
  ΔMenuEntry_Sub
  result! : ANY
where
  -- Declared member operation MenuEntry_Sub::MenuEntry_Sub(void)
  true
end

schema MenuEntry_Var
  MenuEntry  -- inherits base schema
  maxvallen : ℤ
  vartype : ℤ
  wrapAround : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema MenuEntry_Var_processInput
  ΔMenuEntry_Var
