schema debugmenu_findMenu
  ΔdebugmenuModuleState
  name? : seq CHAR
where
  -- State update: tmppath' = strdup(name)
  -- State update: curname' = tmppath
  -- State update: next' = curname
  -- State update: m' = &toplevel
  -- State update: curname' = next
  -- State update: e' = m.findEntry(curname)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = m
  -- Invokes: m->findEntry, m->insertEntrySorted, m->appendEntry
  true
end

