schema Menu_scroll
  ΔMenu
  off? : ℤ
where
  -- State update: scrollStart' = 0
  -- State update: scrollStart' = numEntries-numVisible
  true
end

schema Menu_changeSelection
  ΔMenu
  newsel? : ℤ
where
  -- State update: selection' = newsel
  -- State update: selection' = 0
  -- State update: selection' = numEntries-1
  -- State update: scrollStart' = selection
  -- State update: scrollStart' = selection-numVisible+1
  true
end

schema Menu_changeSelection_2
  ΔMenu
  sel? : Ref[MenuEntry]
where
  -- State update: e' = this.entries
  -- State update: selection' = i
  -- State update: selectedEntry' = sel
  true
end

schema Menu_findEntry
  ΔMenu
  entryname? : seq CHAR
where
  -- State update: m' = this.entries
  -- Return postcondition: result! = m
  -- Return postcondition: result! = nil
  true
end

schema Menu_insertEntrySorted
  ΔMenu
  entry? : Ref[MenuEntry]
where
  -- State update: mp' = &this.entries
  -- State update: cmp' = strcmp(entry.name, (*mp).name)
  -- State update: entry.next' = *mp
  -- State update: mp' = entry
  -- State update: entry.menu' = this
  true
end

schema Menu_appendEntry
  ΔMenu
  entry? : Ref[MenuEntry]
where
  -- State update: mp' = &this.entries
  -- State update: mp' = &(*mp).next)
  -- State update: entry.next' = *mp
  -- State update: mp' = entry
  -- State update: entry.menu' = this
  true
end

schema Menu_update
  ΔMenu
where
  -- State update: x' = this.r.x
  -- State update: y' = this.r.y + 18
  -- State update: end' = this.r.y+this.r.h - 18
  -- State update: numVisible' = 0
  -- State update: deepestMenu' = this
  -- State update: bottomy' = end
  -- Invokes: submenu->update
  true
end

schema Menu_draw
  ΔMenu
where
  -- State update: e' = this.entries
