schema debugmenu_fontGetStringSize
  ΔdebugmenuModuleState
  s? : seq CHAR
where
  -- State update: sz' = { 0, 0 }
  -- State update: sz.y' = fontDesc.height*fontscale
  -- State update: x' = 0
  -- State update: sz.x' = x
  -- State update: x' = 0
  -- State update: sz.x' = x
  -- Return postcondition: result! = sz
  true
end

schema debugmenu_fontPrint
  ΔdebugmenuModuleState
  s? : seq CHAR
  x? : ℝ
  y? : ℝ
  style? : ℤ
where
  -- Return postcondition: result! = fontGetStringSize(s)
  true
end

schema debugmenu_fontGetLen
  ΔdebugmenuModuleState
  len? : ℤ
where
  -- Return postcondition: result! = len*fontDesc.width*fontscale
  true
end

schema debugmenu_createMenuFont
  ΔdebugmenuModuleState
where
  -- State update: fg_normal' = { 255, 255, 255, 255 }
  -- State update: bg_normal' = { 255, 255, 255, 0 }
  -- State update: fg_sel_active' = { 200, 200, 200, 255 }
  -- State update: bg_sel_active' = { 132, 132, 132, 255 }
  -- State update: fg_sel_inactive' = { 200, 200, 200, 255 }
  -- State update: bg_sel_inactive' = { 200, 200, 200, 0 }
  true
end

schema debugmenu_destroyMenuFont
  ΔdebugmenuModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

