schema CPostFX
  pFrontBuffer : Ref[RwRaster]
  pBackBuffer : Ref[RwRaster]
  bJustInitialised : 𝔹
  EffectSwitch : ℤ
  BlurOn : 𝔹
  MotionBlurOn : 𝔹
  Intensity : ℝ
  Next : ℤ
  NumValues : ℤ
where
  #pFrontBuffer ≤ 1
  #pBackBuffer ≤ 1
end

schema CPostFX_InitOnce
  ΔCPostFX
where
  -- Declared member operation CPostFX::InitOnce(void)
  true
end

