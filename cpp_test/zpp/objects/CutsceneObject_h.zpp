schema CCutsceneObject
  CObject  -- inherits base schema
  bRenderRightHand : 𝔹
  bRenderLeftHand : 𝔹
  m_pShadow : Ref[CCutsceneShadow]
  m_pAttachTo : ADDRESS
  m_pAttachmentObject : Ref[CObject]
where
  #m_pShadow ≤ 1
  #m_pAttachmentObject ≤ 1
end

