schema CCutsceneHead_CCutsceneHead
  ΔCCutsceneHead
  obj? : Ref[CObject]
where
  -- State update: unk1' = 0
  -- State update: bIsSkinned' = false
  -- State update: m_parentObject' = (CCutsceneObject*)obj
  -- State update: bIsSkinned' = true
  -- State update: atm' = (RpAtomic*)GetFirstObject(m_pHeadNode)
  -- Invokes: obj->GetClump, m_parentObject->SetRenderHead
  true
end

schema CCutsceneHead_CreateRwObject
  ΔCCutsceneHead
where
  -- State update: atm' = GetFirstAtomic((RpClump*)m_rwObject)
  -- Invokes: CEntity::CreateRwObject
  true
end

schema CCutsceneHead_DeleteRwObject
  ΔCCutsceneHead
where
  -- Invokes: CEntity::DeleteRwObject
  true
