  bone? : ℤ
where
  -- State update: hier' = GetAnimHierarchyFromSkinClump(m_parentObject.GetClump())
  -- State update: idx' = RpHAnimIDGetIndex(hier, bone)
  -- State update: mats' = RpHAnimHierarchyGetMatrixArray(hier)
  -- State update: mi' = (CPedModelInfo*)CModelInfo::GetModelInfo(GetModelIndex())
  -- State update: atomic' = mi.getLeftHand()
  -- State update: atomic' = mi.getRightHand()
