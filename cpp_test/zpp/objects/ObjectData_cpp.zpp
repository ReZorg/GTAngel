--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CObjectData_Initialise
  ΔCObjectData
  filename? : seq CHAR
where
  -- State update: m_fMass' = 99999.0f
  -- State update: m_fTurnMass' = 99999.0f
  -- State update: m_fAirResistance' = 0.99f
  -- State update: m_fElasticity' = 0.1f
  -- State update: m_fBuoyancy' = GRAVITY * ms_aObjectInfo[0].m_fMass * 2.0f
  -- State update: m_fUprootLimit' = 0.0f
  -- Invokes: CFileMgr::SetDir, CFileMgr::LoadFile, CModelInfo::GetModelInfo, mi->SetObjectID
  true
end

schema CObjectData_SetObjectData
  ΔCObjectData
  modelId? : ℤ
  object? : CObject
where
  -- State update: object.m_fMass' = objinfo.m_fMass
  -- State update: object.m_fTurnMass' = objinfo.m_fTurnMass
  -- State update: object.m_fAirResistance' = objinfo.m_fAirResistance
  -- State update: object.m_fElasticity' = objinfo.m_fElasticity
  -- State update: object.m_fBuoyancy' = objinfo.m_fBuoyancy
  -- State update: object.m_fUprootLimit' = objinfo.m_fUprootLimit
  -- Invokes: CModelInfo::GetModelInfo
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema ObjectDataModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 169
end
