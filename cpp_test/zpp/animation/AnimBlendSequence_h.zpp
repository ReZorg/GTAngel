schema AnimBlendSequence_GetRotation
  ΔAnimBlendSequenceModuleState
  quat? : Ref[CQuaternion]
where
  -- State update: scale' = 1.0f/4096.0f
  -- State update: quat.x' = rot[0]*scale
  -- State update: quat.y' = rot[1]*scale
  -- State update: quat.z' = rot[2]*scale
  -- State update: quat.w' = rot[3]*scale
  true
end

schema AnimBlendSequence_SetRotation
  ΔAnimBlendSequenceModuleState
  quat? : CQuaternion
where
  -- Deterministic transition preserving module invariants
  true
end

schema AnimBlendSequence_GetDeltaTime
  ΔAnimBlendSequenceModuleState
  result! : ℝ
where
  -- Return postcondition: result! = deltaTime/60.0f
  true
end

schema AnimBlendSequence_SetTime
  ΔAnimBlendSequenceModuleState
  t? : ℝ
where
  -- State update: deltaTime' = t*60.0f + 0.5f
  true
end

schema AnimBlendSequence_GetTranslation
  ΔAnimBlendSequenceModuleState
  vec? : Ref[CVector]
where
  -- State update: scale' = 1.0f/1024.0f
  -- State update: vec.x' = trans[0]*scale
  -- State update: vec.y' = trans[1]*scale
  -- State update: vec.z' = trans[2]*scale
  true
end

schema AnimBlendSequence_SetTranslation
  ΔAnimBlendSequenceModuleState
  vec? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema AnimBlendSequence_HasTranslation
  ΔAnimBlendSequenceModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = !!(type & KF_TRANS)
  true
end

schema AnimBlendSequence_SetBoneTag
