schema AnimBlendFrameData
  flag : ℕ
  resetPos : RwV3d
  hanimFrame : ℙ ℤ
  nodeID : ℤ
where
  flag ≥ 0
  #hanimFrame ≤ 1
end

schema CAnimBlendClumpData
  link : CAnimBlendLink
  numFrames : ℤ
  velocity3d : Ref[CVector]
  frames : Ref[AnimBlendFrameData]
where
  #velocity3d ≤ 1
  #frames ≤ 1
end

