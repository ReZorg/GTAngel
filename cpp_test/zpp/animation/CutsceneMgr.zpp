  -- State update: ms_useCutsceneShadows' = false
  true
end

schema CutsceneMgr_GetCutsceneTimeInMilleseconds
  ΔCutsceneMgrModuleState
  result! : ℤ
where
  -- Return postcondition: result! = 1000.0f * ms_cutsceneTimer
  true
