  -- Return postcondition: result! = ms_useLodMultiplier
  true
end

schema CutsceneMgr_GetCutsceneObject
  ΔCutsceneMgrModuleState
  id? : ℤ
  result! : Ref[CCutsceneObject]
where
  -- Return postcondition: result! = ms_pCutsceneObjects[id]
  true
end

schema CutsceneMgr_SetCutsceneOffset
  ΔCutsceneMgrModuleState
  vec? : CVector
