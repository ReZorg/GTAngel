--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Bones_ConvertPedNode2BoneTag
  ΔBonesModuleState
  node? : ℤ
where
  -- Return postcondition: result! = BONE_spine1
  -- Return postcondition: result! = BONE_head
  -- Return postcondition: result! = BONE_l_upperarm
  true
end

schema Bones_ConvertBoneTag2BoneName
  ΔBonesModuleState
  tag? : ℤ
where
  -- Return postcondition: result! = "Root"
  -- Return postcondition: result! = "Pelvis"
  -- Return postcondition: result! = "Spine"
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema BonesModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 69
end
