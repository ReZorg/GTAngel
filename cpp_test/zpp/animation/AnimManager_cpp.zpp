end

schema CAnimManager_GetAnimAssociation
  ΔCAnimManager
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- Return postcondition: result! = ms_aAnimAssocGroups[groupId].GetAnimation(animId)
