schema IfpHeader
  ident : seq CHAR
  size : ℕ
where
  #ident = 4
  size ≥ 0
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CAnimManager_Initialise
  ΔCAnimManager
where
  -- State update: ms_numAnimations' = 0
  -- State update: ms_numAnimBlocks' = 0
  -- Invokes: ms_animCache.Init
  true
end

schema CAnimManager_Shutdown
  ΔCAnimManager
where
  -- Invokes: CStreaming::RemoveAnim, ms_animCache.Shutdown
  true
end

schema CAnimManager_UncompressAnimation
  ΔCAnimManager
  hier? : Ref[CAnimBlendHierarchy]
where
  -- State update: link' = ms_animCache.Insert(hier)
  -- State update: lastHier' = ms_animCache.tail.prev.item
  -- State update: lastHier.linkPtr' = ∅
  -- State update: link' = ms_animCache.Insert(hier)
  -- State update: hier.linkPtr' = link
  -- Invokes: hier->CalcTotalTimeCompressed, linkPtr->Remove, head.Insert, ms_animCache.Insert, lastHier->RemoveUncompressedData
  true
end

schema CAnimManager_RemoveFromUncompressedCache
  ΔCAnimManager
  hier? : Ref[CAnimBlendHierarchy]
where
  -- State update: hier.linkPtr' = ∅
  -- Invokes: ms_animCache.Remove
  true
end

schema CAnimManager_GetAnimationBlock
  ΔCAnimManager
  name? : seq CHAR
where
  -- Return postcondition: result! = &ms_aAnimBlocks[i]
  -- Return postcondition: result! = nil
  true
end

schema CAnimManager_GetAnimationBlockIndex
  ΔCAnimManager
  name? : seq CHAR
where
  -- Return postcondition: result! = i
  -- Return postcondition: result! = -1
  true
end

schema CAnimManager_RegisterAnimBlock
  ΔCAnimManager
  name? : seq CHAR
where
  -- State update: animBlock' = GetAnimationBlock(name)
  -- State update: animBlock' = &ms_aAnimBlocks[ms_numAnimBlocks++]
  -- State update: animBlock.numAnims' = 0
  -- Return postcondition: result! = animBlock - ms_aAnimBlocks
  true
end

schema CAnimManager_GetNumRefsToAnimBlock
  ΔCAnimManager
  block? : ℤ
where
  -- Return postcondition: result! = ms_aAnimBlocks[block].refCount
  true
end

schema CAnimManager_AddAnimBlockRef
  ΔCAnimManager
  block? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CAnimManager_RemoveAnimBlockRefWithoutDelete
  ΔCAnimManager
  block? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CAnimManager_RemoveAnimBlockRef
  ΔCAnimManager
  block? : ℤ
where
  -- Invokes: CStreaming::RemoveAnim
  true
end

schema CAnimManager_RemoveAnimBlock
  ΔCAnimManager
  block? : ℤ
where
  -- State update: animblock' = &ms_aAnimBlocks[block]
  -- State update: animblock.isLoaded' = false
  -- State update: animblock.refCount' = 0
  true
end

schema CAnimManager_GetAnimation
