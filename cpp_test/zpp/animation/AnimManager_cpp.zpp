  animBlock? : Ref[CAnimBlock]
where
  -- State update: hier' = &ms_aAnimations[animBlock.firstIndex]
  -- Return postcondition: result! = hier
  -- Return postcondition: result! = nil
  -- Invokes: CGeneral::faststricmp
  true
end

schema CAnimManager_GetAnimGroupName
  ΔCAnimManager
  groupId? : AssocGroupId
where
  -- Return postcondition: result! = ms_aAnimAssocDefinitions[groupId].name
  true
