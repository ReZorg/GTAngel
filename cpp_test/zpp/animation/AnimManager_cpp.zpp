schema CAnimManager_CreateAnimAssociation
  ΔCAnimManager
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- Return postcondition: result! = ms_aAnimAssocGroups[groupId].CopyAnimation(animId)
