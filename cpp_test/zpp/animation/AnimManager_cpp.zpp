schema CAnimManager_GetAnimAssociation_2
  ΔCAnimManager
  groupId? : AssocGroupId
  name? : seq CHAR
where
  -- Return postcondition: result! = ms_aAnimAssocGroups[groupId].GetAnimation(name)
  true
end

schema CAnimManager_AddAnimation
  ΔCAnimManager
  clump? : Ref[RpClump]
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- State update: anim' = CreateAnimAssociation(groupId, animId)
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- State update: syncanim' = ∅
  -- State update: link' = clumpData.link.next
  -- State update: syncanim' = CAnimBlendAssociation::FromLink(link)
  -- Return postcondition: result! = anim
  -- Invokes: anim->IsMovement, CAnimBlendAssociation::FromLink, syncanim->IsMovement, anim->SyncAnimation, anim->Start
  true
end

schema CAnimManager_AddAnimationAndSync
  ΔCAnimManager
  clump? : Ref[RpClump]
  syncanim? : Ref[CAnimBlendAssociation]
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- State update: anim' = CreateAnimAssociation(groupId, animId)
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- Return postcondition: result! = anim
  -- Invokes: anim->IsMovement, anim->SyncAnimation, anim->Start, link.Prepend
  true
end

schema CAnimManager_BlendAnimation
  ΔCAnimManager
  clump? : Ref[RpClump]
  groupId? : AssocGroupId
  animId? : AnimationId
  delta? : ℝ
where
  -- State update: removePrevAnim' = 0
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- State update: anim' = GetAnimAssociation(groupId, animId)
  -- State update: isMovement' = anim.IsMovement()
  -- State update: isPartial' = anim.IsPartial()
  -- State update: movementAnim' = ∅
  -- Return postcondition: result! = found
  -- Return postcondition: result! = found
  -- Invokes: anim->IsMovement, anim->IsPartial, CAnimBlendAssociation::FromLink, found->IsRunning, found->Start
  true
end

schema CAnimManager_LoadAnimFiles
  ΔCAnimManager
where
  -- State update: ms_aAnimAssocGroups' = new CAnimBlendAssocGroup[NUM_ANIM_ASSOC_GROUPS]
  -- State update: clump' = (RpClump*)mi.CreateInstance()
  -- State update: group' = &ms_aAnimAssocGroups[i]
  -- State update: def' = &ms_aAnimAssocDefinitions[i]
  -- Invokes: CModelInfo::GetModelInfo, mi->CreateInstance, group->CreateAssociations, group->GetAnimation
  true
end

schema CAnimManager_CreateAnimAssocGroups
  ΔCAnimManager
where
  -- State update: block' = GetAnimationBlock(ms_aAnimAssocDefinitions[i].blockName)
  -- State update: clump' = (RpClump*)mi.CreateInstance()
  -- State update: group' = &ms_aAnimAssocGroups[i]
  -- State update: def' = &ms_aAnimAssocDefinitions[i]
  -- State update: group.groupId' = i
  -- State update: group.firstAnimId' = def.animDescs[0].animId
  -- Invokes: CModelInfo::GetModelInfo, mi->CreateInstance, group->CreateAssociations, group->GetAnimation
  true
end

schema CAnimManager_LoadAnimFile
  ΔCAnimManager
  filename? : seq CHAR
where
  -- State update: stream' = RwStreamOpen(rwSTREAMFILENAME, rwSTREAMREAD, filename)
  true
end

schema CAnimManager_RemoveLastAnimFile
  ΔCAnimManager
where
  -- State update: ms_numAnimations' = ms_aAnimBlocks[ms_numAnimBlocks].firstIndex
  -- State update: isLoaded' = false
  true
end

schema CAnimManager_LoadAnimFile_2
  ΔCAnimManager
  fd? : ℤ
  compress? : 𝔹
where
  -- State update: fbuf' = (float*)buf
  -- State update: numANPK' = *(int*)buf
  -- State update: numANPK' = 1
  -- State update: animBlock' = &ms_aAnimBlocks[ms_numAnimBlocks++]
  -- State update: animBlock.numAnims' = *(int*)buf
  -- State update: animBlock.firstIndex' = ms_numAnimations
  -- Invokes: CFileMgr::Read, CGeneral::faststrncmp, CFileMgr::Seek, hier->SetName, seq->SetName
  true
end
