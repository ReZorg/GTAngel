--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema AnimBlendList_Init
  ΔAnimBlendListModuleState
where
  -- State update: next' = ∅
  -- State update: prev' = ∅
  true
end

schema AnimBlendList_Prepend
  ΔAnimBlendListModuleState
  link? : Ref[CAnimBlendLink]
where
  -- State update: next.prev' = link
  -- State update: link.next' = next
