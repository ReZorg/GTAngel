schema CPedPlacement_FindZCoorForPed
  ΔCPedPlacement
  pos? : Ref[CVector]
where
  -- State update: startZ' = pos.z - 100.0f
  -- State update: foundColZ' = -100.0f
  -- State update: foundColZ2' = -100.0f
  -- State update: foundColZ' = foundCol.point.z
  -- State update: foundColZ2' = foundCol.point.z
  -- State update: zForPed' = Max(foundColZ, foundColZ2)
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: CWorld::ProcessVerticalLine
  true
end

