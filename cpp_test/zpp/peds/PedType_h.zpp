--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPedType
  m_flag : ℕ
  unknown1 : ℝ
  unknown2 : ℝ
  unknown3 : ℝ
  unknown4 : ℝ
  unknown5 : ℝ
  m_threats : ℕ
  m_avoid : ℕ
  ms_apPedType : seq Ref[CPedType]  -- bounded array [NUM_PEDTYPES]
where
  m_flag ≥ 0
  m_threats ≥ 0
  m_avoid ≥ 0
end

schema CPedType_Initialise
  ΔCPedType
where
  -- Declared member operation CPedType::Initialise(void)
  true
end

schema CPedType_Shutdown_2
  ΔCPedType
where
  -- Declared member operation CPedType::Shutdown(void)
  true
end

schema CPedType_LoadPedData_3
  ΔCPedType
where
  -- Declared member operation CPedType::LoadPedData(void)
  true
end

schema CPedType_FindPedType_4
  ΔCPedType
  type? : seq CHAR
  result! : ePedType
where
  -- Declared member operation CPedType::FindPedType(char *type)
  true
end

schema CPedType_FindPedFlag_5
  ΔCPedType
  type? : seq CHAR
  result! : ℕ
where
  -- Declared member operation CPedType::FindPedFlag(char *type)
  true
end

