where
  -- Declared member operation CPedType::Load(uint8 *buf, uint32 size)
  true
end

schema CPedType_GetFlag_8
  ΔCPedType
  type? : ℤ
  result! : ℕ
where
  -- Declared member operation CPedType::GetFlag(int type)
  true
end

schema CPedType_GetAvoid_9
  ΔCPedType
  type? : ℤ
  result! : ℕ
where
  -- Declared member operation CPedType::GetAvoid(int type)
  true
end

schema CPedType_GetThreats_10
  ΔCPedType
  type? : ℤ
  result! : ℕ
where
  -- Declared member operation CPedType::GetThreats(int type)
  true
end

schema CPedType_SetThreats_11
  ΔCPedType
  type? : ℤ
