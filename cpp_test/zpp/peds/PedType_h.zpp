  ΔCPedStats
  name? : seq CHAR
  result! : ePedStats
where
  -- Declared member operation CPedStats::GetPedStatType(char *name)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema PedType_GetFlag
  ΔPedTypeModuleState
  type? : ℤ
  result! : ℕ
where
  -- Return postcondition: result! = ms_apPedType[type]->m_flag
  true
end

schema PedType_GetAvoid
  ΔPedTypeModuleState
  type? : ℤ
  result! : ℕ
where
  -- Return postcondition: result! = ms_apPedType[type]->m_avoid
  true
end

schema PedType_GetThreats
  ΔPedTypeModuleState
  type? : ℤ
  result! : ℕ
where
  -- Return postcondition: result! = ms_apPedType[type]->m_threats
  true
end

schema PedType_SetThreats
  ΔPedTypeModuleState
  type? : ℤ
  threat? : ℕ
where
  -- State update: m_threats' = threat
  true
end

schema PedType_AddThreat
  ΔPedTypeModuleState
  type? : ℤ
  threat? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema PedType_RemoveThreat
  ΔPedTypeModuleState
  type? : ℤ
  threat? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema PedType_IsThreat
  ΔPedTypeModuleState
  type? : ℤ
  threat? : ℤ
  result! : 𝔹
where
  -- Return postcondition: result! = ms_apPedType[type]->m_threats & threat
  true
end
