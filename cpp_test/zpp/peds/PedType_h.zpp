schema CPedStats
  m_type : ePedStats
  m_name : seq CHAR
  m_fleeDistance : ℝ
  m_headingChangeRate : ℝ
  m_fear : ℤ
  m_temper : ℤ
  m_lawfulness : ℤ
  m_sexiness : ℤ
  m_attackStrength : ℝ
  m_defendWeakness : ℝ
  m_flags : ℤ
  ms_apPedStats : seq Ref[CPedStats]  -- bounded array [NUM_PEDSTATS]
where
  #m_name = 24
end

schema CPedStats_Initialise
  ΔCPedStats
where
  -- Declared member operation CPedStats::Initialise(void)
  true
end

schema CPedStats_Shutdown_2
  ΔCPedStats
where
  -- Declared member operation CPedStats::Shutdown(void)
  true
end

