  -- State update: close' = true
  -- Return postcondition: result! = ms_displacements[qid]
  -- Invokes: ms_displacements.empty, CGeneral::GetRandomNumberInRange, ms_displacements.begin, ms_displacements.end, ms_displacements.push_back
  true
end

