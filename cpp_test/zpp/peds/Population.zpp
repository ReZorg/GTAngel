where
  -- State update: ped' = new CCivilianPed(pedType, miOrCopType)
  -- State update: weapon' = WEAPONTYPE_COLT45
  -- State update: weapon' = WEAPONTYPE_NIGHTSTICK
  -- State update: weapon' = WEAPONTYPE_GOLFCLUB
  -- State update: weapon' = WEAPONTYPE_TEC9
  -- State update: ped' = new CCopPed((eCopType)miOrCopType, modifier)
  -- Return postcondition: result! = ped
  -- Return postcondition: result! = ped
  -- Return postcondition: result! = ped
  -- Invokes: ped->SetPosition, ped->SetOrientation, CWorld::Add, CGeneral::GetRandomNumber, ped->GiveDelayedWeapon
  true
end

