where
  -- State update: dummy' = new CDummyObject(obj)
  -- State update: dummy.bIsVisible' = false
  -- Invokes: dummy->GetMatrix, dummy->UpdateRwFrame, CModelInfo::GetModelInfo, obj->GetModelIndex, CWorld::Remove
  true
end

schema CPopulation_TestRoomForDummyObject
  ΔCPopulation
  obj? : Ref[CObject]
where
  -- Return postcondition: result! = collidingObjs == 0
  -- Invokes: CWorld::FindObjectsKindaColliding, m_objectMatrix.GetPosition, CModelInfo::GetColModel, obj->GetModelIndex
  true
end

schema CPopulation_TestSafeForRealObject
  ΔCPopulation
  dummy? : Ref[CDummyObject]
where
  -- State update: dummyCol' = dummy.GetColModel()
  -- State update: radius' = dummyCol.boundingSphere.radius
  -- State update: minX' = CWorld::GetSectorIndexX(dummy.GetPosition().x - radius)
  -- State update: minX' = 0
  -- State update: minY' = CWorld::GetSectorIndexY(dummy.GetPosition().y - radius)
  -- State update: minY' = 0
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: dummy->GetColModel, CWorld::GetSectorIndexX, dummy->GetPosition, CWorld::GetSectorIndexY, dummy->GetBoundRadius
  true
end

schema CPopulation_ManagePopulation
  ΔCPopulation
where
  -- State update: frameMod32' = CTimer::GetFrameCounter() & 31
  -- State update: playerPos' = FindPlayerCentreOfWorld(CWorld::PlayerInFocus)
  -- State update: objectPoolSize' = CPools::GetObjectPool().GetSize()
  -- State update: obj' = CPools::GetObjectPool().GetSlot(i)
  -- State update: objPlayerDist' = (obj.GetPosition() - playerPos).Magnitude()
  -- State update: dummyPoolSize' = CPools::GetDummyPool().GetSize()
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Invokes: CTimer::GetFrameCounter, CPools::GetObjectPool, obj->CanBeDeleted, obj->GetPosition, obj->GetModelIndex
  true
end
