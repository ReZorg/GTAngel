--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MIN_CREATION_DIST : ℝ  -- #define MIN_CREATION_DIST 40.0f
CREATION_RANGE : ℝ  -- #define CREATION_RANGE 10.0f
OFFSCREEN_CREATION_MULT : ℝ  -- #define OFFSCREEN_CREATION_MULT 0.5f
PED_REMOVE_DIST : ℝ  -- #define PED_REMOVE_DIST (MIN_CREATION_DIST + CREATION_RANGE + 1.0f)
PED_REMOVE_DIST_SPECIAL : ℝ  -- #define PED_REMOVE_DIST_SPECIAL (MIN_CREATION_DIST + CREATION_RANGE + 15.0f)

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema PedGroup
  models : seq ℤ  -- bounded array [NUMMODELSPERPEDGROUP]
where
  instance_addr ∈ ADDRESS
end

schema CPopulation
  ms_pPedGroups : seq PedGroup  -- bounded array [NUMPEDGROUPS]
  ms_bGivePedsWeapons : 𝔹
  m_AllRandomPedsThisType : ℤ
  PedDensityMultiplier : ℝ
  ms_nTotalMissionPeds : ℕ
  MaxNumberOfPedsInUse : ℤ
  MaxNumberOfPedsInUseInterior : ℤ
  ms_nNumCivMale : ℕ
  ms_nNumCivFemale : ℕ
  ms_nNumCop : ℕ
  bZoneChangeHasHappened : 𝔹
  ms_nNumEmergency : ℕ
  m_CountDownToPedsAtStart : ℤ
  ms_nNumGang1 : ℕ
  ms_nNumGang2 : ℕ
  ms_nTotalPeds : ℕ
  ms_nNumGang3 : ℕ
  ms_nTotalGangPeds : ℕ
  ms_nNumGang4 : ℕ
  ms_nTotalCivPeds : ℕ
  ms_nNumGang5 : ℕ
  ms_nNumDummy : ℕ
  ms_nNumGang6 : ℕ
  ms_nNumGang9 : ℕ
  ms_nNumGang7 : ℕ
  ms_nNumGang8 : ℕ
  ms_nTotalCarPassengerPeds : ℕ
  NumMiamiViceCops : ℕ
  RegenerationPoint_a : CVector
  RegenerationPoint_b : CVector
  RegenerationFront : CVector
where
  ms_nTotalMissionPeds ≥ 0
  ms_nNumCivMale ≥ 0
  ms_nNumCivFemale ≥ 0
  ms_nNumCop ≥ 0
  ms_nNumEmergency ≥ 0
  ms_nNumGang1 ≥ 0
  ms_nNumGang2 ≥ 0
  ms_nTotalPeds ≥ 0
  ms_nNumGang3 ≥ 0
  ms_nTotalGangPeds ≥ 0
  ms_nNumGang4 ≥ 0
  ms_nTotalCivPeds ≥ 0
  ms_nNumGang5 ≥ 0
  ms_nNumDummy ≥ 0
  ms_nNumGang6 ≥ 0
  ms_nNumGang9 ≥ 0
end

schema CPopulation_Initialise
  ΔCPopulation
where
  -- Declared member operation CPopulation::Initialise()
  true
end

