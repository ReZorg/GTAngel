schema CPopulation_MoveCarsAndPedsOutOfAbandonedZones
  ΔCPopulation
where
  -- State update: frame' = CTimer::GetFrameCounter() & 7
  -- State update: movedVehicleCount' = 0
  -- State update: poolSize' = CPools::GetVehiclePool().GetSize()
  -- State update: poolIndex' = poolSize - 1
  -- State update: veh' = CPools::GetVehiclePool().GetSlot(poolIndex)
  -- State update: poolSize' = CPools::GetPedPool().GetSize()
  -- Invokes: CTimer::GetFrameCounter, CPools::GetVehiclePool, veh->IsCar, veh->GetStatus, veh->GetPosition
