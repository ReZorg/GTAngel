schema RegenerationPoint
  srcLevel : eLevelName
  destLevel : eLevelName
  x1 : ℝ
  x2 : ℝ
  y1 : ℝ
  y2 : ℝ
  z1 : ℝ
  z2 : ℝ
  destPosA : RwV3d
  destPosB : RwV3d
  srcPosA : RwV3d
  srcPosB : RwV3d
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPopulation_Initialise
  ΔCPopulation
where
  -- State update: ms_nNumCivMale' = 0
  -- State update: ms_nNumCivFemale' = 0
  -- State update: ms_nNumCop' = 0
  -- State update: ms_nNumEmergency' = 0
  -- State update: ms_nNumGang1' = 0
  -- State update: ms_nNumGang2' = 0
  true
end

schema CPopulation_RemovePed
  ΔCPopulation
  ent? : Ref[CPed]
where
  -- Invokes: CWorld::Remove
  true
end

schema CPopulation_ChooseCivilianOccupation
  ΔCPopulation
  group? : ℤ
where
  -- State update: gLastSelectedCivilianIndex' = CGeneral::GetRandomNumberInRange(0, NUMMODELSPERPEDGROUP)
  -- State update: lastModel' = ms_pPedGroups[group].models[gLastSelectedCivilianIndex]
  -- State update: gLastSelectedCivilianIndex' = CGeneral::GetRandomNumberInRange(0, NUMMODELSPERPEDGROUP)
  -- Return postcondition: result! = lastModel
  -- Return postcondition: result! = ms_pPedGroups[group].models[gLastSelectedCivilianIndex]
  -- Invokes: CGeneral::GetRandomNumberInRange, CPopulation::IsSunbather
  true
end

schema CPopulation_ChooseNextCivilianOccupation
  ΔCPopulation
  group? : ℤ
where
  -- State update: gLastSelectedCivilianIndex' = 0
  -- State update: lastModel' = ms_pPedGroups[group].models[gLastSelectedCivilianIndex]
  -- State update: gLastSelectedCivilianIndex' = 0
  -- Return postcondition: result! = lastModel
  -- Return postcondition: result! = ms_pPedGroups[group].models[gLastSelectedCivilianIndex]
  -- Invokes: CPopulation::IsSunbather
  true
end

schema CPopulation_ChoosePolicePedOccupation
  ΔCPopulation
where
  -- Return postcondition: result! = COP_STREET
  -- Invokes: CGeneral::GetRandomNumber
  true
end

schema CPopulation_LoadPedGroups
  ΔCPopulation
where
  -- State update: nextPedGroup' = 0
  -- State update: fd' = CFileMgr::OpenFile("PEDGRP.DAT", "r")
  -- State update: end' = 0
  -- State update: cursor' = 0
  -- State update: nextWhitespace' = cursor
  -- State update: cursor' = nextWhitespace
  -- Invokes: CFileMgr::ChangeDir, CFileMgr::OpenFile, CFileMgr::ReadLine, CModelInfo::GetModelInfo, CFileMgr::CloseFile
  true
end

schema CPopulation_UpdatePedCount
  ΔCPopulation
  pedType? : ePedType
  decrease? : 𝔹
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPopulation_ChooseGangOccupation
  ΔCPopulation
  gangId? : ℤ
where
  -- State update: modelOverride' = CGangs::GetGangPedModelOverride(gangId)
  -- State update: firstGangModel' = 2 * gangId + MI_GANG01
  -- Return postcondition: result! = CGeneral::GetRandomNumberInRange(firstGangModel, firstGangModel + 2)
  -- Return postcondition: result! = firstGangModel + 1
  -- Return postcondition: result! = firstGangModel
  -- Invokes: CGangs::GetGangPedModelOverride, CGeneral::GetRandomNumberInRange
  true
end

schema CPopulation_DealWithZoneChange
  ΔCPopulation
  oldLevel? : eLevelName
  newLevel? : eLevelName
  forceIndustrialZone? : 𝔹
where
  -- State update: bZoneChangeHasHappened' = true
  -- State update: findSafeZoneAround.x' = 690.0f
  -- State update: findSafeZoneAround.y' = -920.0f
  -- State update: findSafeZoneAround.z' = 42.0f
  -- State update: findSafeZoneAround' = FindPlayerCoors()
  -- State update: safeZone' = 0
  -- Invokes: RegenerationFront.Normalise
  true
end

schema CPopulation_Update
  ΔCPopulation
  addPeds? : 𝔹
where
  -- State update: ms_nTotalCivPeds' = ms_nNumCivFemale + ms_nNumCivMale
  -- State update: pcdm' = PedCreationDistMultiplier()
  -- Invokes: CReplay::IsPlayingBack, CCutsceneMgr::IsRunning
  true
end

schema CPopulation_GeneratePedsAtStartOfGame
  ΔCPopulation
where
  -- State update: ms_nTotalCivPeds' = ms_nNumCivFemale + ms_nNumCivMale
  true
end

schema CPopulation_PedCreationDistMultiplier
  ΔCPopulation
where
  -- State update: veh' = FindPlayerVehicle()
  -- State update: vehSpeed' = veh.m_vecMoveSpeed.Magnitude2D()
  -- Return postcondition: result! = 1.0f
  -- Return postcondition: result! = Clamp(vehSpeed - 0.1f + 1.0f, 1.0f, 1.5f)
  -- Invokes: m_vecMoveSpeed.Magnitude2D
  true
end

schema CPopulation_AddPed
  ΔCPopulation
  pedType? : ePedType
