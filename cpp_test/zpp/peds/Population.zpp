where
  -- State update: obj' = new CObject(dummy)
  -- State update: obj.bIsVisible' = false
  -- State update: obj.m_vecMoveSpeed' = CVector(0.0f, 0.0f, -0.001f)
  -- State update: obj.bTouchingWater' = true
  -- Invokes: CWorld::Remove, CWorld::Add, CModelInfo::GetModelInfo, obj->GetModelIndex, obj->SetIsStatic
