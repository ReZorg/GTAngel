schema RegenerationPoint
  srcLevel : eLevelName
  destLevel : eLevelName
  x1 : ℝ
  x2 : ℝ
  y1 : ℝ
  y2 : ℝ
  z1 : ℝ
  z2 : ℝ
  destPosA : RwV3d
  destPosB : RwV3d
  srcPosA : RwV3d
  srcPosB : RwV3d
where
  instance_addr ∈ ADDRESS
end
