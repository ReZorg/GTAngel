-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eCopType ::= COP_STREET | COP_FBI | COP_SWAT | COP_HELI_SWAT | COP_ARMY | COP_MIAMIVICE
  -- val(COP_STREET) = 0
  -- val(COP_FBI) = 1
  -- val(COP_SWAT) = 2
  -- val(COP_HELI_SWAT) = 3
  -- val(COP_ARMY) = 4
  -- val(COP_MIAMIVICE) = 5

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CCopPed
  CPed  -- inherits base schema
  m_nRoadblockVeh : Ref[CVehicle]
  m_fDistanceToTarget : ℝ
  m_bIsInPursuit : 𝔹
  m_bIsDisabledCop : 𝔹
  field_5FE : ℤ
  m_bBeatingSuspect : 𝔹
  m_bStopAndShootDisabledZone : 𝔹
  m_bDragsPlayerFromCar : 𝔹
  m_bZoneDisabled : 𝔹
  m_fAbseilPos : ℝ
  m_nCopType : eCopType
  m_bThrowsSpikeTrap : 𝔹
  m_pRopeEntity : Ref[CEntity]
  m_nRopeID : ℕ
  m_nHassleTimer : ℕ
  field_61C : ℕ
  field_624 : ℤ
  field_628 : ℤ
  m_nRoadblockNode : ℤ
  field_1350 : ℤ
  field_1364 : ℤ
where
  #m_nRoadblockVeh ≤ 1
  #m_pRopeEntity ≤ 1
  m_nRopeID ≥ 0
  m_nHassleTimer ≥ 0
  field_61C ≥ 0
end

schema CCopPed_CCopPed
  ΔCCopPed
  arg_1? : eCopType
  modifier? : ℤ
where
  -- Declared member operation CCopPed::CCopPed(eCopType, int32 modifier = 0)
  true
end

