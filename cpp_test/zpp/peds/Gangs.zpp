schema CGangInfo
  m_nVehicleMI : ℤ
  m_nPedModel1MI : ℤ
  m_nPedModel2MI : ℤ
  m_nPedModelOverride : ℤ
  m_Weapon1 : ℤ
  m_Weapon2 : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CGangInfo_CGangInfo
  ΔCGangInfo
where
  -- Declared member operation CGangInfo::CGangInfo()
  true
end

schema CGangs
  GangAttackWithCops : seq 𝔹  -- bounded array [NUM_GANGS]
where
  instance_addr ∈ ADDRESS
end

