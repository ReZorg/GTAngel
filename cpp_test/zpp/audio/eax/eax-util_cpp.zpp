  -- State update: lpResult.lRoom' = lpStart.lRoom
  -- State update: lpResult.lRoomHF' = lpStart.lRoomHF
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

