--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema _GUID
  Data1 : ℤ
  Data2 : ℤ
  Data3 : ℤ
  Data4 : seq unsigned_char  -- bounded array [8]
where
  #Data4 = 8
end

schema _EAXVECTOR
  x : ℝ
  y : ℝ
  z : ℝ
where
  instance_addr ∈ ADDRESS
end

schema _EAXLISTENERPROPERTIES
  ulEnvironment : ℤ
  flEnvironmentSize : ℝ
  flEnvironmentDiffusion : ℝ
  lRoom : ℤ
  lRoomHF : ℤ
  lRoomLF : ℤ
  flDecayTime : ℝ
  flDecayHFRatio : ℝ
  flDecayLFRatio : ℝ
  lReflections : ℤ
  flReflectionsDelay : ℝ
  vReflectionsPan : EAXVECTOR
  lReverb : ℤ
  flReverbDelay : ℝ
  vReverbPan : EAXVECTOR
  flEchoTime : ℝ
  flEchoDepth : ℝ
  flModulationTime : ℝ
  flModulationDepth : ℝ
  flAirAbsorptionHF : ℝ
  flHFReference : ℝ
  flLFReference : ℝ
  flRoomRolloffFactor : ℝ
  ulFlags : ℤ
where
  instance_addr ∈ ADDRESS
end

schema _EAXBUFFERPROPERTIES
  lDirect : ℤ
  lDirectHF : ℤ
  lRoom : ℤ
  lRoomHF : ℤ
  lObstruction : ℤ
  flObstructionLFRatio : ℝ
  lOcclusion : ℤ
  flOcclusionLFRatio : ℝ
  flOcclusionRoomRatio : ℝ
  flOcclusionDirectRatio : ℝ
  lExclusion : ℤ
  flExclusionLFRatio : ℝ
  lOutsideVolumeHF : ℤ
  flDopplerFactor : ℝ
  flRolloffFactor : ℝ
  flRoomRolloffFactor : ℝ
  flAirAbsorptionFactor : ℝ
  ulFlags : ℤ
where
  instance_addr ∈ ADDRESS
end

schema _EAXOBSTRUCTIONPROPERTIES
  lObstruction : ℤ
  flObstructionLFRatio : ℝ
where
  instance_addr ∈ ADDRESS
end

schema _EAXOCCLUSIONPROPERTIES
  lOcclusion : ℤ
  flOcclusionLFRatio : ℝ
  flOcclusionRoomRatio : ℝ
  flOcclusionDirectRatio : ℝ
where
  instance_addr ∈ ADDRESS
end

schema _EAXEXCLUSIONPROPERTIES
  lExclusion : ℤ
  flExclusionLFRatio : ℝ
where
  instance_addr ∈ ADDRESS
end
