--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema cAudioScriptObject_cAudioScriptObject
  ΔcAudioScriptObject
where
  -- Deterministic transition preserving module invariants
  true
end

schema cAudioScriptObject_cAudioScriptObject_2
  ΔcAudioScriptObject
where
  -- Deterministic transition preserving module invariants
  true
end

schema cAudioScriptObject_Reset
  ΔcAudioScriptObject
where
  -- State update: AudioId' = SCRIPT_SOUND_INVALID
  -- State update: Posn' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: AudioEntity' = AEHANDLE_NONE
  true
end

schema cAudioScriptObject_LoadAllAudioScriptObjects
  ΔcAudioScriptObject
  buf? : ℙ ℕ
  size? : ℕ
where
  -- State update: p' = new(handle) cAudioScriptObject
  -- State update: p.AudioEntity' = DMAudio.CreateLoopingScriptObject(p)
  -- Invokes: DMAudio.CreateLoopingScriptObject
  true
end

schema cAudioScriptObject_SaveAllAudioScriptObjects
  ΔcAudioScriptObject
  buf? : ℙ ℕ
  size? : ℙ ℕ
where
  -- State update: pool_size' = CPools::GetAudioScriptObjectPool().GetNoOfUsedSpaces()
  -- State update: p' = CPools::GetAudioScriptObjectPool().GetSlot(i)
  -- Invokes: CPools::GetAudioScriptObjectPool
  true
end

schema AudioScriptObject_PlayOneShotScriptObject
  ΔAudioScriptObjectModuleState
  id? : ℕ
  pos? : CVector
where
  -- State update: audioScriptObject' = new cAudioScriptObject()
  -- State update: audioScriptObject.Posn' = pos
  -- State update: audioScriptObject.AudioId' = id
  -- State update: audioScriptObject.AudioEntity' = AEHANDLE_NONE
  -- Invokes: DMAudio.IsAudioInitialised, DMAudio.CreateOneShotScriptObject
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema AudioScriptObjectModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 96
end
