[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tStreamedSample
  m_nLength : ℕ
  m_nPosition : ℕ
  m_nLastPosCheckTimer : ℕ
where
  m_nLength ≥ 0
  m_nPosition ≥ 0
  m_nLastPosCheckTimer ≥ 0
end

schema cMusicManager
  m_bIsInitialised : bool8
  m_bDisabled : bool8
  m_bSetNextStation : bool8
  m_nVolumeLatency : ℕ
  m_nCurrentVolume : ℕ
  m_nMaxVolume : ℕ
  m_nAnnouncement : ℕ
  m_bAnnouncementInProgress : bool8
  m_aTracks : seq tStreamedSample  -- bounded array [TOTAL_STREAMED_SOUNDS]
  m_bResetTimers : bool8
  m_nResetTime : ℕ
  m_bRadioSetByScript : bool8
  m_nRadioStationScript : ℕ
  m_nRadioPosition : ℤ
  m_nRadioInCar : ℕ
  m_nFrontendTrack : ℕ
  m_nPlayingTrack : ℕ
  m_nUpcomingMusicMode : ℕ
  m_nMusicMode : ℕ
  m_FrontendLoopFlag : bool8
  m_bTrackChangeStarted : bool8
  m_nNextTrack : ℕ
  m_nNextLoopFlag : bool8
  m_bVerifyNextTrackStartedToPlay : bool8
  m_bGameplayAllowsRadio : bool8
  m_bRadioStreamReady : bool8
  nFramesSinceCutsceneEnded : ℤ
  m_bUserResumedGame : bool8
  m_bMusicModeChangeStarted : bool8
  m_nMusicModeToBeSet : ℕ
  m_bEarlyFrontendTrack : bool8
  aListenTimeArray : seq ℝ  -- bounded array [NUM_RADIOS]
  m_nLastTrackServiceTime : ℝ
  m_bFrontendTrackFinished : bool8
  m_bPlayInFrontend : bool8
  m_bPreviousPlayerInCar : bool8
  m_bPlayerInCar : bool8
  m_nTimer : ℕ
  m_bDoTrackService : bool8
  m_bIgnoreTimeDelay : bool8
  m_bVerifyAmbienceTrackStartedToPlay : bool8
where
  m_nVolumeLatency ≥ 0
  m_nCurrentVolume ≥ 0
  m_nMaxVolume ≥ 0
  m_nAnnouncement ≥ 0
  m_nResetTime ≥ 0
  m_nRadioStationScript ≥ 0
  m_nRadioInCar ≥ 0
  m_nFrontendTrack ≥ 0
  m_nPlayingTrack ≥ 0
  m_nUpcomingMusicMode ≥ 0
  m_nMusicMode ≥ 0
  m_nNextTrack ≥ 0
  m_nMusicModeToBeSet ≥ 0
  m_nTimer ≥ 0
end

