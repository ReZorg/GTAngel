--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHWINDOWS : seq CHAR  -- #define WITHWINDOWS #include "common.h"
MIN_DIST : ℝ  -- #define MIN_DIST 0.5f

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tMP3Entry
  aFilename : seq CHAR
  nTrackLength : ℕ
  nTrackStreamPos : ℕ
  pNext : Ref[tMP3Entry]
  pLinkPath : seq CHAR
where
  nTrackLength ≥ 0
  nTrackStreamPos ≥ 0
  #pNext ≤ 1
end

schema provider_stuff
  name : seq CHAR
  id : HPROVIDER
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema sampman_miles_comp
  Δsampman_milesModuleState
  s1? : Ref[provider_stuff]
  s2? : Ref[provider_stuff]
  result! : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema sampman_miles_add_providers
  Δsampman_milesModuleState
where
  -- State update: next' = HPROENUM_FIRST
  -- State update: id' = pi[i].id
  -- Invokes: SampleManager.SetNum3DProvidersAvailable, SampleManager.Set3DProviderName
  true
end

schema sampman_miles_release_existing
  Δsampman_milesModuleState
where
  -- State update: opened_provider' = ∅
  -- State update: _fPrevEaxRatioDestination' = 0.0f
  -- State update: _usingMilesFast2D' = FALSE
  -- State update: _fEffectsLevel' = 0.0f
  true
end

schema sampman_miles_set_new_provider
  Δsampman_milesModuleState
  index? : S32
where
  -- State update: curprovider' = index
  -- State update: _maxSamples' = MAXCHANNELS_SURROUND
  -- State update: _maxSamples' = MAXCHANNELS
  -- State update: curprovider' = -1
  -- State update: opened_provider' = providers[index].id
  -- State update: usingEAX' = 1
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = FALSE
  -- Return postcondition: result! = TRUE
  -- Invokes: SampleManager.SetSpeakerConfig
  true
end

schema sampman_miles_vfs_open_callback
  Δsampman_milesModuleState
  Filename? : seq CHAR
  FileHandle? : Ref[U32]
  result! : U32_WINAPI
where
  -- State update: FileHandle' = (U32)fopen(Filename, "rb")
  -- Return postcondition: result! = *FileHandle
  true
end

schema sampman_miles_vfs_close_callback
  Δsampman_milesModuleState
  FileHandle? : U32
  result! : void_WINAPI
where
  -- Deterministic transition preserving module invariants
  true
end

schema sampman_miles_vfs_seek_callback
  Δsampman_milesModuleState
  FileHandle? : U32
