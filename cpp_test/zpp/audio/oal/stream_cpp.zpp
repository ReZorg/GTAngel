schema stream_GetBuffer
  ΔstreamModuleState
  size? : ℕ
  result! : ℙ ℕ
where
  -- State update: BufSize' = size
  -- State update: PcmBuf' = (uint16*)malloc(BufSize)
  -- State update: BufSize' = size
  -- State update: PcmBuf' = (uint16*)realloc(PcmBuf, size)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = PcmBuf
  true
end

schema stream_SortStereo
  ΔstreamModuleState
  buf? : ADDRESS
  size? : ℕ
where
  -- State update: InBuf' = (uint16*)buf
  -- State update: OutBuf' = GetBuffer(size)
  -- State update: rightStart' = size / 4
  true
end

