schema stream_audioFileOpsThread
  ΔstreamModuleState
where
  -- State update: streamToClose' = gStreamsToClose.front()
  -- State update: stream' = gStreamsToProcess.front()
  -- State update: insertBufsAfterCheck' = false
  -- State update: stream.m_bDoSeek' = false
  -- State update: pos' = stream.m_SeekPos
  -- State update: insertBufsAfterCheck' = false
  -- Invokes: gAudioThreadCv.wait, gStreamsToProcess.size, gStreamsToClose.size, gStreamsToClose.empty, gStreamsToClose.front
  true
end

