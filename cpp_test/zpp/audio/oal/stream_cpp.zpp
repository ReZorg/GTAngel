schema CStream_Open
  ΔCStream
  filename? : seq CHAR
  overrideSampleRate? : ℕ
  result! : 𝔹
where
  -- State update: m_bDoSeek' = false
  -- State update: m_SeekPos' = 0
  -- State update: m_bPaused' = false
  -- State update: m_bActive' = false
  -- State update: m_bReset' = false
  -- State update: m_nVolume' = 0
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: m_pSoundFile->IsOpened, m_pSoundFile->GetBufferSize, m_pSoundFile->GetAvgSamplesPerSec, m_pSoundFile->GetSampleCount, m_pSoundFile->GetSampleRate
  true
end
