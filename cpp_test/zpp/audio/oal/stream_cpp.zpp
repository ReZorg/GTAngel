--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
SAMPLES_IN_LINE : seq CHAR  -- #define SAMPLES_IN_LINE (8)
VAG_LINE_SIZE : seq CHAR  -- #define VAG_LINE_SIZE (0x10)
VAG_SAMPLES_IN_LINE : seq CHAR  -- #define VAG_SAMPLES_IN_LINE (28)
VB_BLOCK_SIZE : seq CHAR  -- #define VB_BLOCK_SIZE (0x2000)
NUM_VAG_LINES_IN_BLOCK : seq CHAR  -- #define NUM_VAG_LINES_IN_BLOCK (VB_BLOCK_SIZE / VAG_LINE_SIZE)
NUM_VAG_SAMPLES_IN_BLOCK : seq CHAR  -- #define NUM_VAG_SAMPLES_IN_BLOCK (NUM_VAG_LINES_IN_BLOCK * VAG_SAMPLES_IN_LINE)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
stream_Enum_1 ::= WAVEFMT_PCM | WAVEFMT_IMA_ADPCM | WAVEFMT_XBOX_ADPCM
  -- val(WAVEFMT_PCM) = 1
  -- val(WAVEFMT_IMA_ADPCM) = 0x11
  -- val(WAVEFMT_XBOX_ADPCM) = 0x69

