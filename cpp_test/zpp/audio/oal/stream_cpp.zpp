schema CWavFile
  IDecoder  -- inherits base schema
  Size : ℕ
  NumChannels : ℕ
  SampleRate : ℕ
  ByteRate : ℕ
  BlockAlign : ℕ
  BitsPerSample : ℕ
  extra : seq ℕ  -- bounded array [2]
  m_pFile : Ref[FILE]
  m_bIsOpen : 𝔹
  m_FormatHeader : tFormatHeader
  m_DataStartOffset : ℕ
  m_nSampleCount : ℕ
  m_nSamplesPerBlock : ℕ
  m_pAdpcmBuffer : ℙ ℕ
  m_ppPcmBuffers : ℙ ℤ
  m_pAdpcmDecoders : Ref[CImaADPCMDecoder]
  WAVE : ℤ
  size : return
where
  Size ≥ 0
  NumChannels ≥ 0
  SampleRate ≥ 0
  ByteRate ≥ 0
  BlockAlign ≥ 0
  BitsPerSample ≥ 0
  #extra = 2
  #m_pFile ≤ 1
  m_DataStartOffset ≥ 0
  m_nSampleCount ≥ 0
  m_nSamplesPerBlock ≥ 0
  #m_pAdpcmBuffer ≤ 1
  #m_ppPcmBuffers ≤ 1
  #m_pAdpcmDecoders ≤ 1
end

