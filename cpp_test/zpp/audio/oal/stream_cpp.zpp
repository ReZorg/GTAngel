schema stream_DecodeSample
  ΔstreamModuleState
  adpcm? : ℕ
  result! : ℤ
where
  -- State update: step' = StepTable[StepIndex]
  -- State update: StepIndex' = Clamp(StepIndex, 0, 88)
  -- State update: delta' = step >> 3
  -- State update: delta' = -delta
  -- State update: newSample' = Sample + delta
  -- State update: Sample' = Clamp(newSample, -32768, 32767)
  -- Return postcondition: result! = Sample
  true
end

