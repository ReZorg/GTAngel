--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CChannel_InitChannels
  ΔCChannel
where
  -- State update: bChannelsCreated' = true
  true
end

schema CChannel_DestroyChannels
  ΔCChannel
where
  -- State update: bChannelsCreated' = false
  true
end

schema CChannel_CChannel
  ΔCChannel
where
  -- State update: Data' = ∅
  -- State update: DataSize' = 0
  -- State update: bIs2D' = false
  true
end

schema CChannel_SetDefault
  ΔCChannel
where
  -- State update: Pitch' = 1.0f
  -- State update: Gain' = 1.0f
  -- State update: Mix' = 0.0f
  -- State update: LoopCount' = 1
  -- State update: LastProcessedOffset' = UINT32_MAX
  -- State update: Frequency' = MAX_FREQ
  true
end

schema CChannel_Reset
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_Init
  ΔCChannel
  _id? : ℕ
  Is2D? : 𝔹
where
  -- State update: id' = _id
  -- State update: bIs2D' = true
  true
end

schema CChannel_Term
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_Start
  ΔCChannel
where
  -- State update: monoData' = (int16*)Data
  -- State update: stereoData' = (int16*)tempStereoBuffer
  true
end

schema CChannel_Stop
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_HasSource
  ΔCChannel
  result! : 𝔹
where
  -- Return postcondition: result! = alSources[id] != AL_NONE
  true
end

schema CChannel_IsUsed
  ΔCChannel
  result! : 𝔹
where
  -- Return postcondition: result! = sourceState == AL_PLAYING
  -- Return postcondition: result! = false
  true
end

schema CChannel_SetPitch
  ΔCChannel
  pitch? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetGain
  ΔCChannel
  gain? : ℝ
