-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CChannel
  id : ℕ
  Gain : ℝ
  Mix : ℝ
  Data : ADDRESS
  DataSize : ℕ
  Frequency : ℤ
  Position : seq ℝ  -- bounded array [3]
  Distances : seq ℝ  -- bounded array [2]
  LoopCount : ℤ
  LoopPoints : seq ℤ  -- bounded array [2]
  LastProcessedOffset : ℤ
  bIs2D : 𝔹
  channelsThatNeedService : ℤ
where
  id ≥ 0
  DataSize ≥ 0
  #Position = 3
  #Distances = 2
  #LoopPoints = 2
end

schema CChannel_InitChannels
  ΔCChannel
where
  -- Declared member operation CChannel::InitChannels()
  true
end

