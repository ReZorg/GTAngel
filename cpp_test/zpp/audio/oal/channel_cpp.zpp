--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CChannel_InitChannels
  ΔCChannel
where
  -- State update: bChannelsCreated' = true
  true
end

schema CChannel_DestroyChannels
  ΔCChannel
where
  -- State update: bChannelsCreated' = false
  true
end

schema CChannel_CChannel
  ΔCChannel
where
  -- State update: Data' = ∅
  -- State update: DataSize' = 0
  -- State update: bIs2D' = false
  true
end

schema CChannel_SetDefault
  ΔCChannel
where
  -- State update: Pitch' = 1.0f
  -- State update: Gain' = 1.0f
  -- State update: Mix' = 0.0f
  -- State update: LoopCount' = 1
  -- State update: LastProcessedOffset' = UINT32_MAX
  -- State update: Frequency' = MAX_FREQ
  true
end

schema CChannel_Reset
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_Init
  ΔCChannel
  _id? : ℕ
  Is2D? : 𝔹
where
  -- State update: id' = _id
  -- State update: bIs2D' = true
  true
end

schema CChannel_Term
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_Start
  ΔCChannel
where
  -- State update: monoData' = (int16*)Data
  -- State update: stereoData' = (int16*)tempStereoBuffer
  true
end

schema CChannel_Stop
  ΔCChannel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_HasSource
  ΔCChannel
  result! : 𝔹
where
  -- Return postcondition: result! = alSources[id] != AL_NONE
  true
end

schema CChannel_IsUsed
  ΔCChannel
  result! : 𝔹
where
  -- Return postcondition: result! = sourceState == AL_PLAYING
  -- Return postcondition: result! = false
  true
end

schema CChannel_SetPitch
  ΔCChannel
  pitch? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetGain
  ΔCChannel
  gain? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetVolume
  ΔCChannel
  vol? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetSampleData
  ΔCChannel
  _data? : ADDRESS
  _DataSize? : ℕ
  freq? : ℤ
where
  -- State update: Data' = _data
  -- State update: DataSize' = _DataSize
  -- State update: Frequency' = freq
  true
end

schema CChannel_SetCurrentFreq
  ΔCChannel
  freq? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetLoopCount
  ΔCChannel
  count? : ℤ
where
  -- State update: LoopCount' = count
  true
end

schema CChannel_Update
  ΔCChannel
  result! : 𝔹
where
  -- State update: LastProcessedOffset' = offset
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

schema CChannel_SetLoopPoints
  ΔCChannel
  start? : ℤ
  end? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetPosition
  ΔCChannel
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetDistances
  ΔCChannel
  max? : ℝ
  min? : ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_SetPan
  ΔCChannel
  pan? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CChannel_ClearBuffer
  ΔCChannel
where
  -- State update: Data' = ∅
  -- State update: DataSize' = 0
  true
end

schema CChannel_SetReverbMix
  ΔCChannel
  slot? : ℕ
  mix? : ℝ
where
  -- State update: Mix' = mix
  true
end

schema CChannel_UpdateReverb
  ΔCChannel
  slot? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema channelModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 295
end
