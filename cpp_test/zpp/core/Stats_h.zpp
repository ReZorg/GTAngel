--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Stats_Enum_1 ::= TOTAL_FASTEST_TIMES | TOTAL_HIGHEST_SCORES | TOTAL_BEST_POSITIONS | TOTAL_PROPERTIES
  -- val(TOTAL_FASTEST_TIMES) = 23
  -- val(TOTAL_HIGHEST_SCORES) = 5
  -- val(TOTAL_BEST_POSITIONS) = 1
  -- val(TOTAL_PROPERTIES) = 15

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CStats
  SeagullsKilled : ℤ
  DaysPassed : ℤ
  HeadsPopped : ℤ
  CommercialPassed : ℤ
  IndustrialPassed : ℤ
  SuburbanPassed : ℤ
  NumberKillFrenziesPassed : ℤ
  PeopleKilledByOthers : ℤ
  HelisDestroyed : ℤ
  PedsKilledOfThisType : seq ℤ  -- bounded array [NUM_PEDTYPES]
  TimesDied : ℤ
  TimesArrested : ℤ
  KillsSinceLastCheckpoint : ℤ
  DistanceTravelledByCar : ℝ
  DistanceTravelledByHelicoptor : ℝ
  DistanceTravelledByBike : ℝ
  DistanceTravelledByBoat : ℝ
  DistanceTravelledByPlane : ℝ
  DistanceTravelledByGolfCart : ℝ
  DistanceTravelledOnFoot : ℝ
  FlightTime : ℤ
  TimesDrowned : ℤ
  PhotosTaken : ℤ
  LoanSharks : ℝ
  StoresKnockedOff : ℝ
  MovieStunts : ℝ
  Assassinations : ℝ
  PizzasDelivered : ℝ
  GarbagePickups : ℝ
  IceCreamSold : ℝ
  TopShootingRangeScore : ℝ
  ShootingRank : ℝ
  CarsExploded : ℤ
  BoatsExploded : ℤ
  WantedStarsAttained : ℤ
  WantedStarsEvaded : ℤ
  PeopleKilledByPlayer : ℤ
  ProgressMade : ℝ
  TotalProgressInGame : ℝ
  MaximumJumpDistance : ℝ
  MaximumJumpHeight : ℝ
  MaximumJumpFlips : ℤ
  MaximumJumpSpins : ℤ
  BestStuntJump : ℤ
  NumberOfUniqueJumpsFound : ℤ
  TotalNumberOfUniqueJumps : ℤ
  PassengersDroppedOffWithTaxi : ℤ
  MoneyMadeWithTaxi : ℤ
  MissionsGiven : ℤ
  MissionsPassed : ℤ
  LastMissionPassedName : seq CHAR
  TotalLegitimateKills : ℤ
  LivesSavedWithAmbulance : ℤ
  CriminalsCaught : ℤ
  HighestLevelAmbulanceMission : ℤ
  HighestLevelVigilanteMission : ℤ
  HighestLevelFireMission : ℤ
  FiresExtinguished : ℤ
  TotalNumberKillFrenzies : ℤ
  TotalNumberMissions : ℤ
  RoundsFiredByPlayer : ℤ
  KgsOfExplosivesUsed : ℤ
  BulletsThatHit : ℤ
  BestTimeBombDefusal : ℤ
  FastestTimes : seq ℤ  -- bounded array [TOTAL_FASTEST_TIMES]
  HighestScores : seq ℤ  -- bounded array [TOTAL_HIGHEST_SCORES]
  BestPositions : seq ℤ  -- bounded array [TOTAL_BEST_POSITIONS]
  PropertyOwned : seq 𝔹  -- bounded array [TOTAL_PROPERTIES]
  NumPropertyOwned : ℤ
  PropertyDestroyed : ℤ
  HighestChaseValue : ℝ
  CheatedCount : ℤ
  ShowChaseStatOnScreen : ℤ
  PamphletMissionPassed : ℤ
  abSonyCDs : seq 𝔹  -- bounded array [1]
  BloodRingKills : ℤ
  BloodRingTime : ℤ
  FavoriteRadioStationList : seq ℝ  -- bounded array [NUM_RADIOS]
  Sprayings : ℤ
  AutoPaintingBudget : ℝ
  NoMoreHurricanes : ℤ
  FashionBudget : ℝ
  PropertyBudget : ℝ
  WeaponBudget : ℝ
  SafeHouseVisits : ℤ
  TyresPopped : ℤ
  LongestWheelie : ℤ
  LongestStoppie : ℤ
  Longest2Wheel : ℤ
  LongestWheelieDist : ℝ
  LongestStoppieDist : ℝ
  Longest2WheelDist : ℝ
  ElBurroTime : ℤ
  Record4x4One : ℤ
  Record4x4Two : ℤ
  Record4x4Three : ℤ
  Record4x4Mayhem : ℤ
  LongestFlightInDodo : ℤ
  TimeTakenDefuseMission : ℤ
  InstantHitsFiredByPlayer : ℤ
  InstantHitsHitByPlayer : ℤ
  mmRain : ℤ
  CarsCrushed : ℤ
where
  #LastMissionPassedName = 8
  #abSonyCDs = 1
end

schema CStats_Init
  ΔCStats
where
  -- Declared member operation CStats::Init(void)
  true
end

