schema sRadarTrace
  m_nColor : ℕ
  m_eBlipType : ℕ
  m_nEntityHandle : ℤ
  m_vec2DPos : CVector
  m_vecPos : CVector
  m_BlipIndex : ℕ
  m_bDim : 𝔹
  m_bInUse : 𝔹
  m_bShortRange : 𝔹
  m_unused : 𝔹
  m_Radius : ℝ
  m_wScale : ℤ
  m_eBlipDisplay : ℕ
  m_eRadarSprite : ℕ
where
  m_nColor ≥ 0
  m_eBlipType ≥ 0
  m_BlipIndex ≥ 0
  m_eBlipDisplay ≥ 0
  m_eRadarSprite ≥ 0
end

