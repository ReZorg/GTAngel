Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
TOTALNUMCHUNKS : ℝ  -- #define TOTALNUMCHUNKS 52.0f
WANT_TO_LOAD : seq CHAR  -- #define WANT_TO_LOAD TheMemoryCard.m_bWantToLoad
FOUND_GAME_TO_LOAD : seq CHAR  -- #define FOUND_GAME_TO_LOAD TheMemoryCard.b_FoundRecentSavedGameWantToLoad
CLEARMODE : seq CHAR  -- #define CLEARMODE (rwCAMERACLEARZ | rwCAMERACLEARSTENCIL)
TILE_WIDTH : ℕ  -- #define TILE_WIDTH 576
TILE_HEIGHT : ℕ  -- #define TILE_HEIGHT 432
NUM_PREALLOC_ATOMICS : ℕ  -- #define NUM_PREALLOC_ATOMICS 1800
NUM_PREALLOC_CLUMPS : ℕ  -- #define NUM_PREALLOC_CLUMPS 80
NUM_PREALLOC_FRAMES : ℕ  -- #define NUM_PREALLOC_FRAMES 2600
NUM_PREALLOC_GEOMETRIES : ℕ  -- #define NUM_PREALLOC_GEOMETRIES 850
NUM_PREALLOC_TEXDICTS : ℕ  -- #define NUM_PREALLOC_TEXDICTS 121
NUM_PREALLOC_TEXTURES : ℕ  -- #define NUM_PREALLOC_TEXTURES 1700
NUM_PREALLOC_MATERIALS : ℕ  -- #define NUM_PREALLOC_MATERIALS 2600
gbShowTimebars : seq CHAR  -- #define gbShowTimebars false

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tZonePrint
  name : seq CHAR
  area : seq CHAR
  rect : CRect
where
  #name = 11
  #area = 5
end

schema GlobalScene
  world : Ref[RpWorld]
  camera : Ref[RwCamera]
where
  #world ≤ 1
  #camera ≤ 1
end

