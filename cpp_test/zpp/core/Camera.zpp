  m_vecFixedModeUpOffSet : CVector
  m_vecCutSceneOffset : CVector
  m_cvecStartingSourceForInterPol : CVector
  m_cvecStartingTargetForInterPol : CVector
  m_cvecStartingUpForInterPol : CVector
  m_cvecSourceSpeedAtStartInter : CVector
  m_cvecTargetSpeedAtStartInter : CVector
  m_cvecUpSpeedAtStartInter : CVector
  m_vecSourceWhenInterPol : CVector
  m_vecTargetWhenInterPol : CVector
  m_vecUpWhenInterPol : CVector
  m_vecClearGeometryVec : CVector
  m_vecGameCamPos : CVector
  SourceDuringInter : CVector
  TargetDuringInter : CVector
  UpDuringInter : CVector
  m_pRwCamera : Ref[RwCamera]
  pTargetEntity : Ref[CEntity]
  m_arrPathArray : seq CCamPathSplines  -- bounded array [MAX_NUM_OF_SPLINETYPES]
  m_bGarageFixedCamPositionSet : 𝔹
  m_vecDoingSpecialInterPolation : 𝔹
  m_bScriptParametersSetForInterPol : 𝔹
  m_bFading : 𝔹
  m_bMusicFading : 𝔹
  m_viewMatrix : CMatrix
  m_vecFrustumNormals : seq CVector  -- bounded array [4]
  m_vecOldSourceForInter : CVector
  m_vecOldFrontForInter : CVector
  m_vecOldUpForInter : CVector
  m_vecOldFOVForInter : ℝ
  m_fFLOATingFade : ℝ
  m_fFLOATingFadeMusic : ℝ
  m_fTimeToFadeOut : ℝ
  m_fTimeToFadeMusic : ℝ
  m_fFractionInterToStopMoving : ℝ
  m_fFractionInterToStopCatchUp : ℝ
  m_fFractionInterToStopMovingTarget : ℝ
  m_fFractionInterToStopCatchUpTarget : ℝ
  m_fGaitSwayBuffer : ℝ
  m_fScriptPercentageInterToStopMoving : ℝ
  m_fScriptPercentageInterToCatchUp : ℝ
  m_fScriptTimeForInterPolation : ℕ
  m_iFadingDirection : ℤ
  m_iModeObbeCamIsInForCar : ℤ
  m_iModeToGoTo : ℤ
  m_iMusicFadingDirection : ℤ
  m_iTypeOfSwitch : ℤ
  m_uiFadeTimeStarted : ℕ
  m_uiFadeTimeStartedMusic : ℕ
  m_bUseMouse3rdPerson : 𝔹
  m_bUnknown : 𝔹
  unknown : ℕ
  SoundDistRightAsRead : ℝ
  SoundDistRightAsReadOld : ℝ
where
  ActiveCam ≥ 0
  m_uiCamShakeStart ≥ 0
  m_uiFirstPersonCamLastInputTime ≥ 0
  m_uiLongestTimeInMill ≥ 0
  m_uiNumberOfTrainCamNodes ≥ 0
  m_uiTransitionJUSTStarted ≥ 0
  m_uiTransitionState ≥ 0
  m_uiTimeLastChange ≥ 0
  m_uiTimeWeLeftIdle_StillNoInput ≥ 0
  m_uiTimeWeEnteredIdle ≥ 0
  m_uiTimeTransitionStart ≥ 0
  m_uiTransitionDuration ≥ 0
  m_uiTransitionDurationTargetCoors ≥ 0
  #Cams = 3
  #pToGarageWeAreIn ≤ 1
  #pToGarageWeAreInForHackAvoidFirstPerson ≤ 1
end

