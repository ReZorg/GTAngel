-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
PLAYER : seq CHAR  -- #define PLAYER (CWorld::Players[CWorld::PlayerInFocus].m_pPed)
DEFAULT_NEAR : ℝ  -- #define DEFAULT_NEAR (0.9f)
FREE_CAR_ZOOM_VALUE_1 : ℝ  -- #define FREE_CAR_ZOOM_VALUE_1 (-1.0f)
FREE_CAR_ZOOM_VALUE_2 : ℝ  -- #define FREE_CAR_ZOOM_VALUE_2 (2.0f)
FREE_CAR_ZOOM_VALUE_3 : ℝ  -- #define FREE_CAR_ZOOM_VALUE_3 (6.0f)
FREE_BOAT_ZOOM_VALUE_1 : ℝ  -- #define FREE_BOAT_ZOOM_VALUE_1 (-2.41f)
FREE_BOAT_ZOOM_VALUE_2 : ℝ  -- #define FREE_BOAT_ZOOM_VALUE_2 (6.49f)
FREE_BOAT_ZOOM_VALUE_3 : ℝ  -- #define FREE_BOAT_ZOOM_VALUE_3 (15.0f)
