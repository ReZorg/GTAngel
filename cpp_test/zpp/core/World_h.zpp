--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema World_GetCurrentScanCode
  ΔWorldModuleState
  result! : ℕ
where
  -- Return postcondition: result! = ms_nCurrentScanCode
  true
end

schema World_AdvanceCurrentScanCode
  ΔWorldModuleState
where
  -- State update: ms_nCurrentScanCode' = 1
  -- Invokes: CWorld::ClearScanCodes
  true
end

schema World_GetSectorX
  ΔWorldModuleState
  f? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = ((f - WORLD_MIN_X)/SECTOR_SIZE_X)
  true
end

schema World_GetSectorY
  ΔWorldModuleState
  f? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = ((f - WORLD_MIN_Y)/SECTOR_SIZE_Y)
  true
end

schema World_GetSectorIndexX
  ΔWorldModuleState
  f? : ℝ
  result! : ℤ
where
  -- Return postcondition: result! = (int)GetSectorX(f)
  true
end

schema World_GetSectorIndexY
  ΔWorldModuleState
  f? : ℝ
  result! : ℤ
where
  -- Return postcondition: result! = (int)GetSectorY(f)
  true
end

schema World_GetWorldX
  ΔWorldModuleState
  x? : ℤ
  result! : ℝ
where
  -- Return postcondition: result! = x*SECTOR_SIZE_X + WORLD_MIN_X
  true
end

schema World_GetWorldY
  ΔWorldModuleState
  y? : ℤ
  result! : ℝ
where
  -- Return postcondition: result! = y*SECTOR_SIZE_Y + WORLD_MIN_Y
  true
end
