  ΔCCullZone
  x? : ℝ
  y? : ℝ
where
  -- State update: rx' = sq(x - minx)
  -- State update: rx' = sq(x - maxx)
  -- State update: rx' = 0.0f
  -- State update: ry' = sq(y - miny)
  -- State update: ry' = sq(y - maxy)
  -- State update: ry' = 0.0f
  -- Return postcondition: result! = rx + ry
  true
end

