--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NUMUNCOMPRESSED : seq CHAR  -- #define NUMUNCOMPRESSED (6000)
NUMTEMPINDICES : seq CHAR  -- #define NUMTEMPINDICES (140000)
FLAG_FREE : ℕ  -- #define FLAG_FREE 1
FLAG_PROCESSED : ℕ  -- #define FLAG_PROCESSED 2

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eZoneAttribs ::= ATTRZONE_CAMCLOSEIN | ATTRZONE_STAIRS | ATTRZONE_1STPERSON | ATTRZONE_NORAIN | ATTRZONE_NOPOLICE | ATTRZONE_NOTCULLZONE | ATTRZONE_DOINEEDCOLLISION | ATTRZONE_SUBWAYVISIBLE | ATTRZONE_POLICEABANDONCARS | ATTRZONE_ROOMFORAUDIO | ATTRZONE_WATERFUDGE
  -- val(ATTRZONE_CAMCLOSEIN) = 1
  -- val(ATTRZONE_STAIRS) = 2
  -- val(ATTRZONE_1STPERSON) = 4
  -- val(ATTRZONE_NORAIN) = 8
  -- val(ATTRZONE_NOPOLICE) = 0x10
  -- val(ATTRZONE_NOTCULLZONE) = 0x20
  -- val(ATTRZONE_DOINEEDCOLLISION) = 0x40
  -- val(ATTRZONE_SUBWAYVISIBLE) = 0x80
  -- val(ATTRZONE_POLICEABANDONCARS) = 0x100
  -- val(ATTRZONE_ROOMFORAUDIO) = 0x200
  -- val(ATTRZONE_WATERFUDGE) = 0x400

