  y2? : ℝ
  x3? : ℝ
  y3? : ℝ
  x4? : ℝ
  y4? : ℝ
where
  -- State update: topLeft_x' = x1
  -- State update: topLeft_y' = y1
  -- State update: topRight_x' = x2
  -- State update: topRight_y' = y2
  -- State update: bottomLeft_x' = x3
  -- State update: bottomLeft_y' = y3
  true
