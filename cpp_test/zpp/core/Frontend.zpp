schema Frontend_SaveCurrentCoors
  ΔFrontendModuleState
where
  -- State update: old_topLeft_x' = topLeft_x
  -- State update: old_topLeft_y' = topLeft_y
  -- State update: old_topRight_x' = topRight_x
  -- State update: old_topRight_y' = topRight_y
  -- State update: old_bottomLeft_x' = bottomLeft_x
  -- State update: old_bottomLeft_y' = bottomLeft_y
  true
end

schema Frontend_Translate
  ΔFrontendModuleState
  delta? : ℤ
where
  -- State update: bottomRight_x' = delta * mult_bottomRight_x + old_bottomRight_x
  -- State update: bottomRight_y' = delta * mult_bottomRight_y + old_bottomRight_y
  -- State update: bottomLeft_x' = delta * mult_bottomLeft_x + old_bottomLeft_x
  -- State update: bottomLeft_y' = delta * mult_bottomLeft_y + old_bottomLeft_y
  -- State update: topRight_x' = delta * mult_topRight_x + old_topRight_x
  -- State update: topRight_y' = delta * mult_topRight_y + old_topRight_y
  true
end

schema Frontend_UpdateMultipliers
  ΔFrontendModuleState
where
  -- State update: mult_bottomRight_x' = (bottomRight_x - old_bottomRight_x) / 255.0f
  -- State update: mult_bottomRight_y' = (bottomRight_y - old_bottomRight_y) / 255.0f
  -- State update: mult_bottomLeft_x' = (bottomLeft_x - old_bottomLeft_x) / 255.0f
  -- State update: mult_bottomLeft_y' = (bottomLeft_y - old_bottomLeft_y) / 255.0f
  -- State update: mult_topRight_x' = (topRight_x - old_topRight_x) / 255.0f
  -- State update: mult_topRight_y' = (topRight_y - old_topRight_y) / 255.0f
  true
end

schema Frontend_GetIsMenuActive
  ΔFrontendModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = !!m_bMenuActive
  true
end

schema Frontend_CMenuManager
  ΔFrontendModuleState
