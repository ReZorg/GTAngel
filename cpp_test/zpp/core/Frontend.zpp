--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tSkinInfo
  skinId : ℤ
  skinNameDisplayed : seq CHAR
  skinNameOriginal : seq CHAR
  date : seq CHAR
  nextSkin : Ref[tSkinInfo]
where
  #skinNameDisplayed = 256
  #skinNameOriginal = 256
  #date = 256
  #nextSkin ≤ 1
end

schema BottomBarOption
  name : seq CHAR
  screenId : ℤ
where
  #name = 8
end

schema CMenuScreen
  m_ScreenName : seq CHAR
  unk : ℤ
  m_PreviousPage : seq ℤ  -- bounded array [2]
  m_ParentEntry : seq ℤ  -- bounded array [2]
  m_EntryName : seq CHAR
  m_SaveSlot : ℤ
  m_TargetMenu : ℤ
  m_X : ℕ
  m_Y : ℕ
  m_Align : ℕ
where
  #m_ScreenName = 8
  #m_PreviousPage = 2
  #m_ParentEntry = 2
  #m_EntryName = 8
  m_X ≥ 0
  m_Y ≥ 0
  m_Align ≥ 0
end

schema CMenuEntry
  m_Action : ℤ
  m_EntryName : seq CHAR
  m_SaveSlot : ℤ
  m_TargetMenu : ℤ
where
  #m_EntryName = 8
end

schema CCustomScreenLayout
  startX : ℤ
  startY : ℤ
  lineHeight : ℤ
  showLeftRightHelper : 𝔹
  noInvasiveBorders : 𝔹
  xMargin : ℤ
  sprite : eMenuSprites
  columnWidth : ℤ
  headerHeight : ℤ
  font : ℤ
  alignment : ℤ
  fontScaleX : ℝ
  fontScaleY : ℝ
where
  instance_addr ∈ ADDRESS
end

schema CCFO
  value : ADDRESS
  saveCat : seq CHAR
  save : seq CHAR
where
  instance_addr ∈ ADDRESS
end

schema CCFOSelect
  CCFO  -- inherits base schema
  rightTexts : seq CHAR
  numRightTexts : ℤ
  onlyApplyOnEnter : 𝔹
  displayedValue : ℤ
  lastSavedValue : ℤ
  changeFunc : ChangeFunc
  disableIfGameLoaded : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CCFOSelect_CCFOSelect
  ΔCCFOSelect
where
  -- Declared member operation CCFOSelect::CCFOSelect()
  true
end

schema CCFOSelect_CCFOSelect_2
