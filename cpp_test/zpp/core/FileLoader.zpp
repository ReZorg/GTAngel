end

schema CFileLoader_LoadTexDictionary
  ΔCFileLoader
  filename? : seq CHAR
where
  -- State update: txd' = ∅
  -- State update: stream' = RwStreamOpen(rwSTREAMFILENAME, rwSTREAMREAD, filename)
  -- State update: txd' = RwTexDictionaryGtaStreamRead(stream)
  -- State update: txd' = RwTexDictionaryCreate()
  -- Return postcondition: result! = txd
  true
end

schema CFileLoader_LoadCollisionFile
  ΔCFileLoader
  filename? : seq CHAR
where
  -- State update: fd' = CFileMgr::OpenFile(filename, "rb")
  -- State update: mi' = CModelInfo::GetModelInfo(modelname, ∅)
  -- State update: model' = new CColModel
  -- Invokes: CFileMgr::OpenFile, CFileMgr::Read, CModelInfo::GetModelInfo, mi->GetColModel, mi->SetColModel
  true
end

schema CFileLoader_LoadCollisionModel
  ΔCFileLoader
  buf? : ℙ ℕ
  model? : CColModel
  modelname? : seq CHAR
where
  -- State update: model.boundingSphere.radius' = Max(*(float*)(buf), 0.1f)
  -- State update: model.boundingSphere.center.x' = *(float*)(buf+4)
  -- State update: model.boundingSphere.center.y' = *(float*)(buf+8)
  -- State update: model.boundingSphere.center.z' = *(float*)(buf+12)
  -- State update: model.boundingBox.min.x' = *(float*)(buf+16)
  -- State update: model.boundingBox.min.y' = *(float*)(buf+20)
  true
end

