where
  -- Deterministic transition preserving module invariants
  true
end

schema CFileLoader_LoadLevel
  ΔCFileLoader
  filename? : seq CHAR
where
  -- State update: savedTxd' = RwTexDictionaryGetCurrent()
  -- State update: objectsLoaded' = false
  -- State update: savedLevel' = CGame::currLevel
  -- State update: savedTxd' = RwTexDictionaryCreate()
  -- State update: fd' = CFileMgr::OpenFile(filename, "r")
  -- State update: fd' = CFileMgr::OpenFile(filename, "r")
  -- Invokes: CFileMgr::ChangeDir, CFileMgr::OpenFile, CModelInfo::ConstructMloClumps, CObjectData::Initialise, CFileMgr::CloseFile
  true
end

