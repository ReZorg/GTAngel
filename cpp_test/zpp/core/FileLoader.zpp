schema FileLoader_SetModelInfoFlags
  ΔFileLoaderModuleState
  mi? : Ref[CSimpleModelInfo]
  flags? : ℕ
where
  -- State update: mi.m_normalCull' = !!(flags & 1)
  -- State update: mi.m_noFade' = !!(flags & 2)
  -- State update: mi.m_drawLast' = !!(flags & (4|8))
  -- State update: mi.m_additive' = !!(flags & 8)
  -- State update: mi.m_isSubway' = !!(flags & 0x10)
  -- State update: mi.m_ignoreLight' = !!(flags & 0x20)
  -- Invokes: mi->GetModelName
  true
end

