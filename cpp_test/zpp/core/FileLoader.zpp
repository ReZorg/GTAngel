--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
FileLoader_Enum_1 ::= NONE | OBJS | MLO | TOBJ | WEAP | HIER | CARS | PEDS | PATH | TWODFX

FileLoader_Enum_2 ::= NONE | INST | ZONE | CULL | OCCL | PICK | PATH

FileLoader_Enum_3 ::= NONE | INST | ZONE | CULL | PICK | PATH

FileLoader_Enum_4 ::= NONE | PATH

FileLoader_Enum_5 ::= NONE | OBJS | TOBJ | TWODFX

