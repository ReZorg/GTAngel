schema CWorld_ClearScanCodes
  ΔCWorld
where
  -- State update: s' = &ms_aSectors[i][j]
  -- State update: node' = s.m_lists[ENTITYLIST_BUILDINGS].first
  -- State update: m_scanCode' = 0
  -- State update: node' = s.m_lists[ENTITYLIST_VEHICLES].first
  -- State update: m_scanCode' = 0
  -- State update: node' = s.m_lists[ENTITYLIST_PEDS].first
  true
end

schema CWorld_ClearExcitingStuffFromArea
  ΔCWorld
  pos? : CVector
  radius? : ℝ
  bRemoveProjectilesAndTidyUpShadows? : 𝔹
where
  -- State update: pedPool' = CPools::GetPedPool()
  -- State update: pPed' = pedPool.GetSlot(i)
  -- State update: VehiclePool' = CPools::GetVehiclePool()
  -- State update: pVehicle' = VehiclePool.GetSlot(i)
  -- State update: pVehicle.pDriver' = ∅
  -- Invokes: CPools::GetPedPool, pedPool->GetSize, pedPool->GetSlot, pPed->IsPlayer, pPed->CanBeDeleted
  true
end

schema CWorld_CameraToIgnoreThisObject
  ΔCWorld
  ent? : Ref[CEntity]
where
  -- Return postcondition: result! = false
  -- Return postcondition: result! = ((CObject *)ent)->m_bCameraToAvoidThisObject != 1
  -- Invokes: CGarages::IsModelIndexADoor, ent->GetModelIndex
  true
end

schema CWorld_ProcessLineOfSight
  ΔCWorld
  point1? : CVector
  point2? : CVector
  point? : ℤ
  entity? : Ref[CEntity]
  checkBuildings? : 𝔹
  checkVehicles? : 𝔹
  checkPeds? : 𝔹
  checkObjects? : 𝔹
  checkDummies? : 𝔹
  ignoreSeeThrough? : 𝔹
  ignoreSomeObjects? : 𝔹
  ignoreShootThrough? : 𝔹
where
  -- State update: entity' = ∅
  -- State update: dist' = 1.0f
  -- State update: xstart' = GetSectorIndexX(point1.x)
  -- State update: ystart' = GetSectorIndexY(point1.y)
  -- State update: xend' = GetSectorIndexX(point2.x)
  -- State update: yend' = GetSectorIndexY(point2.y)
  -- Return postcondition: result! = ProcessLineOfSightSector(*GetSector(xstart, ystart), LOSARGS)
  -- Return postcondition: result! = dist < 1.0f
  -- Return postcondition: result! = dist < 1.0f
  true
end

schema CWorld_ProcessLineOfSightSector
  ΔCWorld
  sector? : CSector
  line? : CColLine
  point? : ℤ
  dist? : ℝ
  entity? : Ref[CEntity]
  checkBuildings? : 𝔹
  checkVehicles? : 𝔹
  checkPeds? : 𝔹
  checkObjects? : 𝔹
  checkDummies? : 𝔹
  ignoreSeeThrough? : 𝔹
  ignoreSomeObjects? : 𝔹
  ignoreShootThrough? : 𝔹
where
  -- State update: mindist' = dist
  -- State update: deadPeds' = !!bIncludeDeadPeds
  -- State update: bikers' = !!bIncludeBikers
  -- State update: bIncludeDeadPeds' = false
  -- State update: bIncludeBikers' = false
  -- State update: bIncludeDeadPeds' = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  true
end

schema CWorld_ProcessLineOfSightSectorList
  ΔCWorld
  list? : CPtrList
