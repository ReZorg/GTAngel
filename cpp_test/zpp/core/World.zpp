--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
OBJECT_REPOSITION_OFFSET_Z : ℝ  -- #define OBJECT_REPOSITION_OFFSET_Z 2.0f
LOSARGS : seq CHAR  -- #define LOSARGS 
SECTOR_SIZE_X : ℝ  -- #define SECTOR_SIZE_X (40.0f)
SECTOR_SIZE_Y : ℝ  -- #define SECTOR_SIZE_Y (40.0f)
NUMSECTORS_X : seq CHAR  -- #define NUMSECTORS_X (100)
NUMSECTORS_Y : seq CHAR  -- #define NUMSECTORS_Y (100)
WORLD_SIZE_X : seq CHAR  -- #define WORLD_SIZE_X (NUMSECTORS_X * SECTOR_SIZE_X)
WORLD_SIZE_Y : seq CHAR  -- #define WORLD_SIZE_Y (NUMSECTORS_Y * SECTOR_SIZE_Y)
WORLD_MIN_X : ℝ  -- #define WORLD_MIN_X (-2000.0f)
WORLD_MIN_Y : ℝ  -- #define WORLD_MIN_Y (-2000.0f)
WORLD_MAX_X : seq CHAR  -- #define WORLD_MAX_X (WORLD_MIN_X + WORLD_SIZE_X)
WORLD_MAX_Y : seq CHAR  -- #define WORLD_MAX_Y (WORLD_MIN_Y + WORLD_SIZE_Y)
MAP_Z_LOW_LIMIT : ℝ  -- #define MAP_Z_LOW_LIMIT -100.0f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
World_Enum_1 ::= ENTITYLIST_BUILDINGS | ENTITYLIST_BUILDINGS_OVERLAP | ENTITYLIST_MULTIPLAYER | ENTITYLIST_OBJECTS | ENTITYLIST_OBJECTS_OVERLAP | ENTITYLIST_VEHICLES | ENTITYLIST_VEHICLES_OVERLAP | ENTITYLIST_PEDS | ENTITYLIST_PEDS_OVERLAP | ENTITYLIST_DUMMIES | ENTITYLIST_DUMMIES_OVERLAP | NUMSECTORENTITYLISTS

World_Enum_2 ::= ENTITYLIST_BUILDINGS | ENTITYLIST_BUILDINGS_OVERLAP | ENTITYLIST_OBJECTS | ENTITYLIST_OBJECTS_OVERLAP | ENTITYLIST_VEHICLES | ENTITYLIST_VEHICLES_OVERLAP | ENTITYLIST_PEDS | ENTITYLIST_PEDS_OVERLAP | ENTITYLIST_DUMMIES | ENTITYLIST_DUMMIES_OVERLAP | NUMSECTORENTITYLISTS

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CSector
  m_lists : seq CPtrList  -- bounded array [NUMSECTORENTITYLISTS]
where
  instance_addr ∈ ADDRESS
end

schema CWorld
  ms_bigBuildingsList : seq CPtrList  -- bounded array [NUM_LEVELS]
  ms_listMovingEntityPtrs : CPtrList
  ms_nCurrentScanCode : ℕ
  PlayerInFocus : ℕ
  Players : seq CPlayerInfo  -- bounded array [NUMPLAYERS]
  pIgnoreEntity : Ref[CEntity]
  bIncludeDeadPeds : 𝔹
  bNoMoreCollisionTorque : 𝔹
  bSecondShift : 𝔹
  bForceProcessControl : 𝔹
  bProcessCutsceneOnly : 𝔹
  bDoingCarCollisions : 𝔹
  bIncludeCarTyres : 𝔹
  bIncludeBikers : 𝔹
  m_aTempColPts : seq ℤ  -- bounded array [MAX_COLLISION_POINTS]
where
  ms_nCurrentScanCode ≥ 0
  PlayerInFocus ≥ 0
  #pIgnoreEntity ≤ 1
end

