schema CWorld_Initialise
  ΔCWorld
where
  -- State update: pIgnoreEntity' = ∅
  -- State update: bDoingCarCollisions' = false
  -- State update: bSecondShift' = false
  -- State update: bNoMoreCollisionTorque' = false
  -- State update: bProcessCutsceneOnly' = false
  -- State update: bIncludeDeadPeds' = false
  -- Invokes: CPools::Initialise
  true
end

