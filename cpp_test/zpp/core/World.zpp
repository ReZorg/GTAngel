  dist? : ℝ
  entity? : Ref[CEntity]
  ignoreSeeThrough? : 𝔹
  ignoreSomeObjects? : 𝔹
  ignoreShootThrough? : 𝔹
where
  -- State update: deadPeds' = false
  -- State update: bikers' = false
  -- State update: carTyres' = false
  -- State update: mindist' = dist
  -- State update: carTyres' = true
  -- State update: tyreCol.numTriangles' = 0
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: e->IsPed, m_pMyVehicle->IsBike, m_pMyVehicle->IsBoat, CModelInfo::GetModelInfo, e->GetModelIndex
  true
end

