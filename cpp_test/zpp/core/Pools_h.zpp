schema CPools
  ms_pPtrNodePool : Ref[CCPtrNodePool]
  ms_pEntryInfoNodePool : Ref[CEntryInfoNodePool]
  ms_pPedPool : Ref[CPedPool]
  ms_pVehiclePool : Ref[CVehiclePool]
  ms_pBuildingPool : Ref[CBuildingPool]
  ms_pTreadablePool : Ref[CTreadablePool]
  ms_pObjectPool : Ref[CObjectPool]
  ms_pDummyPool : Ref[CDummyPool]
  ms_pAudioScriptObjectPool : Ref[CAudioScriptObjectPool]
  ms_pColModelPool : Ref[CColModelPool]
where
  #ms_pPtrNodePool ≤ 1
  #ms_pEntryInfoNodePool ≤ 1
  #ms_pPedPool ≤ 1
  #ms_pVehiclePool ≤ 1
  #ms_pBuildingPool ≤ 1
  #ms_pTreadablePool ≤ 1
  #ms_pObjectPool ≤ 1
  #ms_pDummyPool ≤ 1
  #ms_pAudioScriptObjectPool ≤ 1
  #ms_pColModelPool ≤ 1
end

