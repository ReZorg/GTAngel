[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CClock
  ms_nGameClockHours : ℕ
  ms_nGameClockMinutes : ℕ
  ms_nGameClockSeconds : ℕ
  ms_Stored_nGameClockHours : ℕ
  ms_Stored_nGameClockMinutes : ℕ
  ms_Stored_nGameClockSeconds : ℕ
  ms_nMillisecondsPerGameMinute : ℕ
  ms_nLastClockTick : ℕ
  ms_bClockHasBeenStored : 𝔹
  ms_EnvMapTimeMultiplicator : ℝ
where
  ms_nGameClockHours ≥ 0
  ms_nGameClockMinutes ≥ 0
  ms_nGameClockSeconds ≥ 0
  ms_Stored_nGameClockHours ≥ 0
  ms_Stored_nGameClockMinutes ≥ 0
  ms_Stored_nGameClockSeconds ≥ 0
  ms_nMillisecondsPerGameMinute ≥ 0
  ms_nLastClockTick ≥ 0
end

schema CClock_Initialise
  ΔCClock
  scale? : ℕ
where
  -- Declared member operation CClock::Initialise(uint32 scale)
  true
end

