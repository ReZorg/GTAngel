  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  true
end

schema General_faststricmp
  ΔGeneralModuleState
  str1? : seq CHAR
  str2? : seq CHAR
  result! : 𝔹
where
  -- Return postcondition: result! = true
  -- Return postcondition: result! = *str2 != '\0'
  true
end

schema General_SolveQuadratic
  ΔGeneralModuleState
  a? : ℝ
  b? : ℝ
  c? : ℝ
  root1? : ℝ
  root2? : ℝ
  result! : 𝔹
where
  -- State update: discriminant' = b * b - 4.f * a * c
  -- State update: discriminantSqrt' = Sqrt(discriminant)
  -- State update: root2' = (-b + discriminantSqrt) / (2.f * a)
  -- State update: root1' = (-b - discriminantSqrt) / (2.f * a)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

schema General_GetRandomNumber
  ΔGeneralModuleState
  result! : ℕ
where
  -- Return postcondition: result! = myrand() & MYRAND_MAX
  true
end

schema General_GetRandomTrueFalse
  ΔGeneralModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = GetRandomNumber() < MYRAND_MAX / 2
  true
end

schema General_GetRandomNumberInRange
  ΔGeneralModuleState
  low? : ℝ
  high? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = low + (high - low)*(GetRandomNumber()/float(MYRAND_MAX + 1))
  true
end

schema General_GetRandomNumberInRange_2
  ΔGeneralModuleState
  low? : ℤ
  high? : ℤ
  result! : ℤ
where
  -- Return postcondition: result! = low + (high - low)*(GetRandomNumber()/float(MYRAND_MAX + 1))
  true
end

schema General_SetRandomSeed
  ΔGeneralModuleState
  seed? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end
