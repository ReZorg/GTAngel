--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema General_GetATanOfXY
  ΔGeneralModuleState
  x? : ℝ
  y? : ℝ
  result! : ℝ
where
  -- State update: xabs' = Abs(x)
  -- State update: yabs' = Abs(y)
  -- Return postcondition: result! = 0.0f
  -- Return postcondition: result! = 0.5f*PI - Atan2(x / y, 1.0f)
  -- Return postcondition: result! = 0.5f*PI + Atan2(-x / y, 1.0f)
  true
end

schema General_LimitAngle
  ΔGeneralModuleState
  angle? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = result
  true
end

schema General_LimitRadianAngle
  ΔGeneralModuleState
  angle? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = result
  true
end

schema General_GetRadianAngleBetweenPoints
  ΔGeneralModuleState
  x1? : ℝ
  y1? : ℝ
  x2? : ℝ
  y2? : ℝ
  result! : ℝ
where
  -- State update: x' = x2 - x1
  -- State update: y' = y2 - y1
  -- State update: y' = 0.0001f
  -- Return postcondition: result! = PI - Atan2(x / y, 1.0f)
  -- Return postcondition: result! = -Atan2(x / y, 1.0f)
  -- Return postcondition: result! = -(PI + Atan2(x / y, 1.0f))
  true
end

schema General_GetAngleBetweenPoints
  ΔGeneralModuleState
  x1? : ℝ
  y1? : ℝ
  x2? : ℝ
  y2? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = RADTODEG(GetRadianAngleBetweenPoints(x1, y1, x2, y2))
  true
end

schema General_GetNodeHeadingFromVector
  ΔGeneralModuleState
  x? : ℝ
  y? : ℝ
  result! : ℤ
where
  -- State update: angle' = CGeneral::GetRadianAngleBetweenPoints(x, y, 0.0f, 0.0f)
  -- State update: angle' = DEGTORAD(22.5f) + TWOPI - angle
  -- Return postcondition: result! = (int)Floor(angle / DEGTORAD(45.0f))
  -- Invokes: CGeneral::GetRadianAngleBetweenPoints
  true
end

schema General_faststrcmp
  ΔGeneralModuleState
  str1? : seq CHAR
  str2? : seq CHAR
  result! : 𝔹
where
  -- Return postcondition: result! = true
  -- Return postcondition: result! = *str2 != '\0'
  true
end

