--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHDINPUT : seq CHAR  -- #define WITHDINPUT #include "common.h"
CURMODE : seq CHAR  -- #define CURMODE (IsAffectedByController ? Mode : 0)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Pad_Enum_1 ::= PLAYERCONTROL_ENABLED | PLAYERCONTROL_CAMERA | PLAYERCONTROL_UNK2 | PLAYERCONTROL_GARAGE | PLAYERCONTROL_UNK8 | PLAYERCONTROL_UNK10 | PLAYERCONTROL_PLAYERINFO | PLAYERCONTROL_PHONE | PLAYERCONTROL_CUTSCENE | PLAYERCONTROL_SHORTCUT_TAXI
