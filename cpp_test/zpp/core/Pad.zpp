where
  -- State update: axis' = GetPad(0).NewState.RightStickY
  -- State update: axis' = -axis
  -- State update: axis' = -axis
  -- Return postcondition: result! = (int16) ( (axis + ( ( axis > 0 ) ? -85 : 85) ) * (127.0f / 32.0f) )
  -- Return postcondition: result! = (int16) ( (axis + ( ( axis > 0 ) ? -40 : 40) ) * (127.0f / 64.0f) )
  -- Return postcondition: result! = 0
  true
end

