  -- val(PLAYERCONTROL_CAMERA) = 1
  -- val(PLAYERCONTROL_UNK2) = 2
  -- val(PLAYERCONTROL_GARAGE) = 4
  -- val(PLAYERCONTROL_UNK8) = 8
  -- val(PLAYERCONTROL_UNK10) = 16
  -- val(PLAYERCONTROL_PLAYERINFO) = 32
  -- val(PLAYERCONTROL_PHONE) = 64
  -- val(PLAYERCONTROL_CUTSCENE) = 128
  -- val(PLAYERCONTROL_SHORTCUT_TAXI) = 256

Pad_Enum_2 ::= PAD1 | PAD2 | MAX_PADS
  -- val(PAD1) = 0

Pad_Enum_3 ::= HORNHISTORY_SIZE | DRUNK_STEERING_BUFFER_SIZE
  -- val(HORNHISTORY_SIZE) = 8
  -- val(DRUNK_STEERING_BUFFER_SIZE) = 10

Pad_Enum_4 ::= PLAYERCONTROL_ENABLED | PLAYERCONTROL_CAMERA | PLAYERCONTROL_UNK2 | PLAYERCONTROL_GARAGE | PLAYERCONTROL_UNK8 | PLAYERCONTROL_UNK10 | PLAYERCONTROL_PLAYERINFO | PLAYERCONTROL_PHONE | PLAYERCONTROL_CUTSCENE
