--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eLevelName ::= LEVEL_IGNORE | LEVEL_GENERIC | LEVEL_BEACH | LEVEL_MAINLAND | LEVEL_COMMERCIAL | LEVEL_SUBURBAN | LEVEL_UNDERGROUND
  -- val(LEVEL_IGNORE) = -1
  -- val(LEVEL_GENERIC) = 0

eAreaName ::= AREA_MAIN_MAP | AREA_HOTEL | AREA_MANSION | AREA_BANK | AREA_MALL | AREA_STRIP_CLUB | AREA_LAWYERS | AREA_COFFEE_SHOP | AREA_CONCERT_HALL | AREA_STUDIO | AREA_RIFLE_RANGE | AREA_BIKER_BAR | AREA_POLICE_STATION | AREA_EVERYWHERE | AREA_DIRT | AREA_BLOOD | AREA_OVALRING | AREA_MALIBU_CLUB | AREA_PRINT_WORKS

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema SkyDataPrefix
  pktSize1 : ℕ
  data : ℕ
  pktSize2 : ℕ
  unused : ℕ
where
  pktSize1 ≥ 0
  data ≥ 0
  pktSize2 ≥ 0
  unused ≥ 0
end

schema DMAGIFUpload
  tag1_addr : ℕ
  vif_direct1 : ℕ
  giftag : seq ℕ  -- bounded array [4]
  gs_bitbltbuf : seq ℕ  -- bounded array [4]
  tag2_addr : ℕ
  vif_direct2 : ℕ
where
  tag1_addr ≥ 0
  vif_direct1 ≥ 0
  #giftag = 4
  #gs_bitbltbuf = 4
  tag2_addr ≥ 0
  vif_direct2 ≥ 0
end

schema CGame
  currLevel : eLevelName
  currArea : ℤ
  bDemoMode : 𝔹
  nastyGame : 𝔹
  frenchGame : 𝔹
  germanGame : 𝔹
  japaneseGame : 𝔹
  playingIntro : 𝔹
  aDatFile : seq CHAR
  VarUpdatePlayerCoords : bool8
where
  #aDatFile = 32
end

