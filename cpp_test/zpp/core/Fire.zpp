schema CFire
  m_bIsOngoing : 𝔹
  m_bIsScriptFire : 𝔹
  m_bPropagationFlag : 𝔹
  m_bAudioSet : 𝔹
  m_vecPos : CVector
  m_pEntity : Ref[CEntity]
  m_pSource : Ref[CEntity]
  m_nExtinguishTime : ℕ
  m_nStartTime : ℕ
  m_nNextTimeToAddFlames : ℕ
  m_fStrength : ℝ
  m_fWaterExtinguishCountdown : ℝ
  m_bExtinguishedWithWater : 𝔹
  field_20 : ℤ
  m_nFiremenPuttingOut : ℕ
where
  #m_pEntity ≤ 1
  #m_pSource ≤ 1
  m_nExtinguishTime ≥ 0
  m_nStartTime ≥ 0
  m_nNextTimeToAddFlames ≥ 0
  m_nFiremenPuttingOut ≥ 0
end

