--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Game_IsInInterior
  ΔGameModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = currArea != AREA_MAIN_MAP
  true
end

schema Game_IsAreaVisible
  ΔGameModuleState
  area? : ℤ
  result! : 𝔹
where
  -- Return postcondition: result! = area == CGame::currArea || area == AREA_EVERYWHERE
  true
end
