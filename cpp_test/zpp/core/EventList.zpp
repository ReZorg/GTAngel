--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
EventList_Enum_1 ::= EVENT_STATE_0 | EVENT_STATE_CANDELETE | EVENT_STATE_CLEAR

eEventType ::= EVENT_NULL | EVENT_ASSAULT | EVENT_RUN_REDLIGHT | EVENT_ASSAULT_POLICE | EVENT_GUNSHOT | EVENT_INJURED_PED | EVENT_DEAD_PED | EVENT_FIRE | EVENT_STEAL_CAR | EVENT_HIT_AND_RUN | EVENT_HIT_AND_RUN_COP | EVENT_SHOOT_PED | EVENT_SHOOT_COP | EVENT_EXPLOSION | EVENT_PED_SET_ON_FIRE | EVENT_COP_SET_ON_FIRE | EVENT_CAR_SET_ON_FIRE | EVENT_ASSAULT_NASTYWEAPON | EVENT_ASSAULT_NASTYWEAPON_POLICE | EVENT_UNK | EVENT_ICECREAM | EVENT_ATM | EVENT_SHOPSTALL | EVENT_SHOPWINDOW | EVENT_LAST_EVENT

eEventEntity ::= EVENT_ENTITY_NONE | EVENT_ENTITY_PED | EVENT_ENTITY_VEHICLE | EVENT_ENTITY_OBJECT

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CEvent
  type : eEventType
  entityType : eEventEntity
  entityRef : ℤ
  criminal : Ref[CPed]
  posn : CVector
  timeout : ℕ
  state : ℤ
where
  #criminal ≤ 1
  timeout ≥ 0
end

schema CEventList
  ms_nFirstFreeSlotIndex : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CEventList_Initialise
  ΔCEventList
where
  -- Declared member operation CEventList::Initialise(void)
  true
end

schema CEventList_Update_2
  ΔCEventList
where
  -- Declared member operation CEventList::Update(void)
  true
end

schema CEventList_RegisterEvent_3
  ΔCEventList
  type? : eEventType
  entityType? : eEventEntity
  ent? : Ref[CEntity]
  criminal? : Ref[CPed]
  timeout? : ℤ
where
  -- Declared member operation CEventList::RegisterEvent(eEventType type, eEventEntity entityType, CEntity *ent, CPed *criminal, int32 timeout)
  true
end

schema CEventList_RegisterEvent_4
  ΔCEventList
  type? : eEventType
  posn? : CVector
  timeout? : ℤ
where
  -- Declared member operation CEventList::RegisterEvent(eEventType type, CVector posn, int32 timeout)
  true
end

schema CEventList_GetEvent_5
  ΔCEventList
  type? : eEventType
  event? : ℙ ℤ
  result! : 𝔹
where
  -- Declared member operation CEventList::GetEvent(eEventType type, int32 *event)
  true
end

schema CEventList_ClearEvent_6
  ΔCEventList
  event? : ℤ
where
  -- Declared member operation CEventList::ClearEvent(int32 event)
  true
end

schema CEventList_FindClosestEvent_7
  ΔCEventList
  type? : eEventType
  posn? : CVector
  event? : ℙ ℤ
  result! : 𝔹
where
  -- Declared member operation CEventList::FindClosestEvent(eEventType type, CVector posn, int32 *event)
  true
end

schema CEventList_ReportCrimeForEvent_8
  ΔCEventList
  type? : eEventType
  arg_2? : ℤ
  arg_3? : 𝔹
where
  -- Declared member operation CEventList::ReportCrimeForEvent(eEventType type, intptr, bool)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CEventList_Initialise
  ΔCEventList
where
  -- State update: type' = EVENT_∅
  -- State update: entityType' = EVENT_ENTITY_NONE
  -- State update: entityRef' = 0
  -- State update: posn.x' = 0.0f
  -- State update: posn.y' = 0.0f
  -- State update: posn.z' = 0.0f
  true
end

schema CEventList_Update
  ΔCEventList
where
  -- State update: ms_nFirstFreeSlotIndex' = 0
  -- State update: type' = EVENT_∅
  -- State update: state' = EVENT_STATE_0
  -- State update: state' = EVENT_STATE_CANDELETE
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CEventList_RegisterEvent
  ΔCEventList
  type? : eEventType
  entityType? : eEventEntity
  ent? : Ref[CEntity]
  criminal? : Ref[CPed]
  timeout? : ℤ
where
  -- State update: copsDontCare' = false
  -- State update: ref' = CPools::GetPedRef((CPed*)ent)
  -- State update: copsDontCare' = true
  -- State update: ref' = CPools::GetVehicleRef((CVehicle*)ent)
  -- State update: ref' = CPools::GetObjectRef((CObject*)ent)
  -- State update: ref' = 0
  -- Invokes: gAccidentManager.ReportAccident, CPools::GetPedRef, ent->GetModelIndex, CPools::GetVehicleRef, CPools::GetObjectRef
  true
end

schema CEventList_RegisterEvent_2
  ΔCEventList
  type? : eEventType
  posn? : CVector
  timeout? : ℤ
where
  -- State update: timeout' = CTimer::GetTimeInMilliseconds() + timeout
  -- State update: ms_nFirstFreeSlotIndex' = i
  -- State update: type' = type
  -- State update: entityType' = EVENT_ENTITY_NONE
  -- State update: timeout' = CTimer::GetTimeInMilliseconds() + timeout
  -- State update: posn' = posn
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CEventList_GetEvent
  ΔCEventList
  type? : eEventType
  event? : ℙ ℤ
where
  -- State update: event' = i
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  true
end

schema CEventList_ClearEvent
  ΔCEventList
  event? : ℤ
where
  -- State update: state' = EVENT_STATE_CLEAR
  true
end

schema CEventList_FindClosestEvent
  ΔCEventList
  type? : eEventType
  posn? : CVector
  event? : ℙ ℤ
where
  -- State update: found' = false
  -- State update: mindist' = 60.0f
  -- State update: dist' = (posn - gaEvent[i].posn).Magnitude()
  -- State update: mindist' = dist
  -- State update: found' = true
  -- State update: event' = i
  -- Return postcondition: result! = found
  true
end

schema CEventList_ReportCrimeForEvent
  ΔCEventList
  type? : eEventType
  crimeId? : ℤ
  copsDontCare? : 𝔹
where
  -- State update: crime' = CRIME_HIT_PED
  -- State update: crime' = CRIME_RUN_REDLIGHT
  -- State update: crime' = CRIME_HIT_COP
  -- State update: crime' = CRIME_POSSESSION_GUN
  -- State update: crime' = CRIME_STEAL_CAR
  -- State update: crime' = CRIME_RUNOVER_PED
  -- Invokes: m_pWanted->GetWantedLevel, CMessages::AddBigMessage, TheText.Get, CWanted::WorkOutPolicePresence, m_pWanted->RegisterCrime_Immediately
  true
end
