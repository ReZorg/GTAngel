--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPlayerInfo_Clear
  ΔCPlayerInfo
where
  -- State update: m_pPed' = ∅
  -- State update: m_pRemoteVehicle' = ∅
  -- State update: m_pVehicleEx.bUsingSpecialColModel' = false
  -- State update: m_pVehicleEx' = ∅
  -- State update: m_nVisibleMoney' = 0
  -- State update: m_nMoney' = m_nVisibleMoney
  true
end

schema CPlayerInfo_Process
  ΔCPlayerInfo
where
  -- State update: startTaxiTimer' = true
  -- State update: veh' = m_pPed.m_pMyVehicle
  -- State update: timePassed' = CTimer::GetTimeInMilliseconds() - m_nUnusedTaxiTimer
  -- State update: startTaxiTimer' = false
  -- State update: m_nUnusedTaxiTimer' = CTimer::GetTimeInMilliseconds()
  -- State update: m_nTimeCarSpentOnTwoWheels' = 0
  -- Invokes: CReplay::IsPlayingBack, veh->IsTaxi, CTimer::GetTimeInMilliseconds, m_pPed->InVehicle, m_pMyVehicle->IsCar
  true
end

schema CPlayerInfo_IsPlayerInRemoteMode
  ΔCPlayerInfo
where
  -- Return postcondition: result! = m_pRemoteVehicle || m_bInRemoteMode
  true
end

