-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPlayerInfo
  m_pPed : Ref[CPlayerPed]
  m_pRemoteVehicle : Ref[CVehicle]
  m_ColModel : CColModel
  m_pVehicleEx : Ref[CVehicle]
  m_aPlayerName : seq CHAR
  m_nMoney : ℤ
  m_nVisibleMoney : ℤ
  m_nCollectedPackages : ℤ
  m_nTotalPackages : ℤ
  m_nLastBumpPlayerCarTimer : ℕ
  m_nUnusedTaxiTimer : ℕ
  m_bUnusedTaxiThing : 𝔹
  m_nNextSexFrequencyUpdateTime : ℕ
  m_nNextSexMoneyUpdateTime : ℕ
  m_nSexFrequency : ℤ
  m_pHooker : Ref[CCivilianPed]
  m_WBState : ℤ
  m_nWBTime : ℕ
  m_bInRemoteMode : 𝔹
  field_D5 : 𝔹
  field_D6 : 𝔹
  m_nTimeLostRemoteCar : ℕ
  m_nTimeLastHealthLoss : ℕ
  m_nTimeLastArmourLoss : ℕ
  m_nTimeTankShotGun : ℕ
  m_nUpsideDownCounter : ℤ
  field_EC : ℤ
  m_nTimeCarSpentOnTwoWheels : ℤ
  m_nDistanceCarTravelledOnTwoWheels : ℝ
  m_nTimeNotFullyOnGround : ℤ
  m_nTimeSpentOnWheelie : ℤ
  m_nDistanceTravelledOnWheelie : ℝ
  m_nTimeSpentOnStoppie : ℤ
  m_nDistanceTravelledOnStoppie : ℝ
  m_nCancelWheelStuntTimer : ℤ
  m_nLastTimeCarSpentOnTwoWheels : ℤ
  m_nLastDistanceCarTravelledOnTwoWheels : ℝ
  m_nLastTimeSpentOnWheelie : ℤ
  m_nLastDistanceTravelledOnWheelie : ℝ
  m_nLastTimeSpentOnStoppie : ℤ
  m_nLastDistanceTravelledOnStoppie : ℝ
  m_nTrafficMultiplier : ℤ
  field_12A : ℤ
  m_fRoadDensity : ℝ
  m_nPreviousTimeRewardedForExplosion : ℕ
  m_nExplosionsSinceLastReward : ℕ
  m_nHavocLevel : ℕ
  m_fMediaAttention : ℝ
  m_bInfiniteSprint : 𝔹
  m_bFastReload : 𝔹
  m_bFireproof : 𝔹
  m_nMaxHealth : ℕ
  m_nMaxArmour : ℕ
  m_bGetOutOfJailFree : 𝔹
  m_bGetOutOfHospitalFree : 𝔹
  m_bDriveByAllowed : 𝔹
  m_nBustedAudioStatus : ℕ
  m_nCurrentBustedAudio : ℤ
  m_pSkinTexture : Ref[RwTexture]
  field_268 : ℤ
  field_272 : ℤ
where
  #m_pPed ≤ 1
  #m_pRemoteVehicle ≤ 1
  #m_pVehicleEx ≤ 1
  #m_aPlayerName = 70
  m_nLastBumpPlayerCarTimer ≥ 0
  m_nUnusedTaxiTimer ≥ 0
  m_nNextSexFrequencyUpdateTime ≥ 0
  m_nNextSexMoneyUpdateTime ≥ 0
  #m_pHooker ≤ 1
  m_nWBTime ≥ 0
  m_nTimeLostRemoteCar ≥ 0
  m_nTimeLastHealthLoss ≥ 0
  m_nTimeLastArmourLoss ≥ 0
  m_nTimeTankShotGun ≥ 0
  m_nPreviousTimeRewardedForExplosion ≥ 0
  m_nExplosionsSinceLastReward ≥ 0
end

