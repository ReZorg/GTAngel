  ΔCPlayerInfo
  carList? : CPtrList
  ped? : Ref[CPed]
  unk1? : ℝ
  unk2? : ℝ
  unk3? : ℝ
  unk4? : ℝ
  lastCloseness? : ℙ ℝ
  closestCarOutput? : Ref[CVehicle]
where
  -- State update: node' = carList.first
  -- State update: car' = (CVehicle*)node.item
  -- State update: car.m_scanCode' = CWorld::GetCurrentScanCode()
  -- State update: carCentre' = car.GetBoundCentre()
  -- State update: dist' = (ped.GetPosition() - carCentre).Magnitude2D()
  -- Invokes: CWorld::GetCurrentScanCode, car->IsVehicle, car->GetStatus, car->GetUp, car->GetBoundCentre
  true
end

schema CPlayerInfo_EvaluateCarPosition
  ΔCPlayerInfo
  carToTest? : Ref[CEntity]
  player? : Ref[CPed]
  carBoundCentrePedDist? : ℝ
  lastCloseness? : ℙ ℝ
  closestCarOutput? : Ref[CVehicle]
where
  -- State update: lastCloseness' = closeness
  -- State update: closestCarOutput' = (CVehicle*)carToTest
  -- Invokes: carToTest->GetPosition, player->GetPosition, CGeneral::GetATanOfXY, player->GetForward
  true
end

