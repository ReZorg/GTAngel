schema CRange3D_IsInRange
  ΔCRange3D
  vec? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRange3D_DebugShowRange
  ΔCRange3D
  arg_1? : ℝ
  arg_2? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
