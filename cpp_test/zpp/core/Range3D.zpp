schema CRange3D_GetRandomPointInRange
  ΔCRange3D
where
  -- State update: distX' = Abs(max.x - min.x)
  -- State update: distY' = Abs(max.y - min.y)
  -- State update: distZ' = Abs(max.z - min.z)
  -- State update: outX' = CGeneral::GetRandomNumber() % distX + min.x
  -- State update: outY' = CGeneral::GetRandomNumber() % distY + min.y
  -- State update: outZ' = CGeneral::GetRandomNumber() % distZ + min.z
  -- Return postcondition: result! = CVector(outX, outY, outZ)
  -- Invokes: CGeneral::GetRandomNumber
  true
end
