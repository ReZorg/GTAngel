-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Pad_CPad
  ΔPadModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Pad_CPad_2
  ΔPadModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Pad_SetDrunkInputDelay
  ΔPadModuleState
  delay? : ℤ
where
  -- State update: DrunkDrivingBufferUsed' = delay
  true
end

schema Pad_GetOddJobTrigger
  ΔPadModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetRightShockJustDown()
  true
end

schema Pad_GuiLeft
  ΔPadModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetAnaloguePadLeft() || GetDPadLeftJustDown()
  true
end

schema Pad_GuiRight
  ΔPadModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetAnaloguePadRight() || GetDPadRightJustDown()
  true
end

schema Pad_GuiUp
  ΔPadModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetAnaloguePadUp() || GetDPadUpJustDown()
  true
end

schema Pad_GuiDown
  ΔPadModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetAnaloguePadDown() || GetDPadDownJustDown()
  true
end

