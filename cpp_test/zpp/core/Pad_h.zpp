schema CKeyboardState
  F : seq ℤ  -- bounded array [12]
  VK_KEYS : seq ℤ  -- bounded array [256]
  ESC : ℤ
  INS : ℤ
  DEL : ℤ
  HOME : ℤ
  END : ℤ
  PGUP : ℤ
  PGDN : ℤ
  UP : ℤ
  DOWN : ℤ
  LEFT : ℤ
  RIGHT : ℤ
  SCROLLLOCK : ℤ
  PAUSE : ℤ
  NUMLOCK : ℤ
  DIV : ℤ
  MUL : ℤ
  SUB : ℤ
  ADD : ℤ
  ENTER : ℤ
  DECIMAL : ℤ
  NUM1 : ℤ
  NUM2 : ℤ
  NUM3 : ℤ
  NUM4 : ℤ
  NUM5 : ℤ
  NUM6 : ℤ
  NUM7 : ℤ
  NUM8 : ℤ
  NUM9 : ℤ
  NUM0 : ℤ
  BACKSP : ℤ
  TAB : ℤ
  CAPSLOCK : ℤ
  EXTENTER : ℤ
  LSHIFT : ℤ
  RSHIFT : ℤ
  SHIFT : ℤ
  LCTRL : ℤ
  RCTRL : ℤ
  LALT : ℤ
  RALT : ℤ
  LWIN : ℤ
  RWIN : ℤ
  APPS : ℤ
where
  #F = 12
  #VK_KEYS = 256
end

schema CKeyboardState_Clear
  ΔCKeyboardState
where
  -- Declared member operation CKeyboardState::Clear()
  true
end

schema CPad
  NewState : CControllerState
  OldState : CControllerState
  SteeringLeftRightBuffer : seq ℤ  -- bounded array [DRUNK_STEERING_BUFFER_SIZE]
  DrunkDrivingBufferUsed : ℤ
  PCTempKeyState : CControllerState
  PCTempJoyState : CControllerState
  PCTempMouseState : CControllerState
  Phase : ℤ
  Mode : ℤ
  ShakeDur : ℤ
  DisablePlayerControls : ℕ
  ShakeFreq : ℕ
  bHornHistory : seq 𝔹  -- bounded array [HORNHISTORY_SIZE]
  iCurrHornHistory : ℕ
  JustOutOfFrontend : ℤ
  bApplyBrakes : ℤ
  CheatString : seq CHAR
  LastTimeTouched : ℤ
  AverageWeapon : ℤ
  AverageEntries : ℤ
  unk_B4 : ℝ
  unk_B8 : ℝ
  bObsoleteControllerMessage : 𝔹
  bOldDisplayNoControllerMessage : 𝔹
  m_bMapPadOneToPadTwo : 𝔹
  m_bDebugCamPCOn : 𝔹
  bHasPlayerCheated : 𝔹
  bInvertLook4Pad : 𝔹
  OldKeyState : CKeyboardState
  NewKeyState : CKeyboardState
  TempKeyState : CKeyboardState
  KeyBoardCheatString : seq CHAR
  OldMouseControllerState : CMouseControllerState
  NewMouseControllerState : CMouseControllerState
  PCTempMouseControllerState : CMouseControllerState
  XInputJoy2 : ℤ
where
  DisablePlayerControls ≥ 0
  ShakeFreq ≥ 0
  iCurrHornHistory ≥ 0
  #CheatString = 12
  #KeyBoardCheatString = 30
end

