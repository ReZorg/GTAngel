--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MILES_IN_METER : ℝ  -- #define MILES_IN_METER 0.000621371192f
FEET_IN_METER : ℝ  -- #define FEET_IN_METER 3.28084f
STAT_D : seq CHAR  -- #define STAT_D *(int*)stat
STAT_F : seq CHAR  -- #define STAT_F *(float*)stat
STAT2_D : seq CHAR  -- #define STAT2_D *(int*)stat2
STAT2_F : seq CHAR  -- #define STAT2_F *(float*)stat2

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Stats_Enum_1 ::= TOTAL_FASTEST_TIMES | TOTAL_HIGHEST_SCORES | TOTAL_BEST_POSITIONS | TOTAL_PROPERTIES
  -- val(TOTAL_FASTEST_TIMES) = 23
  -- val(TOTAL_HIGHEST_SCORES) = 5
  -- val(TOTAL_BEST_POSITIONS) = 1
  -- val(TOTAL_PROPERTIES) = 15

