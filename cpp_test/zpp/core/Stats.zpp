  LastMissionPassedName : seq CHAR
  TotalLegitimateKills : ℤ
  LivesSavedWithAmbulance : ℤ
  CriminalsCaught : ℤ
  HighestLevelAmbulanceMission : ℤ
  HighestLevelVigilanteMission : ℤ
  HighestLevelFireMission : ℤ
  FiresExtinguished : ℤ
  TotalNumberKillFrenzies : ℤ
  TotalNumberMissions : ℤ
  RoundsFiredByPlayer : ℤ
  KgsOfExplosivesUsed : ℤ
  BulletsThatHit : ℤ
  BestTimeBombDefusal : ℤ
  FastestTimes : seq ℤ  -- bounded array [TOTAL_FASTEST_TIMES]
  HighestScores : seq ℤ  -- bounded array [TOTAL_HIGHEST_SCORES]
  BestPositions : seq ℤ  -- bounded array [TOTAL_BEST_POSITIONS]
  PropertyOwned : seq 𝔹  -- bounded array [TOTAL_PROPERTIES]
  NumPropertyOwned : ℤ
  PropertyDestroyed : ℤ
  HighestChaseValue : ℝ
  CheatedCount : ℤ
  ShowChaseStatOnScreen : ℤ
  PamphletMissionPassed : ℤ
  abSonyCDs : seq 𝔹  -- bounded array [1]
  BloodRingKills : ℤ
  BloodRingTime : ℤ
  FavoriteRadioStationList : seq ℝ  -- bounded array [NUM_RADIOS]
  Sprayings : ℤ
  AutoPaintingBudget : ℝ
  NoMoreHurricanes : ℤ
  FashionBudget : ℝ
  PropertyBudget : ℝ
  WeaponBudget : ℝ
  SafeHouseVisits : ℤ
  TyresPopped : ℤ
  LongestWheelie : ℤ
  LongestStoppie : ℤ
  Longest2Wheel : ℤ
  LongestWheelieDist : ℝ
  LongestStoppieDist : ℝ
  Longest2WheelDist : ℝ
  ElBurroTime : ℤ
  Record4x4One : ℤ
  Record4x4Two : ℤ
  Record4x4Three : ℤ
  Record4x4Mayhem : ℤ
  LongestFlightInDodo : ℤ
  TimeTakenDefuseMission : ℤ
  InstantHitsFiredByPlayer : ℤ
  InstantHitsHitByPlayer : ℤ
  mmRain : ℤ
  CarsCrushed : ℤ
where
  #LastMissionPassedName = 8
  #abSonyCDs = 1
end

