schema CStats_ConstructStatLine
  ΔCStats
  rowIdx? : ℤ
where
  -- State update: a' = right1
  -- State update: a' = right1
  -- State update: b' = right2
  -- State update: hour' = 0, minute
  -- State update: minute' = FastestTimes[id]
  -- State update: minute' = -minute
  -- Return postcondition: result! = 0
  -- Return postcondition: result! = 0
  -- Return postcondition: result! = 0
  -- Invokes: CTimer::GetTimeInMilliseconds, CFont::IsJapanese, TheText.Get, DMAudio.GetListenTimeArray, DMAudio.IsMP3RadioChannelAvailable
  true
end

