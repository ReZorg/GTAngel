-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema FileMgr_OpenFile
  ΔFileMgrModuleState
  file? : seq CHAR
  result! : ℤ
where
  -- Return postcondition: result! = OpenFile(file, "rb")
  true
end
