schema CSurfaceTable_Initialise
  ΔCSurfaceTable
  filename? : seq CHAR
where
  -- State update: line' = (char*)work_buff
  -- State update: lineno' = 0
  -- State update: fieldno' = 0
  -- State update: adhesiveLimit' = 0.0f
  -- Invokes: CFileMgr::SetDir, CFileMgr::LoadFile
  true
end

schema CSurfaceTable_GetAdhesionGroup
  ΔCSurfaceTable
  surfaceType? : ℕ
where
  -- Return postcondition: result! = ADHESIVE_ROAD
  -- Return postcondition: result! = ADHESIVE_ROAD
  -- Return postcondition: result! = ADHESIVE_LOOSE
  true
end

schema CSurfaceTable_GetWetMultiplier
  ΔCSurfaceTable
  surfaceType? : ℕ
where
  -- Return postcondition: result! = 1.0f - CWeather::WetRoads*0.25f
  -- Return postcondition: result! = 1.0f - CWeather::WetRoads*0.4f
  -- Return postcondition: result! = 1.0f + CWeather::WetRoads*0.5f
  true
end

