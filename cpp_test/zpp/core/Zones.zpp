  true
end

schema CTheZones_Init
  ΔCTheZones
where
  -- State update: NumberOfAudioZones' = 0
  -- State update: x' = 1000/9
  -- State update: carDensity' = 10
  -- State update: copThreshold' = 50
  -- State update: pedDensity' = 12
  -- State update: copPedThreshold' = 50
  true
end

schema CTheZones_Update
  ΔCTheZones
where
  -- State update: pos' = FindPlayerCoors()
  -- State update: m_pPlayersZone' = FindSmallestZonePosition(&pos)
  -- State update: m_CurrLevel' = GetLevelFromPosition(&pos)
  -- Invokes: CTimer::GetFrameCounter
  true
end

