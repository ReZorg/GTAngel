schema CTheZones_GetZoneInfoForTimeOfDay
  ΔCTheZones
  pos? : Ref[CVector]
  info? : Ref[CZoneInfo]
where
  -- State update: day' = GetZoneInfo(pos, 1)
  -- State update: night' = GetZoneInfo(pos, 0)
  -- State update: info' = *day
  -- State update: info' = *night
  -- State update: d' = 1.0f - n
  -- State update: d' = (CClock::GetHours() - 5) / 3.0f
  -- Invokes: CClock::GetIsTimeInRange, CClock::GetHours
  true
end

