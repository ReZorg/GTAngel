schema CTheZones_InsertZoneIntoZoneHierRecursive
  ΔCTheZones
  inner? : Ref[CZone]
  outer? : Ref[CZone]
where
  -- State update: child' = outer.child
  -- State update: child' = outer.child
  -- State update: inner.next' = outer.child
  -- State update: inner.parent' = outer
  -- State update: outer.child' = inner
  -- State update: insert' = inner
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  true
end

