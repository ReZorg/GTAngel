  buffer? : ℙ ℕ
  size? : ℙ ℕ
where
  -- State update: zone' = WriteSaveBuf(buffer, ZoneArray[i])
  -- State update: zone.child' = (CZone*)GetIndexForZonePointer(ZoneArray[i].child)
  -- State update: zone.parent' = (CZone*)GetIndexForZonePointer(ZoneArray[i].parent)
  -- State update: zone.next' = (CZone*)GetIndexForZonePointer(ZoneArray[i].next)
