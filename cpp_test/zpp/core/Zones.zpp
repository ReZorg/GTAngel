where
  -- State update: p' = name
  -- State update: p' = toupper(*p)
  -- State update: type' = type
  -- State update: minx' = minx
  -- State update: miny' = miny
  -- State update: minz' = minz
  true
end

schema CTheZones_CreateMapZone
  ΔCTheZones
  name? : seq CHAR
