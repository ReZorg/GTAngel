schema Zones_IsNormalZone
  ΔZonesModuleState
  type? : ℤ
  result! : 𝔹
where
  -- Return postcondition: result! = type == ZONE_DEFAULT || type == ZONE_NAVIG || type == ZONE_INFO
  true
end

schema Zones_CheckZoneInfo
  ΔZonesModuleState
  info? : Ref[CZoneInfo]
where
  -- Deterministic transition preserving module invariants
  true
end

schema CZone_GetTranslatedName
  ΔCZone
where
  -- Return postcondition: result! = TheText.Get(name)
