--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CRGBA
  this : Ref[return]
where
  #this ≤ 1
end

schema CRGBA_CRGBA
  ΔCRGBA
where
  -- Declared member operation CRGBA::CRGBA(void)
  true
end

schema CRGBA_operator_2
  ΔCRGBA
  right? : CRGBA
  result! : bool
where
  -- Declared member operation CRGBA::operator !=(const CRGBA &right)
  true
end

schema CRGBA_operator_3
  ΔCRGBA
  right? : CRGBA
  result! : CRGBA
where
  -- Declared member operation CRGBA::operator =(const CRGBA &right)
  true
end

schema CRGBA_operator_RwRGBA_4
  ΞCRGBA
  result! : ANY
where
  -- Declared member operation CRGBA::operator RwRGBA(void)
  true
end

schema CRGBA_operator_5
  ΔCRGBA
  right? : RwRGBA
  result! : CRGBA
where
  -- Declared member operation CRGBA::operator =(const RwRGBA &right)
  true
end

schema check_size
  instance_addr : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema check_size_static_assert
  Δcheck_size
  arg_1? : s
  arg_2? : Invalid_structure_size
where
  -- Declared member operation check_size::static_assert(s == t, "Invalid structure size")
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema common_dpb
  ΔcommonModuleState
  b? : ℕ
  p? : ℕ
  s? : ℕ
  w? : ℕ
  result! : ℕ
where
  -- State update: m' = MASK(p,s)
  -- Return postcondition: result! = (w & ~m) | ((b<<p) & m)
  true
end

schema common_ldb
  ΔcommonModuleState
  p? : ℕ
  s? : ℕ
  w? : ℕ
  result! : ℕ
where
  -- Return postcondition: result! = w>>p & (1<<s)-1
  true
end

schema common_CRGBA
  ΔcommonModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema common_operator
  ΔcommonModuleState
  right? : CRGBA
  result! : 𝔹
where
  -- Deterministic transition preserving module invariants
  true
end

schema common_operator_2
  ΔcommonModuleState
  right? : CRGBA
  result! : 𝔹
where
  -- Return postcondition: result! = !(*this == right)
  true
end

schema common_operator_RwRGBA
  ΔcommonModuleState
where
  -- Return postcondition: result! = rwRGBA
  true
end

schema common_operator_RwRGBA_2
  ΔcommonModuleState
where
  -- Return postcondition: result! = &rwRGBA
  true
end

schema common_RwRGBA
  ΞcommonModuleState
  result! : operator
where
  -- Return postcondition: result! = rwRGBA
  true
end

schema common_sq
  ΔcommonModuleState
  x? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = x*x
  true
end

schema common_TRACE
  ΔcommonModuleState
  f? : seq CHAR
  result! : inline___void
where
  -- Deterministic transition preserving module invariants
  true
end
