-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MB : seq CHAR  -- #define MB (1024*1024)
BIGBUILDINGFLAGS : seq CHAR  -- #define BIGBUILDINGFLAGS STREAMFLAGS_DONT_REMOVE|STREAMFLAGS_PRIORITY
STREAM_DIST : ℝ  -- #define STREAM_DIST 80.0f

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CStreamingInfo_GetCdPosnAndSize
  ΔCStreamingInfo
  posn? : ℕ
  size? : ℕ
where
  -- State update: posn' = m_position
  -- State update: size' = m_size
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

schema CStreamingInfo_SetCdPosnAndSize
  ΔCStreamingInfo
  posn? : ℕ
  size? : ℕ
where
  -- State update: m_position' = posn
  -- State update: m_size' = size
  true
end

schema CStreamingInfo_AddToList
  ΔCStreamingInfo
  link? : Ref[CStreamingInfo]
where
  -- State update: m_next' = link.m_next
  -- State update: m_prev' = link
  -- State update: link.m_next' = this
  -- State update: m_next.m_prev' = this
  true
end

schema CStreamingInfo_RemoveFromList
  ΔCStreamingInfo
where
  -- State update: m_next.m_prev' = m_prev
  -- State update: m_prev.m_next' = m_next
  -- State update: m_next' = ∅
  -- State update: m_prev' = ∅
  true
end

schema CStreaming_Init2
  ΔCStreaming
where
  -- State update: m_loadState' = STREAMSTATE_NOTLOADED
  -- State update: m_next' = ∅
  -- State update: m_prev' = ∅
  -- State update: m_nextID' = -1
  -- State update: m_size' = 0
  -- State update: m_position' = 0
  -- Invokes: CModelInfo::GetModelInfo, mi->GetRwObject, mi->IsSimple, CTxdStore::GetSlot, CPools::GetBuildingPool
  true
end

schema CStreaming_Init
  ΔCStreaming
where
  -- State update: txdHandle' = CFileMgr::OpenFile("MODELS\\TXD.IMG", "r")
  -- Invokes: CFileMgr::OpenFile, CFileMgr::CloseFile, CStreaming::Init2, CStreaming::Shutdown
  true
end

schema CStreaming_ReInit
  ΔCStreaming
where
  -- State update: ms_disableStreaming' = false
  -- Invokes: CStreaming::FlushRequestList, CStreaming::DeleteAllRwObjects, CStreaming::RemoveAllUnusedModels, CModelInfo::GetModelInfo
  true
end

schema CStreaming_Shutdown
  ΔCStreaming
where
  -- State update: ms_streamingBufferSize' = 0
  -- State update: ms_pExtraObjectsDir' = ∅
  true
end

schema CStreaming_Update
  ΔCStreaming
where
  -- State update: requestedSubway' = false
  -- State update: timeProcessingTXD' = 0
  -- State update: timeProcessingDFF' = 0
  -- State update: si' = ms_endRequestedList.m_prev
  -- State update: prev' = si.m_prev
  -- Invokes: CTimer::GetIsPaused, TheCamera.GetPosition, CCutsceneMgr::IsCutsceneProcessing, CReplay::IsPlayingBack, CColStore::AddCollisionNeededAtPosn
  true
end

schema CStreaming_LoadCdDirectory
  ΔCStreaming
where
  -- State update: ms_imageSize' = GetGTA3ImgSize()
  -- State update: ms_lastImageRead' = 0
  true
end

schema CStreaming_LoadCdDirectory_2
  ΔCStreaming
  dirname? : seq CHAR
  n? : ℤ
where
  -- State update: lastID' = -1
  -- State update: fd' = CFileMgr::OpenFile(dirname, "rb")
  -- State update: imgSelector' = n<<24
  -- State update: bAddToStreaming' = false
