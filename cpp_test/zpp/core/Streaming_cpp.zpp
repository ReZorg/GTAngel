end

schema Streaming_GetObjectName
  ΔStreamingModuleState
  streamId? : ℤ
where
  -- Return postcondition: result! = objname
  -- Invokes: CModelInfo::GetModelInfo, CTxdStore::GetTxdName, CColStore::GetColName, CAnimManager::GetAnimationBlock
  true
end

schema Streaming_RegisterAtomicMemPtrsCB
  ΔStreamingModuleState
  atomic? : Ref[RpAtomic]
  data? : ADDRESS
where
  -- State update: geo' = RpAtomicGetGeometry(atomic)
  -- Return postcondition: result! = atomic
  true
end

schema CStreaming_ConvertBufferToObject
  ΔCStreaming
  buf? : ℙ ℤ
  streamId? : ℤ
where
  -- State update: cdsize' = ms_aInfoForModel[streamId].GetCdSize()
  -- State update: mem.start' = (uint8*)buf
  -- State update: mem.length' = cdsize * CDSTREAM_SECTOR_SIZE
  -- State update: stream' = RwStreamOpen(rwSTREAMMEMORY, rwSTREAMREAD, &mem)
  -- State update: mi' = CModelInfo::GetModelInfo(streamId)
  -- State update: success' = CFileLoader::LoadAtomicFile(stream, streamId)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Invokes: CTimer::GetCurrentTimeInCycles, CTimer::GetCyclesPerMillisecond, CModelInfo::GetModelInfo, mi->GetTxdSlot, CTxdStore::GetSlot
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema StreamingModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 5756
end
