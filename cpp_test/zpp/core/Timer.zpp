--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHWINDOWS : seq CHAR  -- #define WITHWINDOWS #include "common.h"
RsTimerType : seq CHAR  -- #define RsTimerType uint32

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CTimer
  m_snTimeInMilliseconds : ℕ
  m_snTimeInMillisecondsPauseMode : ℕ
  m_snTimeInMillisecondsNonClipped : ℕ
  m_snPreviousTimeInMilliseconds : ℕ
  m_FrameCounter : ℕ
  ms_fTimeScale : ℝ
  ms_fTimeStep : ℝ
  ms_fTimeStepNonClipped : ℝ
  m_LogicalFramesPassed : ℕ
  m_CodePause : 𝔹
where
  m_snTimeInMilliseconds ≥ 0
  m_snTimeInMillisecondsPauseMode ≥ 0
  m_snTimeInMillisecondsNonClipped ≥ 0
  m_snPreviousTimeInMilliseconds ≥ 0
  m_FrameCounter ≥ 0
  m_LogicalFramesPassed ≥ 0
end

schema CTimer_GetTimeStep
  ΔCTimer
  result! : ℝ
where
  -- Declared member operation CTimer::GetTimeStep(void)
  true
end

