--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHD3D : seq CHAR  -- #define WITHD3D #endif
RADAR_MIN_X : ℝ  -- #define RADAR_MIN_X (-2000.0f)
RADAR_MIN_Y : ℝ  -- #define RADAR_MIN_Y (-2000.0f)
RADAR_MAX_X : ℝ  -- #define RADAR_MAX_X (2000.0f)
RADAR_MAX_Y : ℝ  -- #define RADAR_MAX_Y (2000.0f)
RADAR_SIZE_X : seq CHAR  -- #define RADAR_SIZE_X (RADAR_MAX_X - RADAR_MIN_X)
RADAR_SIZE_Y : seq CHAR  -- #define RADAR_SIZE_Y (RADAR_MAX_Y - RADAR_MIN_Y)
RADAR_NUM_TILES : seq CHAR  -- #define RADAR_NUM_TILES (8)
RADAR_TILE_SIZE : seq CHAR  -- #define RADAR_TILE_SIZE (RADAR_SIZE_X / RADAR_NUM_TILES)
RADAR_MIN_RANGE : ℝ  -- #define RADAR_MIN_RANGE (120.0f)
RADAR_MAX_RANGE : ℝ  -- #define RADAR_MAX_RANGE (350.0f)
RADAR_MIN_SPEED : ℝ  -- #define RADAR_MIN_SPEED (0.3f)
RADAR_MAX_SPEED : ℝ  -- #define RADAR_MAX_SPEED (0.9f)
WAYPOINT_R : seq CHAR  -- #define WAYPOINT_R (255)
WAYPOINT_G : seq CHAR  -- #define WAYPOINT_G (72)
WAYPOINT_B : seq CHAR  -- #define WAYPOINT_B (77)

