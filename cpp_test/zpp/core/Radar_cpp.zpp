end

schema CRadar_CalculateCachedSinCos
  ΔCRadar
where
  -- State update: cachedSin' = 0.0f
  -- State update: cachedCos' = 1.0f
  -- State update: cachedSin' = Sin(TheCamera.GetForward().Heading())
  -- State update: cachedCos' = Cos(TheCamera.GetForward().Heading())
  -- State update: cachedSin' = Sin(forward.Heading())
  -- State update: cachedCos' = Cos(forward.Heading())
  -- Invokes: TheCamera.GetLookDirection, TheCamera.GetForward, CamTargetEntity->GetForward, forward.Normalise, CamTargetEntity->GetPosition
  true
end

