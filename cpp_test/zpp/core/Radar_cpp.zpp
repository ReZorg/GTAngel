schema CRadar_TransformRadarPointToRealWorldSpace
  ΔCRadar
  out? : CVector2D
  in? : CVector2D
where
  -- State update: s' = -cachedSin
  -- State update: c' = cachedCos
  -- State update: s' = -Sin(TheCamera.GetForward().Heading())
  -- State update: c' = Cos(TheCamera.GetForward().Heading())
  -- State update: s' = 0.0f
  -- State update: c' = 1.0f
  -- Invokes: TheCamera.GetForward, TheCamera.GetLookDirection, CamTargetEntity->GetForward, forward.Normalise, CamTargetEntity->GetPosition
  true
end

