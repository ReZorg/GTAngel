schema Radar_LineRadarBoxCollision
  ΔRadarModuleState
  out? : CVector2D
  p1? : CVector2D
  p2? : CVector2D
  result! : ℤ
where
  -- State update: shortest' = 1.0f
  -- State update: edge' = -1
  -- State update: d1' = -1.0f - p1.x
  -- State update: d2' = -1.0f - p2.x
  -- State update: t' = d1 / (d1 - d2)
  -- State update: y' = (p2.y - p1.y)*t + p1.y
  -- Return postcondition: result! = edge
  true
end

schema CRadar_ClipRadarPoly
  ΔCRadar
  poly? : Ref[CVector2D]
  rect? : Ref[CVector2D]
  result! : ℤ
where
  -- State update: laste' = -1
  -- State update: laste' = e1
  -- State update: e2' = LineRadarBoxCollision(poly[n], rect[i], rect[(i + 1) % 4])
  -- State update: e' = LineRadarBoxCollision(tmp, rect[j], rect[(j + 4 - 1) % 4])
  -- State update: laste' = e
  -- State update: tmp' = poly[n]
  -- Return postcondition: result! = n
  true
end

schema Radar_ClipPolyPlane
  ΔRadarModuleState
  in? : Ref[CVector2D]
  nin? : ℤ
  out? : Ref[CVector2D]
  plane? : Ref[CVector]
where
  -- State update: nout' = 0
  -- State update: x1' = j
  -- State update: x2' = (j+1) % nin
  -- State update: d1' = plane.x*in[x1].x + plane.y*in[x1].y + plane.z
  -- State update: d2' = plane.x*in[x2].x + plane.y*in[x2].y + plane.z
  -- State update: t' = d1/(d1 - d2)
  -- Return postcondition: result! = nout
  true
end

