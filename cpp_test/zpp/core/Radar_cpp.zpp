schema Radar_GetTextureCorners
  ΔRadarModuleState
  x? : ℤ
  y? : ℤ
  out? : Ref[CVector2D]
where
  -- State update: x' = x - RADAR_NUM_TILES/2
  -- State update: y' = -(y - RADAR_NUM_TILES/2)
  -- State update: x' = RADAR_TILE_SIZE * (x)
  -- State update: y' = RADAR_TILE_SIZE * (y - 1)
  -- State update: x' = RADAR_TILE_SIZE * (x + 1)
  -- State update: y' = RADAR_TILE_SIZE * (y - 1)
  true
end

