  out? : CVector2D
  in? : CVector2D
where
  -- State update: s' = cachedSin
  -- State update: c' = cachedCos
  -- State update: s' = 0.0f
  -- State update: c' = 1.0f
  -- State update: s' = Sin(TheCamera.GetForward().Heading())
  -- State update: c' = Cos(TheCamera.GetForward().Heading())
  -- Invokes: TheCamera.GetLookDirection, TheCamera.GetForward, CamTargetEntity->GetForward, forward.Normalise, CamTargetEntity->GetPosition
