--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Placeable_SetPosition
  ΔPlaceableModuleState
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: x' = x
  -- State update: y' = y
  -- State update: z' = z
  -- Invokes: m_matrix.GetPosition
  true
end

schema Placeable_SetPosition_2
  ΔPlaceableModuleState
  pos? : CVector
where
  -- Invokes: m_matrix.GetPosition
  true
end

schema Placeable_SetMatrix
  ΔPlaceableModuleState
  newMatrix? : CMatrix
where
  -- State update: m_matrix' = newMatrix
  true
end

schema Placeable_SetTransform
  ΔPlaceableModuleState
  m? : Ref[RwMatrix]
where
  -- State update: m_matrix' = CMatrix(m, false)
  true
end

schema Placeable_SetOrientation
  ΔPlaceableModuleState
  x? : ℝ
  y? : ℝ
  z? : ℝ
where
  -- State update: pos' = m_matrix.GetPosition()
  -- Invokes: m_matrix.GetPosition, m_matrix.SetRotate, m_matrix.Translate
  true
end
