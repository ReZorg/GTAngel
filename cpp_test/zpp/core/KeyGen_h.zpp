--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CKeyGen
  keyTable : seq ℕ  -- bounded array [256]
where
  #keyTable = 256
end

schema CKeyGen_GetKey
  ΔCKeyGen
  str? : seq CHAR
  size? : ℤ
  result! : ℕ
where
  -- Declared member operation CKeyGen::GetKey(const char *str, int size)
  true
end

schema CKeyGen_GetKey_2
  ΔCKeyGen
  str? : seq CHAR
  result! : ℕ
where
  -- Declared member operation CKeyGen::GetKey(const char *str)
  true
end

schema CKeyGen_GetUppercaseKey_3
  ΔCKeyGen
  str? : seq CHAR
  result! : ℕ
where
  -- Declared member operation CKeyGen::GetUppercaseKey(const char *str)
  true
end

schema CKeyGen_AppendStringToKey_4
  ΔCKeyGen
  key? : ℕ
  str? : seq CHAR
  result! : ℕ
where
  -- Declared member operation CKeyGen::AppendStringToKey(uint32 key, const char *str)
  true
end
