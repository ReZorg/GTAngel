--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ZoneCull_GetGroupStartAndSize
  ΔZoneCullModuleState
  groupid? : ℤ
  start? : ℤ
  size? : ℤ
where
  -- State update: start' = m_indexStart
  -- State update: size' = m_groupIndexCount[0]
  -- State update: start' = m_groupIndexCount[0] + m_indexStart
  -- State update: size' = m_groupIndexCount[1]
  -- State update: start' = m_groupIndexCount[0] + m_groupIndexCount[1] + m_indexStart
  -- State update: size' = m_groupIndexCount[2]
  true
end

schema ZoneCull_CamCloseInForPlayer
  ΔZoneCullModuleState
  result! : 𝔹
