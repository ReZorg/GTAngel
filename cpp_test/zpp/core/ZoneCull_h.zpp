schema CAttributeZone
  minx : ℝ
  maxx : ℝ
  miny : ℝ
  maxy : ℝ
  minz : ℝ
  maxz : ℝ
  attributes : ℤ
  wantedLevel : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CCullZones
  NumCullZones : ℤ
  aZones : seq CCullZone  -- bounded array [NUMCULLZONES]
  NumAttributeZones : ℤ
  aAttributeZones : seq CAttributeZone  -- bounded array [NUMATTRIBZONES]
  aIndices : seq ℕ  -- bounded array [NUMZONEINDICES]
  aPointersToBigBuildingsForBuildings : seq ℤ  -- bounded array [NUMBUILDINGS]
  aPointersToBigBuildingsForTreadables : seq ℤ  -- bounded array [NUMTREADABLES]
  CurrentWantedLevelDrop_Player : ℤ
  CurrentFlags_Camera : ℤ
  CurrentFlags_Player : ℤ
  OldCullZone : ℤ
  EntityIndicesUsed : ℤ
  bCurrentSubwayIsInvisible : 𝔹
  bCullZonesDisabled : 𝔹
  bAtBeachForAudio : 𝔹
where
  instance_addr ∈ ADDRESS
end

