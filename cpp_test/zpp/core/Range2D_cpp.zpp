--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CRange2D_IsInRange
  ΔCRange2D
  vec? : CVector2D
where
  -- Return postcondition: result! = min.x < vec.x && max.x > vec.x && min.y < vec.y && max.y > vec.y
  true
end

schema CRange2D_DebugShowRange
  ΔCRange2D
  arg_1? : ℝ
  arg_2? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRange2D_GetRandomPointInRange
  ΔCRange2D
where
  -- State update: distX' = Abs(max.x - min.x)
  -- State update: distY' = Abs(max.y - min.y)
  -- State update: outX' = CGeneral::GetRandomNumber() % distX + min.x
  -- State update: outY' = CGeneral::GetRandomNumber() % distY + min.y
  -- Return postcondition: result! = CVector2D(outX, outY)
  -- Invokes: CGeneral::GetRandomNumber
  true
end

