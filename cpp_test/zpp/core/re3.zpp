schema re3_myrand
  Δre3ModuleState
where
  -- State update: myrand_seed' = 0x5851F42D4C957F2D * myrand_seed + 1
  -- State update: myrand_seed' = myrand_seed * 1103515245 + 12345
  -- Return postcondition: result! = ((myrand_seed >> 32) & 0x7FFFFFFF)
  true
end

schema re3_mysrand
  Δre3ModuleState
  seed? : ℤ
where
  -- State update: myrand_seed' = seed
  true
end

