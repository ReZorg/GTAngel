--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Wanted_GetWantedLevel
  ΔWantedModuleState
  result! : ℤ
where
  -- Return postcondition: result! = m_nWantedLevel
  true
end

schema Wanted_IsIgnored
  ΔWantedModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = m_bIgnoredByCops || m_bIgnoredByEveryone
  true
end
