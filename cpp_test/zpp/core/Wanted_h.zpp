[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CWanted
  m_nChaos : ℤ
  m_nMinChaos : ℤ
  m_nLastUpdateTime : ℤ
  m_nLastWantedLevelChange : ℕ
  m_nLastTimeSuspended : ℕ
  m_fCrimeSensitivity : ℝ
  m_CurrentCops : ℕ
  m_MaxCops : ℕ
  m_MaximumLawEnforcerVehicles : ℕ
  m_CopsBeatingSuspect : ℕ
  m_RoadblockDensity : ℤ
  m_bIgnoredByCops : 𝔹
  m_bIgnoredByEveryone : 𝔹
  m_bSwatRequired : 𝔹
  m_bFbiRequired : 𝔹
  m_bArmyRequired : 𝔹
  m_nWantedLevel : ℤ
  m_nMinWantedLevel : ℤ
  m_aCrimes : seq CCrimeBeingQd  -- bounded array [16]
  m_pCops : seq Ref[CCopPed]  -- bounded array [10]
  MaximumWantedLevel : ℤ
  nMaximumWantedLevel : ℤ
where
  m_nLastWantedLevelChange ≥ 0
  m_nLastTimeSuspended ≥ 0
  m_CurrentCops ≥ 0
  m_MaxCops ≥ 0
  m_MaximumLawEnforcerVehicles ≥ 0
  m_CopsBeatingSuspect ≥ 0
  #m_bIgnoredByCops = 1
  #m_bIgnoredByEveryone = 1
  #m_bSwatRequired = 1
  #m_bFbiRequired = 1
  #m_bArmyRequired = 1
  #m_aCrimes = 16
  #m_pCops = 10
end

