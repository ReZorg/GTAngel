COORDBLIP_MARKER_COLOR_G : ℕ  -- #define COORDBLIP_MARKER_COLOR_G 255
COORDBLIP_MARKER_COLOR_B : ℕ  -- #define COORDBLIP_MARKER_COLOR_B 128
COORDBLIP_MARKER_COLOR_A : ℕ  -- #define COORDBLIP_MARKER_COLOR_A 228
NUM_MAP_LEGENDS : ℕ  -- #define NUM_MAP_LEGENDS 75
MENU_MAP_LENGTH_UNIT : ℝ  -- #define MENU_MAP_LENGTH_UNIT 1190.0f
MENU_MAP_WIDTH_SCALE : ℝ  -- #define MENU_MAP_WIDTH_SCALE 1.112f
