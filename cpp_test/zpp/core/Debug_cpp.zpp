--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
DEBUG_X_POS : seq CHAR  -- #define DEBUG_X_POS (300)
DEBUG_Y_POS : seq CHAR  -- #define DEBUG_Y_POS (41)
DEBUG_LINE_HEIGHT : seq CHAR  -- #define DEBUG_LINE_HEIGHT (22)

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CDebug_DebugInitTextBuffer
  ΔCDebug
where
  -- State update: ms_nCurrentTextLine' = 0
  true
end

schema CDebug_DebugAddText
  ΔCDebug
  str? : seq CHAR
where
  -- State update: ms_nCurrentTextLine' = 0
  true
end

schema CDebug_DebugDisplayTextBuffer
  ΔCDebug
where
  -- State update: y' = DEBUG_Y_POS
  -- State update: line' = ms_aTextBuffer[(ms_nCurrentTextLine + i++) % MAX_LINES]
  -- Invokes: CFont::SetPropOn, CFont::SetBackgroundOff, CFont::SetScale, CFont::SetCentreOff, CFont::SetRightJustifyOff
  true
end

schema CDebug_DisplayScreenStrings
  ΔCDebug
where
  -- State update: ms_nScreenStrs' = 0
  -- Invokes: CFont::SetPropOn, CFont::SetBackgroundOff, CFont::SetScale, CFont::SetCentreOff, CFont::SetRightJustifyOff
  true
end

schema CDebug_PrintAt
  ΔCDebug
  str? : seq CHAR
  x? : ℤ
  y? : ℤ
where
  -- State update: x' = x
  -- State update: y' = y
  true
end

schema CDebug_AddLine
  ΔCDebug
  p1? : CVector
  p2? : CVector
  c1? : ℕ
  c2? : ℕ
where
  -- State update: p1' = p1
  -- State update: p2' = p2
  -- State update: c1' = c1
  -- State update: c2' = c2
  true
end

schema CDebug_DrawLines
  ΔCDebug
where
  -- State update: l' = &ms_aLines[i]
  -- State update: ms_nLines' = 0
  -- Invokes: CLines::RenderLineWithClipping
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema DebugModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 189
end
