--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Zones_GetIndexForNavigationZonePointer
  ΔZonesModuleState
  zone? : Ref[CZone]
  result! : ℕ
where
  -- Return postcondition: result! = zone == nil ? -1 : zone - NavigationZoneArray
  true
end

schema Zones_CreateMapZone
  ΔZonesModuleState
  name? : seq CHAR
  type? : eZoneType
  i? : ℙ ℕ
where
  -- Return postcondition: result! = &ZoneArray[i]
  true
end

schema Zones_GetIndexForZonePointer
  ΔZonesModuleState
  zone? : Ref[CZone]
  result! : ℕ
where
  -- Return postcondition: result! = zone == nil ? -1 : zone - ZoneArray
  true
end
