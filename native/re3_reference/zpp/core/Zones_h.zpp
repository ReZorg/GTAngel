--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Zones (core)
-- Source File(s): core/Zones.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Game.zpp  (from "Game.h")
-- include Gangs.zpp  (from "Gangs.h")
-- include CarCtrl.zpp  (from "CarCtrl.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eZoneType ::= ZONE_DEFAULT | ZONE_NAVIG | ZONE_INFO | ZONE_MAPZONE

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CZone
  name : seq CHAR
  minx : ℝ
  miny : ℝ
  minz : ℝ
  maxx : ℝ
  maxy : ℝ
  maxz : ℝ
  type : eZoneType
  level : eLevelName
  zoneinfoDay : ℤ
  zoneinfoNight : ℤ
  child : Ref[CZone]
  parent : Ref[CZone]
  next : Ref[CZone]
where
  #name = 8
  #child ≤ 1
  #parent ≤ 1
  #next ≤ 1
end

schema CZone_GetTranslatedName
  ΔCZone
  result! : seq CHAR
where
  -- Declared member operation CZone::GetTranslatedName(void)
  true
end

schema CZoneInfo
  carDensity : ℤ
  carThreshold : seq ℤ  -- bounded array [CCarCtrl::NUM_CAR_CLASSES]
  boatThreshold : seq ℤ  -- bounded array [CCarCtrl::NUM_BOAT_CLASSES]
  gangThreshold : seq ℤ  -- bounded array [NUM_GANGS]
  copThreshold : ℤ
  pedDensity : ℕ
  gangPedThreshold : seq ℕ  -- bounded array [NUM_GANGS]
  copPedThreshold : ℕ
  pedGroup : ℕ
  copDensity : ℕ
  gangDensity : seq ℕ  -- bounded array [NUM_GANGS]
where
  pedDensity ≥ 0
  copPedThreshold ≥ 0
  pedGroup ≥ 0
  copDensity ≥ 0
end

schema CTheZones
  FindIndex : ℤ
  NumberOfAudioZones : ℕ
  AudioZoneArray : seq ℤ  -- bounded array [NUMAUDIOZONES]
  TotalNumberOfMapZones : ℕ
  TotalNumberOfInfoZones : ℕ
  TotalNumberOfNavigationZones : ℕ
  InfoZoneArray : seq CZone  -- bounded array [NUMINFOZONES]
  MapZoneArray : seq CZone  -- bounded array [NUMMAPZONES]
  NavigationZoneArray : seq CZone  -- bounded array [NUMNAVIGZONES]
  TotalNumberOfZoneInfos : ℕ
  ZoneInfoArray : seq CZoneInfo  -- bounded array [2*NUMINFOZONES]
  m_CurrLevel : eLevelName
  m_pPlayersZone : Ref[CZone]
  TotalNumberOfZones : ℕ
  ZoneArray : seq CZone  -- bounded array [NUMZONES]
where
  NumberOfAudioZones ≥ 0
  TotalNumberOfMapZones ≥ 0
  TotalNumberOfInfoZones ≥ 0
  TotalNumberOfNavigationZones ≥ 0
  TotalNumberOfZoneInfos ≥ 0
  #m_pPlayersZone ≤ 1
  TotalNumberOfZones ≥ 0
end

schema CTheZones_Init
  ΔCTheZones
where
  -- Declared member operation CTheZones::Init(void)
  true
end

schema CTheZones_Update_2
  ΔCTheZones
where
  -- Declared member operation CTheZones::Update(void)
  true
end

