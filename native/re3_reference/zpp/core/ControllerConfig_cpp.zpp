--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHDINPUT : seq CHAR  -- #define WITHDINPUT #include "common.h"
UP : seq CHAR  -- #define UP "~U~"
DOWN : seq CHAR  -- #define DOWN "~D~"
LEFT : seq CHAR  -- #define LEFT "~<~"
RIGHT : seq CHAR  -- #define RIGHT "~>~"
PS2_TRIANGLE : seq CHAR  -- #define PS2_TRIANGLE "
PS2_CIRCLE : seq CHAR  -- #define PS2_CIRCLE "|"
PS2_CROSS : seq CHAR  -- #define PS2_CROSS "/"
PS2_SQUARE : seq CHAR  -- #define PS2_SQUARE "^"

