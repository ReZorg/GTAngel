--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Lists_new
  ΔListsModuleState
  arg_1? : ℕ
  result! : CPtrNode__operator
where
  -- State update: node' = CPools::GetPtrNodePool().New()
  -- Return postcondition: result! = node
  -- Invokes: CPools::GetPtrNodePool
  true
end

schema Lists_delete
  ΔListsModuleState
  p? : ADDRESS
  arg_2? : ℕ
  result! : CPtrNode__operator
where
  -- Invokes: CPools::GetPtrNodePool
  true
end

schema Lists_new_2
  ΔListsModuleState
  arg_1? : ℕ
  result! : CEntryInfoNode__operator
where
  -- State update: node' = CPools::GetEntryInfoNodePool().New()
  -- Return postcondition: result! = node
  -- Invokes: CPools::GetEntryInfoNodePool
  true
end

schema Lists_delete_2
  ΔListsModuleState
  p? : ADDRESS
  arg_2? : ℕ
  result! : CEntryInfoNode__operator
where
  -- Invokes: CPools::GetEntryInfoNodePool
  true
end

schema Lists_CPtrList
  ΔListsModuleState
where
  -- State update: first' = ∅
  true
end

schema Lists_CPtrList_2
  ΔListsModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Lists_RemoveNode
  ΔListsModuleState
  node? : Ref[CPtrNode]
where
  -- State update: first' = node.next
  -- State update: node.prev.next' = node.next
  -- State update: node.next.prev' = node.prev
  true
end

schema Lists_DeleteNode
  ΔListsModuleState
  node? : Ref[CPtrNode]
where
  -- Deterministic transition preserving module invariants
  true
end

schema Lists_RemoveItem
  ΔListsModuleState
  item? : ADDRESS
where
  -- State update: node' = first
  -- State update: next' = node.next
  true
end

schema Lists_Flush
  ΔListsModuleState
where
  -- State update: node' = first
  -- State update: next' = node.next
  true
end

schema Lists_CEntryInfoList
  ΔListsModuleState
where
  -- State update: first' = ∅
  true
end

schema Lists_CEntryInfoList_2
  ΔListsModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Lists_RemoveNode_2
  ΔListsModuleState
  node? : Ref[CEntryInfoNode]
where
  -- State update: first' = node.next
  -- State update: node.prev.next' = node.next
  -- State update: node.next.prev' = node.prev
  true
end

schema Lists_DeleteNode_2
  ΔListsModuleState
  node? : Ref[CEntryInfoNode]
where
  -- Deterministic transition preserving module invariants
  true
end

schema Lists_Flush_2
  ΔListsModuleState
where
  -- State update: node' = first
  -- State update: next' = node.next
  true
end
