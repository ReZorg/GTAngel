--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPtrNode
  item : ADDRESS
  prev : Ref[CPtrNode]
  next : Ref[CPtrNode]
where
  #prev ≤ 1
  #next ≤ 1
end

schema CPtrNode_operator_new
  ΔCPtrNode
  arg_1? : ℕ
  result! : ADDRESS
where
  -- Declared member operation CPtrNode::operator new(size_t)
  true
end

schema CPtrNode_operator_delete_2
  ΔCPtrNode
  p? : ADDRESS
  arg_2? : ℕ
where
  -- Declared member operation CPtrNode::operator delete(void *p, size_t)
  true
end

schema CPtrList
  first : Ref[CPtrNode]
  nil : return
  node : return
where
  #first ≤ 1
end

schema CPtrList_CPtrList
  ΔCPtrList
where
  -- Declared member operation CPtrList::CPtrList(void)
  true
end

