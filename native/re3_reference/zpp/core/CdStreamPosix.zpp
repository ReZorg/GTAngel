schema CdStreamPosix_CdStreamGetStatus
  ΔCdStreamPosixModuleState
  channel? : ℤ
where
  -- State update: pChannel' = &gpReadInfo[channel]
  -- State update: status' = pChannel.nStatus
  -- State update: pChannel.nStatus' = STREAM_NONE
  -- Return postcondition: result! = STREAM_NONE
  -- Return postcondition: result! = STREAM_NONE
  -- Return postcondition: result! = STREAM_READING
  true
end

schema CdStreamPosix_CdStreamGetLastPosn
  ΔCdStreamPosixModuleState
where
  -- Return postcondition: result! = lastPosnRead
  true
end

schema CdStreamPosix_CdStreamSync
  ΔCdStreamPosixModuleState
  channel? : ℤ
where
  -- State update: pChannel' = &gpReadInfo[channel]
  -- State update: pChannel.nSectorsToRead' = 0
  -- State update: pChannel.bLocked' = true
  -- State update: pChannel.bLocked' = true
  -- State update: pChannel.bReading' = false
  -- State update: pChannel.bLocked' = true
  -- Return postcondition: result! = STREAM_NONE
  -- Return postcondition: result! = pChannel->nStatus
