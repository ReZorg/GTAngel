--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
RE3_SEM_OPEN : seq CHAR  -- #define RE3_SEM_OPEN re3_sem_open
RE3_SEM_CLOSE : seq CHAR  -- #define RE3_SEM_CLOSE re3_sem_close

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CdReadInfo
  nSectorOffset : ℕ
  nSectorsToRead : ℕ
  pBuffer : ADDRESS
  bLocked : 𝔹
  bReading : 𝔹
  nStatus : ℤ
  pChannelThread : pthread_t
  pStartSemaphore : Ref[sem_t]
  hFile : ℤ
where
  nSectorOffset ≥ 0
  nSectorsToRead ≥ 0
  #pStartSemaphore ≤ 1
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CdStreamPosix_re3_sem_open
  ΔCdStreamPosixModuleState
where
  -- State update: sem' = (sem_t*)malloc(sizeof(sem_t))
  -- State update: sem' = SEM_FAILED
  -- Return postcondition: result! = sem
  true
end

schema CdStreamPosix_re3_sem_close
  ΔCdStreamPosixModuleState
  sem? : Ref[sem_t]
where
  -- Deterministic transition preserving module invariants
  true
end

schema CdStreamPosix_re3_sem_open_2
  ΔCdStreamPosixModuleState
  format? : seq CHAR
where
  -- State update: re3Sem' = new sem_t
  -- Return postcondition: result! = sem_open(semName, O_CREAT, 0644, 1)
  -- Return postcondition: result! = re3Sem
  true
end

schema CdStreamPosix_re3_sem_close_2
  ΔCdStreamPosixModuleState
  sem? : Ref[sem_t]
  format? : seq CHAR
where
  -- Deterministic transition preserving module invariants
  true
end

