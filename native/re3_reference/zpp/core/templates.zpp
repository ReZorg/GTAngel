--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema templates_Clear
  ΔtemplatesModuleState
where
  -- State update: allocPtr' = 0
  true
end

schema templates_GetIndex
  ΔtemplatesModuleState
  item? : Ref[T]
  result! : ℤ
where
  -- Return postcondition: result! = item - store
  true
end

schema templates_CPool
  ΔtemplatesModuleState
  size? : ℤ
  name? : seq CHAR
where
  -- State update: m_entries' = (U*)new uint8[sizeof(U)*size]
  -- State update: m_flags' = new uint8[size]
  -- State update: m_size' = size
  -- State update: m_allocPtr' = -1
  true
end

schema templates_GetId
  ΞtemplatesModuleState
  i? : ℤ
  result! : ℤ
where
  -- Return postcondition: result! = m_flags[i] & POOLFLAG_ID
  true
end

schema templates_GetIsFree
  ΞtemplatesModuleState
  i? : ℤ
  result! : 𝔹
where
  -- Return postcondition: result! = !!(m_flags[i] & POOLFLAG_ISFREE)
  true
end

schema templates_SetId
  ΔtemplatesModuleState
  i? : ℤ
  id? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema templates_SetIsFree
  ΔtemplatesModuleState
  i? : ℤ
  isFree? : 𝔹
where
  -- Deterministic transition preserving module invariants
  true
end

schema templates_CPool_2
  ΔtemplatesModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema templates_Flush
  ΔtemplatesModuleState
where
  -- State update: m_entries' = ∅
  -- State update: m_flags' = ∅
  -- State update: m_size' = 0
  -- State update: m_allocPtr' = 0
  true
end

schema templates_GetSize
  ΞtemplatesModuleState
  result! : ℤ
where
  -- Return postcondition: result! = m_size
  true
end

schema templates_SetNotFreeAt
  ΔtemplatesModuleState
  handle? : ℤ
where
  -- State update: idx' = handle>>8
  -- State update: m_allocPtr' = 0
  true
end

schema templates_Delete
  ΔtemplatesModuleState
  entry? : Ref[T]
where
  -- State update: m_allocPtr' = i
  true
end

schema templates_GetIndex_2
  ΔtemplatesModuleState
  entry? : Ref[T]
  result! : ℤ
where
  -- Return postcondition: result! = m_flags[i] + (i<<8)
  true
end

schema templates_GetJustIndex
  ΔtemplatesModuleState
  entry? : Ref[T]
  result! : ℤ
where
  -- State update: index' = GetJustIndex_NoFreeAssert(entry)
  -- Return postcondition: result! = index
  true
end

schema templates_GetJustIndex_NoFreeAssert
  ΔtemplatesModuleState
  entry? : Ref[T]
  result! : ℤ
where
  -- State update: index' = ((U*)entry - m_entries)
  -- Return postcondition: result! = index
  true
end

schema templates_GetNoOfUsedSpaces
  ΞtemplatesModuleState
  result! : ℤ
where
  -- Return postcondition: result! = n
  true
end

schema templates_ClearStorage
  ΔtemplatesModuleState
  flags? : ℙ ℕ
  entries? : Ref[U]
where
  -- State update: flags' = ∅
  -- State update: entries' = ∅
  true
end

schema templates_GetMaxEntrySize
  ΞtemplatesModuleState
  result! : ℕ
where
  -- Return postcondition: result! = sizeof(U)
  true
end

schema templates_CopyBack
  ΔtemplatesModuleState
  flags? : ℙ ℕ
  entries? : Ref[U]
where
  -- State update: m_allocPtr' = 0
  true
end

schema templates_Store
  ΔtemplatesModuleState
  flags? : ℙ ℕ
  entries? : Ref[U]
where
  -- State update: flags' = (uint8*)new uint8[sizeof(uint8)*m_size]
  -- State update: entries' = (U*)new uint8[sizeof(U)*m_size]
  true
end

schema templates_GetNoOfFreeSpaces
  ΞtemplatesModuleState
  result! : ℤ
where
  -- Return postcondition: result! = GetSize() - GetNoOfUsedSpaces()
  true
end

schema templates_Insert
  ΔtemplatesModuleState
  link? : Ref[CLink_T]
where
  -- State update: link.next' = this.next
  -- State update: next.prev' = link
  -- State update: link.prev' = this
  -- State update: next' = link
  true
end

schema templates_Remove
  ΔtemplatesModuleState
where
  -- State update: prev.next' = this.next
  -- State update: next.prev' = this.prev
  true
end

schema templates_Init
  ΔtemplatesModuleState
  n? : ℤ
where
  -- State update: links' = new CLink<T>[n]
  -- State update: head.next' = &tail
  -- State update: tail.prev' = &head
  -- State update: freeHead.next' = &freeTail
  -- State update: freeTail.prev' = &freeHead
  -- Invokes: freeHead.Insert
  true
end

schema templates_Shutdown
  ΔtemplatesModuleState
where
  -- State update: links' = ∅
  true
end

schema templates_Clear_2
  ΔtemplatesModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema templates_Remove_2
  ΔtemplatesModuleState
  link? : Ref[CLink_T]
where
  -- Invokes: link->Remove, freeHead.Insert
  true
end

schema templates_Count
  ΔtemplatesModuleState
  result! : ℤ
where
  -- State update: lnk' = head.next
  -- Return postcondition: result! = n
  true
end

schema templates_CPool_3
  ΔtemplatesModuleState
  size? : ℤ
where
  -- State update: m_entries' = (U*)new uint8[sizeof(U)*size]
  -- State update: m_flags' = new uint8[size]
  -- State update: m_size' = size
  -- State update: m_allocPtr' = 0
  true
end

