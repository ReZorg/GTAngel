--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: templates (core)
-- Source File(s): core/templates.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
POOLFLAG_ID : seq CHAR  -- #define POOLFLAG_ID 0x7f
POOLFLAG_ISFREE : seq CHAR  -- #define POOLFLAG_ISFREE 0x80

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CStore
  allocPtr : ℤ
  store : seq T  -- bounded array [n]
where
  instance_addr ∈ ADDRESS
end

schema CStore_Alloc
  ΔCStore
  result! : Ref[T]
where
  -- Declared member operation CStore::Alloc(void)
  true
end

schema CStore_assert_2
  ΔCStore
  arg_1? : 0
where
  -- Declared member operation CStore::assert(0)
  true
end

schema CStore_Clear_3
  ΔCStore
  result! : void
where
  -- Declared member operation CStore::Clear(void)
  true
end

schema CStore_GetIndex_4
  ΔCStore
  item? : Ref[T]
  result! : ℤ
where
  -- Declared member operation CStore::GetIndex(T *item)
  true
end

schema CStore_assert_5
  ΔCStore
  store? : seq item  -- bounded array [n]
where
  -- Declared member operation CStore::assert(item < &store[n])
  true
end

schema CStore_GetItem_6
  ΔCStore
  index? : ℤ
  result! : Ref[T]
where
  -- Declared member operation CStore::GetItem(int32 index)
  true
end

schema CStore_assert_7
  ΔCStore
  n? : index
where
  -- Declared member operation CStore::assert(index < n)
  true
end

schema CPool
  m_entries : Ref[U]
  m_flags : ℙ ℕ
  m_size : ℤ
  m_allocPtr : ℤ
  size : i
  entry : return
  index : return
  n : return
where
  #m_entries ≤ 1
  #m_flags ≤ 1
end

schema CPool_CPool
  ΔCPool
  size? : ℤ
  name? : seq CHAR
where
  -- Declared member operation CPool::CPool(int32 size, const char *name)
  true
end

schema CPool_SetId_2
  ΔCPool
  arg_1? : i
  arg_2? : 0
  result! : i
where
  -- Declared member operation CPool::SetId(i, 0)
  true
end

schema CPool_SetIsFree_3
  ΔCPool
  arg_1? : i
  arg_2? : true
where
  -- Declared member operation CPool::SetIsFree(i, true)
  true
end

schema CPool_GetId_4
  ΞCPool
  i? : ℤ
  result! : ℤ
where
  -- Declared member operation CPool::GetId(int i)
  true
end

schema CPool_GetIsFree_5
  ΞCPool
  i? : ℤ
  result! : bool
where
  -- Declared member operation CPool::GetIsFree(int i)
  true
end

schema CPool_SetId_6
  ΔCPool
  i? : ℤ
  id? : ℤ
  result! : void
where
  -- Declared member operation CPool::SetId(int i, int id)
  true
end

schema CPool_SetIsFree_7
  ΔCPool
  i? : ℤ
  isFree? : 𝔹
  result! : void
where
  -- Declared member operation CPool::SetIsFree(int i, bool isFree)
  true
end

schema CPool_CPool_8
  ΔCPool
  result! : ANY
where
  -- Declared member operation CPool::CPool()
  true
end

schema CPool_Flush_9
  ΔCPool
  result! : void
where
  -- Declared member operation CPool::Flush()
  true
end

schema CPool_GetSize_10
  ΞCPool
  result! : ℤ
where
  -- Declared member operation CPool::GetSize(void)
  true
end

schema CPool_New_11
  ΔCPool
  result! : Ref[T]
where
  -- Declared member operation CPool::New(void)
  true
end

schema CPool_if_12
  ΔCPool
  arg_1? : m_allocPtr
  result! : do__ifdef_FIX_BUGS
where
  -- Declared member operation CPool::if(++m_allocPtr >= m_size)
  true
end

schema CPool_if_13
  ΔCPool
  arg_1? : wrapped
where
  -- Declared member operation CPool::if(wrapped)
  true
end

schema CPool_if_14
  ΔCPool
  m_allocPtr? : ANY
  result! : else
where
  -- Declared member operation CPool::if(++m_allocPtr == m_size)
  true
end

schema CPool_while_15
  ΔCPool
  m_allocPtr? : GetIsFree
  result! : endif
where
  -- Declared member operation CPool::while(!GetIsFree(m_allocPtr)
  true
end

