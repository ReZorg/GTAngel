schema CLink
  item : T
  prev : Ref[CLink_T]
  next : Ref[CLink_T]
where
  #prev ≤ 1
  #next ≤ 1
end

schema CLink_Insert
  ΔCLink
  link? : Ref[CLink_T]
where
  -- Declared member operation CLink::Insert(CLink<T> *link)
  true
end

schema CLink_Remove_2
  ΔCLink
  result! : void
where
  -- Declared member operation CLink::Remove(void)
  true
end

schema CLinkList
  tail : CLink_T__head
  freeTail : CLink_T__freeHead
  links : Ref[CLink_T]
  node : return
  lnk : Ref[CLink_T]
  n : return
where
  #links ≤ 1
  #lnk ≤ 1
end

schema CLinkList_Init
  ΔCLinkList
  n? : ℤ
where
  -- Declared member operation CLinkList::Init(int n)
  true
end

schema CLinkList_while_2
  ΔCLinkList
  arg_1? : n
where
  -- Declared member operation CLinkList::while(n--)
  true
end

schema CLinkList_Shutdown_3
  ΔCLinkList
  result! : void
where
  -- Declared member operation CLinkList::Shutdown(void)
  true
end

schema CLinkList_Clear_4
  ΔCLinkList
  result! : void
where
  -- Declared member operation CLinkList::Clear(void)
  true
end

schema CLinkList_Insert_5
  ΔCLinkList
  item? : T
  result! : Ref[CLink_T]
where
  -- Declared member operation CLinkList::Insert(T const &item)
  true
end

schema CLinkList_if_6
  ΔCLinkList
  arg_1? : node
where
  -- Declared member operation CLinkList::if(node == &freeTail)
  true
end

schema CLinkList_Remove_7
  ΔCLinkList
  result! : node
where
  -- Declared member operation CLinkList::Remove()
  true
end

schema CLinkList_Insert_8
  ΔCLinkList
  arg_1? : node
  result! : head
where
  -- Declared member operation CLinkList::Insert(node)
  true
end

schema CLinkList_InsertSorted_9
  ΔCLinkList
  item? : T
  result! : Ref[CLink_T]
where
  -- Declared member operation CLinkList::InsertSorted(T const &item)
  true
end

schema CLinkList_if_10
  ΔCLinkList
  arg_1? : sort__item_sort
  result! : sort___sort__next
where
  -- Declared member operation CLinkList::if(sort->item.sort >= item.sort)
  true
end

schema CLinkList_if_11
  ΔCLinkList
  arg_1? : node
where
  -- Declared member operation CLinkList::if(node == &freeTail)
  true
end

schema CLinkList_Remove_12
  ΔCLinkList
  result! : node
where
  -- Declared member operation CLinkList::Remove()
  true
end

schema CLinkList_Insert_13
  ΔCLinkList
  arg_1? : node
  result! : sort__prev
where
  -- Declared member operation CLinkList::Insert(node)
  true
end

schema CLinkList_Remove_14
  ΔCLinkList
  link? : Ref[CLink_T]
  result! : void
where
  -- Declared member operation CLinkList::Remove(CLink<T> *link)
  true
end

schema CLinkList_Insert_15
  ΔCLinkList
  arg_1? : link
  result! : freeHead
where
  -- Declared member operation CLinkList::Insert(link)
  true
end

schema CLinkList_Count_16
  ΔCLinkList
  result! : ℤ
where
  -- Declared member operation CLinkList::Count(void)
  true
