--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CRange2D
  max : CVector2D_min
where
  instance_addr ∈ ADDRESS
end

schema CRange2D_CRange2D
  ΔCRange2D
  _min? : CVector2D
  _max? : CVector2D
where
  -- Declared member operation CRange2D::CRange2D(CVector2D _min, CVector2D _max)
  true
end

schema CRange2D_IsInRange_2
  ΔCRange2D
  vec? : CVector2D
  result! : 𝔹
where
  -- Declared member operation CRange2D::IsInRange(CVector2D vec)
  true
end

schema CRange2D_DebugShowRange_3
  ΔCRange2D
  arg_1? : ℝ
  arg_2? : ℤ
where
  -- Declared member operation CRange2D::DebugShowRange(float, int)
  true
end

schema CRange2D_GetRandomPointInRange_4
  ΔCRange2D
  result! : CVector2D
where
  -- Declared member operation CRange2D::GetRandomPointInRange()
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CRange2D_IsInRange
  ΔCRange2D
  vec? : CVector2D
where
  -- Return postcondition: result! = min.x < vec.x && max.x > vec.x && min.y < vec.y && max.y > vec.y
  true
end

schema CRange2D_DebugShowRange
  ΔCRange2D
  arg_1? : ℝ
  arg_2? : ℤ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRange2D_GetRandomPointInRange
  ΔCRange2D
where
  -- State update: distX' = Abs(max.x - min.x)
  -- State update: distY' = Abs(max.y - min.y)
  -- State update: outX' = CGeneral::GetRandomNumber() % distX + min.x
  -- State update: outY' = CGeneral::GetRandomNumber() % distY + min.y
  -- Return postcondition: result! = CVector2D(outX, outY)
  -- Invokes: CGeneral::GetRandomNumber
  true
end
