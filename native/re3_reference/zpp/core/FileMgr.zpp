--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
_CRT_SECURE_NO_WARNINGS : seq CHAR  -- #define _CRT_SECURE_NO_WARNINGS #include <fcntl.h>
NUMFILES : ℕ  -- #define NUMFILES 20
_getcwd : seq CHAR  -- #define _getcwd getcwd
mychdir : seq CHAR  -- #define mychdir chdir

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema myFILE
  isText : 𝔹
  file : Ref[FILE]
where
  #file ≤ 1
end

schema CFileMgr
  ms_rootDirName : seq CHAR
  ms_dirName : seq CHAR
where
  #ms_rootDirName = 128
  #ms_dirName = 128
end

schema CFileMgr_Initialise
  ΔCFileMgr
where
  -- Declared member operation CFileMgr::Initialise(void)
  true
end

schema CFileMgr_ChangeDir_2
  ΔCFileMgr
  dir? : seq CHAR
where
  -- Declared member operation CFileMgr::ChangeDir(const char *dir)
  true
end

