--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: ControllerConfig (core)
-- Source File(s): core/ControllerConfig.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include dinput.zpp  (from "dinput.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
DIRECTINPUT_VERSION : seq CHAR  -- #define DIRECTINPUT_VERSION 0x0800
JOY_BUTTONS : ℕ  -- #define JOY_BUTTONS 16
MAX_BUTTONS : seq CHAR  -- #define MAX_BUTTONS (JOY_BUTTONS+1)
ACTIONNAME_LENGTH : ℕ  -- #define ACTIONNAME_LENGTH 40

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eControllerType ::= KEYBOARD | OPTIONAL_EXTRA | MOUSE | JOYSTICK | MAX_CONTROLLERTYPES
  -- val(KEYBOARD) = 0

e_ControllerAction ::= PED_FIREWEAPON | PED_CYCLE_WEAPON_RIGHT | PED_CYCLE_WEAPON_LEFT | GO_FORWARD | GO_BACK | GO_LEFT | GO_RIGHT | PED_SNIPER_ZOOM_IN | PED_SNIPER_ZOOM_OUT | VEHICLE_ENTER_EXIT | CAMERA_CHANGE_VIEW_ALL_SITUATIONS | PED_JUMPING | PED_SPRINT | PED_LOOKBEHIND | PED_DUCK | PED_ANSWER_PHONE | VEHICLE_BRAKE | VEHICLE_CHANGE_RADIO_STATION | VEHICLE_HORN | TOGGLE_SUBMISSIONS | VEHICLE_HANDBRAKE | PED_1RST_PERSON_LOOK_LEFT | PED_1RST_PERSON_LOOK_RIGHT | VEHICLE_LOOKLEFT | VEHICLE_LOOKRIGHT | VEHICLE_LOOKBEHIND | VEHICLE_TURRETLEFT | VEHICLE_TURRETRIGHT | VEHICLE_TURRETUP | VEHICLE_TURRETDOWN | PED_CYCLE_TARGET_LEFT | PED_CYCLE_TARGET_RIGHT | PED_CENTER_CAMERA_BEHIND_PLAYER | PED_LOCK_TARGET | NETWORK_TALK | PED_1RST_PERSON_LOOK_UP | PED_1RST_PERSON_LOOK_DOWN | _CONTROLLERACTION_36 | TOGGLE_DPAD | SWITCH_DEBUG_CAM_ON | TAKE_SCREEN_SHOT | SHOW_MOUSE_POINTER_TOGGLE | UNKNOWN_ACTION | MAX_CONTROLLERACTIONS
  -- val(PED_FIREWEAPON) = 0

e_ControllerActionType ::= ACTIONTYPE_1RSTPERSON | ACTIONTYPE_3RDPERSON | ACTIONTYPE_VEHICLE | ACTIONTYPE_VEHICLE_3RDPERSON | ACTIONTYPE_COMMON | ACTIONTYPE_1RST3RDPERSON | ACTIONTYPE_NONE
  -- val(ACTIONTYPE_1RSTPERSON) = 0

eContSetOrder ::= SETORDER_NONE | SETORDER_1 | SETORDER_2 | SETORDER_3 | SETORDER_4 | MAX_SETORDERS
  -- val(SETORDER_NONE) = 0

eSimCheckers ::= SIM_X1 | SIM_Y1 | SIM_X2 | SIM_Y2 | MAX_SIMS
  -- val(SIM_X1) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema GlfwJoyState
  id : ℤ
  isGamepad : 𝔹
  numButtons : ℕ
  buttons : ℙ ℕ
  mappedButtons : seq 𝔹  -- bounded array [17]
where
  numButtons ≥ 0
  #buttons ≤ 1
  #mappedButtons = 17
end

schema CControllerConfigManager
  m_ContSetOrder : ℤ
  m_bFirstCapture : 𝔹
  m_NewState : GlfwJoyState
  m_aButtonStates : seq 𝔹  -- bounded array [MAX_BUTTONS]
  m_bMouseAssociated : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CControllerConfigManager_tControllerConfigBind
  ΔCControllerConfigManager
where
  -- Declared member operation CControllerConfigManager::tControllerConfigBind()
  true
end

