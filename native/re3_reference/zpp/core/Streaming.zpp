schema CStreamingChannel
  streamIds : seq ℤ  -- bounded array [4]
  offsets : seq ℤ  -- bounded array [4]
  state : ℤ
  field24 : ℤ
  position : ℤ
  size : ℤ
  numTries : ℤ
  status : ℤ
where
  #streamIds = 4
  #offsets = 4
end

schema CStreaming
  ms_disableStreaming : 𝔹
  ms_bLoadingBigModel : 𝔹
  ms_numModelsRequested : ℤ
  ms_aInfoForModel : seq CStreamingInfo  -- bounded array [NUMSTREAMINFO]
  ms_startLoadedList : CStreamingInfo
  ms_endLoadedList : CStreamingInfo
  ms_startRequestedList : CStreamingInfo
  ms_endRequestedList : CStreamingInfo
  ms_oldSectorX : ℤ
  ms_oldSectorY : ℤ
  ms_streamingBufferSize : ℤ
  ms_channel : seq CStreamingChannel  -- bounded array [2]
  ms_channelError : ℤ
  ms_numVehiclesLoaded : ℤ
  ms_numPedsLoaded : ℤ
  ms_vehiclesLoaded : seq ℤ  -- bounded array [MAXVEHICLESLOADED]
  ms_lastVehicleDeleted : ℤ
  ms_bIsPedFromPedGroupLoaded : seq 𝔹  -- bounded array [NUMMODELSPERPEDGROUP]
  ms_pExtraObjectsDir : Ref[CDirectory]
  ms_numPriorityRequests : ℤ
  ms_currentPedGrp : ℤ
  ms_lastCullZone : ℤ
  ms_loadedGangs : ℕ
  ms_loadedGangCars : ℕ
  ms_currentPedLoading : ℤ
  ms_imageOffsets : seq ℤ  -- bounded array [NUMCDIMAGES]
  ms_lastImageRead : ℤ
  ms_imageSize : ℤ
  ms_memoryAvailable : ℕ
  ms_hasLoadedLODs : 𝔹
where
  #ms_channel = 2
  #ms_pExtraObjectsDir ≤ 1
  ms_loadedGangs ≥ 0
  ms_loadedGangCars ≥ 0
  ms_memoryAvailable ≥ 0
end

