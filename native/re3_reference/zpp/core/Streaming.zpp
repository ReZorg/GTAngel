schema CStreaming_ConvertBufferToObject
  ΔCStreaming
  buf? : ℙ ℤ
  streamId? : ℤ
where
  -- State update: cdsize' = ms_aInfoForModel[streamId].GetCdSize()
  -- State update: mem.start' = (uint8*)buf
  -- State update: mem.length' = cdsize * CDSTREAM_SECTOR_SIZE
  -- State update: stream' = RwStreamOpen(rwSTREAMMEMORY, rwSTREAMREAD, &mem)
  -- State update: mi' = CModelInfo::GetModelInfo(streamId)
  -- State update: success' = CFileLoader::LoadAtomicFile(stream, streamId)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Invokes: CTimer::GetCurrentTimeInCycles, CTimer::GetCyclesPerMillisecond, CModelInfo::GetModelInfo, mi->GetTxdSlot, CTxdStore::GetSlot
  true
end

