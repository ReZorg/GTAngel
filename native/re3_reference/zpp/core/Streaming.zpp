--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MB : seq CHAR  -- #define MB (1024*1024)
BIGBUILDINGFLAGS : seq CHAR  -- #define BIGBUILDINGFLAGS STREAMFLAGS_DONT_REMOVE|STREAMFLAGS_PRIORITY
STREAM_DIST : ℝ  -- #define STREAM_DIST 80.0f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Streaming_Enum_1 ::= STREAM_OFFSET_TXD | STREAM_OFFSET_COL | STREAM_OFFSET_ANIM | NUMSTREAMINFO
  -- val(STREAM_OFFSET_TXD) = MODELINFOSIZE
  -- val(STREAM_OFFSET_COL) = STREAM_OFFSET_TXD+TXDSTORESIZE
  -- val(STREAM_OFFSET_ANIM) = STREAM_OFFSET_COL+COLSTORESIZE
  -- val(NUMSTREAMINFO) = STREAM_OFFSET_ANIM+NUMANIMBLOCKS

StreamFlags ::= STREAMFLAGS_DONT_REMOVE | STREAMFLAGS_SCRIPTOWNED | STREAMFLAGS_DEPENDENCY | STREAMFLAGS_PRIORITY | STREAMFLAGS_NOFADE | STREAMFLAGS_20 | STREAMFLAGS_40 | STREAMFLAGS_AMBIENT_SCRIPT_OWNED | STREAMFLAGS_CANT_REMOVE | STREAMFLAGS_KEEP_IN_MEMORY
  -- val(STREAMFLAGS_DONT_REMOVE) = 0x01
  -- val(STREAMFLAGS_SCRIPTOWNED) = 0x02
  -- val(STREAMFLAGS_DEPENDENCY) = 0x04
  -- val(STREAMFLAGS_PRIORITY) = 0x08
  -- val(STREAMFLAGS_NOFADE) = 0x10
  -- val(STREAMFLAGS_20) = 0x20
  -- val(STREAMFLAGS_40) = 0x40
  -- val(STREAMFLAGS_AMBIENT_SCRIPT_OWNED) = 0x80
  -- val(STREAMFLAGS_CANT_REMOVE) = STREAMFLAGS_DONT_REMOVE|STREAMFLAGS_SCRIPTOWNED|STREAMFLAGS_AMBIENT_SCRIPT_OWNED
  -- val(STREAMFLAGS_KEEP_IN_MEMORY) = STREAMFLAGS_DONT_REMOVE|STREAMFLAGS_SCRIPTOWNED|STREAMFLAGS_DEPENDENCY |STREAMFLAGS_AMBIENT_SCRIPT_OWNED

StreamLoadState ::= STREAMSTATE_NOTLOADED | STREAMSTATE_LOADED | STREAMSTATE_INQUEUE | STREAMSTATE_READING | STREAMSTATE_STARTED
  -- val(STREAMSTATE_NOTLOADED) = 0
  -- val(STREAMSTATE_LOADED) = 1
  -- val(STREAMSTATE_INQUEUE) = 2
  -- val(STREAMSTATE_READING) = 3
  -- val(STREAMSTATE_STARTED) = 4

ChannelState ::= CHANNELSTATE_IDLE | CHANNELSTATE_READING | CHANNELSTATE_STARTED | CHANNELSTATE_ERROR
  -- val(CHANNELSTATE_IDLE) = 0
  -- val(CHANNELSTATE_READING) = 1
  -- val(CHANNELSTATE_STARTED) = 2
  -- val(CHANNELSTATE_ERROR) = 3

Streaming_Enum_5 ::= STREAM_OFFSET_TXD | NUMSTREAMINFO
  -- val(STREAM_OFFSET_TXD) = MODELINFOSIZE
  -- val(NUMSTREAMINFO) = STREAM_OFFSET_TXD+TXDSTORESIZE

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CStreamingInfo
  m_next : Ref[CStreamingInfo]
  m_prev : Ref[CStreamingInfo]
  m_loadState : ℕ
  m_flags : ℕ
  m_nextID : ℤ
  m_position : ℕ
  m_size : ℕ
where
  #m_next ≤ 1
  #m_prev ≤ 1
  m_loadState ≥ 0
  m_flags ≥ 0
  m_position ≥ 0
  m_size ≥ 0
end

schema CStreamingInfo_GetCdPosnAndSize
  ΔCStreamingInfo
  posn? : ℕ
  size? : ℕ
  result! : 𝔹
where
  -- Declared member operation CStreamingInfo::GetCdPosnAndSize(uint32 &posn, uint32 &size)
  true
end

