--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPlaceName
  m_pZone : Ref[CZone]
  m_pZone2 : Ref[CZone]
  m_nAdditionalTimer : ℤ
where
  #m_pZone ≤ 1
  #m_pZone2 ≤ 1
end

schema CPlaceName_CPlaceName
  ΔCPlaceName
where
  -- Declared member operation CPlaceName::CPlaceName()
  true
end

schema CPlaceName_Init_2
  ΔCPlaceName
where
  -- Declared member operation CPlaceName::Init()
  true
end

schema CPlaceName_Process_3
  ΔCPlaceName
where
  -- Declared member operation CPlaceName::Process()
  true
end

schema CPlaceName_Display_4
  ΔCPlaceName
where
  -- Declared member operation CPlaceName::Display()
  true
end

schema CPlaceName_ProcessAfterFrontEndShutDown_5
  ΔCPlaceName
where
  -- Declared member operation CPlaceName::ProcessAfterFrontEndShutDown()
  true
end

schema CCurrentVehicle
  m_pCurrentVehicle : Ref[CVehicle]
where
  #m_pCurrentVehicle ≤ 1
end

schema CCurrentVehicle_CCurrentVehicle
  ΔCCurrentVehicle
where
  -- Declared member operation CCurrentVehicle::CCurrentVehicle()
  true
end

schema CCurrentVehicle_Init_2
  ΔCCurrentVehicle
where
  -- Declared member operation CCurrentVehicle::Init()
  true
end

schema CCurrentVehicle_Process_3
  ΔCCurrentVehicle
where
  -- Declared member operation CCurrentVehicle::Process()
  true
end

schema CCurrentVehicle_Display_4
  ΔCCurrentVehicle
where
  -- Declared member operation CCurrentVehicle::Display()
  true
end

schema CUserDisplay
  PlaceName : CPlaceName
  OnscnTimer : COnscreenTimer
  Pager : CPager
  CurrentVehicle : CCurrentVehicle
where
  instance_addr ∈ ADDRESS
end

schema CUserDisplay_Init
  ΔCUserDisplay
where
  -- Declared member operation CUserDisplay::Init()
  true
end

schema CUserDisplay_Process_2
  ΔCUserDisplay
where
  -- Declared member operation CUserDisplay::Process()
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPlaceName_CPlaceName
  ΔCPlaceName
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlaceName_Init
  ΔCPlaceName
where
  -- State update: m_pZone' = ∅
  -- State update: m_pZone2' = ∅
  -- State update: m_nAdditionalTimer' = 0
  true
end

schema CPlaceName_Process
  ΔCPlaceName
where
  -- State update: pos' = CWorld::Players[CWorld::PlayerInFocus].GetPos()
  -- State update: m_pZone' = ∅
  -- State update: m_pZone2' = ∅
  -- State update: m_nAdditionalTimer' = 0
  -- State update: m_pZone' = ∅
  -- State update: m_pZone2' = ∅
  -- Invokes: CTheZones::FindSmallestNavigationZoneForPosition
  true
end

schema CPlaceName_Display
  ΔCPlaceName
where
  -- State update: text' = m_pZone.GetTranslatedName()
  -- State update: text' = m_pZone2.GetTranslatedName()
  -- State update: text' = ∅
  -- Invokes: m_pZone->GetTranslatedName, m_pZone2->GetTranslatedName, CHud::SetZoneName
  true
end

schema CPlaceName_ProcessAfterFrontEndShutDown
  ΔCPlaceName
where
  -- State update: m_pLastZoneName' = ∅
  -- State update: m_ZoneState' = 0
  -- State update: m_nAdditionalTimer' = 250
  true
end

schema CCurrentVehicle_CCurrentVehicle
  ΔCCurrentVehicle
where
  -- Deterministic transition preserving module invariants
  true
end

schema CCurrentVehicle_Init
  ΔCCurrentVehicle
where
  -- State update: m_pCurrentVehicle' = ∅
  true
end

schema CCurrentVehicle_Process
  ΔCCurrentVehicle
where
  -- State update: m_pCurrentVehicle' = CWorld::Players[CWorld::PlayerInFocus].m_pPed.m_pMyVehicle
  -- State update: m_pCurrentVehicle' = ∅
  -- Invokes: m_pPed->InVehicle
  true
end

schema CCurrentVehicle_Display
  ΔCCurrentVehicle
where
  -- State update: text' = ∅
  -- Invokes: TheText.Get, CModelInfo::GetModelInfo, m_pCurrentVehicle->GetModelIndex, CHud::SetVehicleName
  true
end

schema CUserDisplay_Init
  ΔCUserDisplay
where
  -- Invokes: PlaceName.Init, OnscnTimer.Init, Pager.Init, CurrentVehicle.Init
  true
end

schema CUserDisplay_Process
  ΔCUserDisplay
where
  -- Invokes: CReplay::IsPlayingBack, PlaceName.Process, OnscnTimer.Process, Pager.Process, CurrentVehicle.Process
  true
end
