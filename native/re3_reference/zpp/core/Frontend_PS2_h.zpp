--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Frontend_PS2 (core)
-- Source File(s): core/Frontend_PS2.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Sprite2d.zpp  (from "Sprite2d.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Frontend_PS2_Enum_1 ::= PAGE_STATS | PAGE_LOAD | PAGE_BRIEFS | PAGE_CONTROLS | PAGE_AUDIO | PAGE_DISPLAY | PAGE_LANGUAGE | NUM_PAGES | PAGE_FIRST | PAGE_LAST
  -- val(PAGE_FIRST) = PAGE_STATS
  -- val(PAGE_LAST) = PAGE_LANGUAGE

Frontend_PS2_Enum_2 ::= PAGESTATE_NORMAL | PAGESTATE_HIGHLIGHTED | PAGESTATE_SELECTED
  -- val(PAGESTATE_NORMAL) = 0

eFrontendSprites ::= FE2_MAINPANEL_UL | FE2_MAINPANEL_UR | FE2_MAINPANEL_DL | FE2_MAINPANEL_DR | FE2_MAINPANEL_DR2 | FE2_TABACTIVE | FE_ICONBRIEF | FE_ICONSTATS | FE_ICONCONTROLS | FE_ICONSAVE | FE_ICONAUDIO | FE_ICONDISPLAY | FE_ICONLANGUAGE | FE_CONTROLLER | FE_CONTROLLERSH | FE_ARROWS1 | FE_ARROWS2 | FE_ARROWS3 | FE_ARROWS4 | FE_RADIO1 | FE_RADIO2 | FE_RADIO3 | FE_RADIO4 | FE_RADIO5 | FE_RADIO6 | FE_RADIO7 | FE_RADIO8 | FE_RADIO9 | NUM_FE_SPRITES

eControlMethod ::= CONTROL_STANDARD | CONTROL_CLASSIC
  -- val(CONTROL_STANDARD) = 0

LANGUAGE ::= LANGUAGE_AMERICAN | LANGUAGE_FRENCH | LANGUAGE_GERMAN | LANGUAGE_ITALIAN | LANGUAGE_SPANISH | LANGUAGE_RUSSIAN | LANGUAGE_JAPANESE

CONTRCONFIG ::= CONFIG_1 | CONFIG_2 | CONFIG_3 | CONFIG_4
  -- val(CONFIG_1) = 0

Frontend_PS2_Enum_7 ::= NUM_SPRIRES
  -- val(NUM_SPRIRES) = 28

Frontend_PS2_Enum_8 ::= PAGESTATE_NORMAL | PAGESTATE_HIGHLIGHTED | PAGESTATE_SELELECTED
  -- val(PAGESTATE_NORMAL) = 0
  -- val(PAGESTATE_HIGHLIGHTED) = 1
  -- val(PAGESTATE_SELELECTED) = 2

Frontend_PS2_Enum_9 ::= SLIDE_TO_BOTTOM | SLIDE_TO_RIGHT | SLIDE_TO_TOP | SLIDE_TO_LEFT | SLIDE_MAX
  -- val(SLIDE_TO_BOTTOM) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CMenuManager
  m_currentPage : ℤ
  m_newPage : ℤ
  m_pageState : ℤ
  m_nPageLeftTimer : ℕ
  m_nPageRightTimer : ℕ
  m_nChangePageTimer : ℕ
  field_18 : ℤ
  m_fade : ℕ
  m_someAlpha : ℕ
  m_nStartPauseTimer : ℕ
  m_nEndPauseTimer : ℕ
  m_position : CVector2D
  m_nSlidingDir : ℕ
  m_bInitialised : 𝔹
  m_bWantToUpdateContent : 𝔹
  m_bMenuActive : 𝔹
  m_bWantToRestart : 𝔹
  m_bRenderGameInMenu : 𝔹
  m_bSaveMenuActive : 𝔹
  m_bInSaveZone : 𝔹
  field_3C : seq CHAR
  m_bTexturesLoaded : 𝔹
  m_sprites : seq CSprite2d  -- bounded array [NUM_SPRIRES]
  m_PrefsSfxVolume : ℤ
  m_PrefsMusicVolume : ℤ
  m_PrefsBrightness : ℤ
  m_PrefsShowTrails : 𝔹
  m_PrefsShowSubtitles : 𝔹
  m_PrefsAllowNastyGame : 𝔹
  m_PrefsRadioStation : ℤ
  m_PrefsStereoMono : ℤ
  m_PrefsUseWideScreen : ℤ
  m_PrefsLanguage : ℤ
  m_PrefsControllerConfig : CONTRCONFIG
  m_PrefsUseVibration : 𝔹
  m_nMouseTempPosX : ℤ
  m_nMouseTempPosY : ℤ
  m_nPrefsVideoMode : ℤ
  m_nDisplayVideoMode : ℤ
  m_nPrefsAudio3DProviderIndex : ℤ
  OS_Language : ℤ
  m_PrefsVsync : ℤ
  m_PrefsVsyncDisp : ℤ
  m_PrefsFrameLimiter : ℤ
  m_PrefsSpeakers : ℤ
  m_ControlMethod : ℤ
  m_PrefsDMA : ℤ
  m_PrefsLOD : ℝ
  m_PrefsSkinFile : seq CHAR
  m_PrefsDisableTutorials : 𝔹
  fMapSize : ℝ
  fMapCenterY : ℝ
  fMapCenterX : ℝ
  m_nPrefsSubsystem : ℤ
  m_nSelectedScreenMode : ℤ
where
  m_nPageLeftTimer ≥ 0
  m_nPageRightTimer ≥ 0
  m_nChangePageTimer ≥ 0
  m_fade ≥ 0
  m_someAlpha ≥ 0
  m_nStartPauseTimer ≥ 0
  m_nEndPauseTimer ≥ 0
  m_nSlidingDir ≥ 0
  #m_PrefsSkinFile = 256
end

