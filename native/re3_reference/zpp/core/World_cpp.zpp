  -- State update: xstart' = GetSectorIndexX(point1.x)
  -- State update: ystart' = GetSectorIndexY(point1.y)
  -- State update: xend' = GetSectorIndexX(point2.x)
  -- State update: yend' = GetSectorIndexY(point2.y)
