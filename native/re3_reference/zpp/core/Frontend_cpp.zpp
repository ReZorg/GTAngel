--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
FORCE_PC_SCALING : seq CHAR  -- #define FORCE_PC_SCALING #define WITHWINDOWS
WITHDINPUT : seq CHAR  -- #define WITHDINPUT #include "common.h"
TIDY_UP_PBP : seq CHAR  -- #define TIDY_UP_PBP #define MAX_VISIBLE_LIST_ROW 30
SCROLLBAR_MAX_HEIGHT : ℝ  -- #define SCROLLBAR_MAX_HEIGHT 263.0f
SCROLLABLE_PAGES : seq CHAR  -- #define SCROLLABLE_PAGES #define RED_DELETE_BACKGROUND
MAX_VISIBLE_OPTION : ℕ  -- #define MAX_VISIBLE_OPTION 12
MAX_VISIBLE_OPTION_ON_SCREEN : seq CHAR  -- #define MAX_VISIBLE_OPTION_ON_SCREEN (hasNativeList(m_nCurrScreen) ? MAX_VISIBLE_LIST_ROW : MAX_VISIBLE_OPTION)
SCREEN_HAS_AUTO_SCROLLBAR : seq CHAR  -- #define SCREEN_HAS_AUTO_SCROLLBAR (m_nTotalListRow > MAX_VISIBLE_OPTION && !hasNativeList(m_nCurrScreen))
GetBackJustUp : seq CHAR  -- #define GetBackJustUp GetTriangleJustUp
GetBackJustDown : seq CHAR  -- #define GetBackJustDown GetTriangleJustDown
PAGE_NAME_X : seq CHAR  -- #define PAGE_NAME_X MENU_X_RIGHT_ALIGNED
SCROLLBAR_BOTTOM_Y : ℝ  -- #define SCROLLBAR_BOTTOM_Y 125.0f
SCROLLBAR_RIGHT_X : ℝ  -- #define SCROLLBAR_RIGHT_X 36.0f
SCROLLBAR_WIDTH : ℝ  -- #define SCROLLBAR_WIDTH 9.5f
SCROLLBAR_TOP_Y : ℕ  -- #define SCROLLBAR_TOP_Y 64
optionWidth : ℝ  -- #define optionWidth MENU_X(66.0f)
rawOptionHeight : ℝ  -- #define rawOptionHeight 22.0f
optionBottom : ℝ  -- #define optionBottom SCREEN_SCALE_FROM_BOTTOM(20.0f)
optionTop : ℝ  -- #define optionTop SCREEN_SCALE_FROM_BOTTOM(20.0f + rawOptionHeight)
leftPadding : ℝ  -- #define leftPadding MENU_X_LEFT_ALIGNED(90.0f)
int_STAT_IS_FLOAT : seq CHAR  -- #define int_STAT_IS_FLOAT false
float_STAT_IS_FLOAT : seq CHAR  -- #define float_STAT_IS_FLOAT true
DEFAULT_BRIGHTNESS : seq CHAR  -- #define DEFAULT_BRIGHTNESS 0x150
MIN_BRIGHTNESS : ℕ  -- #define MIN_BRIGHTNESS 180
MAX_BRIGHTNESS : ℕ  -- #define MAX_BRIGHTNESS 700
MAP_MIN_SIZE : ℝ  -- #define MAP_MIN_SIZE 162.f
MAP_SIZE_TO_ALLOW_X_MOVE : ℝ  -- #define MAP_SIZE_TO_ALLOW_X_MOVE 297.f
MINUS_SCROLL_OFFSET : seq CHAR  -- #define MINUS_SCROLL_OFFSET - scrollOffset
PLUS_LINE_HEIGHT_ON_SCREEN : seq CHAR  -- #define PLUS_LINE_HEIGHT_ON_SCREEN + MENU_DEFAULT_LINE_HEIGHT

