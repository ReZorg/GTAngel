--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPools_Initialise
  ΔCPools
where
  -- State update: ms_pPtrNodePool' = new CCPtrNodePool(NUMPTRNODES, "PtrNode")
  -- State update: ms_pEntryInfoNodePool' = new CEntryInfoNodePool(NUMENTRYINFOS, "EntryInfoNode")
  -- State update: ms_pPedPool' = new CPedPool(NUMPEDS, "Peds")
  -- State update: ms_pVehiclePool' = new CVehiclePool(NUMVEHICLES, "Vehicles")
  -- State update: ms_pBuildingPool' = new CBuildingPool(NUMBUILDINGS, "Buildings")
  -- State update: ms_pTreadablePool' = new CTreadablePool(NUMTREADABLES, "Treadables")
  true
end

schema CPools_ShutDown
  ΔCPools
where
  -- Invokes: ms_pPtrNodePool->GetNoOfUsedSpaces, ms_pEntryInfoNodePool->GetNoOfUsedSpaces, ms_pPedPool->GetNoOfUsedSpaces, ms_pVehiclePool->GetNoOfUsedSpaces, ms_pBuildingPool->GetNoOfUsedSpaces
  true
end

schema CPools_GetPedRef
  ΔCPools
  ped? : Ref[CPed]
  result! : ℤ
where
  -- Return postcondition: result! = ms_pPedPool->GetIndex(ped)
  -- Invokes: ms_pPedPool->GetIndex
  true
end

schema CPools_GetVehicleRef
  ΔCPools
  vehicle? : Ref[CVehicle]
  result! : ℤ
where
  -- Return postcondition: result! = ms_pVehiclePool->GetIndex(vehicle)
  -- Invokes: ms_pVehiclePool->GetIndex
  true
end

schema CPools_GetObjectRef
  ΔCPools
  object? : Ref[CObject]
  result! : ℤ
where
  -- Return postcondition: result! = ms_pObjectPool->GetIndex(object)
  -- Invokes: ms_pObjectPool->GetIndex
  true
end

schema CPools_CheckPoolsEmpty
  ΔCPools
where
  -- Invokes: ms_pPedPool->GetNoOfUsedSpaces, ms_pVehiclePool->GetNoOfUsedSpaces
  true
end

schema CPools_MakeSureSlotInObjectPoolIsEmpty
  ΔCPools
  slot? : ℤ
where
  -- State update: object' = ms_pObjectPool.GetSlot(slot)
  -- State update: newObject' = new CObject(object.GetModelIndex(), false)
  -- State update: newObject' = *object
  -- State update: object.m_rwObject' = ∅
  -- State update: newObject.m_pFirstReference' = ∅
  -- Invokes: ms_pObjectPool->GetIsFree, ms_pObjectPool->GetSlot, CWorld::Remove, CProjectileInfo::RemoveIfThisIsAProjectile, object->GetModelIndex
  true
end

schema CPools_LoadVehiclePool
  ΔCPools
  buf? : ℙ ℕ
  size? : ℕ
where
  -- State update: pVehicle' = new(slot) CBoat(model, RANDOM_VEHICLE)
  -- State update: pVehicle' = new(slot) CAutomobile(model, RANDOM_VEHICLE)
  -- State update: pVehicle' = new(slot) CBike(model, RANDOM_VEHICLE)
  -- State update: pBoat' = new(slot) CBoat(model, RANDOM_VEHICLE)
  -- State update: pVehicle' = pBoat
  -- State update: pAutomobile' = new(slot) CAutomobile(model, RANDOM_VEHICLE)
  -- Invokes: CStreaming::RequestModel, CStreaming::LoadAllRequestedModels, pVehicle->Load, CWorld::Add, pAutomobile->SetupDamageAfterLoad
  true
end

schema CPools_SaveVehiclePool
  ΔCPools
  buf? : ℙ ℕ
  size? : ℙ ℕ
where
  -- State update: nNumCars' = 0
  -- State update: nNumBoats' = 0
  -- State update: nNumBikes' = 0
  -- State update: nPoolSize' = GetVehiclePool().GetSize()
  -- State update: pVehicle' = GetVehiclePool().GetSlot(i)
  -- State update: bHasPassenger' = false
  -- Invokes: pVehicle->IsCar, pVehicle->IsBoat, pVehicle->IsBike, pVehicle->GetModelIndex, pVehicle->Save
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema PoolsModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 684
end
