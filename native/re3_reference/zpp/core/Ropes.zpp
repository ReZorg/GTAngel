--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CRope
  m_bActive : 𝔹
  m_bWasRegistered : 𝔹
  m_unk : 𝔹
  m_id : ℕ
  m_updateTimer : ℕ
  m_pos : seq CVector  -- bounded array [32]
  m_speed : seq CVector  -- bounded array [32]
where
  m_id ≥ 0
  m_updateTimer ≥ 0
  #m_pos = 32
  #m_speed = 32
end

schema CRope_Update
  ΔCRope
where
  -- Declared member operation CRope::Update(void)
  true
end

schema CRope_Render_2
  ΔCRope
where
  -- Declared member operation CRope::Render(void)
  true
end

schema CRopes
  aRopes : seq CRope  -- bounded array [8]
where
  #aRopes = 8
end

schema CRopes_Init
  ΔCRopes
where
  -- Declared member operation CRopes::Init(void)
  true
end

schema CRopes_Update_2
  ΔCRopes
where
  -- Declared member operation CRopes::Update(void)
  true
end

schema CRopes_Render_3
  ΔCRopes
where
  -- Declared member operation CRopes::Render(void)
  true
end

schema CRopes_RegisterRope_4
  ΔCRopes
  id? : ℕ
  pos? : CVector
  setUpdateTimer? : 𝔹
  result! : 𝔹
where
  -- Declared member operation CRopes::RegisterRope(uintptr id, CVector pos, bool setUpdateTimer)
  true
end

schema CRopes_SetSpeedOfTopNode_5
  ΔCRopes
  id? : ℕ
  speed? : CVector
where
  -- Declared member operation CRopes::SetSpeedOfTopNode(uintptr id, CVector speed)
  true
end

schema CRopes_FindCoorsAlongRope_6
  ΔCRopes
  id? : ℕ
  t? : ℝ
  coors? : Ref[CVector]
  result! : 𝔹
where
  -- Declared member operation CRopes::FindCoorsAlongRope(uintptr id, float t, CVector *coors)
  true
end

schema CRopes_CreateRopeWithSwatComingDown_7
  ΔCRopes
  pos? : CVector
  result! : 𝔹
where
  -- Declared member operation CRopes::CreateRopeWithSwatComingDown(CVector pos)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CRope_Update
  ΔCRope
where
  -- State update: step' = Pow(0.85f, CTimer::GetTimeStep())
  -- State update: prevPos' = m_pos[i]
  -- State update: dist' = m_pos[i] - m_pos[i-1]
  -- State update: m_bActive' = false
  -- State update: m_bWasRegistered' = false
  -- Invokes: CTimer::GetTimeStep, CTimer::GetTimeInMilliseconds, dist.Magnitude
  true
end

schema CRope_Render
  ΔCRope
where
  -- State update: numVerts' = 0
  -- Invokes: TheCamera.IsSphereVisible
  true
end

schema CRopes_Init
  ΔCRopes
where
  -- State update: m_bActive' = false
  true
end

schema CRopes_Update
  ΔCRopes
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRopes_Render
  ΔCRopes
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRopes_RegisterRope
  ΔCRopes
  id? : ℕ
  pos? : CVector
  setUpdateTimer? : 𝔹
where
  -- State update: m_bWasRegistered' = true
  -- State update: m_id' = id
  -- State update: m_unk' = false
  -- State update: m_bWasRegistered' = true
  -- State update: m_bActive' = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CRopes_SetSpeedOfTopNode
  ΔCRopes
  id? : ℕ
  speed? : CVector
where
  -- Deterministic transition preserving module invariants
  true
end

schema CRopes_FindCoorsAlongRope
  ΔCRopes
  id? : ℕ
  t? : ℝ
  coors? : Ref[CVector]
where
  -- State update: t' = (ARRAY_SIZE(aRopes[0].m_pos)-1)*Clamp(t, 0.0f, 0.999f)
  -- State update: f' = t - j
  -- State update: coors' = (1.0f-f)*aRopes[i].m_pos[j] + f*aRopes[i].m_pos[j+1]
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  true
end

schema CRopes_CreateRopeWithSwatComingDown
  ΔCRopes
  pos? : CVector
where
  -- State update: ropeId' = 0
  -- State update: swat.bUsesCollision' = false
  -- State update: swat.m_pRopeEntity' = (CEntity*)1
  -- State update: swat.m_nRopeID' = 100 + ropeId
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CStreaming::HasModelLoaded, CPopulation::AddPed, CAnimManager::BlendAnimation, swat->GetClump
  true
end
