--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: ControllerConfig (core)
-- Source File(s): core/ControllerConfig.cpp, core/ControllerConfig.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include common.zpp  (from "common.h")
-- include platform.zpp  (from "platform.h")
-- include crossplatform.zpp  (from "crossplatform.h")
