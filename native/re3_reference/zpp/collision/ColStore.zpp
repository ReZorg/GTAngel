  -- State update: def.isLoaded' = true
  -- Return postcondition: result! = success
  -- Invokes: CFileLoader::LoadCollisionFileFirstTime, CFileLoader::LoadCollisionFile
  true
end

schema CColStore_LoadColCHK
  ΔCColStore
  slot? : ℤ
  data? : ADDRESS
  chunk? : ADDRESS
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.chunk' = chunk
  -- State update: entry' = (ColChunkEntry*)data
  -- State update: mi' = CModelInfo::GetModelInfo(entry.modelId)
  -- State update: def.isLoaded' = true
  -- Invokes: CStreaming::RegisterPointer, CModelInfo::GetModelInfo, mi->SetColModel
  true
end

schema CColStore_RemoveCol
  ΔCColStore
  slot? : ℤ
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.isLoaded' = false
  -- State update: id' = 0
  -- State update: mi' = CModelInfo::GetModelInfo(id)
  -- State update: col' = mi.GetColModel()
  -- State update: id' = 0
  -- Invokes: CModelInfo::GetModelInfo, mi->GetColModel, col->RemoveCollisionVolumes, mi->SetColModel, CStreaming::UnregisterPointer
  true
end

