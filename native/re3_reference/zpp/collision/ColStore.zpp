schema ColChunkEntry
  modelId : ℤ
  colModel : Ref[CColModel]
where
  #colModel ≤ 1
end

schema ColDef
  unused : ℤ
  isLoaded : 𝔹
  bounds : CRect
  name : seq CHAR
  minIndex : ℤ
  maxIndex : ℤ
  chunk : ADDRESS
where
  #name = 20
end

schema CColStore
  ms_pColPool : Ref[CPool_ColDef_ColDef]
  m_onlyBB : 𝔹
where
  #ms_pColPool ≤ 1
end

