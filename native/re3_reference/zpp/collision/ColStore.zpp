schema ColStore_LevelPos
  ΔColStoreModuleState
  level? : eLevelName
where
  -- Return postcondition: result! = pos[level]
  true
end

schema ColStore_PosLevel
  ΔColStoreModuleState
  pos? : CVector
where
  -- State update: lastPlayerLevel' = LEVEL_INDUSTRIAL
  -- State update: lastOtherLevel' = LEVEL_INDUSTRIAL
  -- State update: lastPlayerLevel' = CGame::currLevel
  -- State update: lvl' = CTheZones::GetLevelFromPosition(&pos)
  -- State update: lastOtherLevel' = lvl
  -- Return postcondition: result! = lastPlayerLevel
  -- Return postcondition: result! = lastOtherLevel
  -- Invokes: CTheZones::GetLevelFromPosition
  true
end

