schema VuCollision_DistanceBetweenSphereAndLine
  ΔVuCollisionModuleState
  center? : CVuVector
  p0? : CVuVector
  line? : CVuVector
where
  -- State update: p1' = p0+line
  -- State update: dist0' = center - p0
  -- State update: dist1' = center - p1
  -- State update: lenSq' = line.MagnitudeSqr()
  -- State update: distSq0' = dist0.MagnitudeSqr()
  -- State update: distSq1' = dist1.MagnitudeSqr()
  -- Return postcondition: result! = ret
  -- Return postcondition: result! = ret
  -- Return postcondition: result! = ret
  -- Invokes: line.MagnitudeSqr, dist0.MagnitudeSqr, dist1.MagnitudeSqr
  true
end

