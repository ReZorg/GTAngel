--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CColModel
  boundingSphere : CSphere
  boundingBox : CBox
  numSpheres : ℤ
  numBoxes : ℤ
  numTriangles : ℤ
  numLines : ℤ
  numTriBBoxes : ℤ
  level : ℕ
  ownsCollisionVolumes : 𝔹
  spheres : Ref[CColSphere]
  lines : Ref[CColLine]
  boxes : Ref[CColBox]
  triBBoxes : Ref[CColTriBBox]
  vertices : Ref[CompressedVector]
  triangles : Ref[CColTriangle]
  trianglePlanes : Ref[CColTrianglePlane]
where
  level ≥ 0
  #spheres ≤ 1
  #lines ≤ 1
  #boxes ≤ 1
  #triBBoxes ≤ 1
  #vertices ≤ 1
  #triangles ≤ 1
  #trianglePlanes ≤ 1
end

schema CColModel_CColModel
  ΔCColModel
where
  -- Declared member operation CColModel::CColModel(void)
  true
end

