--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CColModel_CColModel
  ΔCColModel
where
  -- State update: numTriBBoxes' = 0
  -- State update: triBBoxes' = ∅
  -- State update: numSpheres' = 0
  -- State update: spheres' = ∅
  -- State update: numLines' = 0
  -- State update: lines' = ∅
  -- Invokes: boundingSphere.Set, boundingBox.Set
  true
end

schema CColModel_CColModel_2
  ΔCColModel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CColModel_RemoveCollisionVolumes
  ΔCColModel
where
  -- State update: numSpheres' = 0
  -- State update: numTriBBoxes' = 0
  -- State update: numLines' = 0
  -- State update: numBoxes' = 0
  -- State update: numTriangles' = 0
  -- State update: spheres' = ∅
  -- Invokes: CCollision::RemoveTrianglePlanes
  true
end

schema CColModel_CalculateTrianglePlanes
  ΔCColModel
where
  -- Deterministic transition preserving module invariants
  true
end

schema CColModel_RemoveTrianglePlanes
  ΔCColModel
where
  -- State update: trianglePlanes' = ∅
  true
end

schema CColModel_SetLinkPtr
  ΔCColModel
  lptr? : Ref[CLink_CColModel]
where
  -- Deterministic transition preserving module invariants
  true
end

schema CColModel_GetLinkPtr
  ΔCColModel
where
  -- Return postcondition: result! = *(CLink<CColModel*>**)ALIGNPTR(&trianglePlanes[numTriangles])
  true
end

schema CColModel_GetTrianglePoint
  ΞCColModel
  v? : CVector
  i? : ℤ
where
  -- State update: v' = vertices[i].Get()
  true
end

schema CColModel_operator
  ΔCColModel
  other? : CColModel
where
  -- State update: boundingSphere' = other.boundingSphere
  -- State update: boundingBox' = other.boundingBox
  -- State update: numTriBBoxes' = other.numTriBBoxes
  -- State update: triBBoxes' = new CColTriBBox[numTriBBoxes]
  -- State update: numTriBBoxes' = 0
  -- State update: triBBoxes' = ∅
  -- Return postcondition: result! = *this
  true
end

schema CColModel_Write
  ΔCColModel
  writer? : base__cRelocatableChunkWriter
  allocSpace? : 𝔹
where
  -- State update: numVerts' = -1
  -- State update: numVerts' = triangles[i].a
  -- State update: numVerts' = triangles[i].b
  -- State update: numVerts' = triangles[i].c
  -- State update: triBBoxes' = ∅
  -- Return postcondition: result! = 1
  -- Invokes: writer.AllocateRaw, writer.AddPatch
  true
end

schema CColModel_operator_2
  ΔCColModel
  other? : CColModel
where
  -- State update: boundingSphere' = other.boundingSphere
  -- State update: boundingBox' = other.boundingBox
  -- State update: numSpheres' = other.numSpheres
  -- State update: spheres' = (CColSphere*)RwMalloc(numSpheres*sizeof(CColSphere))
  -- State update: numSpheres' = 0
  -- State update: spheres' = ∅
  -- Return postcondition: result! = *this
  true
end
