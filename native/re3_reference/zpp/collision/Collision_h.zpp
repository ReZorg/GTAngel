schema CStoredCollPoly
  instance_addr : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema CCollision
  ms_collisionInMemory : eLevelName
  ms_colModelCache : Ref[CLinkList_CColModel]
where
  #ms_colModelCache ≤ 1
end

