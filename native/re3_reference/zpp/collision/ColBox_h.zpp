--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: ColBox (collision)
-- Source File(s): collision/ColBox.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include SurfaceTable.zpp  (from "SurfaceTable.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CBox
  min : CVector
  max : CVector
where
  instance_addr ∈ ADDRESS
end

schema CBox_GetSize
  ΔCBox
  result! : CVector
where
  -- Declared member operation CBox::GetSize(void)
  true
end

schema CBox_Set_2
  ΔCBox
  min? : CVector
  max? : CVector
  result! : void
where
  -- Declared member operation CBox::Set(const CVector &min, const CVector &max)
  true
end

schema CColBox
  min : CVector
  max : CVector
  surface : ℕ
  piece : ℕ
where
  surface ≥ 0
  piece ≥ 0
end

schema CColBox_Set
  ΔCColBox
  min? : CVector
  max? : CVector
  surf? : ℕ
  piece? : ℕ
where
  -- Declared member operation CColBox::Set(const CVector &min, const CVector &max, uint8 surf = SURFACE_DEFAULT, uint8 piece = 0)
  true
end

schema CColBox_GetSize_2
  ΔCColBox
  result! : CVector
where
  -- Declared member operation CColBox::GetSize(void)
  true
end

schema CColBox_operator_3
  ΔCColBox
  other? : CColBox
  result! : CColBox
where
  -- Declared member operation CColBox::operator=(const CColBox &other)
  true
end

schema CColBox_Set_4
  ΔCColBox
  min? : CVector
  max? : CVector
  surf? : ℕ
  piece? : ℕ
where
  -- Declared member operation CColBox::Set(const CVector &min, const CVector &max, uint8 surf, uint8 piece)
  true
end

schema CColTriBBox
  CBox  -- inherits base schema
  first : ℤ
  last : ℤ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ColBox_GetSize
  ΔColBoxModuleState
  result! : CVector
where
  -- Return postcondition: result! = max - min
  true
end

schema ColBox_Set
  ΔColBoxModuleState
  min? : CVector
  max? : CVector
where
  -- State update: min' = min
  -- State update: max' = max
  true
end

schema ColBox_GetSize_2
  ΔColBoxModuleState
  result! : CVector
where
  -- Return postcondition: result! = max - min
  true
end
