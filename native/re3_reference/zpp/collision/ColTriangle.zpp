--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CColTriangle_Set
  ΔCColTriangle
  arg_1? : Ref[CompressedVector]
  a? : ℤ
  b? : ℤ
  c? : ℤ
  surf? : ℕ
  piece? : ℕ
where
  -- State update: a' = a
  -- State update: b' = b
  -- State update: c' = c
  -- State update: surface' = surf
  true
end

schema CColTrianglePlane_Set
  ΔCColTrianglePlane
  va? : CVector
  vb? : CVector
  vc? : CVector
where
  -- State update: normal' = CrossProduct(vc-va, vb-va)
  -- State update: dist' = DotProduct(normal, va)
  -- State update: dir' = normal.x < 0.0f ? DIR_X_NEG : DIR_X_POS
  -- State update: dir' = normal.y < 0.0f ? DIR_Y_NEG : DIR_Y_POS
  -- State update: dir' = normal.z < 0.0f ? DIR_Z_NEG : DIR_Z_POS
  -- Invokes: normal.Normalise
  true
end

schema ColTriangle_Set
  ΔColTriangleModuleState
  a? : ℤ
  b? : ℤ
  c? : ℤ
  surf? : ℕ
where
  -- State update: a' = a
  -- State update: b' = b
  -- State update: c' = c
  -- State update: surface' = surf
  true
end

schema ColTriangle_Set_2
  ΔColTriangleModuleState
  v? : Ref[CompressedVector]
  tri? : CColTriangle
where
  -- Deterministic transition preserving module invariants
  true
end

schema ColTriangle_GetNormal
  ΞColTriangleModuleState
  n? : CVector
where
  -- State update: n.x' = normal.x/4096.0f
  -- State update: n.y' = normal.y/4096.0f
  -- State update: n.z' = normal.z/4096.0f
  true
end

schema ColTriangle_Unpack
  ΞColTriangleModuleState
  qword? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema ColTriangle_Unpack_2
