schema ModelIndices_IsBodyPart
  ΔModelIndicesModuleState
  id? : ℤ
where
  -- Return postcondition: result! = id == MI_BODYPARTA || id == MI_BODYPARTB
  true
end

schema ModelIndices_IsPedModel
  ΔModelIndicesModuleState
  id? : ℤ
where
  -- Return postcondition: result! = id >= MI_PLAYER && id <= MI_LAST_PED
  true
end

