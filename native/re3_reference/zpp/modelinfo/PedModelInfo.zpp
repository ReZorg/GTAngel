--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NUMPEDINFONODES : ℕ  -- #define NUMPEDINFONODES 8

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
PedNode ::= PED_TORSO | PED_MID | PED_HEAD | PED_UPPERARML | PED_UPPERARMR | PED_HANDL | PED_HANDR | PED_UPPERLEGL | PED_UPPERLEGR | PED_FOOTL | PED_FOOTR | PED_LOWERLEGR | PED_FOREARML | PED_FOREARMR | PED_CLAVICLEL | PED_CLAVICLER | PED_NECK

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema LimbCBarg
  mi : Ref[CPedModelInfo]
  clump : Ref[RpClump]
  frameIDs : seq ℤ  -- bounded array [3]
where
  #mi ≤ 1
  #clump ≤ 1
  #frameIDs = 3
end

schema ColNodeInfo
  name : seq CHAR
  pedNode : ℤ
  pieceType : ℤ
  z : ℝ
  radius : ℝ
where
  instance_addr ∈ ADDRESS
end

schema PedChunk
  colmodel : Ref[CColModel]
  clump : Ref[RpClump]
where
  #colmodel ≤ 1
  #clump ≤ 1
end

schema CPedModelInfo
  CClumpModelInfo  -- inherits base schema
  m_animGroup : ℕ
  m_pedType : ePedType
  m_pedStatType : ePedStats
  m_carsCanDrive : ℕ
  m_hitColModel : Ref[CColModel]
  m_lhand : Ref[RpAtomic]
  m_rhand : Ref[RpAtomic]
  msClassInfo : base__cRelocatableChunkClassInfo
  msClassInstance : CPedModelInfo
where
  m_animGroup ≥ 0
  m_carsCanDrive ≥ 0
  #m_hitColModel ≤ 1
  #m_lhand ≤ 1
  #m_rhand ≤ 1
end

schema CPedModelInfo_CPedModelInfo
  ΔCPedModelInfo
where
  -- Declared member operation CPedModelInfo::CPedModelInfo(void)
  true
end

