--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_MODEL_NAME : seq CHAR  -- #define MAX_MODEL_NAME (24)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
ModelInfoType ::= MITYPE_NA | MITYPE_SIMPLE | MITYPE_MLO | MITYPE_TIME | MITYPE_WEAPON | MITYPE_CLUMP | MITYPE_VEHICLE | MITYPE_PED | MITYPE_XTRACOMPS | MITYPE_HAND

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CBaseModelInfo
  m_unk : seq ℕ  -- bounded array [2]
  m_nameKey : ℕ
  m_chunk : ADDRESS
  m_type : ℕ
  m_num2dEffects : ℕ
  m_bOwnsColModel : 𝔹
  m_colModel : Ref[CColModel]
  m_2dEffectsID : ℤ
  m_objectId : ℤ
  m_refCount : ℕ
  m_txdSlot : ℤ
  m_twodEffects : Ref[C2dEffect]
  m_bIsTree : 𝔹
  m_bCanBeIgnored : 𝔹
where
  #m_unk = 2
  m_nameKey ≥ 0
  m_type ≥ 0
  m_num2dEffects ≥ 0
  #m_colModel ≤ 1
  m_refCount ≥ 0
  #m_twodEffects ≤ 1
end

schema CBaseModelInfo_CBaseModelInfo
  ΔCBaseModelInfo
  type? : ModelInfoType
where
  -- Declared member operation CBaseModelInfo::CBaseModelInfo(ModelInfoType type)
  true
end

