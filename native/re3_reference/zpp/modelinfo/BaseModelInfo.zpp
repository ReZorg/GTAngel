schema CBaseModelInfo_Add2dEffect
  ΔCBaseModelInfo
  fx? : Ref[C2dEffect]
where
  -- State update: m_2dEffectsID' = CModelInfo::Get2dEffectStore().GetIndex(fx)
  -- State update: m_num2dEffects' = 1
  -- Invokes: CModelInfo::Get2dEffectStore
  true
end

schema CBaseModelInfo_Get2dEffect
  ΔCBaseModelInfo
  n? : ℤ
where
  -- Return postcondition: result! = CModelInfo::Get2dEffectStore().GetItem(m_2dEffectsID+n)
  -- Return postcondition: result! = nil
  -- Invokes: CModelInfo::Get2dEffectStore
  true
end

schema CBaseModelInfo_SetModelName
  ΔCBaseModelInfo
  name? : seq CHAR
where
  -- State update: m_nameKey' = CKeyGen::GetUppercaseKey(name)
  -- Invokes: CKeyGen::GetUppercaseKey
  true
end

schema CBaseModelInfo_DeleteChunk
  ΔCBaseModelInfo
