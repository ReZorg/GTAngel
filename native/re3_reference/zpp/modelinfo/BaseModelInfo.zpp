  name? : seq CHAR
where
  -- State update: slot' = CTxdStore::FindTxdSlot(name)
  -- State update: slot' = CTxdStore::AddTxdSlot(name)
  -- State update: m_txdSlot' = slot
  -- Invokes: CTxdStore::FindTxdSlot, CTxdStore::AddTxdSlot
  true
end

