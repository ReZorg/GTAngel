end

schema CSimpleModelInfo_FindRelatedModel
  ΔCSimpleModelInfo
where
  -- State update: thisIndex' = 0
  -- State update: thisIndex' = -1
  -- State update: otherIndex' = 0
  -- State update: mi' = CModelInfo::GetModelInfo(m_sTempIdeData[otherIndex].id)
  -- Invokes: CModelInfo::GetModelInfo, CGeneral::faststrcmp, mi->IsSimple, this->SetRelatedModel
  true
end

schema CSimpleModelInfo_SetupBigBuilding
  ΔCSimpleModelInfo
where
  -- State update: m_isBigBuilding' = 1
  -- State update: related' = GetRelatedModel()
  -- State update: m_drawLast' = false
  -- Invokes: related->GetLargestLodDistance
  true
end

schema CSimpleModelInfo_LoadModel
  ΔCSimpleModelInfo
  atomics? : ADDRESS
  chunk? : ADDRESS
where
  -- State update: m_chunk' = (void*)chunk
  -- State update: m_atomics' = (RpAtomic**)atomics
  -- Invokes: CStreaming::RegisterPointer, CStreaming::RegisterAtomic
  true
end

schema CSimpleModelInfo_Write
  ΔCSimpleModelInfo
  writer? : base__cRelocatableChunkWriter
where
  -- State update: m_atomics' = ∅
  -- Invokes: CBaseModelInfo::Write, writer.AddPatch
  true
end

schema CSimpleModelInfo_WriteModel
  ΔCSimpleModelInfo
  writer? : base__cRelocatableChunkWriter
where
  -- State update: numAtomics' = 0
  -- State update: firstDam' = m_firstDamaged - m_numAtomics + numAtomics
  -- State update: m_firstDamaged' = firstDam
  -- State update: m_firstDamaged' = 0
  -- State update: m_numAtomics' = numAtomics
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = m_atomics
  -- Invokes: writer.AllocateRaw, writer.AddPatch
  true
end

schema CSimpleModelInfo_RcWriteThis
  ΔCSimpleModelInfo
  writer? : base__cRelocatableChunkWriter
where
  -- Invokes: writer.AllocateRaw, writer.Class
  true
end

schema CSimpleModelInfo_RcWriteEmpty
  ΔCSimpleModelInfo
  writer? : base__cRelocatableChunkWriter
where
  -- Invokes: writer.AllocateRaw, writer.Class
  true
end

schema CSimpleModelInfo_FindRelatedModel_2
  ΔCSimpleModelInfo
  minID? : ℤ
  maxID? : ℤ
where
  -- State update: mi' = CModelInfo::GetModelInfo(i)
  -- Invokes: CModelInfo::GetModelInfo, CGeneral::faststrcmp, mi->GetModelName, mi->IsSimple, this->SetRelatedModel
  true
end

schema CSimpleModelInfo_SetupBigBuilding_2
  ΔCSimpleModelInfo
  minID? : ℤ
  maxID? : ℤ
where
  -- State update: m_isBigBuilding' = 1
  -- State update: related' = GetRelatedModel()
  -- State update: m_drawLast' = false
  -- Invokes: related->GetLargestLodDistance
  true
end

