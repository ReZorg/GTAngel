-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CSimpleModelInfo_DeleteRwObject
  ΔCSimpleModelInfo
where
  -- State update: f' = RpAtomicGetFrame(m_atomics[i])
  -- State update: m_atomics' = ∅
  -- Invokes: CAnimManager::RemoveAnimBlockRef, CStreaming::UnregisterPointer, CStreaming::UnregisterAtomic
  true
end

schema CSimpleModelInfo_CreateInstance
  ΔCSimpleModelInfo
where
  -- State update: atomic' = RpAtomicClone(m_atomics[0])
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = (RwObject*)atomic
  -- Invokes: CStreaming::RegisterInstance
  true
end

schema CSimpleModelInfo_CreateInstance_2
  ΔCSimpleModelInfo
  matrix? : Ref[RwMatrix]
where
  -- State update: atomic' = RpAtomicClone(m_atomics[0])
  -- State update: frame' = RwFrameCreate()
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = (RwObject*)atomic
  -- Invokes: CStreaming::RegisterInstance
  true
end

schema CSimpleModelInfo_Init
  ΔCSimpleModelInfo
where
  -- State update: m_numAtomics' = 0
  -- State update: m_firstDamaged' = 0
  -- State update: m_wetRoadReflection' = 0
  -- State update: m_isDamaged' = 0
  -- State update: m_isBigBuilding' = 0
  -- State update: m_noFade' = 0
  true
end

schema CSimpleModelInfo_SetAtomic
  ΔCSimpleModelInfo
  n? : ℤ
  atomic? : Ref[RpAtomic]
where
  -- State update: m_atomics' = new RpAtomic*[3]
  -- State update: geo' = RpAtomicGetGeometry(atomic)
  -- Invokes: CAnimManager::AddAnimBlockRef, CustomPipes::AttachGlossPipe, CustomPipes::AttachWorldPipe
  true
end

schema CSimpleModelInfo_SetLodDistances
  ΔCSimpleModelInfo
  dist? : ℙ ℝ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CSimpleModelInfo_IncreaseAlpha
  ΔCSimpleModelInfo
where
  -- State update: m_alpha' = 0xFF
  true
end

schema CSimpleModelInfo_GetLodDistance
  ΔCSimpleModelInfo
  i? : ℤ
where
  -- Return postcondition: result! = m_lodDistances[i] * TheCamera.LODDistMultiplier
  true
end

schema CSimpleModelInfo_GetNearDistance
  ΔCSimpleModelInfo
where
  -- Return postcondition: result! = m_lodDistances[2] * TheCamera.LODDistMultiplier
  true
end

schema CSimpleModelInfo_GetLargestLodDistance
  ΔCSimpleModelInfo
where
  -- State update: d' = m_lodDistances[m_numAtomics-1]
  -- State update: d' = m_lodDistances[m_firstDamaged-1]
  -- Return postcondition: result! = d * TheCamera.LODDistMultiplier
  true
end

schema CSimpleModelInfo_GetLodAtomic
  ΔCSimpleModelInfo
  n? : ℤ
where
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = m_atomics[n]
  true
end

