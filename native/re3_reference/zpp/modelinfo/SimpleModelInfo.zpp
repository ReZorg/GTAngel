--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NEAR_DRAW_DIST : ℝ  -- #define NEAR_DRAW_DIST 100.0f

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema TempIdeData
  name : seq CHAR
  id : ℤ
where
  #name = 24
end

schema CSimpleModelInfo
  CBaseModelInfo  -- inherits base schema
  m_atomics : Ref[RpAtomic]
  m_lodDistances : seq ℝ  -- bounded array [3]
  m_numAtomics : ℕ
  m_alpha : ℕ
  m_firstDamaged : 𝔹
  m_wetRoadReflection : 𝔹
  m_isDamaged : 𝔹
  m_isBigBuilding : 𝔹
  m_noFade : 𝔹
  m_drawLast : 𝔹
  m_additive : 𝔹
  m_isSubway : 𝔹
  m_ignoreLight : 𝔹
  m_noZwrite : 𝔹
  m_noShadows : 𝔹
  m_ignoreDrawDist : 𝔹
  m_isCodeGlass : 𝔹
  m_isArtistGlass : 𝔹
  m_relatedModel : Ref[CSimpleModelInfo]
  msClassInfo : base__cRelocatableChunkClassInfo
  msClassInstance : CSimpleModelInfo
  m_normalCull : 𝔹
where
  #m_atomics ≤ 1
  #m_lodDistances = 3
  m_numAtomics ≥ 0
  m_alpha ≥ 0
  #m_firstDamaged = 2
  #m_wetRoadReflection = 1
  #m_isDamaged = 1
  #m_isBigBuilding = 1
  #m_noFade = 1
  #m_drawLast = 1
  #m_additive = 1
  #m_isSubway = 1
  #m_ignoreLight = 1
  #m_noZwrite = 1
  #m_noShadows = 1
  #m_ignoreDrawDist = 1
end

schema CSimpleModelInfo_CSimpleModelInfo
  ΔCSimpleModelInfo
where
  -- Declared member operation CSimpleModelInfo::CSimpleModelInfo(void)
  true
end

