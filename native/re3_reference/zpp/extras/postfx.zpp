--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPostFX_InitOnce
  ΔCPostFX
where
  -- State update: u_blurcolor' = rw::gl3::registerUniform("u_blurcolor")
  -- State update: u_contrastAdd' = rw::gl3::registerUniform("u_contrastAdd")
  -- State update: u_contrastMult' = rw::gl3::registerUniform("u_contrastMult")
  -- Invokes: gl3::registerUniform
  true
end

schema CPostFX_Open
  ΔCPostFX
  cam? : Ref[RwCamera]
where
  -- State update: depth' = RwRasterGetDepth(RwCameraGetRaster(cam))
  -- State update: bJustInitialised' = true
  -- State update: zero' = HALFPX
  -- State update: xmax' = width + HALFPX
  -- State update: ymax' = height + HALFPX
  -- State update: zero' = -HALFPX
  -- Invokes: d3d::createPixelShader, Shader::create
  true
end

schema CPostFX_Close
  ΔCPostFX
where
  -- State update: pFrontBuffer' = ∅
  -- State update: pBackBuffer' = ∅
  -- State update: colourfilterLCS_PS' = ∅
  -- State update: contrast_PS' = ∅
  -- State update: colourFilterLCS' = ∅
  -- State update: contrast' = ∅
  -- Invokes: d3d::destroyPixelShader, colourFilterLCS->destroy, contrast->destroy
  true
end

schema CPostFX_RenderOverlayBlur
  ΔCPostFX
  cam? : Ref[RwCamera]
  r? : ℤ
  g? : ℤ
  b? : ℤ
  a? : ℤ
where
  -- State update: intensity' = 255*blurIntensity
  true
end

schema CPostFX_RenderOverlaySniper
  ΔCPostFX
  cam? : Ref[RwCamera]
  r? : ℤ
  g? : ℤ
  b? : ℤ
  a? : ℤ
where
  -- Deterministic transition preserving module invariants
