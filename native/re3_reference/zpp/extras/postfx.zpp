--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHD3D : seq CHAR  -- #define WITHD3D #include "common.h"

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
postfx_Enum_1 ::= POSTFX_OFF | POSTFX_PSP | POSTFX_PS2 | POSTFX_SIMPLE | POSTFX_MOBILE
  -- val(POSTFX_SIMPLE) = -1
  -- val(POSTFX_MOBILE) = -2

postfx_Enum_2 ::= NUMAVERAGE
  -- val(NUMAVERAGE) = 20

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPostFX
  pFrontBuffer : Ref[RwRaster]
  pBackBuffer : Ref[RwRaster]
  bJustInitialised : 𝔹
  EffectSwitch : ℤ
  BlurOn : 𝔹
  MotionBlurOn : 𝔹
  Intensity : ℝ
  Next : ℤ
  NumValues : ℤ
where
  #pFrontBuffer ≤ 1
  #pBackBuffer ≤ 1
end

schema CPostFX_InitOnce
  ΔCPostFX
where
  -- Declared member operation CPostFX::InitOnce(void)
  true
end

schema CPostFX_Open_2
  ΔCPostFX
  cam? : Ref[RwCamera]
where
  -- Declared member operation CPostFX::Open(RwCamera *cam)
  true
end

