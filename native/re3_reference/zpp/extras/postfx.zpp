schema CPostFX_RenderOverlayShader
  ΔCPostFX
  cam? : Ref[RwCamera]
  r? : ℤ
  g? : ℤ
  b? : ℤ
  a? : ℤ
where
  -- State update: im2dOverridePS' = contrast_PS
  -- State update: im2dOverrideShader' = contrast
  -- State update: f' = Intensity
  -- State update: im2dOverridePS' = colourfilterLCS_PS
  -- State update: im2dOverrideShader' = colourFilterLCS
  -- State update: im2dOverridePS' = ∅
  -- Invokes: d3ddevice->SetPixelShaderConstantF, contrast->use, colourFilterLCS->use
  true
end

