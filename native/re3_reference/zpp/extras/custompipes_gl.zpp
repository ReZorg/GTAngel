schema custompipes_gl_AtomicFirstPass
  Δcustompipes_glModuleState
  atomic? : Ref[RpAtomic]
  pass? : ℤ
where
  -- State update: building' = &blendInsts[pass][numBlendInsts[pass]]
  -- State update: building.instHeader' = (gl3::InstanceDataHeader*)atomic.geometry.instData
  -- State update: building.fadeAlpha' = 255
  -- State update: building.lighting' = !!(atomic.geometry.flags & rw::Geometry::LIGHT)
  -- State update: setupDone' = false
  -- State update: defer' = false
  -- Invokes: atomic->getPipeline, atomic->getFrame, leedsWorldShader_mobile->use, leedsWorldShader->use, CustomPipes::uploadWorldLights
  true
end

