  -- State update: building.instHeader' = (gl3::InstanceDataHeader*)atomic.geometry.instData
  -- State update: building.fadeAlpha' = fadeAlpha
  -- State update: building.lighting' = !!(atomic.geometry.flags & rw::Geometry::LIGHT)
  -- State update: building.matrix' = *atomic.getFrame().getLTM()
  -- Invokes: atomic->getPipeline, atomic->getFrame
  true
end

schema custompipes_gl_RenderBlendPass
  Δcustompipes_glModuleState
  pass? : ℤ
where
  -- State update: building' = &blendInsts[pass][i]
  -- State update: inst' = building.instHeader.inst
  -- State update: m' = inst.material
  -- State update: color' = m.color
  -- State update: color.alpha' = (color.alpha * building.fadeAlpha)/255
  -- State update: cs' = 1.0f
  -- Invokes: leedsWorldShader_mobile->use, leedsWorldShader->use, CustomPipes::uploadWorldLights
  true
end

