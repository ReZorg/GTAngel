schema custompipes_gl_uploadEnvMatrix
  Δcustompipes_glModuleState
  frame? : Ref[rw__Frame]
where
  -- State update: frame' = engine.currentCamera.getFrame()
  -- State update: tmp' = *frame.getLTM()
  -- State update: tmp.at.z' = 0.0f
  -- State update: tmp.at' = normalize(tmp.at)
  -- State update: tmp.right.x' = -tmp.at.y
  -- State update: tmp.right.y' = tmp.at.x
  -- Invokes: currentCamera->getFrame, frame->getLTM, up.set, pos.set, Matrix::invert
  true
end

