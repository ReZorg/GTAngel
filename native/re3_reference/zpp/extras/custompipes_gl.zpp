schema BuildingInst
  matrix : rw__Matrix
  instHeader : Ref[rw__gl3__InstanceDataHeader]
  fadeAlpha : ℕ
  lighting : 𝔹
where
  #instHeader ≤ 1
  fadeAlpha ≥ 0
end

