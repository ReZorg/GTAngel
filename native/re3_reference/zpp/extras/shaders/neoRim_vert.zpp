--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema neoRim_main
  ΔneoRimModuleState
where
  -- State update: Vertex' = u_world * vec4(in_pos, 1.0)
  -- State update: gl_Position' = u_proj * u_view * Vertex
  -- State update: Normal' = mat3(u_world) * in_normal
  -- State update: v_tex0' = in_tex0
  -- State update: v_color' = in_color
