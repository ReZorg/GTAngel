schema neoVehicle_main
  ΔneoVehicleModuleState
where
  -- State update: pass1' = v_color*texture(tex0, vec2(v_tex0.x, 1.0-v_tex0.y))
  -- State update: envmap' = texture(tex1, vec2(v_tex1.x, 1.0-v_tex1.y)).rgb
  -- State update: pass1.rgb' = mix(pass1.rgb, envmap, v_reflcolor.a)
  -- State update: pass1.rgb' = mix(u_fogColor.rgb, pass1.rgb, v_fog)
  -- State update: pass2' = v_reflcolor.rgb * v_fog
  -- State update: color.rgb' = pass1.rgb*pass1.a + pass2
  true
end

--------------------------------------------------------------------------------
