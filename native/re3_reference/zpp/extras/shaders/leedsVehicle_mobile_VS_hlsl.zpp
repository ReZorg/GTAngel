--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NdotV : seq CHAR  -- #define NdotV (output.ReflData.x)
lightingCont : seq CHAR  -- #define lightingCont (output.ReflData.y)

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema VS_in
  POSITION : ℝ
  NORMAL : ℝ
  TEXCOORD0 : ℝ
  COLOR0 : ℝ
where
  instance_addr ∈ ADDRESS
end

schema VS_out
  POSITION : ℝ
  TEXCOORD0 : ℝ
  TEXCOORD1 : ℝ
  TEXCOORD2 : ℝ
  COLOR0 : ℝ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema leedsVehicle_mobile_VS_main
  ΔleedsVehicle_mobile_VSModuleState
  input? : in_VS_in
  result! : VS_out
where
  -- State update: output.Position' = mul(combinedMat, input.Position)
  -- State update: V' = mul(worldMat, input.Position).xyz
  -- State update: N' = mul(normalMat, input.Normal)
  -- State update: output.TexCoord0.xy' = input.TexCoord
  -- State update: ViewNormal' = mul(viewMat, float4(N, 0.0))
  -- State update: output.TexCoord1' = (ViewNormal.xy + float2(1.0, 1.0))*0.5
  -- Return postcondition: result! = output
  true
end
