--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: default_UV2_VS (extras)
-- Source File(s): extras/shaders/default_UV2_VS.hlsl
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include standardConstants.zpp  (from "standardConstants.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema VS_in
  POSITION : ℝ
  NORMAL : ℝ
  TEXCOORD0 : ℝ
  TEXCOORD1 : ℝ
  COLOR0 : ℝ
where
  instance_addr ∈ ADDRESS
end

schema VS_out
  POSITION : ℝ
  TEXCOORD0 : ℝ
  TEXCOORD1 : ℝ
  COLOR0 : ℝ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema default_UV2_VS_main
  Δdefault_UV2_VSModuleState
  input? : in_VS_in
  result! : VS_out
where
  -- State update: output.Position' = mul(combinedMat, input.Position)
  -- State update: Vertex' = mul(worldMat, input.Position).xyz
  -- State update: Normal' = mul(normalMat, input.Normal)
  -- State update: output.TexCoord0.xy' = input.TexCoord
  -- State update: output.TexCoord1.xy' = input.TexCoord1
  -- State update: output.Color' = input.Prelight
  -- Return postcondition: result! = output
  true
end
