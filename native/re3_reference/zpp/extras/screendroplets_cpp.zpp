--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHD3D : seq CHAR  -- #define WITHD3D #include "common.h"
MAXSIZE : ℕ  -- #define MAXSIZE 15
MINSIZE : ℕ  -- #define MINSIZE 4
NUMINDICES : ℕ  -- #define NUMINDICES 1024
NUMVERTICES : ℕ  -- #define NUMVERTICES 1024

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema Im2DVertexUV2
  rw__RWDEVICE__Im2DVertex  -- inherits base schema
  v2 : ℝ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ScreenDroplets_Initialise
  ΔScreenDroplets
where
  -- State update: ms_splashDuration' = -1
  -- State update: ms_splashObject' = ∅
  true
end

schema screendroplets_CreateDropMask
  ΔscreendropletsModuleState
  size? : ℤ
where
  -- State update: img' = RwImageCreate(size, size, 32)
  -- State update: pixels' = RwImageGetPixels(img)
  -- State update: stride' = RwImageGetStride(img)
  -- State update: y' = 0
  -- State update: yf' = ((y + 0.5f)/size - 0.5f)*2.0f
  -- State update: x' = 0
  -- Return postcondition: result! = RwTextureCreate(ras)
  true
end

schema ScreenDroplets_InitDraw
  ΔScreenDroplets
where
  -- State update: ms_maskTex' = CreateDropMask(64)
  -- State update: ms_screenTex' = RwTextureCreate(∅)
  -- State update: screenDroplet_PS' = rw::d3d::createPixelShader(screenDroplet_PS_cso)
  -- State update: screenDroplet' = Shader::create(vs, fs)
  -- State update: ms_initialised' = 1
  -- Invokes: d3d::createPixelShader, Shader::create
  true
end

schema ScreenDroplets_Shutdown
  ΔScreenDroplets
where
  -- State update: ms_maskTex' = ∅
  -- State update: ms_screenTex' = ∅
  -- State update: screenDroplet_PS' = ∅
  -- State update: screenDroplet' = ∅
  -- Invokes: d3d::destroyPixelShader, screenDroplet->destroy
  true
end

schema ScreenDroplets_Process
  ΔScreenDroplets
where
  -- Deterministic transition preserving module invariants
  true
end

schema screendroplets_FlushBuffer
  ΔscreendropletsModuleState
where
  -- State update: TempBufferVerticesStored' = 0
  -- State update: TempBufferIndicesStored' = 0
  true
end

schema screendroplets_StartStoring
  ΔscreendropletsModuleState
  numIndices? : ℤ
  numVertices? : ℤ
  indexStart? : Ref[RwImVertexIndex]
  vertexStart? : Ref[Im2DVertexUV2]
where
  -- State update: indexStart' = &TempBufferRenderIndexList[TempBufferIndicesStored]
  -- State update: vertexStart' = &VertexBuffer[TempBufferVerticesStored]
  -- State update: vertOffset' = TempBufferVerticesStored
  -- Return postcondition: result! = vertOffset
  true
end

schema ScreenDroplets_Render
  ΔScreenDroplets
where
  -- State update: im2dOverridePS' = screenDroplet_PS
  -- State update: im2dOverrideShader' = screenDroplet
  -- State update: drop' = &ms_drops[0]
  -- State update: im2dOverridePS' = ∅
  -- State update: im2dOverrideShader' = ∅
  -- Invokes: d3d::setTexture, gl3::setTexture, RenderBuffer::ClearRenderBuffer
  true
end

schema ScreenDroplets_AddToRenderList
  ΔScreenDroplets
  drop? : Ref[ScreenDroplets__ScreenDrop]
where
  -- State update: first' = StartStoring(6, 4, &indices, &verts)
  -- State update: scale' = 0.5f*SCREEN_SCALE_X(drop.size)
  -- State update: screenz' = RwIm2DGetNearScreenZ()
  -- State update: z' = RwCameraGetNearClipPlane(Scene.camera)
  -- State update: recipz' = 1.0f/z
  -- State update: magSize' = SCREEN_SCALE_Y(drop.magnification*(300.0f-40.0f) + 40.0f)
  true
end

schema ScreenDroplets_Clear
  ΔScreenDroplets
where
  -- State update: drop' = &ms_drops[0]
  -- State update: drop.active' = false
  -- State update: ms_numDrops' = 0
  true
end

schema ScreenDroplets_NewDrop
  ΔScreenDroplets
  x? : ℝ
  y? : ℝ
  size? : ℝ
  lifetime? : ℝ
  fades? : 𝔹
  r? : ℤ
  g? : ℤ
  b? : ℤ
where
  -- State update: drop' = ms_drops
  -- State update: drop.x' = x
  -- State update: drop.y' = y
  -- State update: drop.size' = size
  -- State update: drop.magnification' = (MAXSIZE - size + 1.0f) / (MAXSIZE - MINSIZE + 1.0f)
  -- State update: drop.fades' = fades
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = drop
  true
end

schema ScreenDroplets_SetMoving
  ΔScreenDroplets
  drop? : Ref[ScreenDroplets__ScreenDrop]
where
  -- State update: moving' = ms_dropsMoving
  -- State update: moving.drop' = drop
  -- State update: moving.dist' = 0.0f
  true
end

schema ScreenDroplets_FillScreen
  ΔScreenDroplets
  n? : ℤ
where
  -- State update: ms_numDrops' = 0
  -- State update: drop' = &ms_drops[0]
  -- State update: drop.active' = false
  -- State update: x' = CGeneral::GetRandomNumber() % (int)SCREEN_WIDTH
  -- State update: y' = CGeneral::GetRandomNumber() % (int)SCREEN_HEIGHT
  -- State update: size' = CGeneral::GetRandomNumberInRange(MINSIZE, MAXSIZE)
  -- Invokes: CGeneral::GetRandomNumber, CGeneral::GetRandomNumberInRange
  true
end

schema ScreenDroplets_FillScreenMoving
  ΔScreenDroplets
  amount? : ℝ
  isBlood? : 𝔹
where
  -- State update: x' = CGeneral::GetRandomNumber() % (int)SCREEN_WIDTH
  -- State update: y' = CGeneral::GetRandomNumber() % (int)SCREEN_HEIGHT
  -- State update: size' = CGeneral::GetRandomNumberInRange(MINSIZE, MAXSIZE)
  -- State update: drop' = ∅
  -- State update: drop' = NewDrop(x, y, size, 2000.0f, true, 255, 0, 0)
  -- State update: drop' = NewDrop(x, y, size, 2000.0f, true)
  -- Invokes: CGeneral::GetRandomNumber, CGeneral::GetRandomNumberInRange
  true
end

schema ScreenDroplets_RegisterSplash
  ΔScreenDroplets
  pobj? : Ref[CParticleObject]
where
  -- State update: dist' = pobj.GetPosition() - ms_prevCamPos
  -- State update: ms_splashDuration' = 14
  -- State update: ms_splashObject' = pobj
  -- Invokes: pobj->GetPosition, dist.MagnitudeSqr
  true
end

schema ScreenDroplets_ProcessCameraMovement
  ΔScreenDroplets
where
  -- State update: camMat' = RwFrameGetMatrix(RwCameraGetFrame(Scene.camera))
  -- State update: camPos' = camMat.pos
  -- State update: camUp' = camMat.at
  -- State update: ms_camMoveDelta' = camPos - ms_prevCamPos
  -- State update: ms_camMoveDist' = ms_camMoveDelta.Magnitude()
  -- State update: ms_prevCamUp' = camUp
  -- Invokes: ms_camMoveDelta.Magnitude, ms_screenMoveDelta.Magnitude2D, CPad::GetPad
  true
end

schema ScreenDroplets_SprayDrops
  ΔScreenDroplets
where
  -- State update: noRain' = CCullZones::PlayerNoRain() || CCullZones::CamNoRain()
  -- State update: angle' = 180.0f - ms_camUpAngle
  -- State update: angle' = Max(angle, 40.0f)
  -- State update: hyd' = CAudioHydrant::Get(i)
  -- State update: dist' = hyd.pParticleObject.GetPosition() - ms_prevCamPos
  -- State update: numDropMult' = 1.0f
  -- Invokes: CCullZones::PlayerNoRain, CCullZones::CamNoRain, CAudioHydrant::Get, pParticleObject->GetPosition, dist.MagnitudeSqr
  true
end

schema ScreenDroplets_NewTrace
  ΔScreenDroplets
  moving? : Ref[ScreenDroplets__ScreenDropMoving]
where
  -- State update: moving.dist' = 0.0f
  true
end

schema ScreenDroplets_MoveDrop
  ΔScreenDroplets
  moving? : Ref[ScreenDroplets__ScreenDropMoving]
where
  -- State update: drop' = moving.drop
  -- State update: moving.drop' = ∅
  -- State update: d' = ms_screenMoveDelta.z*0.2f
  -- State update: dx' = drop.x - SCREEN_WIDTH*0.5f + ms_screenMoveDelta.x
  -- State update: dy' = drop.y - SCREEN_HEIGHT*1.2f - ms_screenMoveDelta.y
  -- State update: dy' = drop.y - SCREEN_HEIGHT*0.5f - ms_screenMoveDelta.y
  true
end

schema ScreenDroplets_ProcessMoving
  ΔScreenDroplets
where
  -- State update: moving' = ms_dropsMoving
  true
end

schema ScreenDroplets_Fade
  ΔScreenDroplets
where
  -- State update: drop' = &ms_drops[0]
  -- Invokes: drop->Fade
  true
end

