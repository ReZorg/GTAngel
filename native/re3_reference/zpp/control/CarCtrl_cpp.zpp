schema CCarCtrl_FindPathDirection
  ΔCCarCtrl
  prevNode? : ℤ
  curNode? : ℤ
  nextNode? : ℤ
  result! : ℕ
where
  -- State update: distPrevToCur' = prevToCur.Magnitude()
  -- State update: sin_a' = prevToCur.x / distPrevToCur
  -- State update: cos_a' = prevToCur.y / distPrevToCur
  -- State update: distCurToNext' = curToNext.Magnitude()
  -- State update: sin_b' = curToNext.y / distCurToNext
  -- State update: cos_b' = curToNext.x / distCurToNext
  -- Return postcondition: result! = PATH_DIRECTION_NONE
  -- Return postcondition: result! = PATH_DIRECTION_NONE
  -- Return postcondition: result! = PATH_DIRECTION_LEFT
  -- Invokes: prevToCur.Magnitude, curToNext.Magnitude
  true
end

schema CCarCtrl_PickNextNodeToFollowPath
  ΔCCarCtrl
