  result! : 𝔹
where
  -- State update: curNode' = pVehicle.AutoPilot.m_nNextRouteNode
  -- State update: pCurNode' = &ThePaths.m_pathNodes[curNode]
  -- State update: pNextPathNode' = &ThePaths.m_pathNodes[pVehicle.AutoPilot.m_nNextRouteNode]
  -- State update: pVehicle.AutoPilot.m_nPrevRouteNode' = pVehicle.AutoPilot.m_nCurrentRouteNode
  -- State update: pVehicle.AutoPilot.m_nCurrentRouteNode' = pVehicle.AutoPilot.m_nNextRouteNode
  -- State update: pVehicle.AutoPilot.m_nCurrentDirection' = pVehicle.AutoPilot.m_nNextDirection
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: CGeneral::SetRandomSeed, ThePaths.DoPathSearch, pVehicle->GetPosition, AutoPilot.RemoveOnePathNode, ThePaths.ConnectedNode
  true
end

