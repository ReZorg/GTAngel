schema CCarCtrl_TestCollisionBetween2MovingRects
  ΔCCarCtrl
  pVehicleA? : Ref[CVehicle]
  pVehicleB? : Ref[CVehicle]
  projectionX? : ℝ
  projectionY? : ℝ
  pForwardA? : Ref[CVector]
  pForwardB? : Ref[CVector]
  id? : ℕ
  result! : ℝ
where
  -- State update: vecBToA' = pVehicleA.GetPosition() - pVehicleB.GetPosition()
  -- State update: lenB' = pVehicleB.GetModelInfo().GetColModel().boundingBox.max.y
  -- State update: widthB' = pVehicleB.GetModelInfo().GetColModel().boundingBox.max.x
  -- State update: lenA' = pVehicleA.GetModelInfo().GetColModel().boundingBox.max.y
  -- State update: widthA' = pVehicleA.GetModelInfo().GetColModel().boundingBox.max.x
  -- State update: proximity' = 1.0f
  -- Return postcondition: result! = proximity
  -- Invokes: pVehicleA->GetPosition, pVehicleB->GetPosition, pVehicleB->GetModelInfo, pVehicleA->GetModelInfo
  true
end

schema CCarCtrl_FindAngleToWeaveThroughTraffic
  ΔCCarCtrl
  pVehicle? : Ref[CVehicle]
  pTarget? : Ref[CPhysical]
  angleToTarget? : ℝ
  angleForward? : ℝ
  result! : ℝ
where
  -- State update: left' = pVehicle.GetPosition().x - distanceToTest
  -- State update: right' = pVehicle.GetPosition().x + distanceToTest
  -- State update: top' = pVehicle.GetPosition().y - distanceToTest
  -- State update: bottom' = pVehicle.GetPosition().y + distanceToTest
  -- State update: xstart' = Max(0, CWorld::GetSectorIndexX(left))
  -- State update: xend' = Min(NUMSECTORS_X - 1, CWorld::GetSectorIndexX(right))
  -- Return postcondition: result! = angleToBisectActualToTarget
  -- Return postcondition: result! = angleToWeaveRight
  -- Return postcondition: result! = angleDiffLeft < angleDiffRight ? angleToWeaveLeft : angleToWeaveRight
  -- Invokes: pVehicle->GetMoveSpeed, pVehicle->GetPosition, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::AdvanceCurrentScanCode
  true
end

