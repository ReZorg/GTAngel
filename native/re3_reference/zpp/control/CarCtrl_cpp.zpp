schema CarCtrl_GetRandomOffsetForVehicle
  ΔCarCtrlModuleState
  pVehicle? : Ref[CVehicle]
  bNext? : 𝔹
  result! : CVector
where
  -- State update: offset.x' = (seed - 3) * 0.009f
  -- State update: offset.y' = ((seed >> 3) - 3) * 0.009f
  -- State update: offset.z' = 0.0f
  -- Return postcondition: result! = offset
  true
end

schema CCarCtrl_UpdateCarOnRails
  ΔCCarCtrl
  pVehicle? : Ref[CVehicle]
where
  -- State update: pVehicle.AutoPilot.m_nTempAction' = TEMPACT_NONE
  -- State update: pVehicle.AutoPilot.m_nAntiReverseTimer' = CTimer::GetTimeInMilliseconds()
  -- State update: nextPathLinkForwardX' = pNextLink.GetDirX() * pVehicle.AutoPilot.m_nNextDirection
  -- State update: nextPathLinkForwardY' = pNextLink.GetDirY() * pVehicle.AutoPilot.m_nNextDirection
  -- State update: directionCurrentLink' = GetRandomOffsetForVehicle(pVehicle, false)
  -- State update: directionNextLink' = GetRandomOffsetForVehicle(pVehicle, true)
  -- Invokes: pVehicle->SetMoveSpeed, AutoPilot.ModifySpeed, CTimer::GetTimeInMilliseconds, pVehicle->GetStatus, pCurrentLink->GetDirX
  true
end

schema CCarCtrl_FindMaximumSpeedForThisCarInTraffic
  ΔCCarCtrl
  pVehicle? : Ref[CVehicle]
where
  -- State update: left' = pVehicle.GetPosition().x - DISTANCE_TO_SCAN_FOR_DANGER
  -- State update: right' = pVehicle.GetPosition().x + DISTANCE_TO_SCAN_FOR_DANGER
  -- State update: top' = pVehicle.GetPosition().y - DISTANCE_TO_SCAN_FOR_DANGER
  -- State update: bottom' = pVehicle.GetPosition().y + DISTANCE_TO_SCAN_FOR_DANGER
  -- State update: xstart' = Max(0, CWorld::GetSectorIndexX(left))
  -- State update: xend' = Min(NUMSECTORS_X - 1, CWorld::GetSectorIndexX(right))
  -- Return postcondition: result! = pVehicle->AutoPilot.GetCruiseSpeed()
  -- Return postcondition: result! = maxSpeed
  -- Return postcondition: result! = (maxSpeed + pVehicle->AutoPilot.GetCruiseSpeed()) / 2
  -- Invokes: AutoPilot.GetCruiseSpeed, pVehicle->GetPosition, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::AdvanceCurrentScanCode
  true
end

schema CCarCtrl_ScanForPedDanger
  ΔCCarCtrl
  pVehicle? : Ref[CVehicle]
where
  -- State update: storedSlowDownFlag' = pVehicle.AutoPilot.m_bSlowedDownBecauseOfPeds
  -- State update: left' = pVehicle.GetPosition().x - DISTANCE_TO_SCAN_FOR_PED_DANGER
  -- State update: right' = pVehicle.GetPosition().x + DISTANCE_TO_SCAN_FOR_PED_DANGER
  -- State update: top' = pVehicle.GetPosition().y - DISTANCE_TO_SCAN_FOR_PED_DANGER
  -- State update: bottom' = pVehicle.GetPosition().y + DISTANCE_TO_SCAN_FOR_PED_DANGER
  -- State update: xstart' = Max(0, CWorld::GetSectorIndexX(left))
  -- Invokes: pVehicle->GetPosition, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::AdvanceCurrentScanCode, CWorld::GetSector
  true
end

