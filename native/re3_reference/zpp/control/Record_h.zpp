--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Record_IsRecording
  ΔRecordModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = Status == STATE_RECORD
  true
end

schema Record_IsRecording_2
  ΔRecordModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = RecordingState == STATE_RECORD
  true
end

schema Record_IsPlayingBack
  ΔRecordModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = RecordingState == STATE_PLAYBACK
  true
end
