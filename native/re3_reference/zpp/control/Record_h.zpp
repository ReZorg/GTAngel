--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Record (control)
-- Source File(s): control/Record.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Record_Enum_1 ::= NUM_CHASE_CARS
  -- val(NUM_CHASE_CARS) = 20

Record_Enum_2 ::= STATE_NONE | STATE_RECORD | STATE_PLAYBACK_INIT | STATE_PLAYBACK | STATE_PLAYBACK_BEFORE_RECORDING
  -- val(STATE_NONE) = 0
  -- val(STATE_RECORD) = 1
  -- val(STATE_PLAYBACK_INIT) = 2
  -- val(STATE_PLAYBACK) = 3
  -- val(STATE_PLAYBACK_BEFORE_RECORDING) = 4

Record_Enum_3 ::= STATE_NONE | STATE_RECORD | STATE_PLAYBACK
  -- val(STATE_NONE) = 0
  -- val(STATE_RECORD) = 1
  -- val(STATE_PLAYBACK) = 2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CCarStateEachFrame
  velX : ℤ
  velY : ℤ
  velZ : ℤ
  rightX : ℤ
  rightY : ℤ
  rightZ : ℤ
  forwardX : ℤ
  forwardY : ℤ
  forwardZ : ℤ
  wheel : ℤ
  gas : ℤ
  brake : ℤ
  handbrake : 𝔹
  pos : CVector
where
  instance_addr ∈ ADDRESS
end

schema CRecordDataForChase
  Status : ℕ
  PositionChanges : ℤ
  CurrentCar : ℕ
  AnimTime : ℝ
  AnimStartTime : ℕ
  pBaseMemForCar : seq Ref[CCarStateEachFrame]  -- bounded array [NUM_CHASE_CARS]
  TimeMultiplier : ℝ
  FId2 : ℤ
where
  Status ≥ 0
  CurrentCar ≥ 0
  AnimStartTime ≥ 0
end

schema CRecordDataForChase_IsRecording
  ΔCRecordDataForChase
  result! : 𝔹
where
  -- Declared member operation CRecordDataForChase::IsRecording(void)
  true
end

schema CRecordDataForChase_Init_2
  ΔCRecordDataForChase
  result! : void
where
  -- Declared member operation CRecordDataForChase::Init(void)
  true
end

