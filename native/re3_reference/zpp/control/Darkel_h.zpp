schema CDarkel
  TimeLimit : ℤ
  PreviousTime : ℤ
  TimeOfFrenzyStart : ℤ
  WeaponType : ℤ
  AmmoInterruptedWeapon : ℤ
  KillsNeeded : ℤ
  InterruptedWeaponType : ℤ
  InterruptedWeaponSelected : ℤ
  bStandardSoundAndMessages : 𝔹
  bNeedHeadShot : 𝔹
  bProperKillFrenzy : 𝔹
  Status : ℕ
  RegisteredKills : seq ℕ  -- bounded array [NUM_DEFAULT_MODELS]
  ModelToKill : ℤ
  ModelToKill2 : ℤ
  ModelToKill3 : ℤ
  ModelToKill4 : ℤ
  pStartMessage : seq CHAR
  InterruptedWeapon : ℤ
where
  Status ≥ 0
end

