schema CTheScripts_HighlightImportantArea
  ΔCTheScripts
  id? : ℕ
  x1? : ℝ
  y1? : ℝ
  x2? : ℝ
  y2? : ℝ
  z? : ℝ
where
  -- State update: infX' = x1
  -- State update: supX' = x2
  -- State update: infX' = x2
  -- State update: supX' = x1
  -- State update: infY' = y1
  -- State update: supY' = y2
  -- Invokes: CWorld::FindGroundZForCoord, CShadows::RenderIndicatorShadow
  true
end

schema CTheScripts_HighlightImportantAngledArea
  ΔCTheScripts
  id? : ℕ
  x1? : ℝ
  y1? : ℝ
  x2? : ℝ
  y2? : ℝ
  x3? : ℝ
  y3? : ℝ
  x4? : ℝ
  y4? : ℝ
  z? : ℝ
where
  -- State update: X' = (x1 + x2) / 2
  -- State update: Y' = (y1 + y2) / 2
  -- State update: infX' = X
  -- State update: infY' = Y
  -- State update: X' = (x2 + x3) / 2
  -- State update: Y' = (y2 + y3) / 2
  -- Invokes: CWorld::FindGroundZForCoord, CShadows::RenderIndicatorShadow
  true
end

