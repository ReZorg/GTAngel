schema CPathNode
  prevIndex : ℤ
  nextIndex : ℤ
  x : ℤ
  y : ℤ
  z : ℤ
  distance : ℤ
  firstLink : ℤ
  width : ℕ
  group : ℤ
  numLinks : 𝔹
  bDeadEnd : 𝔹
  bDisabled : 𝔹
  bBetweenLevels : 𝔹
  bUseInRoadBlock : 𝔹
  bWaterPath : 𝔹
  bOnlySmallBoats : 𝔹
  bSelected : 𝔹
  speedLimit : 𝔹
  spawnRate : 𝔹
  flagsC : 𝔹
  pos : CVector
  prev : Ref[CPathNode]
  next : Ref[CPathNode]
  objectIndex : ℤ
  unkBits : 𝔹
where
  width ≥ 0
  #numLinks = 4
  #bDeadEnd = 1
  #bDisabled = 1
  #bBetweenLevels = 1
  #bUseInRoadBlock = 1
  #bWaterPath = 1
  #bOnlySmallBoats = 1
  #bSelected = 1
  #speedLimit = 2
  #spawnRate = 4
  #flagsC = 4
  #prev ≤ 1
  #next ≤ 1
  #unkBits = 2
end

