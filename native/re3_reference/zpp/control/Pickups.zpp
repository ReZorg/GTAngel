schema CPickup_GiveUsAPickUpObject
  ΔCPickup
  ppObject? : Ref[CObject]
  ppExtraObject? : Ref[CObject]
  handle? : ℤ
  extraHandle? : ℤ
where
  -- State update: object' = *ppObject
  -- State update: extraObject' = *ppExtraObject
  -- State update: extraObject' = ∅
  -- State update: modelId' = -1
  -- State update: modelId' = weaponInfo.m_nModelId
  -- State update: modelId' = weaponInfo.m_nModel2Id
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = object
  -- Invokes: CModelInfo::GetModelInfo, CWeaponInfo::GetWeaponInfo, CPools::MakeSureSlotInObjectPoolIsEmpty, object->SetPosition, object->SetOrientation
  true
end

schema CPickup_CanBePickedUp
