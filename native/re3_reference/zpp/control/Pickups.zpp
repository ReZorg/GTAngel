  NumMessages : ℤ
  aMessages : seq tPickupMessage  -- bounded array [NUMPICKUPMESSAGES]
  PlayerOnWeaponPickup : ℤ
  aPickUps : seq CPickup  -- bounded array [NUMPICKUPS]
  bPickUpcamActivated : 𝔹
  pPlayerVehicle : Ref[CVehicle]
  StaticCamCoors : CVector
  StaticCamStartTime : ℕ
where
  #pPlayerVehicle ≤ 1
  StaticCamStartTime ≥ 0
end

