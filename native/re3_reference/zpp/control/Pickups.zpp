schema CPickups_RemovePickUp
  ΔCPickups
  pickupIndex? : ℤ
where
  -- State update: index' = GetActualPickupIndex(pickupIndex)
  -- State update: m_pObject' = ∅
  -- State update: m_pExtraObject' = ∅
