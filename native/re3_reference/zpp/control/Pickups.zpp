  -- State update: m_bRemoved' = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = result
  -- Invokes: m_pObject->GetMatrix, m_pExtraObject->GetMatrix, CTimer::GetTimeInMilliseconds, CWorld::Add, m_pObject->GetModelIndex
