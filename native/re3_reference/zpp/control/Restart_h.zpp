schema CRestart_FindClosestPoliceRestartPoint_5
  ΔCRestart
  arg_1? : CVector
  arg_2? : Ref[CVector]
  arg_3? : ℙ ℝ
where
  -- Declared member operation CRestart::FindClosestPoliceRestartPoint(const CVector &, CVector *, float *)
  true
