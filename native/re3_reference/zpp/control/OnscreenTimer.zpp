where
  -- State update: m_bDisabled' = false
  -- State update: m_nCounterOffset' = 0
  -- State update: m_nTotal' = -1
  -- State update: m_nType' = COUNTER_DISPLAY_NUMBER
  -- State update: m_nTypeOfTotal' = 0
  -- State update: m_bCounterProcessed' = false
  true
end

schema COnscreenTimer_Process
  ΔCOnscreenTimer
where
  -- Invokes: CReplay::IsPlayingBack
  true
end

