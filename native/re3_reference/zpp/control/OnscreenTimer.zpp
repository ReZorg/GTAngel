OnscreenTimer_Enum_1 ::= COUNTER_DISPLAY_NUMBER | COUNTER_DISPLAY_BAR

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema COnscreenTimerEntry
  m_nTimerOffset : ℕ
  m_nCounterOffset : ℕ
  m_aTimerText : seq CHAR
  m_aCounterText : seq CHAR
  m_nType : ℕ
  m_bCounterBuffer : seq CHAR
  m_bTimerBuffer : seq CHAR
  m_bTimerProcessed : 𝔹
  m_bCounterProcessed : 𝔹
  m_nClockOffset : ℕ
  m_aClockText : seq CHAR
  m_aClockBuffer : seq CHAR
  m_bClockProcessed : 𝔹
  m_bClockGoingDown : 𝔹
  m_aClockColour : CRGBA
  m_bClockTickThisFrame : 𝔹
where
  m_nTimerOffset ≥ 0
  m_nCounterOffset ≥ 0
  #m_aTimerText = 10
  #m_aCounterText = 10
  m_nType ≥ 0
  #m_bCounterBuffer = 42
  #m_bTimerBuffer = 42
  m_nClockOffset ≥ 0
  #m_aClockText = 10
  #m_aClockBuffer = 40
end

schema COnscreenTimerEntry_Process
  ΔCOnscreenTimerEntry
where
  -- Declared member operation COnscreenTimerEntry::Process()
  true
end

schema COnscreenTimerEntry_ProcessForDisplay_2
  ΔCOnscreenTimerEntry
  result! : 𝔹
where
  -- Declared member operation COnscreenTimerEntry::ProcessForDisplay()
  true
end

