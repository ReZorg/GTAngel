schema COnscreenCounterEntry
  m_nCounterOffset : ℕ
  m_nTotal : ℤ
  m_aCounterText1 : seq CHAR
  m_aCounterText2 : seq CHAR
  m_nTypeOfTotal : ℕ
  m_nType : ℕ
  m_aCounterBuffer : seq CHAR
  m_bCounterProcessed : 𝔹
  m_colour1 : CRGBA
  m_colour2 : CRGBA
  m_bAddDollarPrefix : 𝔹
  m_aCounterText : seq CHAR
where
  m_nCounterOffset ≥ 0
  #m_aCounterText1 = 10
  #m_aCounterText2 = 10
  m_nTypeOfTotal ≥ 0
  m_nType ≥ 0
  #m_aCounterBuffer = 40
  #m_aCounterText = 10
end

schema COnscreenCounterEntry_ProcessForDisplayCounter
  ΔCOnscreenCounterEntry
where
  -- Declared member operation COnscreenCounterEntry::ProcessForDisplayCounter()
  true
end

schema COnscreenTimer
  m_sClocks : seq COnscreenTimerEntry  -- bounded array [NUMONSCREENCLOCKS]
  m_sCounters : seq COnscreenCounterEntry  -- bounded array [NUMONSCREENCOUNTERS]
  m_bProcessed : 𝔹
  m_bDisabled : 𝔹
  m_sEntries : seq COnscreenTimerEntry  -- bounded array [NUMONSCREENTIMERENTRIES]
where
  instance_addr ∈ ADDRESS
end

