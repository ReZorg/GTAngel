  -- State update: m_bProcessed' = false
  -- State update: m_bClockProcessed' = false
  -- State update: m_bClockProcessed' = true
  -- State update: m_bProcessed' = true
  -- State update: m_bCounterProcessed' = false
  -- State update: m_bCounterProcessed' = true
