  ΔCOnscreenTimerEntry
where
  -- Declared member operation COnscreenTimerEntry::ProcessForDisplayClock()
  true
end

schema COnscreenTimerEntry_ProcessForDisplayCounter_4
  ΔCOnscreenTimerEntry
where
  -- Declared member operation COnscreenTimerEntry::ProcessForDisplayCounter()
