-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CDummy_Add
  ΔCDummy
where
  -- State update: bounds' = GetBoundRect()
  -- State update: xstart' = CWorld::GetSectorIndexX(bounds.left)
  -- State update: xend' = CWorld::GetSectorIndexX(bounds.right)
  -- State update: xmid' = CWorld::GetSectorIndexX((bounds.left + bounds.right)/2.0f)
  -- State update: ystart' = CWorld::GetSectorIndexY(bounds.top)
  -- State update: yend' = CWorld::GetSectorIndexY(bounds.bottom)
  -- Invokes: CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::GetSector, list->InsertItem, m_entryInfoList.InsertItem
  true
end

schema CDummy_Remove
  ΔCDummy
where
  -- State update: node' = m_entryInfoList.first
  -- State update: next' = node.next
  -- Invokes: list->DeleteNode, m_entryInfoList.DeleteNode
  true
end

schema Dummy_IsDummyPointerValid
  ΔDummyModuleState
  pDummy? : Ref[CDummy]
where
  -- State update: index' = CPools::GetDummyPool().GetJustIndex_NoFreeAssert(pDummy)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = pDummy->m_entryInfoList.first
  -- Invokes: CPools::GetDummyPool
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema DummyModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 73
end
