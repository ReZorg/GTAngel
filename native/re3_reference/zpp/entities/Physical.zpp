-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPhysical
  CEntity  -- inherits base schema
  m_audioEntityId : ℤ
  m_phys_unused1 : ℝ
  m_nLastTimeCollided : ℕ
  m_vecMoveSpeed : CVector
  m_vecTurnSpeed : CVector
  m_vecMoveFriction : CVector
  m_vecTurnFriction : CVector
  m_vecMoveSpeedAvg : CVector
  m_vecTurnSpeedAvg : CVector
  m_fMass : ℝ
  m_fTurnMass : ℝ
  m_fForceMultiplier : ℝ
  m_fAirResistance : ℝ
  m_fElasticity : ℝ
  m_fBuoyancy : ℝ
  m_vecCentreOfMass : CVector
  m_entryInfoList : CEntryInfoList
  m_movingListNode : Ref[CPtrNode]
  m_phys_unused2 : ℤ
  m_nStaticFrames : ℕ
  m_nCollisionRecords : ℕ
  m_aCollisionRecords : seq Ref[CEntity]  -- bounded array [PHYSICAL_MAX_COLLISIONRECORDS]
  m_fDistanceTravelled : ℝ
  m_fDamageImpulse : ℝ
  m_pDamageEntity : Ref[CEntity]
  m_vecDamageNormal : CVector
  m_nDamagePieceType : ℤ
  bIsHeavy : 𝔹
  bAffectedByGravity : 𝔹
  bInfiniteMass : 𝔹
  m_phy_flagA08 : 𝔹
  bIsInWater : 𝔹
  m_phy_flagA20 : 𝔹
  bHitByTrain : 𝔹
  bSkipLineCol : 𝔹
  bIsFrozen : 𝔹
  bDontLoadCollision : 𝔹
  m_bIsVehicleBeingShifted : 𝔹
  bJustCheckCollision : 𝔹
  phys_lcs_unk1 : 𝔹
  m_nSurfaceTouched : ℕ
  m_nZoneLevel : ℤ
  phys_lcs_unk2 : ℤ
  m_treadable : seq Ref[CTreadable]  -- bounded array [2]
  m_phy_flagA10 : 𝔹
where
  m_nLastTimeCollided ≥ 0
  #m_movingListNode ≤ 1
  m_nStaticFrames ≥ 0
  m_nCollisionRecords ≥ 0
  #m_pDamageEntity ≤ 1
  #bIsHeavy = 1
  #bAffectedByGravity = 1
  #bInfiniteMass = 1
  #m_phy_flagA08 = 1
  #bIsInWater = 1
  #m_phy_flagA20 = 1
  #bHitByTrain = 1
  #bSkipLineCol = 1
  #bIsFrozen = 1
  #bDontLoadCollision = 1
  #m_bIsVehicleBeingShifted = 1
end

