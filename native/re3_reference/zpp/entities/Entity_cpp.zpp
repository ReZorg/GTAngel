  -- State update: ystart' = CWorld::GetSectorIndexY(bounds.top)
  -- State update: yend' = CWorld::GetSectorIndexY(bounds.bottom)
  -- Invokes: CWorld::GetSectorIndexX, CWorld::GetSectorIndexY, CWorld::GetSector, list->InsertItem
  true
end

