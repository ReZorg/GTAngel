  -- State update: m_status' = ((tmp >> 3) & (BIT(5) - 1))
  -- State update: bUsesCollision' = !!(tmp & BIT(8))
  -- State update: bCollisionProcessed' = !!(tmp & BIT(9))
  -- State update: bIsStatic' = !!(tmp & BIT(10))
  -- State update: bHasContacted' = !!(tmp & BIT(11))
