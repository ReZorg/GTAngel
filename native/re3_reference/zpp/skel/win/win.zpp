--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
_WIN32_WINDOWS : seq CHAR  -- #define _WIN32_WINDOWS 0x0500
WINVER : seq CHAR  -- #define WINVER 0x0500
MAPVK_VK_TO_CHAR : seq CHAR  -- #define MAPVK_VK_TO_CHAR (2)
WM_GRAPHNOTIFY : seq CHAR  -- #define WM_GRAPHNOTIFY WM_USER+13
WITHD3D : seq CHAR  -- #define WITHD3D #define WITHDINPUT
MAX_SUBSYSTEMS : seq CHAR  -- #define MAX_SUBSYSTEMS (16)
CMDSTR : seq CHAR  -- #define CMDSTR LPWSTR
DEVICE_AXIS_MIN : seq CHAR  -- #define DEVICE_AXIS_MIN -2000
DEVICE_AXIS_MAX : ℕ  -- #define DEVICE_AXIS_MAX 2000

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eJoypads ::= JOYSTICK1 | JOYSTICK2 | MAX_JOYSTICKS
  -- val(JOYSTICK1) = 0

eJoypadState ::= JOYPAD_UNUSED | JOYPAD_ATTACHED

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tJoy
  m_State : eJoypadState
  m_bInitialised : 𝔹
  m_bHasAxisZ : 𝔹
  m_bHasAxisR : 𝔹
  m_nVendorID : ℤ
  m_nProductID : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CJoySticks
  m_aJoys : seq tJoy  -- bounded array [MAX_JOYSTICKS]
where
  instance_addr ∈ ADDRESS
end

schema CJoySticks_CJoySticks
  ΔCJoySticks
where
  -- Declared member operation CJoySticks::CJoySticks()
  true
end

schema CJoySticks_ClearJoyInfo_2
  ΔCJoySticks
  joyID? : ℤ
where
  -- Declared member operation CJoySticks::ClearJoyInfo(int joyID)
  true
end

