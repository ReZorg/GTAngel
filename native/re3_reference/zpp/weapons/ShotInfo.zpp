--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CShotInfo
  m_weapon : eWeaponType
  m_startPos : CVector
  m_areaAffected : CVector
  m_radius : ℝ
  m_sourceEntity : Ref[CEntity]
  m_timeout : ℝ
  m_inUse : 𝔹
  ms_afRandTable : seq ℝ  -- bounded array [20]
where
  #m_sourceEntity ≤ 1
  #ms_afRandTable = 20
end

schema CShotInfo_Initialise
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Initialise(void)
  true
end

schema CShotInfo_AddShot_2
  ΔCShotInfo
  arg_1? : Ref[CEntity]
  arg_2? : eWeaponType
  arg_3? : CVector
  arg_4? : CVector
  result! : 𝔹
where
  -- Declared member operation CShotInfo::AddShot(CEntity*, eWeaponType, CVector, CVector)
  true
end

schema CShotInfo_Shutdown_3
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Shutdown(void)
  true
end

schema CShotInfo_Update_4
  ΔCShotInfo
where
  -- Declared member operation CShotInfo::Update(void)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CShotInfo_Initialise
  ΔCShotInfo
where
  -- State update: m_inUse' = false
  -- State update: m_weapon' = WEAPONTYPE_COLT45
  -- State update: m_startPos' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_areaAffected' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_radius' = 1.0f
  -- State update: m_sourceEntity' = ∅
  true
end

schema CShotInfo_AddShot
  ΔCShotInfo
  sourceEntity? : Ref[CEntity]
  weapon? : eWeaponType
  startPos? : CVector
  endPos? : CVector
where
  -- State update: weaponInfo' = CWeaponInfo::GetWeaponInfo(weapon)
  -- State update: slot' = 0
  -- State update: m_inUse' = true
  -- State update: m_weapon' = weapon
  -- State update: m_startPos' = startPos
  -- State update: m_areaAffected' = endPos - startPos
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CWeaponInfo::GetWeaponInfo, CGeneral::GetRandomNumber, m_areaAffected.Normalise, weaponInfo->IsFlagSet, CTimer::GetTimeInMilliseconds
  true
end

schema CShotInfo_Shutdown
  ΔCShotInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema CShotInfo_Update
  ΔCShotInfo
where
  -- State update: slot' = 0
  -- State update: shot' = gaShotInfo[slot]
  -- State update: shot.m_sourceEntity' = ∅
  -- State update: weaponInfo' = CWeaponInfo::GetWeaponInfo(shot.m_weapon)
  -- State update: shot.m_inUse' = false
  -- State update: ped' = (CPed*) shot.m_sourceEntity
  -- Invokes: m_sourceEntity->IsPed, CWeaponInfo::GetWeaponInfo, CTimer::GetTimeInMilliseconds, weaponInfo->IsFlagSet, CTimer::GetTimeStep
  true
end
