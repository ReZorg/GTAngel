--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Explosion (weapons)
-- Source File(s): weapons/Explosion.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eExplosionType ::= EXPLOSION_GRENADE | EXPLOSION_MOLOTOV | EXPLOSION_ROCKET | EXPLOSION_CAR | EXPLOSION_CAR_QUICK | EXPLOSION_BOAT | EXPLOSION_HELI | EXPLOSION_HELI2 | EXPLOSION_MINE | EXPLOSION_BARREL | EXPLOSION_TANK_GRENADE | EXPLOSION_HELI_BOMB

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CExplosion
  m_ExplosionType : eExplosionType
  m_vecPosition : CVector
  m_fRadius : ℝ
  m_fPropagationRate : ℝ
  m_pCreatorEntity : Ref[CEntity]
  m_pVictimEntity : Ref[CEntity]
  m_fStopTime : ℝ
  m_nIteration : ℕ
  m_nActiveCounter : ℕ
  m_bIsBoat : 𝔹
  m_bMakeSound : 𝔹
  m_fStartTime : ℝ
  m_nParticlesExpireTime : ℕ
  m_fPower : ℝ
  m_fZshift : ℝ
where
  #m_pCreatorEntity ≤ 1
  #m_pVictimEntity ≤ 1
  m_nIteration ≥ 0
  m_nActiveCounter ≥ 0
  m_nParticlesExpireTime ≥ 0
end

schema CExplosion_AddExplosion
  ΔCExplosion
  explodingEntity? : Ref[CEntity]
  culprit? : Ref[CEntity]
  type? : eExplosionType
  pos? : CVector
  lifetime? : ℕ
  makeSound? : 𝔹
  radius? : ℝ
  result! : ifdef_SIMPLER_MISSIONS__bool
where
  -- Declared member operation CExplosion::AddExplosion(CEntity *explodingEntity, CEntity *culprit, eExplosionType type, const CVector &pos, uint32 lifetime, bool makeSound = true, float radius = -1.0f)
  true
end

schema CExplosion_DoesExplosionMakeSound_2
  ΔCExplosion
  id? : ℕ
  result! : 𝔹
where
  -- Declared member operation CExplosion::DoesExplosionMakeSound(uint8 id)
  true
end

