--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
BULLET_LIFETIME : seq CHAR  -- #define BULLET_LIFETIME (1000)
NUM_PED_BLOOD_PARTICLES : seq CHAR  -- #define NUM_PED_BLOOD_PARTICLES (8)
BLOOD_PARTICLE_OFFSET : ℝ  -- #define BLOOD_PARTICLE_OFFSET (CVector(0.0f, 0.0f, 0.0f))
NUM_VEHICLE_SPARKS : seq CHAR  -- #define NUM_VEHICLE_SPARKS (16)
NUM_TYRE_POP_SMOKES : seq CHAR  -- #define NUM_TYRE_POP_SMOKES (4)
NUM_OTHER_SPARKS : seq CHAR  -- #define NUM_OTHER_SPARKS (8)
BULLET_HIT_FORCE : ℝ  -- #define BULLET_HIT_FORCE (7.5f)
BULLET_BOUNDARY_MIN_X : ℝ  -- #define BULLET_BOUNDARY_MIN_X -2400.0f
BULLET_BOUNDARY_MAX_X : ℝ  -- #define BULLET_BOUNDARY_MAX_X 1600.0f
BULLET_BOUNDARY_MIN_Y : ℝ  -- #define BULLET_BOUNDARY_MIN_Y -2000.0f
BULLET_BOUNDARY_MAX_Y : ℝ  -- #define BULLET_BOUNDARY_MAX_Y 2000.0f
MAP_BORDER : ℝ  -- #define MAP_BORDER (1960.0f)

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CBulletInfo_Initialise
  ΔCBulletInfo
where
  -- State update: m_bInUse' = false
  -- State update: m_eWeaponType' = WEAPONTYPE_COLT45
  -- State update: m_fTimer' = 0.0f
  -- State update: m_pSource' = ∅
  -- State update: bulletInfoInUse' = 0
  true
end

schema CBulletInfo_Shutdown
  ΔCBulletInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema CBulletInfo_AddBullet
  ΔCBulletInfo
  pSource? : Ref[CEntity]
  type? : eWeaponType
  vecPosition? : CVector
  vecSpeed? : CVector
  result! : 𝔹
where
  -- State update: m_pSource' = pSource
  -- State update: m_eWeaponType' = type
  -- State update: m_nDamage' = CWeaponInfo::GetWeaponInfo(type).m_nDamage
  -- State update: m_vecPosition' = vecPosition
  -- State update: m_vecSpeed' = vecSpeed
  -- State update: m_fTimer' = CTimer::GetTimeInMilliseconds() + BULLET_LIFETIME
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CWeaponInfo::GetWeaponInfo, CTimer::GetTimeInMilliseconds
  true
end

schema CBulletInfo_Update
  ΔCBulletInfo
where
  -- State update: bPlayerSniperBullet' = false
  -- State update: pBullet' = &gaBulletInfo[i]
  -- State update: pBullet.m_pSource' = ∅
  -- State update: pBullet.m_bInUse' = false
  -- State update: vecOldPos' = pBullet.m_vecPosition
  -- State update: pBullet.m_bInUse' = false
  -- Invokes: m_pSource->IsPed, CTimer::GetTimeInMilliseconds, CTimer::GetTimeStep, CWorld::ProcessLineOfSight, CWeapon::CheckForShootingVehicleOccupant
  true
end

schema CBulletInfo_TestForSniperBullet
  ΔCBulletInfo
  x1? : ℝ
  x2? : ℝ
  y1? : ℝ
  y2? : ℝ
  z1? : ℝ
  z2? : ℝ
  result! : 𝔹
where
  -- State update: minP' = 0.0f
  -- State update: maxP' = 1.0f
  -- State update: minX' = Min(PlayerSniperBulletStart.x, PlayerSniperBulletEnd.x)
  -- State update: maxX' = Max(PlayerSniperBulletStart.x, PlayerSniperBulletEnd.x)
  -- State update: minP' = Min(minP, (x1 - minX) / (maxX - minX))
  -- State update: maxP' = Max(maxP, (maxX - x2) / (maxX - minX))
  -- Return postcondition: result! = false
  -- Return postcondition: result! = CCollision::TestLineBox(line, box)
  -- Return postcondition: result! = false
  -- Invokes: box.Set, CCollision::TestLineBox
  true
end

