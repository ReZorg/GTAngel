--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
PROJECTILE_BOUNDARY_MIN_X : ℝ  -- #define PROJECTILE_BOUNDARY_MIN_X -2390.0f
PROJECTILE_BOUNDARY_MAX_X : ℝ  -- #define PROJECTILE_BOUNDARY_MAX_X 1590.0f
