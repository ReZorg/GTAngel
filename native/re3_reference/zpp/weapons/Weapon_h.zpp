[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
CAR_DRIVEBYAUTOAIMING_MAXDIST : ℝ  -- #define CAR_DRIVEBYAUTOAIMING_MAXDIST (2.5f)
DOOMAUTOAIMING_MAXDIST : ℝ  -- #define DOOMAUTOAIMING_MAXDIST (9000.0f)
DRIVEBYAUTOAIMING_MAXDIST : ℝ  -- #define DRIVEBYAUTOAIMING_MAXDIST (2.5f)

