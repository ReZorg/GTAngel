schema CWeapon
  m_eWeaponType : eWeaponType
  m_eWeaponState : eWeaponState
  m_nAmmoInClip : ℤ
  m_nAmmoTotal : ℤ
  m_nTimer : ℕ
  m_bAddRotOffset : 𝔹
  bPhotographHasBeenTaken : 𝔹
where
  m_nTimer ≥ 0
end

schema CWeapon_CWeapon
  ΔCWeapon
where
  -- Declared member operation CWeapon::CWeapon()
  true
end

