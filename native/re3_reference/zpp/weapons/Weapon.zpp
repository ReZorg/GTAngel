  camFront? : CVector
  camUp? : CVector
where
  -- State update: source' = pos
  -- State update: target' = dist * FindPlayerPed().GetForward() + source
  -- State update: source' = camSource
  -- State update: target' = camFront
  -- State update: target' = dist * target + source
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CPad::GetPad, CDraw::GetAspectRatio, target.Normalise
  true
end

