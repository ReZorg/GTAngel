schema CProjectileInfo_Initialise
  ΔCProjectileInfo
where
  -- State update: m_eWeaponType' = WEAPONTYPE_GRENADE
  -- State update: m_pSource' = ∅
  -- State update: m_nExplosionTime' = 0
  -- State update: m_bInUse' = false
  -- State update: projectileInUse' = 0
  true
end

schema CProjectileInfo_Shutdown
  ΔCProjectileInfo
where
  -- Deterministic transition preserving module invariants
  true
end

schema CProjectileInfo_GetProjectileInfo
  ΔCProjectileInfo
  id? : ℤ
where
  -- Return postcondition: result! = &gaProjectileInfo[id]
  true
end

schema CProjectileInfo_AddProjectile
  ΔCProjectileInfo
  entity? : Ref[CEntity]
  weapon? : eWeaponType
  pos? : CVector
  speed? : ℝ
where
  -- State update: SpecialCollisionResponseCase' = COLLRESPONSE_NONE
  -- State update: gravity' = true
  -- State update: elasticity' = 0.75f
  -- State update: ped' = (CPed*)entity
  -- State update: vy' = 0.35f
  -- State update: time' = CTimer::GetTimeInMilliseconds() + 2000
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CTimer::GetTimeInMilliseconds, entity->GetModelIndex, ped->GetMatrix, matrix.GetPosition, entity->GetForward
  true
end

schema CProjectileInfo_RemoveProjectile
  ΔCProjectileInfo
  info? : Ref[CProjectileInfo]
  projectile? : Ref[CProjectile]
where
  -- State update: info.m_bInUse' = false
  -- Invokes: CExplosion::AddExplosion, projectile->GetPosition, m_pSource->IsVehicle, CWorld::Remove
  true
end

schema CProjectileInfo_RemoveNotAdd
  ΔCProjectileInfo
  entity? : Ref[CEntity]
  weaponType? : eWeaponType
  pos? : CVector
where
  -- Invokes: CExplosion::AddExplosion
  true
end

schema CProjectileInfo_Update
  ΔCProjectileInfo
where
  -- State update: tearGasOffset' = -0.0f
  -- State update: ped' = (CPed*)gaProjectileInfo[i].m_pSource
  -- State update: m_pSource' = ∅
  -- State update: m_bInUse' = false
  -- State update: m_fElasticity' = 0.03f
  -- State update: projectilePos' = ms_apProjectile[i].GetPosition()
  -- Invokes: ped->IsPed, ped->IsPointerValid, CTimer::GetTimeStep, CWorld::Remove, CTimer::GetTimeInMilliseconds
  true
end

schema CProjectileInfo_IsProjectileInRange
  ΔCProjectileInfo
  x1? : ℝ
  x2? : ℝ
  y1? : ℝ
  y2? : ℝ
  z1? : ℝ
  z2? : ℝ
  remove? : 𝔹
where
  -- State update: pos' = ms_apProjectile[i].GetPosition()
  -- State update: m_bInUse' = false
  -- Return postcondition: result! = result
  -- Invokes: CWorld::Remove
  true
end

