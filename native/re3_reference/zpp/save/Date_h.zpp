--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Date (save)
-- Source File(s): save/Date.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CDate
  m_nSecond : ℤ
  m_nMinute : ℤ
  m_nHour : ℤ
  m_nDay : ℤ
  m_nMonth : ℤ
  m_nYear : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CDate_CDate
  ΔCDate
where
  -- Declared member operation CDate::CDate()
  true
end

schema CDate_operator_2
  ΔCDate
  right? : CDate
  result! : 𝔹
where
  -- Declared member operation CDate::operator>(const CDate &right)
  true
end

schema CDate_operator_3
  ΔCDate
  right? : CDate
  result! : 𝔹
where
  -- Declared member operation CDate::operator<(const CDate &right)
  true
end

schema CDate_operator_4
  ΔCDate
  right? : CDate
  result! : 𝔹
where
  -- Declared member operation CDate::operator==(const CDate &right)
  true
end

schema CDate_PopulateDateFields_5
  ΔCDate
  second? : ℤ
  minute? : ℤ
  hour? : ℤ
  day? : ℤ
  month? : ℤ
  year? : ℤ
where
  -- Declared member operation CDate::PopulateDateFields(int8 &second, int8 &minute, int8 &hour, int8 &day, int8 &month, int16 year)
  true
end
