schema CMemoryCardInfo
  port : ℤ
  slot : ℤ
  type : ℤ
  free : ℤ
  format : ℤ
  dir : seq CHAR
  Year : ℤ
  _Create : time
  _Modify : time
  FileSizeByte : ℤ
  AttrFile : ℤ
  EntryName : seq unsigned_char  -- bounded array [32]
where
  #dir = 40
  #EntryName = 32
end

schema CMemoryCard
  _unk0 : ℤ
  _unk1 : ℤ
  m_bWantToLoad : 𝔹
  JustLoadedDontFadeInYet : 𝔹
  StillToFadeOut : 𝔹
  b_FoundRecentSavedGameWantToLoad : 𝔹
  TimeStartedCountingForFade : ℕ
  TimeToStayFadedBeforeFadeOut : ℕ
  LastBlockSize : ℕ
  _bunk2 : 𝔹
  SaveFileNameJustSaved : seq CHAR
  _pad0 : seq CHAR
  pErrorMsg : seq CHAR
  _unk4 : seq CHAR
  _bunk5 : 𝔹
  _bunk6 : 𝔹
  _bunk7 : 𝔹
  _bunk8 : 𝔹
  nError : ℤ
  _unk9 : seq CHAR
  LoadFileName : seq CHAR
  _pad1 : seq CHAR
  CompileDateAndTime : CDate
  m_LanguageToLoad : ℤ
  m_LevelToLoad : ℤ
  CurrentCard : ℤ
  _unk10 : seq CHAR
where
  TimeStartedCountingForFade ≥ 0
  TimeToStayFadedBeforeFadeOut ≥ 0
  LastBlockSize ≥ 0
  #SaveFileNameJustSaved = 30
  #_pad0 = 3
  #_unk4 = 32
  #_unk9 = 30
  #LoadFileName = 30
  #_pad1 = 2
  #_unk10 = 32
end

