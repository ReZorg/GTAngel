--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CMessages_Init
  ΔCMessages
where
  -- State update: m_pText' = ∅
  -- State update: m_pString' = ∅
  true
end

schema CMessages_GetWideStringLength
  ΔCMessages
  src? : seq CHAR
where
  -- State update: length' = 0
  -- Return postcondition: result! = length
  true
end

schema CMessages_WideStringCopy
  ΔCMessages
  dst? : seq CHAR
  src? : seq CHAR
  size? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema Messages_FixupChar
  ΔMessagesModuleState
  c? : seq CHAR
  result! : seq CHAR
where
  -- Return postcondition: result! = c & 0x7fff
  -- Return postcondition: result! = c
  -- Invokes: CFont::IsJapanese
  true
end

schema CMessages_WideStringCompare
  ΔCMessages
  str1? : seq CHAR
  str2? : seq CHAR
  size? : ℕ
where
  -- State update: len1' = GetWideStringLength(str1)
  -- State update: len2' = GetWideStringLength(str2)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  true
end

