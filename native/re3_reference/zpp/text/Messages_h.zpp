--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Messages (text)
-- Source File(s): text/Messages.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
NUMBRIEFMESSAGES : ℕ  -- #define NUMBRIEFMESSAGES 8
NUMBIGMESSAGES : ℕ  -- #define NUMBIGMESSAGES 8
NUMPREVIOUSBRIEFS : ℕ  -- #define NUMPREVIOUSBRIEFS 5

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tMessage
  m_pText : seq CHAR
  m_nFlag : ℕ
  m_nTime : ℕ
  m_nStartTime : ℕ
  m_nNumber : seq ℤ  -- bounded array [6]
  m_pString : seq CHAR
where
  m_nFlag ≥ 0
  m_nTime ≥ 0
  m_nStartTime ≥ 0
  #m_nNumber = 6
end

schema tBigMessage
  m_Stack : seq tMessage  -- bounded array [4]
where
  #m_Stack = 4
end

schema tPreviousBrief
  m_pText : seq CHAR
  m_nNumber : seq ℤ  -- bounded array [6]
  m_pString : seq CHAR
where
  #m_nNumber = 6
end

schema CMessages
  BriefMessages : seq tMessage  -- bounded array [NUMBRIEFMESSAGES]
  BIGMessages : seq tBigMessage  -- bounded array [NUMBIGMESSAGES]
  PreviousBriefs : seq tPreviousBrief  -- bounded array [NUMPREVIOUSBRIEFS]
  PreviousMissionTitle : seq CHAR
where
  #PreviousMissionTitle = 16
end

schema CMessages_Init
  ΔCMessages
where
  -- Declared member operation CMessages::Init(void)
  true
end

