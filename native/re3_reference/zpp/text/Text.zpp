schema CMissionTextOffsets
  offset : ℕ
  data : seq Entry  -- bounded array [MAX_MISSION_TEXTS]
  size : ℕ
where
  offset ≥ 0
  size ≥ 0
end

schema CMissionTextOffsets_CMissionTextOffsets
