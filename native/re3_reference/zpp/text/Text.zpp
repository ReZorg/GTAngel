end

schema CText_LoadMissionText
  ΔCText
  MissionTableName? : seq CHAR
where
  -- State update: search_result' = false
  -- State update: missionTableId' = 0
  -- State update: missionTableId' = 0
  -- State update: search_result' = true
  -- State update: file' = CFileMgr::OpenFile(filename, "rb")
  -- State update: tdat_loaded' = false
  -- Invokes: CMessages::ClearAllMessagesDisplayedByGame, mission_keyArray.Unload, mission_data.Unload, CFileMgr::SetDir, CTimer::Suspend
  true
end

schema CText_IsLoaded
