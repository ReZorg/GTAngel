  bHasMissionTextOffsets : 𝔹
  bIsMissionTextLoaded : 𝔹
  szMissionTableName : seq CHAR
  MissionTextOffsets : CMissionTextOffsets
  bIsLoaded : 𝔹
  msInstance : Ref[CText]
where
  #szMissionTableName = 8
  #msInstance ≤ 1
end

