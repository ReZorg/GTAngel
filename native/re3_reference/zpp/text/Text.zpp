--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CText_CText
  ΔCText
where
  -- State update: encoding' = 'e'
  -- State update: bHasMissionTextOffsets' = false
  -- State update: bIsMissionTextLoaded' = false
  true
end

schema CText_Load
  ΔCText
where
  -- State update: tdat_loaded' = false
  -- State update: bIsMissionTextLoaded' = false
  -- State update: bHasMissionTextOffsets' = false
  -- State update: file' = CFileMgr::OpenFile(filename, "rb")
  -- State update: offset' = 0
  -- State update: bHasMissionTextOffsets' = true
  -- Invokes: CFileMgr::SetDir, CFileMgr::OpenFile, MissionTextOffsets.Load, keyArray.Load, data.Load
  true
end

schema CText_Unload
  ΔCText
where
  -- State update: bIsLoaded' = false
  -- State update: bIsMissionTextLoaded' = false
  -- Invokes: CMessages::ClearAllMessagesDisplayedByGame, keyArray.Unload, data.Unload, mission_keyArray.Unload, mission_data.Unload
  true
end

schema CText_Get
  ΔCText
  key? : seq CHAR
where
  -- State update: outstr' = keyArray.Search(key, data.chars, &result)
  -- State update: outstr' = keyArray.Search(key, &result)
  -- State update: outstr' = mission_keyArray.Search(key, mission_data.chars, &result)
  -- State update: outstr' = mission_keyArray.Search(key, &result)
  -- Return postcondition: result! = outstr
  -- Invokes: keyArray.Search, mission_keyArray.Search
  true
end

schema CText_GetUpperCase
  ΔCText
  c? : seq CHAR
where
  -- Return postcondition: result! = c - 32
  -- Return postcondition: result! = c - 32
  -- Return postcondition: result! = FrenchUpperCaseTable[c-128]
  true
end

schema CText_UpperCase
  ΔCText
  s? : seq CHAR
where
  -- State update: s' = GetUpperCase(*s)
  true
end

schema CText_GetNameOfLoadedMissionText
