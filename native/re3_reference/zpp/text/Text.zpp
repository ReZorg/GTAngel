where
  -- Return postcondition: result! = bIsLoaded
  true
end

schema CKeyArray_Load
  ΔCKeyArray
  length? : ℕ
  file? : ℤ
  offset? : ℙ ℕ
where
  -- State update: numEntries' = (int)(length / sizeof(CKeyEntry))
  -- State update: entries' = new CKeyEntry[numEntries]
  -- State update: rawbytes' = (char*)entries
  -- Invokes: CFileMgr::Read
  true
end

schema CKeyArray_Unload
  ΔCKeyArray
where
  -- State update: entries' = ∅
  -- State update: numEntries' = 0
  true
end

schema CKeyArray_Update
  ΔCKeyArray
  chars? : seq CHAR
where
  -- State update: value' = (wchar*)((uint8*)chars + (uintptr)entries[i].value)
  true
end

schema CKeyArray_BinarySearch
  ΔCKeyArray
  key? : seq CHAR
  entries? : Ref[CKeyEntry]
  low? : ℤ
  high? : ℤ
where
  -- State update: mid' = (low + high)/2
  -- State update: diff' = strcmp(key, entries[mid].key)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = &entries[mid]
  -- Return postcondition: result! = BinarySearch(key, entries, low, mid-1)
  true
end

