schema CKeyEntry
  instance_addr : ADDRESS
where
  instance_addr ∈ ADDRESS
end

schema CKeyArray
  entries : Ref[CKeyEntry]
  numEntries : ℤ
where
  #entries ≤ 1
end

schema CKeyArray_CKeyArray
  ΔCKeyArray
where
  -- Declared member operation CKeyArray::CKeyArray(void)
  true
end

schema CKeyArray_Load_2
  ΔCKeyArray
