where
  -- Declared member operation CMissionTextOffsets::CMissionTextOffsets(void)
  true
end

schema Entry
  szMissionName : seq CHAR
  offset : ℕ
where
  #szMissionName = 8
  offset ≥ 0
end

schema ChunkHeader
  magic : seq CHAR
  size : ℤ
where
  #magic = 4
end

schema CText
  keyArray : CKeyArray
  data : CData
  mission_keyArray : CKeyArray
