--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_PARTICLEOBJECTS : ℕ  -- #define MAX_PARTICLEOBJECTS 70
MAX_AUDIOHYDRANTS : ℕ  -- #define MAX_AUDIOHYDRANTS 8

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eParticleObjectType ::= POBJECT_PAVEMENT_STEAM | POBJECT_PAVEMENT_STEAM_SLOWMOTION | POBJECT_WALL_STEAM | POBJECT_WALL_STEAM_SLOWMOTION | POBJECT_DARK_SMOKE | POBJECT_FIRE_HYDRANT | POBJECT_FIRE_HYDRANT_STEAM | POBJECT_CAR_WATER_SPLASH | POBJECT_PED_WATER_SPLASH | POBJECT_SPLASHES_AROUND | POBJECT_SMALL_FIRE | POBJECT_BIG_FIRE | POBJECT_DRY_ICE | POBJECT_DRY_ICE_SLOWMOTION | POBJECT_WATER_FOUNTAIN_VERT | POBJECT_WATER_FOUNTAIN_HORIZ | POBJECT_FIRE_TRAIL | POBJECT_SMOKE_TRAIL | POBJECT_FIREBALL_AND_SMOKE | POBJECT_ROCKET_TRAIL | POBJECT_EXPLOSION_ONCE | POBJECT_CATALINAS_GUNFLASH | POBJECT_CATALINAS_SHOTGUNFLASH
  -- val(POBJECT_PAVEMENT_STEAM) = 0

eParticleObjectState ::= POBJECTSTATE_INITIALISED | POBJECTSTATE_UPDATE_CLOSE | POBJECTSTATE_UPDATE_FAR | POBJECTSTATE_FREE
  -- val(POBJECTSTATE_INITIALISED) = 0

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CParticleObject
  CPlaceable  -- inherits base schema
  m_pNext : Ref[CParticleObject]
  m_pPrev : Ref[CParticleObject]
  m_pParticle : Ref[CParticle]
  m_nRemoveTimer : ℕ
  m_Type : eParticleObjectType
  m_ParticleType : tParticleType
  m_nNumEffectCycles : ℕ
  m_nSkipFrames : ℕ
  m_nFrameCounter : ℕ
  m_nState : ℕ
  m_vecTarget : CVector
  m_fRandVal : ℝ
  m_fSize : ℝ
  m_Color : CRGBA
  m_bRemove : ℕ
  m_nCreationChance : ℤ
  pCloseListHead : Ref[CParticleObject]
  pFarListHead : Ref[CParticleObject]
  pUnusedListHead : Ref[CParticleObject]
where
  #m_pNext ≤ 1
  #m_pPrev ≤ 1
  #m_pParticle ≤ 1
  m_nRemoveTimer ≥ 0
  m_nNumEffectCycles ≥ 0
  m_nSkipFrames ≥ 0
  m_nFrameCounter ≥ 0
  m_nState ≥ 0
  m_bRemove ≥ 0
  #pCloseListHead ≤ 1
  #pFarListHead ≤ 1
  #pUnusedListHead ≤ 1
end

