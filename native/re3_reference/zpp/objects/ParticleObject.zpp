--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CAudioHydrant_Add
  ΔCAudioHydrant
  particleobject? : Ref[CParticleObject]
where
  -- State update: AudioEntity' = DMAudio.CreateEntity(AUDIOTYPE_FIREHYDRANT, particleobject)
  -- State update: pParticleObject' = particleobject
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: DMAudio.CreateEntity, DMAudio.SetEntityStatus
  true
end

schema CAudioHydrant_Remove
  ΔCAudioHydrant
  particleobject? : Ref[CParticleObject]
where
  -- State update: AudioEntity' = AEHANDLE_NONE
  -- State update: pParticleObject' = ∅
  -- Invokes: DMAudio.DestroyEntity
  true
end

schema CParticleObject_CParticleObject
  ΔCParticleObject
where
  -- Deterministic transition preserving module invariants
  true
end

schema CParticleObject_Initialise
  ΔCParticleObject
where
  -- State update: pCloseListHead' = ∅
  -- State update: pFarListHead' = ∅
  -- State update: pUnusedListHead' = &gPObjectArray[0]
  -- State update: m_pPrev' = ∅
  -- State update: m_pPrev' = &gPObjectArray[i - 1]
  -- State update: m_pNext' = ∅
  true
end

