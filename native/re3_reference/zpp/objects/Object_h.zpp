--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CObject
  CPhysical  -- inherits base schema
  m_objectMatrix : CMatrix
  m_fUprootLimit : ℝ
  ObjectCreatedBy : ℤ
  bIsPickup : 𝔹
  bAmmoCollected : 𝔹
  bPickupObjWithMessage : 𝔹
  bOutOfStock : 𝔹
  bGlassCracked : 𝔹
  bGlassBroken : 𝔹
  bHasBeenDamaged : 𝔹
  bUseVehicleColours : 𝔹
  bIsWeapon : 𝔹
  bIsStreetLight : 𝔹
  m_nBonusValue : ℤ
  m_nLastWeaponToDamage : ℤ
  m_nCostValue : ℕ
  m_fCollisionDamageMultiplier : ℝ
  m_nCollisionDamageEffect : ℕ
  m_nSpecialCollisionResponseCases : ℕ
  m_bCameraToAvoidThisObject : 𝔹
  m_nBeachballBounces : ℕ
  m_obj_unused1 : ℕ
  m_nEndOfLifeTime : ℕ
  m_nRefModelIndex : ℤ
  m_pCurSurface : Ref[CEntity]
  m_pCollidingEntity : Ref[CEntity]
  m_colour2 : ℤ
  nNoTempObjects : ℤ
  fDistToNearestTree : ℝ
  nBodyCastHealth : ℤ
where
  #bIsPickup = 1
  #bAmmoCollected = 1
  #bPickupObjWithMessage = 1
  #bOutOfStock = 1
  #bGlassCracked = 1
  #bGlassBroken = 1
  #bHasBeenDamaged = 1
  #bUseVehicleColours = 1
  #bIsWeapon = 1
  #bIsStreetLight = 1
  m_nCostValue ≥ 0
  m_nCollisionDamageEffect ≥ 0
  m_nSpecialCollisionResponseCases ≥ 0
  m_nBeachballBounces ≥ 0
  m_obj_unused1 ≥ 0
  m_nEndOfLifeTime ≥ 0
end

schema CObject_operator_new
  ΔCObject
  arg_1? : ℕ
  result! : ADDRESS
where
  -- Declared member operation CObject::operator new(size_t)
  true
end

