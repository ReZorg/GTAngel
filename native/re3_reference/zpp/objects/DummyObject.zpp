--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CDummyObject
  CDummy  -- inherits base schema
where
  instance_addr ∈ ADDRESS
end

schema CDummyObject_CDummyObject
  ΔCDummyObject
where
  -- Declared member operation CDummyObject::CDummyObject(void)
  true
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CDummyObject_CDummyObject
  ΔCDummyObject
  obj? : Ref[CObject]
where
  -- State update: m_level' = obj.m_level
  -- State update: m_area' = obj.m_area
  -- Invokes: obj->GetModelIndex, obj->DetachFromRwObject
  true
end

schema DummyObject_CDummyObject
  ΔDummyObjectModuleState
where
  -- Deterministic transition preserving module invariants
  true
end
