RpGeometryLockMode ::= rpGEOMETRYLOCKPOLYGONS | rpGEOMETRYLOCKVERTICES | rpGEOMETRYLOCKNORMALS | rpGEOMETRYLOCKPRELIGHT | rpGEOMETRYLOCKTEXCOORDS | rpGEOMETRYLOCKTEXCOORDS1 | rpGEOMETRYLOCKTEXCOORDS2 | rpGEOMETRYLOCKTEXCOORDS3 | rpGEOMETRYLOCKTEXCOORDS4 | rpGEOMETRYLOCKTEXCOORDS5 | rpGEOMETRYLOCKTEXCOORDS6 | rpGEOMETRYLOCKTEXCOORDS7 | rpGEOMETRYLOCKTEXCOORDS8 | rpGEOMETRYLOCKTEXCOORDSALL | rpGEOMETRYLOCKALL
