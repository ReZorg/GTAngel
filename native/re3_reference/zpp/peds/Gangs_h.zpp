--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Gangs_Enum_1 ::= GANG_MAFIA | GANG_TRIAD | GANG_DIABLOS | GANG_YAKUZA | GANG_YARDIE | GANG_COLUMB | GANG_HOODS | GANG_FORELLI | GANG_SINDACCO | NUM_GANGS
  -- val(GANG_MAFIA) = 0

Gangs_Enum_2 ::= GANG_CUBAN | GANG_HAITIAN | GANG_STREET | GANG_DIAZ | GANG_SECURITY | GANG_BIKER | GANG_PLAYER | GANG_GOLFER | GANG_9 | NUM_GANGS
  -- val(GANG_CUBAN) = 0

Gangs_Enum_3 ::= GANG_MAFIA | GANG_TRIAD | GANG_DIABLOS | GANG_YAKUZA | GANG_YARDIE | GANG_COLUMB | GANG_HOODS | GANG_7 | GANG_8 | NUM_GANGS
