  -- State update: m_nSelectedWepSlot' = TOTAL_WEAPON_SLOTS - 1
  -- State update: m_nSelectedWepSlot' = WEAPONSLOT_PROJECTILE
  -- State update: m_nSelectedWepSlot' = m_currentWeapon - 1
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: CDarkel::FrenzyOnGoing, padUsed->CycleWeaponRightJustDown, padUsed->CycleWeaponLeftJustDown, CWeaponInfo::GetWeaponInfo, padUsed->GetWeapon
  true
end
