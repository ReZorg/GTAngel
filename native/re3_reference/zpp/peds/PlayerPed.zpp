schema animAndGroup
  animId : AnimationId
  groupId : AssocGroupId
where
  instance_addr ∈ ADDRESS
end

schema CPlayerPed
  CPed  -- inherits base schema
  m_pWanted : Ref[CWanted]
  m_pArrestingCop : Ref[CCopPed]
  m_fMoveSpeed : ℝ
  m_fCurrentStamina : ℝ
  m_fMaxStamina : ℝ
  m_fStaminaProgress : ℝ
  m_nSelectedWepSlot : ℤ
  m_bSpeedTimerFlag : 𝔹
  m_nEvadeAmount : ℕ
  m_nSpeedTimer : ℕ
  m_nHitAnimDelayTimer : ℕ
  m_fAttackButtonCounter : ℝ
  m_bHaveTargetSelected : 𝔹
  m_pEvadingFrom : Ref[CEntity]
  m_nTargettableObjects : seq ℤ  -- bounded array [4]
  m_nAdrenalineTime : ℕ
  m_nDrunkenness : ℕ
  m_nFadeDrunkenness : ℕ
  m_nDrunkCountdown : ℕ
  m_bAdrenalineActive : 𝔹
  m_bHasLockOnTarget : 𝔹
  m_bCanBeDamaged : 𝔹
  m_bNoPosForMeleeAttack : 𝔹
  unk1 : 𝔹
  m_vecSafePos : seq CVector  -- bounded array [6]
  m_pPedAtSafePos : seq Ref[CPed]  -- bounded array [6]
  m_pMeleeList : seq Ref[CPed]  -- bounded array [6]
  m_nAttackDirToCheck : ℤ
  m_fWalkAngle : ℝ
  m_fFPSMoveHeading : ℝ
  m_pMinigunTopAtomic : Ref[RpAtomic]
  m_fGunSpinSpeed : ℝ
  m_fGunSpinAngle : ℝ
  m_nPadDownPressedInMilliseconds : ℤ
  m_nLastBusFareCollected : ℤ
  m_cachedCamSource : CVector
  m_cachedCamFront : CVector
  m_cachedCamUp : CVector
  field_1367 : ℤ
  field_1413 : ℤ
where
  #m_pWanted ≤ 1
  #m_pArrestingCop ≤ 1
  m_nEvadeAmount ≥ 0
  m_nSpeedTimer ≥ 0
  m_nHitAnimDelayTimer ≥ 0
  #m_pEvadingFrom ≤ 1
  #m_nTargettableObjects = 4
  m_nAdrenalineTime ≥ 0
  m_nDrunkenness ≥ 0
  m_nFadeDrunkenness ≥ 0
  m_nDrunkCountdown ≥ 0
  #m_vecSafePos = 6
  #m_pPedAtSafePos = 6
  #m_pMeleeList = 6
  #m_pMinigunTopAtomic ≤ 1
end

