where
  -- State update: mat' = RwFrameGetMatrix(m_ped.m_pFrames[PED_HEAD].frame)
  -- State update: pos' = matrix.GetPosition()
  -- Return postcondition: result! = result
  -- Invokes: m_ped->GetClump, matrix.GetPosition, matrix.SetRotateZ, matrix.RotateX, matrix.Translate
  true
end

