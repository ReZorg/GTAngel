--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema PedIK_GetBoneMatrix
  ΔPedIKModuleState
  ped? : Ref[CPed]
  bone? : ℤ
where
  -- State update: hier' = GetAnimHierarchyFromSkinClump(ped.GetClump())
  -- State update: idx' = RpHAnimIDGetIndex(hier, bone)
  -- State update: mats' = RpHAnimHierarchyGetMatrixArray(hier)
  -- Return postcondition: result! = &mats[idx]
  -- Invokes: ped->GetClump
  true
end

schema PedIK_GetComponentMatrix
  ΔPedIKModuleState
  ped? : Ref[CPed]
  node? : ℤ
where
  -- Return postcondition: result! = GetBoneMatrix(ped, ped->m_pFrames[node]->nodeID)
  true
end

schema CPedIK_RotateTorso
  ΔCPedIK
  node? : Ref[AnimBlendFrameData]
  limb? : Ref[LimbOrientation]
  changeRoll? : 𝔹
where
  -- State update: q' = &node.hanimFrame.q
  -- State update: mat' = GetBoneMatrix(m_ped, BONE_mid)
  -- State update: vec1.x' = mat.right.z
  -- State update: vec1.y' = mat.up.z
  -- State update: vec1.z' = mat.at.z
  -- State update: c' = Cos(m_ped.m_fRotationCur)
  -- Invokes: m_ped->GetClump, inversedForward.Normalise
  true
end

schema CPedIK_GetComponentPosition
  ΔCPedIK
  pos? : RwV3d
  node? : ℕ
where
  -- State update: pos.x' = 0.0f
  -- State update: pos.y' = 0.0f
  -- State update: pos.z' = 0.0f
  -- State update: mat' = GetComponentMatrix(m_ped, node)
  -- State update: f' = m_ped.m_pFrames[node].frame
  -- State update: mat' = RwFrameGetMatrix(f)
  -- Invokes: m_ped->GetClump
  true
end

schema CPedIK_GetWorldMatrix
  ΔCPedIK
  source? : Ref[RwFrame]
  destination? : Ref[RwMatrix]
where
  -- State update: destination' = *RwFrameGetMatrix(source)
  -- Return postcondition: result! = destination
  true
end

schema CPedIK_MoveLimb
  ΔCPedIK
  limb? : LimbOrientation
  targetYaw? : ℝ
  targetPitch? : ℝ
  moveInfo? : LimbMovementInfo
where
  -- State update: limb.yaw' = targetYaw
  -- State update: limb.yaw' = Clamp(limb.yaw, moveInfo.minYaw, moveInfo.maxYaw)
  -- State update: limb.pitch' = targetPitch
  -- State update: limb.pitch' = Clamp(limb.pitch, moveInfo.minPitch, moveInfo.maxPitch)
  -- Return postcondition: result! = result
  true
end

schema CPedIK_RestoreGunPosn
  ΔCPedIK
where
  -- State update: limbStatus' = MoveLimb(m_torsoOrient, 0.0f, 0.0f, ms_torsoInfo)
  -- Return postcondition: result! = limbStatus == ANGLES_SET_EXACTLY
  true
end

schema CPedIK_RotateHead
  ΔCPedIK
where
  -- State update: q' = &m_ped.m_pFrames[PED_HEAD].hanimFrame.q
  -- State update: m_ped.bDontAcceptIKLookAts' = true
  true
end

schema CPedIK_LookInDirection
  ΔCPedIK
  targetYaw? : ℝ
  targetPitch? : ℝ
where
  -- State update: success' = true
  -- State update: worldMat' = *GetBoneMatrix(m_ped, BONE_torso)
  -- State update: success' = false
  -- State update: success' = true
  -- State update: frame' = m_ped.m_pFrames[PED_HEAD].frame
  -- State update: frameMat' = RwFrameGetMatrix(frame)
  -- Return postcondition: result! = success
  -- Return postcondition: result! = success
  -- Invokes: m_ped->GetClump, CGeneral::LimitRadianAngle, nextFrame.GetPosition, nextFrame.SetRotateZ, nextFrame.RotateX
  true
end

schema CPedIK_LookAtPosition
  ΔCPedIK
  pos? : CVector
where
  -- State update: pedpos' = &GetComponentMatrix(m_ped, PED_MID).pos
  -- Return postcondition: result! = LookInDirection(yawToFace, pitchToFace)
  -- Invokes: CGeneral::GetRadianAngleBetweenPoints, m_ped->GetPosition
  true
end

schema CPedIK_PointGunInDirection
  ΔCPedIK
  targetYaw? : ℝ
  targetPitch? : ℝ
where
  -- State update: armPointedToGun' = false
  -- State update: armPointedToGun' = PointGunInDirectionUsingArm(targetYaw, targetPitch)
  -- State update: matrix' = RwMatrixCreate()
  -- State update: matrix' = *GetComponentMatrix(m_ped, PED_CLAVICLER)
  -- State update: targetPitch' = Max(targetPitch - Abs(targetYaw), 0.0f)
  -- State update: targetPitch' = Min(targetPitch + Abs(targetYaw), 0.0f)
  -- Return postcondition: result! = result
  -- Invokes: CGeneral::LimitRadianAngle, m_ped->GetForward, m_ped->GetClump
  true
end

schema CPedIK_PointGunInDirectionUsingArm
  ΔCPedIK
  targetYaw? : ℝ
  targetPitch? : ℝ
where
  -- State update: matrix' = RwMatrixCreate()
  -- State update: matrix' = *GetComponentMatrix(m_ped, PED_UPPERARMR)
  -- State update: frame' = m_ped.m_pFrames[PED_UPPERARMR].frame
  -- State update: matrix' = GetWorldMatrix(RwFrameGetParent(frame), RwMatrixCreate())
  -- State update: upVector.x' = matrix.right.z
  -- State update: upVector.y' = matrix.up.z
  -- Return postcondition: result! = result
  -- Invokes: m_ped->GetClump, CGeneral::LimitRadianAngle
  true
end

schema CPedIK_PointGunAtPosition
  ΔCPedIK
  position? : CVector
where
  -- State update: startPoint' = m_ped.GetPosition()
  -- State update: startPoint.x' = m_ped.GetPosition().x
  -- State update: startPoint.y' = m_ped.GetPosition().y
  -- State update: startPoint.z' = armPos.z
  -- Invokes: m_ped->GetWeapon, m_ped->GetPosition, CGeneral::GetRadianAngleBetweenPoints
  true
end

schema CPedIK_RestoreLookAt
