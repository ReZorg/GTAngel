schema CCivilianPed
  CPed  -- inherits base schema
  m_bLookForVacantCars : 𝔹
  m_nLookForVacantCarsCounter : ℕ
  m_bStealCarEvenIfThereIsSomeoneInIt : 𝔹
  m_bJustStoleACar : 𝔹
  m_nStealWishList : seq ℕ  -- bounded array [16]
  m_bAttractorUnk : 𝔹
  m_nAttractorCycleState : ℤ
where
  m_nLookForVacantCarsCounter ≥ 0
  #m_nStealWishList = 16
end

