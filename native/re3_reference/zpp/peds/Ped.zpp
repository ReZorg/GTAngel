  ANIM_WEAPON_CROUCHRELOAD : return
  ANIM_WEAPON_RELOAD : return
  m_pPathNodesStates : seq ADDRESS  -- bounded array [8]
  m_stPathNodeStates : seq CVector2D  -- bounded array [10]
  m_nPathNodes : ℕ
  m_nCurPathNode : ℤ
  m_victimOfPlayerCrime : Ref[CEntity]
  m_fleeFromPosX : ℝ
  m_fleeFromPosY : ℝ
  m_vecSeekPosEx : CVector
  m_distanceToCountSeekDoneEx : ℝ
  frame : Ref[RwFrame]
  bPedCheat2 : 𝔹
where
  #bIsStanding = 1
  #bWasStanding = 1
  #bIsAttacking = 1
  #bIsPointingGunAt = 1
  #bIsLooking = 1
  #bKeepTryingToLook = 1
  #bIsRestoringLook = 1
  #bIsAimingGun = 1
  #bIsRestoringGun = 1
  #bCanPointGunAtTarget = 1
  #bIsTalking = 1
  #bIsInTheAir = 1
  #bIsLanding = 1
  #bIsRunning = 1
  #bHitSomethingLastFrame = 1
  #bVehEnterDoorIsBlocked = 1
end

