schema CPed_SetObjectiveTimer
  ΔCPed
  time? : ℤ
where
  -- State update: m_objectiveTimer' = 0
  -- State update: m_objectiveTimer' = CTimer::GetTimeInMilliseconds() + time
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CPed_SetStoredObjective
  ΔCPed
where
  -- State update: m_prevObjective' = m_objective
  true
end

schema CPed_ForceStoredObjective
  ΔCPed
  objective? : eObjective
where
  -- State update: m_prevObjective' = m_objective
  -- State update: m_prevObjective' = m_objective
  true
end

schema CPed_IsTemporaryObjective
  ΔCPed
  objective? : eObjective
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPed_SetObjective
  ΔCPed
  newObj? : eObjective
where
  -- State update: bStartWanderPathOnFoot' = true
  -- State update: m_objective' = OBJECTIVE_NONE
  -- State update: m_prevObjective' = OBJECTIVE_NONE
  -- State update: m_prevObjective' = newObj
  -- State update: m_objective' = newObj
  -- State update: bObjectiveCompleted' = false
  true
end

