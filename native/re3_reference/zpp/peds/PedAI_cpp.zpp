  -- State update: m_pNextPathNode' = ∅
  -- Invokes: m_pedInObjective->RegisterReference, m_pedInObjective->CleanUpOldReference, m_pLookTarget->CleanUpOldReference, m_pLookTarget->RegisterReference, m_carInObjective->RegisterReference
  true
end

