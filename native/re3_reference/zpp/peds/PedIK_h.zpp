--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
LimbMoveStatus ::= ANGLES_SET_TO_MAX | ONE_ANGLE_COULDNT_BE_SET_EXACTLY | ANGLES_SET_EXACTLY

PedIK_Enum_2 ::= GUN_POINTED_SUCCESSFULLY | LOOKAROUND_HEAD_ONLY | AIMS_WITH_ARM
  -- val(GUN_POINTED_SUCCESSFULLY) = 1
  -- val(LOOKAROUND_HEAD_ONLY) = 2
  -- val(AIMS_WITH_ARM) = 4

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema LimbOrientation
  yaw : ℝ
  pitch : ℝ
where
  instance_addr ∈ ADDRESS
end

schema LimbMovementInfo
  maxYaw : ℝ
  minYaw : ℝ
  yawD : ℝ
  maxPitch : ℝ
  minPitch : ℝ
  pitchD : ℝ
where
  instance_addr ∈ ADDRESS
end

schema CPedIK
  m_ped : Ref[CPed_Const]
  m_headOrient : LimbOrientation
  m_torsoOrient : LimbOrientation
  m_upperArmOrient : LimbOrientation
  m_lowerArmOrient : LimbOrientation
  m_flags : ℤ
  ms_torsoInfo : LimbMovementInfo
  ms_headInfo : LimbMovementInfo
  ms_headRestoreInfo : LimbMovementInfo
  ms_upperArmInfo : LimbMovementInfo
  ms_lowerArmInfo : LimbMovementInfo
where
  #m_ped ≤ 1
end

schema CPedIK_CPedIK
  ΔCPedIK
  ped? : Ref[CPed]
where
  -- Declared member operation CPedIK::CPedIK(CPed *ped)
  true
end

