schema CAnimBlendHierarchy
  name : seq CHAR
  sequences : Ref[CAnimBlendSequence]
  numSequences : ℤ
  compressed : 𝔹
  keepCompressed : 𝔹
  totalLength : ℝ
  linkPtr : Ref[CLink_CAnimBlendHierarchy]
where
  #name = 24
  #sequences ≤ 1
  #linkPtr ≤ 1
end

schema CAnimBlendHierarchy_CAnimBlendHierarchy
  ΔCAnimBlendHierarchy
where
  -- Declared member operation CAnimBlendHierarchy::CAnimBlendHierarchy(void)
  true
end

