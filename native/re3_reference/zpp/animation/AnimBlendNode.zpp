schema CAnimBlendNode
  theta : ℝ
  invSin : ℝ
  frameA : ℤ
  frameB : ℤ
  remainingTime : ℝ
  sequence : Ref[CAnimBlendSequence]
  association : Ref[CAnimBlendAssociation]
where
  #sequence ≤ 1
  #association ≤ 1
end

schema CAnimBlendNode_Init
  ΔCAnimBlendNode
where
  -- Declared member operation CAnimBlendNode::Init(void)
  true
end

