schema CAnimManager_AddAnimation
  ΔCAnimManager
  clump? : Ref[RpClump]
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- State update: anim' = CreateAnimAssociation(groupId, animId)
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- State update: syncanim' = ∅
  -- State update: link' = clumpData.link.next
  -- State update: syncanim' = CAnimBlendAssociation::FromLink(link)
  -- Return postcondition: result! = anim
  -- Invokes: anim->IsMovement, CAnimBlendAssociation::FromLink, syncanim->IsMovement, anim->SyncAnimation, anim->Start
  true
end

schema CAnimManager_AddAnimationAndSync
  ΔCAnimManager
  clump? : Ref[RpClump]
  syncanim? : Ref[CAnimBlendAssociation]
  groupId? : AssocGroupId
  animId? : AnimationId
where
  -- State update: anim' = CreateAnimAssociation(groupId, animId)
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- Return postcondition: result! = anim
  -- Invokes: anim->IsMovement, anim->SyncAnimation, anim->Start, link.Prepend
  true
end

schema CAnimManager_BlendAnimation
  ΔCAnimManager
  clump? : Ref[RpClump]
  groupId? : AssocGroupId
  animId? : AnimationId
  delta? : ℝ
where
  -- State update: removePrevAnim' = 0
  -- State update: clumpData' = *RPANIMBLENDCLUMPDATA(clump)
  -- State update: anim' = GetAnimAssociation(groupId, animId)
  -- State update: isMovement' = anim.IsMovement()
  -- State update: isPartial' = anim.IsPartial()
  -- State update: movementAnim' = ∅
  -- Return postcondition: result! = found
  -- Return postcondition: result! = found
  -- Invokes: anim->IsMovement, anim->IsPartial, CAnimBlendAssociation::FromLink, found->IsRunning, found->Start
  true
end

