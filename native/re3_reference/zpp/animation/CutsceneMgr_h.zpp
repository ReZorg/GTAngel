--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: CutsceneMgr (animation)
-- Source File(s): animation/CutsceneMgr.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include CutsceneObject.zpp  (from "CutsceneObject.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
CUTSCENENAMESIZE : ℕ  -- #define CUTSCENENAMESIZE 8

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
CutsceneMgr_Enum_1 ::= CUTSCENE_NOT_LOADED | CUTSCENE_LOADING | CUTSCENE_LOADED
  -- val(CUTSCENE_NOT_LOADED) = 0

CutsceneMgr_Enum_2 ::= CUTSCENE_PLAYING_0 | CUTSCENE_STARTED | CUTSCENE_PLAYING_2 | CUTSCENE_PLAYING_3 | CUTSCENE_PLAYING_4
  -- val(CUTSCENE_PLAYING_0) = 0

CutsceneMgr_Enum_3 ::= NAMELENGTH | NUM_CUTS_PARTICLE_EFFECTS | NUM_CUTS_MAX_TEXTS | NUM_CUTS_UNCOMPRESSED_ANIMS | TEXT_KEY_SIZE | CUTSCENENAMESIZE
  -- val(NAMELENGTH) = 32
  -- val(NUM_CUTS_PARTICLE_EFFECTS) = 8
  -- val(NUM_CUTS_MAX_TEXTS) = 64
  -- val(NUM_CUTS_UNCOMPRESSED_ANIMS) = 8
  -- val(TEXT_KEY_SIZE) = 8
  -- val(CUTSCENENAMESIZE) = 8

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema sToHideItem
  z : ℝ
  name : seq CHAR
where
  instance_addr ∈ ADDRESS
end

schema sParticleEffect
  name : seq CHAR
  bPlayed : 𝔹
  iTime : ℤ
  unk1 : ℤ
  unk2 : ℤ
  name2 : seq CHAR
  x : ℝ
  y : ℝ
  z : ℝ
  unkX : ℝ
  unkY : ℝ
  unkZ : ℝ
  unk10 : 𝔹
  unk11 : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema sAttachInfo
  boneId : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CCutsceneMgr
  ms_running : 𝔹
  ms_pCutsceneObjects : seq Ref[CCutsceneObject]  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_numCutsceneObjs : ℤ
  ms_loaded : 𝔹
  ms_animLoaded : 𝔹
  ms_useLodMultiplier : 𝔹
  ms_cutsceneName : seq CHAR
  ms_cutsceneAssociations : CAnimBlendAssocGroup
  ms_cutsceneOffset : CVector
  ms_cutsceneTimer : ℝ
  ms_wasCutsceneSkipped : 𝔹
  ms_cutsceneProcessing : 𝔹
  ms_useCutsceneShadows : 𝔹
  ms_hasFileInfo : 𝔹
  ms_numLoadObjectNames : ℤ
  ms_numAppendObjectNames : ℤ
  ms_pCutsceneDir : Ref[CDirectory]
  ms_cutsceneLoadStatus : ℕ
  mCutsceneSkipFading : 𝔹
  mCutsceneSkipFadeTime : ℤ
  m_fPrevCarDensity : ℝ
  m_fPrevPedDensity : ℝ
  m_PrevExtraColourOn : 𝔹
  m_PrevExtraColour : ℕ
  ms_iNumParticleEffects : ℕ
  ms_pParticleEffects : seq sParticleEffect  -- bounded array [NUM_CUTS_PARTICLE_EFFECTS]
  ms_crToHideItems : seq sToHideItem  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_iNumHiddenEntities : ℕ
  ms_pHiddenEntities : seq Ref[CEntity]  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_numAttachObjectToBones : ℤ
  ms_bRepeatObject : seq 𝔹  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_iAttachObjectToBone : seq sAttachInfo  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_numUncompressedCutsceneAnims : ℕ
  ms_iTextDuration : seq ℕ  -- bounded array [NUM_CUTS_MAX_TEXTS]
  ms_iTextStartTime : seq ℕ  -- bounded array [NUM_CUTS_MAX_TEXTS]
  ms_currTextOutput : ℕ
  ms_numTextOutput : ℕ
  ms_iModelIndex : seq ℕ  -- bounded array [NUMCUTSCENEOBJECTS]
  ms_cutscenePlayStatus : ℕ
where
  #ms_pCutsceneDir ≤ 1
  ms_cutsceneLoadStatus ≥ 0
  m_PrevExtraColour ≥ 0
  ms_iNumParticleEffects ≥ 0
  ms_iNumHiddenEntities ≥ 0
  ms_numUncompressedCutsceneAnims ≥ 0
  ms_currTextOutput ≥ 0
  ms_numTextOutput ≥ 0
  ms_cutscenePlayStatus ≥ 0
end

