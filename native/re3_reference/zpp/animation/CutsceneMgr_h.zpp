--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CutsceneMgr_StartCutsceneProcessing
  ΔCutsceneMgrModuleState
where
  -- State update: ms_cutsceneProcessing' = true
  true
end

schema CutsceneMgr_IsRunning
  ΔCutsceneMgrModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = ms_running
  true
end

schema CutsceneMgr_HasLoaded
  ΔCutsceneMgrModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = ms_loaded
  true
end

schema CutsceneMgr_IsCutsceneProcessing
  ΔCutsceneMgrModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = ms_cutsceneProcessing
  true
end

schema CutsceneMgr_WasCutsceneSkipped
  ΔCutsceneMgrModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = ms_wasCutsceneSkipped
  true
end

schema CutsceneMgr_UseLodMultiplier
  ΔCutsceneMgrModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = ms_useLodMultiplier
  true
end

schema CutsceneMgr_GetCutsceneObject
  ΔCutsceneMgrModuleState
  id? : ℤ
  result! : Ref[CCutsceneObject]
where
  -- Return postcondition: result! = ms_pCutsceneObjects[id]
  true
end

schema CutsceneMgr_SetCutsceneOffset
  ΔCutsceneMgrModuleState
  vec? : CVector
where
  -- State update: ms_cutsceneOffset' = vec
  true
end

schema CutsceneMgr_DisableCutsceneShadows
  ΔCutsceneMgrModuleState
where
  -- State update: ms_useCutsceneShadows' = false
  true
end

schema CutsceneMgr_GetCutsceneTimeInMilleseconds
  ΔCutsceneMgrModuleState
  result! : ℤ
where
  -- Return postcondition: result! = 1000.0f * ms_cutsceneTimer
  true
end
