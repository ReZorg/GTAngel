--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CAnimBlock
  name : seq CHAR
  isLoaded : 𝔹
  refCount : ℤ
  firstIndex : ℤ
  numAnims : ℤ
where
  instance_addr ∈ ADDRESS
end

schema AnimAssocDesc
  animId : ℤ
  flags : ℤ
where
  instance_addr ∈ ADDRESS
end

schema AnimAssocDefinition
  name : seq CHAR
  blockName : seq CHAR
  modelIndex : ℤ
  numAnims : ℤ
  animNames : seq CHAR
  animDescs : Ref[AnimAssocDesc]
where
  #animDescs ≤ 1
end

schema CAnimManager
  ms_aAnimAssocDefinitions : seq AnimAssocDefinition  -- bounded array [NUM_ANIM_ASSOC_GROUPS]
  ms_aAnimBlocks : seq CAnimBlock  -- bounded array [NUMANIMBLOCKS]
  ms_aAnimations : seq CAnimBlendHierarchy  -- bounded array [NUMANIMATIONS]
  ms_numAnimBlocks : ℤ
  ms_numAnimations : ℤ
  ms_aAnimAssocGroups : Ref[CAnimBlendAssocGroup]
  ms_animCache : Ref[CLinkList_CAnimBlendHierarchy]
where
  #ms_aAnimAssocGroups ≤ 1
  #ms_animCache ≤ 1
end

schema CAnimManager_Initialise
  ΔCAnimManager
where
  -- Declared member operation CAnimManager::Initialise(void)
  true
end

