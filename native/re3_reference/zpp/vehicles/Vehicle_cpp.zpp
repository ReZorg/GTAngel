schema CVehicle_FlyingControl
  ΔCVehicle
  flightModel? : eFlightModel
where
  -- State update: moveSpeed' = m_vecMoveSpeed.Magnitude()
  -- State update: sideSpeed' = DotProduct(m_vecMoveSpeed, GetRight())
  -- State update: sideImpulse' = -1.0f * sideSpeed / moveSpeed
  -- State update: fwdSpeed' = DotProduct(m_vecMoveSpeed, GetForward())
  -- State update: magic' = m_vecMoveSpeed.MagnitudeSqr() * sq(fwdSpeed)
  -- State update: moveSpeed' = m_vecMoveSpeed.Magnitude()
  -- Invokes: m_vecMoveSpeed.Magnitude, m_vecMoveSpeed.MagnitudeSqr, CTimer::GetTimeStep, CPad::GetPad, m_vecTurnSpeed.MagnitudeSqr
  true
end

schema CVehicle_DoBladeCollision
