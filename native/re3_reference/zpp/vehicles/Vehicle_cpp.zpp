  matrix? : CMatrix
  rotorType? : ℤ
  damageMult? : ℝ
where
  -- State update: turnSpeed.z' = -ROTOR_TURN_SPEED
  -- State update: axis' = -matrix.GetUp()
  -- State update: turnSpeed.z' = ROTOR_TURN_SPEED
  -- State update: axis' = matrix.GetUp()
  -- State update: turnSpeed.y' = -ROTOR_TURN_SPEED
  -- State update: axis' = -matrix.GetForward()
  -- Return postcondition: result! = false
  -- Invokes: matrix.GetUp, matrix.GetForward, matrix.GetRight, CWorld::GetCurrentScanCode, entity->IsPed
  true
end

