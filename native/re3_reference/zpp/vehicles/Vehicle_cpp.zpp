--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
DAMAGE_FLEE_IN_CAR_PROBABILITY_VALUE : seq CHAR  -- #define DAMAGE_FLEE_IN_CAR_PROBABILITY_VALUE (MYRAND_MAX * 35 / 100)
DAMAGE_FLEE_ON_FOOT_PROBABILITY_VALUE : seq CHAR  -- #define DAMAGE_FLEE_ON_FOOT_PROBABILITY_VALUE (MYRAND_MAX * 70 / 100)
DAMAGE_HEALTH_TO_FLEE_ALWAYS : ℝ  -- #define DAMAGE_HEALTH_TO_FLEE_ALWAYS (200.0f)
DAMAGE_HEALTH_TO_CATCH_FIRE : ℝ  -- #define DAMAGE_HEALTH_TO_CATCH_FIRE (250.0f)
GLARE_MIN_DIST : ℝ  -- #define GLARE_MIN_DIST (13.0f)
GLARE_FULL_DIST : ℝ  -- #define GLARE_FULL_DIST (30.0f)
GLARE_MIN_ANGLE : ℝ  -- #define GLARE_MIN_ANGLE (0.99f)
GLARE_FULL_ANGLE : ℝ  -- #define GLARE_FULL_ANGLE (0.995f)

