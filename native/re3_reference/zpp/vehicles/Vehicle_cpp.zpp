  radius? : ℝ
  damageMult? : ℝ
where
  -- State update: min.z' = -ROTOR_SEMI_THICKNESS
  -- State update: max.z' = ROTOR_SEMI_THICKNESS
  -- State update: min.y' = -ROTOR_SEMI_THICKNESS
  -- State update: max.y' = ROTOR_SEMI_THICKNESS
  -- State update: min.x' = -ROTOR_SEMI_THICKNESS
  -- State update: max.x' = ROTOR_SEMI_THICKNESS
  -- Return postcondition: result! = hadCollision
  -- Invokes: boundingBox.Set, boundingSphere.Set, rotorColSphere.Set, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY
  true
end

schema CVehicle_BladeColSectorList
