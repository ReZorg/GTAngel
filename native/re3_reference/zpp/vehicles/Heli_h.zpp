--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Heli (vehicles)
-- Source File(s): vehicles/Heli.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Vehicle.zpp  (from "Vehicle.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eHeliNodes ::= HELI_CHASSIS | HELI_TOPROTOR | HELI_BACKROTOR | HELI_TAIL | HELI_TOPKNOT | HELI_SKID_LEFT | HELI_SKID_RIGHT | NUM_HELI_NODES
  -- val(HELI_CHASSIS) = 1

Heli_Enum_2 ::= HELI_RANDOM0 | HELI_RANDOM1 | HELI_SCRIPT | HELI_CATALINA | NUM_HELIS

Heli_Enum_3 ::= HELI_TYPE_RANDOM | HELI_TYPE_SCRIPT | HELI_TYPE_CATALINA

Heli_Enum_4 ::= HELI_RANDOM0 | HELI_RANDOM1 | HELI_SCRIPT | HELI_CATALINA | NUM_HELIS

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CHeli
  CVehicle  -- inherits base schema
  m_aHeliNodes : seq Ref[RwFrame]  -- bounded array [NUM_HELI_NODES]
  m_heliStatus : ℤ
  m_fSearchLightX : ℝ
  m_fSearchLightY : ℝ
  m_nExplosionTimer : ℕ
  m_fRotation : ℝ
  m_fAngularSpeed : ℝ
  m_fTargetZ : ℝ
  m_fSearchLightIntensity : ℝ
  m_nHeliId : ℤ
  m_heliType : ℤ
  m_pathState : ℤ
  m_numSwat : ℤ
  m_aSwatState : seq ℕ  -- bounded array [4]
  m_aSearchLightHistoryX : seq ℝ  -- bounded array [6]
  m_aSearchLightHistoryY : seq ℝ  -- bounded array [6]
  m_nSearchLightTimer : ℕ
  m_nShootTimer : ℕ
  m_nLastShotTime : ℕ
  m_nBulletDamage : ℕ
  m_fRotorRotation : ℝ
  m_fHeliDustZ : seq ℝ  -- bounded array [8]
  m_nPoliceShoutTimer : ℕ
  m_fTargetOffset : ℝ
  m_bTestRight : 𝔹
  pHelis : seq Ref[CHeli]  -- bounded array [NUM_HELIS]
  NumRandomHelis : ℤ
  TestForNewRandomHelisTimer : ℕ
  CatalinaHeliOn : 𝔹
  CatalinaHasBeenShotDown : 𝔹
  ScriptHeliOn : 𝔹
  NumScriptHelis : ℤ
where
  m_nExplosionTimer ≥ 0
  #m_aSwatState = 4
  #m_aSearchLightHistoryX = 6
  #m_aSearchLightHistoryY = 6
  m_nSearchLightTimer ≥ 0
  m_nShootTimer ≥ 0
  m_nLastShotTime ≥ 0
  m_nBulletDamage ≥ 0
  #m_fHeliDustZ = 8
  m_nPoliceShoutTimer ≥ 0
  TestForNewRandomHelisTimer ≥ 0
end

schema CHeli_CHeli
  ΔCHeli
  id? : ℤ
  CreatedBy? : ℕ
where
  -- Declared member operation CHeli::CHeli(int32 id, uint8 CreatedBy)
  true
end

