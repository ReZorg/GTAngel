--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CVehicle_CVehicle
  ΔCVehicle
  CreatedBy? : ℕ
where
  -- State update: m_fGasPedal' = 0.0f
  -- State update: m_fBrakePedal' = 0.0f
  -- State update: m_fWheelSpin' = 0.0f
  -- State update: bRewardVehicle' = false
  -- State update: m_vehLCS_29E' = 0
  -- State update: m_vehLCS_29C' = 0
  -- Invokes: CCarCtrl::UpdateCarCount, CGeneral::GetRandomNumberInRange, DMAudio.CreateEntity, DMAudio.SetEntityStatus, CGeneral::GetRandomNumber
  true
end

schema CVehicle_CVehicle_2
  ΔCVehicle
where
  -- State update: m_nAlarmState' = 0
  -- State update: m_audioEntityId' = -5
  -- State update: bIsAmbulanceOnDuty' = false
  -- State update: bIsFireTruckOnDuty' = false
  -- Invokes: DMAudio.DestroyEntity, CRadar::ClearBlipForEntity, CPools::GetVehiclePool, pDriver->FlagToDestroyWhenNextProcessed, m_pCarFire->Extinguish
  true
end

schema CVehicle_SetModelIndex
  ΔCVehicle
  id? : ℕ
where
  -- Invokes: CEntity::SetModelIndex, CVehicleModelInfo::GetMaximumNumberOfPassengersFromNumberOfDoors
  true
