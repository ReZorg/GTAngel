schema CVehicle_SetupLighting
  ΔCVehicle
where
  -- State update: coors' = GetPosition()
  -- State update: lighting' = CPointLights::GenerateLightsAffectingObject(&coors)
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: CPointLights::GenerateLightsAffectingObject
  true
end

schema CVehicle_RemoveLighting
  ΔCVehicle
  reset? : 𝔹
where
  -- Invokes: CRenderer::RemoveVehiclePedLights
  true
end

schema CVehicle_IsClearToDriveAway
  ΔCVehicle
where
  -- State update: length' = GetColModel().boundingBox.GetSize().y
  -- State update: ent' = ∅
  -- State update: front' = GetForward() * (length*0.5f + 3.0f)
  -- Invokes: boundingBox.GetSize, CWorld::ProcessLineOfSight
  true
end

schema CVehicle_GetHeightAboveRoad
  ΔCVehicle
where
  -- Return postcondition: result! = -1.0f * GetColModel()->boundingBox.min.z
  true
end

schema CVehicle_FlyingControl
  ΔCVehicle
  flightModel? : eFlightModel
where
  -- State update: moveSpeed' = m_vecMoveSpeed.Magnitude()
  -- State update: sideSpeed' = DotProduct(m_vecMoveSpeed, GetRight())
  -- State update: sideImpulse' = -1.0f * sideSpeed / moveSpeed
  -- State update: fwdSpeed' = DotProduct(m_vecMoveSpeed, GetForward())
  -- State update: magic' = m_vecMoveSpeed.MagnitudeSqr() * sq(fwdSpeed)
  -- State update: moveSpeed' = m_vecMoveSpeed.Magnitude()
  -- Invokes: m_vecMoveSpeed.Magnitude, m_vecMoveSpeed.MagnitudeSqr, CTimer::GetTimeStep, CPad::GetPad, m_vecTurnSpeed.MagnitudeSqr
  true
end

schema CVehicle_DoBladeCollision
  ΔCVehicle
  pos? : CVector
  matrix? : CMatrix
  rotorType? : ℤ
  radius? : ℝ
  damageMult? : ℝ
where
  -- State update: min.z' = -ROTOR_SEMI_THICKNESS
  -- State update: max.z' = ROTOR_SEMI_THICKNESS
  -- State update: min.y' = -ROTOR_SEMI_THICKNESS
  -- State update: max.y' = ROTOR_SEMI_THICKNESS
  -- State update: min.x' = -ROTOR_SEMI_THICKNESS
  -- State update: max.x' = ROTOR_SEMI_THICKNESS
  -- Return postcondition: result! = hadCollision
  -- Invokes: boundingBox.Set, boundingSphere.Set, rotorColSphere.Set, CWorld::GetSectorIndexX, CWorld::GetSectorIndexY
  true
end

schema CVehicle_BladeColSectorList
  ΔCVehicle
  list? : CPtrList
  rotorColModel? : CColModel
  matrix? : CMatrix
  rotorType? : ℤ
  damageMult? : ℝ
where
  -- State update: turnSpeed.z' = -ROTOR_TURN_SPEED
  -- State update: axis' = -matrix.GetUp()
  -- State update: turnSpeed.z' = ROTOR_TURN_SPEED
  -- State update: axis' = matrix.GetUp()
  -- State update: turnSpeed.y' = -ROTOR_TURN_SPEED
  -- State update: axis' = -matrix.GetForward()
  -- Return postcondition: result! = false
  -- Invokes: matrix.GetUp, matrix.GetForward, matrix.GetRight, CWorld::GetCurrentScanCode, entity->IsPed
  true
end

schema CVehicle_ProcessWheel
  ΔCVehicle
  wheelFwd? : CVector
  wheelRight? : CVector
  wheelContactSpeed? : CVector
  wheelContactPoint? : CVector
  wheelsOnGround? : ℤ
  thrust? : ℝ
  brake? : ℝ
  adhesion? : ℝ
  wheelId? : ℤ
  wheelSpeed? : ℙ ℝ
  wheelState? : Ref[tWheelState]
  wheelStatus? : ℕ
where
  -- State update: bAlreadySkidding' = false
  -- State update: bAlreadySkidding' = false
  -- State update: fwd' = 0.0f
  -- State update: right' = 0.0f
  -- State update: thrust' = 0.0f
  -- State update: contactSpeedFwd' = DotProduct(wheelContactSpeed, wheelFwd)
  -- Invokes: CTimer::GetTimeStep, CGeneral::GetRandomNumberInRange, pHandling->GetMass, CTimer::GetTimeStepFix, totalSpeed.Magnitude
