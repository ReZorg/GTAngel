--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CPlane_CPlane
  ΔCPlane
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlane_SetModelIndex
  ΔCPlane
  id? : ℕ
where
  -- Invokes: CVehicle::SetModelIndex, CClumpModelInfo::FillFrameArray
  true
end

schema CPlane_DeleteRwObject
  ΔCPlane
where
  -- State update: f' = RpAtomicGetFrame((RpAtomic*)m_rwObject)
  -- State update: m_rwObject' = ∅
  -- Invokes: CEntity::DeleteRwObject
  true
end

schema CPlane_ProcessControl
  ΔCPlane
where
  -- State update: frm' = CTimer::GetFrameCounter() - m_nFrameWhenHit
  -- State update: dir.x' = CGeneral::GetRandomNumberInRange(-2.0f, 2.0f)
  -- State update: dir.y' = CGeneral::GetRandomNumberInRange(-2.0f, 2.0f)
  -- State update: dir.z' = CGeneral::GetRandomNumberInRange(0.0f, 2.0f)
  -- State update: rotSpeed' = CGeneral::GetRandomNumberInRange(10, 30)
  -- State update: rotSpeed' = -rotSpeed
  -- Invokes: CTimer::GetFrameCounter, CExplosion::AddExplosion, CGeneral::GetRandomNumberInRange, CGeneral::GetRandomNumber, CParticle::AddParticle
  true
end

schema CPlane_PreRender
  ΔCPlane
where
  -- State update: lookVector' = GetPosition() - TheCamera.GetPosition()
  -- State update: camDist' = lookVector.Magnitude()
  -- State update: lookVector' = CVector(1.0f, 0.0f, 0.0f)
  -- State update: behindness' = DotProduct(lookVector, GetForward())
  -- State update: lightPos' = mi.m_positions[PLANE_POS_LIGHT_RIGHT]
  -- State update: lightR' = GetMatrix() * lightPos
  -- Invokes: CModelInfo::GetModelInfo, TheCamera.GetPosition, lookVector.Magnitude, CCoronas::RegisterCorona, CTimer::GetTimeInMilliseconds
  true
end

schema CPlane_Render
  ΔCPlane
where
  -- Invokes: CCutsceneMgr::IsRunning, CEntity::Render
  true
end

schema CPlane_RenderAllRemaning
  ΔCPlane
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlane_InitPlanes
  ΔCPlane
where
  -- State update: CesnaMissionStatus' = CESNA_STATUS_NONE
  -- State update: p.z' = colpoint.point.z
  -- State update: bOnGround' = true
  -- State update: bOnGround' = false
  -- State update: LandingPoint' = -1.0f
  -- State update: TakeOffPoint' = -1.0f
  -- Invokes: CWorld::ProcessVerticalLine, CStreaming::LoadAllRequestedModels, CStreaming::RequestModel, plane->GetMatrix, plane->SetStatus
  true
end

schema CPlane_Shutdown
  ΔCPlane
where
  -- State update: pPathNodes' = ∅
  -- State update: pPath2Nodes' = ∅
  -- State update: pPath3Nodes' = ∅
  -- State update: pPath4Nodes' = ∅
  true
end

schema CPlane_LoadPath
  ΔCPlane
  filename? : seq CHAR
  numNodes? : ℤ
  totalLength? : ℝ
  loop? : 𝔹
where
  -- State update: gString' = '\0'
  -- State update: lp' = 0
  -- State update: nodes' = new CPlaneNode[numNodes]
  -- State update: lp' = 0
  -- State update: totalLength' = 0.0f
  -- State update: t' = totalLength
  -- Return postcondition: result! = nodes
  -- Invokes: CFileMgr::LoadFile
  true
end

schema CPlane_UpdatePlanes
  ΔCPlane
where
  -- State update: time' = CTimer::GetTimeInMilliseconds()
  -- State update: t' = TotalDurationOfFlightPath * (float)(time & 0x7FFFF)/0x80000
  -- State update: deltaT' = t - aPlaneLineBits[j].time
  -- State update: time' = CTimer::GetTimeInMilliseconds()
  -- State update: t' = TotalDurationOfFlightPath2/0x80000
  -- State update: t' = TotalDurationOfFlightPath3/0x80000
  -- Invokes: CReplay::IsPlayingBack, CTimer::GetTimeInMilliseconds, CStreaming::HasModelLoaded, plane->GetMatrix, plane->SetStatus
  true
end

schema CPlane_RemoveTemporaryPlanes
  ΔCPlane
where
  -- State update: plane' = (CPlane*)CPools::GetVehiclePool().GetSlot(i)
  -- State update: bCesnasActivated' = false
  -- State update: bHelisActivated' = false
  -- Invokes: CPools::GetVehiclePool, plane->IsPlane, CWorld::Remove
  true
end

schema CPlane_TestRocketCollision
  ΔCPlane
  rocketPos? : Ref[CVector]
where
  -- State update: plane' = (CPlane*)CPools::GetVehiclePool().GetSlot(i)
  -- State update: plane.m_nFrameWhenHit' = CTimer::GetFrameCounter()
  -- State update: plane.m_bHasBeenHit' = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = false
  -- Invokes: CPools::GetVehiclePool, plane->GetModelIndex, plane->GetPosition, CTimer::GetFrameCounter, m_pWanted->RegisterCrime_Immediately
  true
end

