--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
CRUISE_SPEED : ℝ  -- #define CRUISE_SPEED (50.0f)
TAXI_SPEED : ℝ  -- #define TAXI_SPEED (5.0f)

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Plane_Enum_1 ::= CESNA_STATUS_NONE | CESNA_STATUS_FLYING | CESNA_STATUS_DESTROYED | CESNA_STATUS_LANDED

ePlaneNodes ::= PLANE_BACKROTOR | PLANE_WHEEL_READ | NUM_PLANE_NODES

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPlaneNode
  p : CVector
  t : ℝ
  bOnGround : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CPlaneInterpolationLine
  type : ℕ
  time : ℝ
  position : ℝ
  speed : ℝ
  acceleration : ℝ
where
  type ≥ 0
end

schema CPlane
  CVehicle  -- inherits base schema
  m_fRotorRotation : ℝ
  m_isFarAway : ℤ
  m_nCurPathNode : ℤ
  m_fSpeed : ℝ
  m_nFrameWhenHit : ℕ
  m_bHasBeenHit : 𝔹
  m_bIsDrugRunCesna : 𝔹
  m_bIsDropOffCesna : 𝔹
  m_bTempPlane : 𝔹
where
  m_nFrameWhenHit ≥ 0
end

