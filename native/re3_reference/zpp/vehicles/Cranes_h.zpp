--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
CraneState ::= IDLE | GOING_TOWARDS_TARGET | LIFTING_TARGET | GOING_TOWARDS_TARGET_ONLY_HEIGHT | ROTATING_TARGET | DROPPING_TARGET
  -- val(IDLE) = 0
  -- val(GOING_TOWARDS_TARGET) = 1
  -- val(LIFTING_TARGET) = 2
  -- val(GOING_TOWARDS_TARGET_ONLY_HEIGHT) = 3
  -- val(ROTATING_TARGET) = 4
  -- val(DROPPING_TARGET) = 5

CraneStatus ::= NONE | ACTIVATED | DEACTIVATED
  -- val(NONE) = 0
  -- val(ACTIVATED) = 1
  -- val(DEACTIVATED) = 2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CCrane
  m_pCraneEntity : Ref[CBuilding]
  m_pHook : Ref[CObject]
  m_nAudioEntity : ℤ
  m_fPickupX1 : ℝ
  m_fPickupX2 : ℝ
  m_fPickupY1 : ℝ
  m_fPickupY2 : ℝ
  m_vecDropoffTarget : CVector
  m_fDropoffHeading : ℝ
  m_fPickupAngle : ℝ
  m_fDropoffAngle : ℝ
  m_fPickupDistance : ℝ
  m_fDropoffDistance : ℝ
  m_fPickupHeight : ℝ
  m_fDropoffHeight : ℝ
  m_fHookAngle : ℝ
  m_fHookOffset : ℝ
  m_fHookHeight : ℝ
  m_vecHookInitPos : CVector
  m_vecHookCurPos : CVector
  m_vecHookVelocity : CVector2D
  m_pVehiclePickedUp : Ref[CVehicle]
  m_nTimeForNextCheck : ℕ
  m_nCraneStatus : ℕ
  m_nCraneState : ℕ
  m_nVehiclesCollected : ℕ
  m_bIsCrusher : 𝔹
  m_bIsMilitaryCrane : 𝔹
  m_bWasMilitaryCrane : 𝔹
  m_bIsTop : 𝔹
where
  #m_pCraneEntity ≤ 1
  #m_pHook ≤ 1
  #m_pVehiclePickedUp ≤ 1
  m_nTimeForNextCheck ≥ 0
  m_nCraneStatus ≥ 0
  m_nCraneState ≥ 0
  m_nVehiclesCollected ≥ 0
end

