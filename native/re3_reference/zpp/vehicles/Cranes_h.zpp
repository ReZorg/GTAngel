schema Cranes_GetHeightToPickupHeight
  ΔCranesModuleState
  result! : ℝ
where
  -- Return postcondition: result! = m_fPickupHeight + (m_bIsCrusher ? 7.0f : 4.0f)
  true
end

schema Cranes_GetHeightToDropoffHeight
  ΔCranesModuleState
  result! : ℝ
where
  -- Return postcondition: result! = m_fDropoffHeight + (m_bIsCrusher ? 7.0f : 2.0f)
