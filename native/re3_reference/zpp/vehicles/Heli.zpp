schema CHeli_GenerateHeli
  ΔCHeli
  catalina? : 𝔹
where
  -- State update: heli' = new CHeli(MI_ESCAPE, PERMANENT_VEHICLE)
  -- State update: heli' = new CHeli(MI_CHOPPER, PERMANENT_VEHICLE)
  -- State update: heliPos' = CVector(-224.0f, 201.0f, 83.0f)
  -- State update: heliPos' = FindPlayerCoors()
  -- State update: angle' = (float)(CGeneral::GetRandomNumber() & 0xFF)/0x100 * 6.28f
  -- State update: heliPos' = FindPlayerCoors()
  -- Return postcondition: result! = heli
  -- Invokes: CModelInfo::GetModelInfo, CGeneral::GetRandomNumber, heli->GetMatrix, heli->SetStatus, CWorld::Add
  true
end

schema CHeli_UpdateHelis
