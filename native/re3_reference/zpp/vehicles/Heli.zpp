  -- State update: frame' = RwFrameCreate()
  -- State update: atomic' = RpAtomicClone(atomic)
  -- State update: obj.bDontStream' = true
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Invokes: obj->SetModelIndexNoCreate, obj->RefModelInfo, CVisibilityPlugins::SetAtomicRenderCallback, obj->AttachToRwObject, obj->SetIsStatic
