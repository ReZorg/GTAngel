schema CHeli_TestRocketCollision
  ΔCHeli
  rocketPos? : Ref[CVector]
where
  -- State update: hit' = false
  -- State update: m_fAngularSpeed' = CGeneral::GetRandomTrueFalse() ? 0.05f : -0.05f
  -- State update: m_heliStatus' = HELI_STATUS_SHOT_DOWN
  -- State update: m_nExplosionTimer' = CTimer::GetTimeInMilliseconds() + 10000
  -- State update: hit' = true
  -- Return postcondition: result! = hit
  -- Invokes: CGeneral::GetRandomTrueFalse, CTimer::GetTimeInMilliseconds
  true
end

schema CHeli_TestBulletCollision
  ΔCHeli
  line0? : Ref[CVector]
  line1? : Ref[CVector]
  bulletPos? : Ref[CVector]
  damage? : ℤ
where
  -- State update: hit' = false
  -- State update: distToHeli' = (pHelis[i].GetPosition() - *line0).Magnitude()
  -- State update: line' = (*line1 - *line0)
  -- State update: lineLength' = line.Magnitude()
  -- State update: bulletPos' = *line0 + line*Max(1.0f, distToHeli-5.0f)/lineLength
  -- State update: m_fAngularSpeed' = CGeneral::GetRandomTrueFalse() ? 0.05f : -0.05f
  -- Return postcondition: result! = hit
  -- Invokes: CCollision::DistToLine, line.Magnitude, CGeneral::GetRandomTrueFalse, CTimer::GetTimeInMilliseconds
  true
end

