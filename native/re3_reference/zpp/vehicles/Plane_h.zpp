--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Plane (vehicles)
-- Source File(s): vehicles/Plane.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Vehicle.zpp  (from "Vehicle.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
ePlaneNodes ::= PLANE_BACKROTOR | PLANE_WHEEL_READ | NUM_PLANE_NODES

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CPlaneNode
  p : CVector
  t : ℝ
  bOnGround : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CPlaneInterpolationLine
  type : ℕ
  time : ℝ
  position : ℝ
  speed : ℝ
  acceleration : ℝ
where
  type ≥ 0
end

schema CPlane
  CVehicle  -- inherits base schema
  m_fRotorRotation : ℝ
  m_isFarAway : ℤ
  m_nCurPathNode : ℤ
  m_fSpeed : ℝ
  m_nFrameWhenHit : ℕ
  m_bHasBeenHit : 𝔹
  m_bIsDrugRunCesna : 𝔹
  m_bIsDropOffCesna : 𝔹
  m_bTempPlane : 𝔹
where
  m_nFrameWhenHit ≥ 0
end

schema CPlane_CPlane
  ΔCPlane
  id? : ℤ
  CreatedBy? : ℕ
where
  -- Declared member operation CPlane::CPlane(int32 id, uint8 CreatedBy)
  true
end

