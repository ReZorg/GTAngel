--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_DISTANCE_TO_FIND_CRANE : ℝ  -- #define MAX_DISTANCE_TO_FIND_CRANE (10.0f)
CRANE_UPDATE_RADIUS : ℝ  -- #define CRANE_UPDATE_RADIUS (300.0f)
CRANE_MOVEMENT_PROCESSING_RADIUS : ℝ  -- #define CRANE_MOVEMENT_PROCESSING_RADIUS (150.0f)
CRUSHER_Z : ℝ  -- #define CRUSHER_Z (-0.951f)
MILITARY_Z : ℝ  -- #define MILITARY_Z (10.7862f)
DISTANCE_FROM_PLAYER_TO_REMOVE_VEHICLE : ℝ  -- #define DISTANCE_FROM_PLAYER_TO_REMOVE_VEHICLE (5.0f)
DISTANCE_FROM_HOOK_TO_VEHICLE_TO_COLLECT : ℝ  -- #define DISTANCE_FROM_HOOK_TO_VEHICLE_TO_COLLECT (0.5f)
CAR_REWARD_MILITARY_CRANE : seq CHAR  -- #define CAR_REWARD_MILITARY_CRANE (1500)
CAR_MOVING_SPEED_THRESHOLD : ℝ  -- #define CAR_MOVING_SPEED_THRESHOLD (0.01f)
CRANE_SLOWDOWN_MULTIPLIER : ℝ  -- #define CRANE_SLOWDOWN_MULTIPLIER (0.3f)
OSCILLATION_SPEED : ℝ  -- #define OSCILLATION_SPEED (0.002f)
CAR_ROTATION_SPEED : ℝ  -- #define CAR_ROTATION_SPEED (0.0035f)
CRANE_MOVEMENT_SPEED : ℝ  -- #define CRANE_MOVEMENT_SPEED (0.001f)
HOOK_ANGLE_MOVEMENT_SPEED : ℝ  -- #define HOOK_ANGLE_MOVEMENT_SPEED (0.004f)
HOOK_OFFSET_MOVEMENT_SPEED : ℝ  -- #define HOOK_OFFSET_MOVEMENT_SPEED (0.1f)
HOOK_HEIGHT_MOVEMENT_SPEED : ℝ  -- #define HOOK_HEIGHT_MOVEMENT_SPEED (0.06f)
MESSAGE_SHOW_DURATION : seq CHAR  -- #define MESSAGE_SHOW_DURATION (4000)
MAX_DISTANCE : ℝ  -- #define MAX_DISTANCE (99999.9f)
MIN_VALID_POSITION : ℝ  -- #define MIN_VALID_POSITION (-10000.0f)
DEFAULT_OFFSET : ℝ  -- #define DEFAULT_OFFSET (20.0f)
CRANES_SAVE_SIZE : seq CHAR  -- #define CRANES_SAVE_SIZE 0x400

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
CraneState ::= IDLE | GOING_TOWARDS_TARGET | LIFTING_TARGET | GOING_TOWARDS_TARGET_ONLY_HEIGHT | ROTATING_TARGET | DROPPING_TARGET
  -- val(IDLE) = 0
  -- val(GOING_TOWARDS_TARGET) = 1
  -- val(LIFTING_TARGET) = 2
  -- val(GOING_TOWARDS_TARGET_ONLY_HEIGHT) = 3
  -- val(ROTATING_TARGET) = 4
  -- val(DROPPING_TARGET) = 5

CraneStatus ::= NONE | ACTIVATED | DEACTIVATED
  -- val(NONE) = 0
  -- val(ACTIVATED) = 1
  -- val(DEACTIVATED) = 2

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CCrane
  m_pCraneEntity : Ref[CBuilding]
  m_pHook : Ref[CObject]
  m_nAudioEntity : ℤ
  m_fPickupX1 : ℝ
  m_fPickupX2 : ℝ
  m_fPickupY1 : ℝ
  m_fPickupY2 : ℝ
  m_vecDropoffTarget : CVector
  m_fDropoffHeading : ℝ
  m_fPickupAngle : ℝ
  m_fDropoffAngle : ℝ
  m_fPickupDistance : ℝ
  m_fDropoffDistance : ℝ
  m_fPickupHeight : ℝ
  m_fDropoffHeight : ℝ
  m_fHookAngle : ℝ
  m_fHookOffset : ℝ
  m_fHookHeight : ℝ
  m_vecHookInitPos : CVector
  m_vecHookCurPos : CVector
  m_vecHookVelocity : CVector2D
  m_pVehiclePickedUp : Ref[CVehicle]
  m_nTimeForNextCheck : ℕ
  m_nCraneStatus : ℕ
  m_nCraneState : ℕ
  m_nVehiclesCollected : ℕ
  m_bIsCrusher : 𝔹
  m_bIsMilitaryCrane : 𝔹
  m_bWasMilitaryCrane : 𝔹
  m_bIsTop : 𝔹
where
  #m_pCraneEntity ≤ 1
  #m_pHook ≤ 1
  #m_pVehiclePickedUp ≤ 1
  m_nTimeForNextCheck ≥ 0
  m_nCraneStatus ≥ 0
  m_nCraneState ≥ 0
  m_nVehiclesCollected ≥ 0
end

