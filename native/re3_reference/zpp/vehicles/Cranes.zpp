--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CCranes_InitCranes
  ΔCCranes
where
  -- State update: CarsCollectedMilitaryCrane' = 0
  -- State update: NumCranes' = 0
  -- State update: pEntity' = (CEntity*)pNode.item
  -- State update: pNode' = CWorld::GetBigBuildingList(LEVEL_INDUSTRIAL).first
  -- State update: pEntity' = (CEntity*)pNode.item
  -- Invokes: CWorld::GetSector, pEntity->GetModelIndex, CWorld::GetBigBuildingList
  true
end

schema CCranes_AddThisOneCrane
  ΔCCranes
  pEntity? : Ref[CEntity]
where
  -- State update: pCrane' = &aCranes[NumCranes]
  -- State update: pCrane.m_pCraneEntity' = (CBuilding*)pEntity
  -- State update: pCrane.m_nCraneStatus' = CCrane::NONE
  -- State update: pCrane.m_fHookAngle' = NumCranes
  -- State update: pCrane.m_fHookOffset' = DEFAULT_OFFSET
  -- State update: pCrane.m_fHookHeight' = DEFAULT_OFFSET
  -- Invokes: pEntity->GetMatrix, pCrane->Init, DMAudio.CreateEntity, DMAudio.SetEntityStatus, pEntity->GetModelIndex
  true
end

schema CCranes_ActivateCrane
  ΔCCranes
  fInfX? : ℝ
  fSupX? : ℝ
  fInfY? : ℝ
  fSupY? : ℝ
  fDropOffX? : ℝ
  fDropOffY? : ℝ
  fDropOffZ? : ℝ
  fHeading? : ℝ
  bIsCrusher? : 𝔹
  bIsMilitary? : 𝔹
  fPosX? : ℝ
  fPosY? : ℝ
where
  -- State update: fMinDistance' = MAX_DISTANCE
  -- State update: Y' = fPosY
  -- State update: X' = fDropOffX
  -- State update: Y' = fDropOffY
  -- State update: index' = 0
  -- State update: fMinDistance' = distance
  -- Invokes: m_pCraneEntity->GetPosition, CWorld::FindGroundZForCoord, pCrane->FindParametersForTarget
  true
end

schema CCranes_DeActivateCrane
  ΔCCranes
  X? : ℝ
  Y? : ℝ
where
  -- State update: fMinDistance' = MAX_DISTANCE
  -- State update: index' = 0
  -- State update: fMinDistance' = distance
  -- State update: index' = i
  -- State update: m_nCraneStatus' = CCrane::DEACTIVATED
  -- State update: m_nCraneState' = CCrane::IDLE
  -- Invokes: m_pCraneEntity->GetPosition
  true
end

schema CCranes_IsThisCarPickedUp
  ΔCCranes
  X? : ℝ
  Y? : ℝ
  pVehicle? : Ref[CVehicle]
  result! : 𝔹
where
  -- State update: index' = 0
  -- Return postcondition: result! = result
  -- Invokes: m_pCraneEntity->GetPosition
  true
end

schema CCranes_UpdateCranes
  ΔCCranes
where
  -- Invokes: TheCamera.GetPosition, m_pCraneEntity->GetPosition
  true
end

schema CCrane_Update
  ΔCCrane
where
  -- State update: xstart' = Max(0, CWorld::GetSectorIndexX(m_fPickupX1))
  -- State update: xend' = Min(NUMSECTORS_X - 1, CWorld::GetSectorIndexX(m_fPickupX2))
  -- State update: ystart' = Max(0, CWorld::GetSectorIndexY(m_fPickupY1))
  -- State update: yend' = Min(NUMSECTORS_Y - 1, CWorld::GetSectorIndexY(m_fPickupY2))
  -- State update: xstart' = CWorld::GetSectorIndexX(m_fPickupX1)
  -- State update: xend' = CWorld::GetSectorIndexX(m_fPickupX2)
  -- Invokes: CReplay::IsPlayingBack, TheCamera.GetGameCamPosition, m_pCraneEntity->GetPosition, CTimer::GetTimeInMilliseconds, CWorld::AdvanceCurrentScanCode
  true
end

schema CCrane_RotateCarriedCarProperly
  ΔCCrane
  result! : 𝔹
where
  -- State update: fDeltaThisFrame' = CAR_ROTATION_SPEED * CTimer::GetTimeStep()
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  -- Invokes: CGeneral::GetATanOfXY, m_pVehiclePickedUp->GetForward, CTimer::GetTimeStep, m_pVehiclePickedUp->GetMatrix
  true
end

schema CCrane_FindCarInSectorList
  ΔCCrane
  pList? : Ref[CPtrList]
where
  -- State update: node' = pList.first
  -- State update: pVehicle' = (CVehicle*)node.item
  -- State update: pVehicle.m_scanCode' = CWorld::GetCurrentScanCode()
  -- State update: pVehicle.bCraneMessageDone' = true
  -- State update: m_pVehiclePickedUp' = pVehicle
  -- State update: m_nCraneState' = GOING_TOWARDS_TARGET
  -- Invokes: CWorld::GetCurrentScanCode, pVehicle->GetPosition, pVehicle->GetMoveSpeed, pVehicle->IsCar, pVehicle->GetStatus
  true
end

schema CCrane_DoesCranePickUpThisCarType
  ΔCCrane
  mi? : ℕ
  result! : 𝔹
where
  -- Return postcondition: result! = true
  true
end

schema CCranes_DoesMilitaryCraneHaveThisOneAlready
  ΔCCranes
  mi? : ℕ
  result! : 𝔹
where
  -- Return postcondition: result! = (CarsCollectedMilitaryCrane & 1)
  -- Return postcondition: result! = (CarsCollectedMilitaryCrane & 2)
  -- Return postcondition: result! = (CarsCollectedMilitaryCrane & 4)
  true
end

schema CCranes_RegisterCarForMilitaryCrane
  ΔCCranes
  mi? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CCranes_HaveAllCarsBeenCollectedByMilitaryCrane
  ΔCCranes
  result! : 𝔹
where
  -- Return postcondition: result! = (CarsCollectedMilitaryCrane & 0x7F) == 0x7F
  true
end

schema CCrane_GoTowardsTarget
  ΔCCrane
  fAngleToTarget? : ℝ
  fDistanceToTarget? : ℝ
  fTargetHeight? : ℝ
  fSpeedMultiplier? : ℝ
  result! : 𝔹
where
  -- State update: fHookAngleDelta' = fAngleToTarget - m_fHookAngle
  -- State update: m_fHookAngle' = fAngleToTarget
  -- State update: bAngleMovementFinished' = true
  -- State update: bAngleMovementFinished' = false
  -- State update: fHookOffsetDelta' = fDistanceToTarget - m_fHookOffset
  -- State update: m_fHookOffset' = fDistanceToTarget
  -- Invokes: CTimer::GetTimeStep
  true
end

schema CCrane_GoTowardsHeightTarget
  ΔCCrane
  fTargetHeight? : ℝ
  fSpeedMultiplier? : ℝ
  result! : 𝔹
where
  -- State update: fHookHeightDelta' = fTargetHeight - m_fHookHeight
  -- State update: m_fHookHeight' = fTargetHeight
  -- State update: bHeightMovementFinished' = true
  -- State update: bHeightMovementFinished' = false
  -- Return postcondition: result! = bHeightMovementFinished
  -- Invokes: CTimer::GetTimeStep
  true
end

schema CCrane_FindParametersForTarget
