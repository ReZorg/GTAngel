schema CStream
  m_aFilename : seq CHAR
  m_pAlSources : ℙ ℕ
  m_bPaused : 𝔹
  m_bActive : 𝔹
  m_fillBuffers : ℕ
  m_queueBuffers : ℕ
  m_bDoSeek : 𝔹
  m_SeekPos : ℕ
  m_bIExist : 𝔹
  m_bReset : 𝔹
  m_nVolume : ℕ
  m_nPan : ℕ
  m_nPosBeforeReset : ℕ
  m_nLoopCount : ℤ
  m_pSoundFile : Ref[IDecoder]
where
  #m_aFilename = 128
  #m_pAlSources ≤ 1
  m_fillBuffers ≥ 0
  m_queueBuffers ≥ 0
  m_SeekPos ≥ 0
  m_nVolume ≥ 0
  m_nPan ≥ 0
  m_nPosBeforeReset ≥ 0
  #m_pSoundFile ≤ 1
end

