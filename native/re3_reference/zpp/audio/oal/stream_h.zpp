--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema stream_IDecoder
  ΔstreamModuleState
  result! : ANY
where
  -- Deterministic transition preserving module invariants
  true
end

schema stream_GetAvgSamplesPerSec
  ΔstreamModuleState
  result! : ℕ
where
  -- Return postcondition: result! = GetChannels() * GetSampleRate()
  true
end

schema stream_ms2samples
  ΔstreamModuleState
  ms? : ℕ
  result! : ℕ
where
  -- Return postcondition: result! = float(ms) / 1000.0f * float(GetSampleRate())
  true
end

schema stream_samples2ms
  ΔstreamModuleState
  sm? : ℕ
  result! : ℕ
where
  -- Return postcondition: result! = float(sm) * 1000.0f / float(GetSampleRate())
  true
end

schema stream_GetBufferSamples
  ΔstreamModuleState
  result! : ℕ
where
  -- Return postcondition: result! = (GetAvgSamplesPerSec() / 4)
  true
end

schema stream_GetBufferSize
  ΔstreamModuleState
  result! : ℕ
where
  -- Return postcondition: result! = GetBufferSamples() * GetSampleSize()
  true
end

schema stream_GetLength
  ΔstreamModuleState
  result! : ℕ
where
  -- Return postcondition: result! = float(GetSampleCount()) * 1000.0f / float(GetSampleRate())
  true
end

schema stream_push
  ΔstreamModuleState
  value? : T
where
  -- Invokes: m_queue.push
  true
end

schema stream_peekPop
  ΔstreamModuleState
  retVal? : Ref[T]
  result! : 𝔹
where
  -- State update: retVal' = m_queue.front()
  -- Return postcondition: result! = false
  -- Return postcondition: result! = true
  -- Invokes: m_queue.front, m_queue.pop
  true
end

schema stream_swapNts
  ΔstreamModuleState
  replaceWith? : tsQueue_T
where
  -- State update: replaceWith.count' = count
  -- Invokes: m_queue.swap
  true
end

schema stream_emptyNts
  ΔstreamModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = count == 0
  true
end
