-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
aldlist_Enum_1 ::= ADEXT_EXT_CAPTURE | ADEXT_EXT_EFX | ADEXT_EXT_OFFSET | ADEXT_EXT_LINEAR_DISTANCE | ADEXT_EXT_EXPONENT_DISTANCE | ADEXT_EAX2 | ADEXT_EAX3 | ADEXT_EAX4 | ADEXT_EAX5 | ADEXT_EAX_RAM
