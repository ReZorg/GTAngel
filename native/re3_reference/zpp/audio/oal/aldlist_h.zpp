--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema aldlist_ALDEVICEINFO
  ΔaldlistModuleState
where
  -- State update: strDeviceName' = ∅
  true
end

schema aldlist_SetName
  ΔaldlistModuleState
  name? : seq CHAR
where
  -- State update: strDeviceName' = new char[strlen(name) + 1]
  true
end
