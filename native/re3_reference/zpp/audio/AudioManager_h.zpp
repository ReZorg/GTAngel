--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema AudioManager_cPedComments
  ΔAudioManagerModuleState
where
  -- State update: m_nLoadingTimeout' = -1
  -- State update: m_nActiveQueue' = 0
  true
end

schema AudioManager_cAudioScriptObjectManager
  ΔAudioManagerModuleState
where
  -- State update: m_nScriptObjectEntityTotal' = 0
  true
end

schema AudioManager_cAudioScriptObjectManager_2
  ΔAudioManagerModuleState
where
  -- State update: m_nScriptObjectEntityTotal' = 0
  true
end

schema AudioManager_cPedParams
  ΔAudioManagerModuleState
where
  -- State update: m_bDistanceCalculated' = false
  -- State update: m_fDistance' = 0.0f
  -- State update: m_pPed' = ∅
  true
end

schema AudioManager_cVehicleParams
  ΔAudioManagerModuleState
where
  -- State update: m_VehicleType' = -1
  -- State update: m_bDistanceCalculated' = false
  -- State update: m_fDistance' = 0.0f
  -- State update: m_pVehicle' = ∅
  -- State update: m_pTransmission' = ∅
  -- State update: m_nIndex' = 0
  true
end

schema AudioManager_Sqrt
  ΞAudioManagerModuleState
  v? : ℝ
  result! : ℝ
where
  -- Return postcondition: result! = v <= 0.0f ? 0.0f : ::Sqrt(v)
  true
end

schema AudioManager_IsMissionAudioSamplePlaying
  ΔAudioManagerModuleState
  result! : bool8
where
  -- Return postcondition: result! = m_nMissionAudioPlayStatus == PLAY_STATUS_PLAYING
  true
end

schema AudioManager_ShouldDuckMissionAudio
  ΔAudioManagerModuleState
  result! : bool8
where
  -- Return postcondition: result! = IsMissionAudioSamplePlaying()
  true
end
