sampman_Enum_2 ::= SFX_BANK_0 | CAR_SFX_BANKS_OFFSET | SFX_BANK_PACARD | SFX_BANK_PATHFINDER | SFX_BANK_PORSCHE | SFX_BANK_SPIDER | SFX_BANK_MERC | SFX_BANK_TRUCK | SFX_BANK_HOTROD | SFX_BANK_COBRA | SFX_BANK_NONE | SFX_BANK_PED_COMMENTS | MAX_SFX_BANKS | INVALID_SFX_BANK
  -- val(SFX_BANK_PACARD) = CAR_SFX_BANKS_OFFSET

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tSample
  nOffset : ℕ
  nSize : ℕ
  nFrequency : ℕ
  nLoopStart : ℕ
  nLoopEnd : ℤ
where
  nOffset ≥ 0
  nSize ≥ 0
  nFrequency ≥ 0
  nLoopStart ≥ 0
end

schema cSampleManager
  m_nEffectsVolume : ℕ
  m_nMusicVolume : ℕ
  m_nMP3BoostVolume : ℕ
  m_nEffectsFadeVolume : ℕ
  m_nMusicFadeVolume : ℕ
  m_nMonoMode : bool8
  m_szCDRomRootPath : seq CHAR
  m_bInitialised : bool8
  m_nNumberOfProviders : ℕ
  m_aAudioProviders : seq CHAR
  m_aSamples : seq tSample  -- bounded array [TOTAL_AUDIO_SAMPLES]
  m_MiscomPath : seq CHAR
  m_WavFilesPath : seq CHAR
  m_MP3FilesPath : seq CHAR
  m_aChannels : seq ADDRESS  -- bounded array [18]
where
  m_nEffectsVolume ≥ 0
  m_nMusicVolume ≥ 0
  m_nMP3BoostVolume ≥ 0
  m_nEffectsFadeVolume ≥ 0
  m_nMusicFadeVolume ≥ 0
  #m_szCDRomRootPath = 80
  m_nNumberOfProviders ≥ 0
  #m_MiscomPath = 260
  #m_WavFilesPath = 260
  #m_MP3FilesPath = 188
  #m_aChannels = 18
end

schema cSampleManager_cSampleManager
  ΔcSampleManager
where
  -- Declared member operation cSampleManager::cSampleManager(void)
  true
end

