--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
MAX_VOLUME : ℕ  -- #define MAX_VOLUME 127
MAX_FREQ : seq CHAR  -- #define MAX_FREQ DIGITALRATE
MAX_PEDSFX : ℕ  -- #define MAX_PEDSFX 7
PED_BLOCKSIZE : ℕ  -- #define PED_BLOCKSIZE 79000
MAXPROVIDERS : ℕ  -- #define MAXPROVIDERS 64
MAXCHANNELS : seq CHAR  -- #define MAXCHANNELS (NUM_CHANNELS_GENERIC+1)
MAXCHANNELS_SURROUND : seq CHAR  -- #define MAXCHANNELS_SURROUND (MAXCHANNELS-4)
MAX2DCHANNELS : ℕ  -- #define MAX2DCHANNELS 1
MAX_STREAMS : ℕ  -- #define MAX_STREAMS 3
DIGITALRATE : ℕ  -- #define DIGITALRATE 32000
DIGITALBITS : ℕ  -- #define DIGITALBITS 16
DIGITALCHANNELS : ℕ  -- #define DIGITALCHANNELS 2
MAX_DIGITAL_MIXER_CHANNELS : seq CHAR  -- #define MAX_DIGITAL_MIXER_CHANNELS (MAXCHANNELS+MAX_STREAMS*2+MAX2DCHANNELS)
MISSION_AUDIO_BLOCKSIZE : ℕ  -- #define MISSION_AUDIO_BLOCKSIZE 160000

