schema cAudioManager_ProcessReverb
  ΔcAudioManager
where
  -- State update: OldVolL' = 0
  -- State update: OldVolR' = 0
  -- State update: VolL' = Min(40, 3 * (20 - TheCamera.SoundDistLeft)) + 20
  -- State update: VolR' = Min(40, 3 * (20 - TheCamera.SoundDistRight)) + 20
  -- State update: VolUp' = 5 * (20 - TheCamera.SoundDistUp)
  -- State update: VolL' = Min(MAX_VOLUME, VolL + VolUp)
  -- Invokes: SampleManager.UpdateReverb, SampleManager.SetChannelReverbFlag
  true
end

schema cAudioManager_GetDistanceSquared
  ΔcAudioManager
  v? : CVector
where
  -- State update: c' = TheCamera.GetPosition()
  -- Return postcondition: result! = sq(v.x - c.x) + sq(v.y - c.y) + sq((v.z - c.z) * 0.2f)
  -- Invokes: TheCamera.GetPosition
  true
end

schema cAudioManager_CalculateDistance
  ΔcAudioManager
  distCalculated? : bool8
  dist? : ℝ
where
  -- State update: m_sQueueSample.m_fDistance' = Sqrt(dist)
  -- State update: distCalculated' = TRUE
  true
end

schema cAudioManager_FindVehicleOfPlayer
  ΔcAudioManager
where
  -- State update: vehicle' = FindPlayerVehicle()
  -- State update: ped' = FindPlayerPed()
  -- State update: attachedTo' = ped.m_attachedTo
  -- State update: vehicle' = (CVehicle*)attachedTo
  -- Return postcondition: result! = vehicle
  -- Invokes: attachedTo->IsVehicle
  true
end

