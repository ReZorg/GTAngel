  -- State update: modificator' = ABS(modificator)
  -- State update: Vol' = (REVERSE_GEAR_VOLUME * modificator)
  -- State update: m_sQueueSample.m_nCounter' = 61
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = TRUE
  -- Return postcondition: result! = FALSE
  -- Invokes: veh->GetModelIndex
  true
end

