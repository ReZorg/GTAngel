schema cAudioManager_ProcessVehicle
  ΔcAudioManager
  veh? : Ref[CVehicle]
where
  -- State update: m_sQueueSample.m_vecPos' = veh.GetPosition()
  -- State update: params.m_bDistanceCalculated' = FALSE
  -- State update: params.m_pVehicle' = veh
  -- State update: params.m_fDistance' = GetDistanceSquared(m_sQueueSample.m_vecPos)
  -- State update: params.m_nIndex' = veh.m_modelIndex - MI_FIRST_VEHICLE
  -- State update: params.m_fVelocityChange' = veh.AutoPilot.m_fMaxTrafficSpeed * 0.02f
  -- Invokes: veh->GetPosition, veh->GetStatus, veh->GetForward, veh->GetVehicleAppearance
  true
end

