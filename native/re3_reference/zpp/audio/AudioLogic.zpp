schema cAudioManager_ProcessRainOnVehicle
  ΔcAudioManager
  params? : cVehicleParams
where
  -- State update: veh' = params.m_pVehicle
  -- State update: veh.m_bRainAudioCounter' = 0
  -- State update: Vol' = RAIN_ON_VEHICLE_VOLUME * CWeather::Rain
  -- State update: m_sQueueSample.m_nCounter' = veh.m_bRainSamplesCounter++
  -- State update: veh.m_bRainSamplesCounter' = 68
  -- State update: m_sQueueSample.m_nSampleIndex' = (m_anRandomTable[1] & 3) + SFX_CAR_RAIN_1
  -- Invokes: CCullZones::CamNoRain, CCullZones::PlayerNoRain
  true
end

schema cAudioManager_ProcessReverseGear
