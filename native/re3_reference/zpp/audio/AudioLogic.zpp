where
  -- State update: m_nFireAudioEntity' = CreateEntity(AUDIOTYPE_FIRE, &gFireManager)
  -- State update: m_nCollisionEntity' = CreateEntity(AUDIOTYPE_COLLISION, (void *)1)
  -- State update: m_nFrontEndEntity' = CreateEntity(AUDIOTYPE_FRONTEND, (void *)1)
  -- State update: m_nProjectileEntity' = CreateEntity(AUDIOTYPE_PROJECTILE, (void *)1)
