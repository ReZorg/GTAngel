--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema tVehicleSampleData
  m_nAccelerationSampleIndex : eSfxSample
  m_nBank : ℕ
  m_nHornSample : eSfxSample
  m_nHornFrequency : ℤ
  m_nSirenOrAlarmSample : ℕ
  m_nSirenOrAlarmFrequency : ℤ
  m_bDoorType : ℕ
where
  m_nBank ≥ 0
  m_nSirenOrAlarmSample ≥ 0
  m_bDoorType ≥ 0
end

schema sToniReactions
  sfx : seq ℕ  -- bounded array [4]
  count : seq ℕ  -- bounded array [4]
where
  #sfx = 4
  #count = 4
end

schema MissionAudioData
  m_pName : seq CHAR
  m_nId : ℕ
where
  m_nId ≥ 0
end

schema tHelicopterSampleData
  m_fMaxDistance : ℝ
  m_fBaseDistance : ℝ
  m_bBaseVolume : ℕ
where
  m_bBaseVolume ≥ 0
end

