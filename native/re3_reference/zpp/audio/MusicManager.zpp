schema cMusicManager_cMusicManager
  ΔcMusicManager
where
  -- State update: m_bIsInitialised' = FALSE
  -- State update: m_bDisabled' = FALSE
  -- State update: m_nFrontendTrack' = NO_TRACK
  -- State update: m_nPlayingTrack' = NO_TRACK
  -- State update: m_nUpcomingMusicMode' = MUSICMODE_DISABLED
  -- State update: m_nMusicMode' = MUSICMODE_DISABLED
  true
end

schema cMusicManager_ResetMusicAfterReload
  ΔcMusicManager
where
  -- State update: m_bRadioSetByScript' = FALSE
  -- State update: m_nRadioStationScript' = WILDSTYLE
  -- State update: m_nRadioPosition' = -1
  -- State update: m_nAnnouncement' = NO_TRACK
  -- State update: m_bAnnouncementInProgress' = FALSE
  -- State update: m_bSetNextStation' = FALSE
  -- Invokes: CStats::GetFavoriteRadioStationList, CTimer::GetTimeInMillisecondsPauseMode
  true
end

