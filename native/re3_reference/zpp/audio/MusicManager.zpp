schema MusicManager_GetHeightScale
  ΔMusicManagerModuleState
where
  -- Return postcondition: result! = 1.0f - (TheCamera.GetPosition().z - 20.0f) / 30.0f
  -- Return postcondition: result! = 0.0f
  -- Return postcondition: result! = 1.0f
  -- Invokes: TheCamera.GetPosition
  true
end

schema cMusicManager_ComputeAmbienceVol
  ΔcMusicManager
  reset? : bool8
  outVolume? : ℕ
where
  -- State update: fVol' = 0.0f
  -- State update: fHeightScale' = GetHeightScale()
  -- State update: distToRiotSq' = (TheCamera.GetPosition() - vecRiotPosition).MagnitudeSqr()
  -- State update: fVol' = 0.0f
  -- State update: fVol' = Min(fVol, 60.0f)
  -- State update: outVolume' = fVol
  -- Invokes: TheCamera.GetPosition
  true
end

