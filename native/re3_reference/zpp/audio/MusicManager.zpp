  -- State update: pTm.tm_sec' = AudioManager.m_anRandomTable[0]
  -- State update: pTm.tm_min' = AudioManager.m_anRandomTable[1]
  -- State update: pTm.tm_hour' = AudioManager.m_anRandomTable[2]
  -- Invokes: SampleManager.GetStreamedFileLength, CTimer::GetTimeInMillisecondsPauseMode
  true
end

