schema ClumpRead_ClumpAtomicStreamRead
  ΔClumpReadModuleState
  stream? : Ref[RwStream]
  frmList? : Ref[rwFrameList]
  geomList? : Ref[rpGeometryList]
where
  -- State update: numberGeometrys' = 0
  -- State update: atomic' = RpAtomicCreate()
  -- State update: geom' = RpGeometryStreamRead(stream)
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  true
end

schema ClumpRead_RpClumpGtaStreamRead1
  ΔClumpReadModuleState
  stream? : Ref[RwStream]
where
  -- State update: streamPosition' = STREAMPOS(stream)
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  -- Return postcondition: result! = false
  true
end

schema ClumpRead_RpClumpGtaStreamRead2
  ΔClumpReadModuleState
  stream? : Ref[RwStream]
where
  -- State update: clump' = RpClumpCreate()
