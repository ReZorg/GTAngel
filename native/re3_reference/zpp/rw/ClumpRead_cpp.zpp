--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema rpGeometryList
  geometries : Ref[RpGeometry]
  numGeoms : ℤ
where
  #geometries ≤ 1
end

schema rpAtomicBinary
  frameIndex : ℤ
  geomIndex : ℤ
  flags : ℤ
  unused : ℤ
where
  instance_addr ∈ ADDRESS
end

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema ClumpRead_GeometryListStreamRead1
  ΔClumpReadModuleState
  stream? : Ref[RwStream]
  geomlist? : Ref[rpGeometryList]
where
  -- State update: numberGeometrys' = 0
  -- State update: numberGeometrys' = numGeoms/2
  -- State update: geomlist.numGeoms' = numGeoms
  -- State update: geomlist.geometries' = ∅
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
  true
end

schema ClumpRead_GeometryListStreamRead2
  ΔClumpReadModuleState
  stream? : Ref[RwStream]
  geomlist? : Ref[rpGeometryList]
where
  -- Return postcondition: result! = nil
  -- Return postcondition: result! = nil
