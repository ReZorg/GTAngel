schema CTxdStore_StartLoadTxd
  ΔCTxdStore
  slot? : ℤ
  stream? : Ref[RwStream]
where
  -- State update: def' = GetSlot(slot)
  -- State update: def.texDict' = RwTexDictionaryGtaStreamRead1(stream)
