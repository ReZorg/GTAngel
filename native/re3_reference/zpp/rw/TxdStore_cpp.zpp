schema CTxdStore_Initialise
  ΔCTxdStore
where
  -- State update: ms_pTxdPool' = new CPool<TxdDef,TxdDef>(TXDSTORESIZE, "TexDictionary")
  true
end

schema CTxdStore_Shutdown
  ΔCTxdStore
where
  -- Deterministic transition preserving module invariants
  true
end

schema CTxdStore_GameShutdown
  ΔCTxdStore
where
  -- State update: def' = GetSlot(i)
  true
end

schema CTxdStore_AddTxdSlot
  ΔCTxdStore
  name? : seq CHAR
where
  -- State update: def' = ms_pTxdPool.New()
  -- State update: def.texDict' = ∅
  -- State update: def.refCount' = 0
  -- State update: def.refCountGu' = 0
  -- Return postcondition: result! = ms_pTxdPool->GetJustIndex(def)
  -- Invokes: ms_pTxdPool->New, ms_pTxdPool->GetJustIndex
  true
end

schema CTxdStore_RemoveTxdSlot
  ΔCTxdStore
  slot? : ℤ
where
  -- State update: def' = GetSlot(slot)
  -- Invokes: ms_pTxdPool->Delete
  true
end

schema CTxdStore_FindTxdSlot
  ΔCTxdStore
