--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WITHD3D : seq CHAR  -- #define WITHD3D #include "common.h"

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema MatFXNothing
  pad : seq ℤ  -- bounded array [5]
  effect : ℤ
where
  #pad = 5
end

schema MatFXBump
  bumpFrame : Ref[RwFrame]
  bumpedTex : Ref[RwTexture]
  bumpTex : Ref[RwTexture]
  negBumpCoefficient : ℝ
  pad : ℤ
  effect : ℤ
where
  #bumpFrame ≤ 1
  #bumpedTex ≤ 1
  #bumpTex ≤ 1
end

schema MatFXEnv
  envFrame : Ref[RwFrame]
  envTex : Ref[RwTexture]
  envCoeff : ℝ
  envFBalpha : ℤ
  pad : ℤ
  effect : ℤ
where
  #envFrame ≤ 1
  #envTex ≤ 1
end

schema MatFXDual
  dualTex : Ref[RwTexture]
  srcBlend : ℤ
  dstBlend : ℤ
where
  #dualTex ≤ 1
end

schema MatFX
  b : MatFXBump
  e : MatFXEnv
  d : MatFXDual
  effects : ℤ
where
  instance_addr ∈ ADDRESS
end

