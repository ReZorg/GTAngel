schema CVarConsole_ModifyLeft
  ΔCVarConsole
where
  -- State update: entry' = m_aEntries[m_nCurEntry]
  -- State update: entry.pInt8Value' = entry.I8_max
  -- State update: entry.pInt8Value' = entry.I8_min
  -- State update: entry.pInt16Value' = entry.I16_max
  -- State update: entry.pInt16Value' = entry.I16_min
  -- State update: entry.pInt32Value' = entry.I32_max
  -- Invokes: entry.pCallback
  true
end

schema CVarConsole_ModifyRight
  ΔCVarConsole
where
  -- State update: entry' = m_aEntries[m_nCurEntry]
  -- State update: entry.pInt8Value' = entry.I8_min
  -- State update: entry.pInt8Value' = entry.I8_max
  -- State update: entry.pInt16Value' = entry.I16_min
  -- State update: entry.pInt16Value' = entry.I16_max
  -- State update: entry.pInt32Value' = entry.I32_min
  -- Invokes: entry.pCallback
  true
end

schema CVarConsole_Enter
  ΔCVarConsole
where
  -- State update: m_bIsOpen' = true
  true
end

schema CVarConsole_Exit
  ΔCVarConsole
where
  -- State update: m_bIsOpen' = false
  true
end

schema CVarConsole_Input
  ΔCVarConsole
where
  -- State update: m_nFirstEntryOnPage' = m_nCurEntry
  -- State update: m_nCurEntry' = m_nCountEntries - 1
  -- State update: m_nFirstEntryOnPage' = m_nCurEntry - 29
  -- State update: m_nCurEntry' = 0
  -- State update: m_nFirstEntryOnPage' = 0
  -- State update: m_nCurPage' = 1
  -- Invokes: CPad::GetPad
  true
end

schema CVarConsole_Process
  ΔCVarConsole
where
  -- Deterministic transition preserving module invariants
  true
end

schema CVarConsole_Open
  ΔCVarConsole
where
  -- Return postcondition: result! = m_bIsOpen
  true
end

schema CVarConsole_Check
  ΔCVarConsole
where
  -- Invokes: CPad::GetPad
  true
end

schema VarConsole_CVarConsole
  ΔVarConsoleModuleState
where
  -- Deterministic transition preserving module invariants
  true
end
