schema CVarConsoleEntry
  text : seq CHAR
  pInt8Value : ℙ ℤ
  pInt16Value : ℙ ℤ
  pInt32Value : ℙ ℤ
  pInt64Value : ℙ ℤ
  pUint8Value : ℙ ℕ
  pUint16Value : ℙ ℕ
  pUint32Value : ℙ ℕ
  pUint64Value : ℙ ℕ
  pFloatValue : ℙ ℝ
  pBoolValue : ℙ 𝔹
  I8_min : ℤ
  I16_min : ℤ
  I32_min : ℤ
  I64_min : ℤ
  F_min : ℝ
  bAllowExceedBounds : bool8
  VarType : ℕ
where
  #pInt8Value ≤ 1
  #pInt16Value ≤ 1
  #pInt32Value ≤ 1
  #pInt64Value ≤ 1
  #pUint8Value ≤ 1
  #pUint16Value ≤ 1
  #pUint32Value ≤ 1
  #pUint64Value ≤ 1
  #pFloatValue ≤ 1
  #pBoolValue ≤ 1
  VarType ≥ 0
end

schema CVarConsoleEntry_void
  ΔCVarConsoleEntry
  arg_1? : Ref[pCallback]
where
  -- Declared member operation CVarConsoleEntry::void(*pCallback)
  true
end

schema CVarConsole
  m_nCountEntries : ℤ
  m_bIsOpen : bool8
  m_nCurEntry : ℤ
  m_nFirstEntryOnPage : ℤ
  m_nCurPage : ℤ
  m_nNumPages : ℤ
  m_aEntries : seq CVarConsoleEntry  -- bounded array [91]
where
  #m_aEntries = 91
end

schema CVarConsole_CVarConsole
  ΔCVarConsole
  result! : ifdef_FIX_BUGS
where
  -- Declared member operation CVarConsole::CVarConsole()
  true
end

