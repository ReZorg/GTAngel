--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
BRIGHTLIGHTS_MAX_DIST : ℝ  -- #define BRIGHTLIGHTS_MAX_DIST (60.0f)
BRIGHTLIGHTS_FADE_DIST : ℝ  -- #define BRIGHTLIGHTS_FADE_DIST (45.0f)
CARLIGHTS_MAX_DIST : ℝ  -- #define CARLIGHTS_MAX_DIST (30.0f)
CARLIGHTS_FADE_DIST : ℝ  -- #define CARLIGHTS_FADE_DIST (15.0f)
MONEY_MESSAGE_LIFETIME_MS : ℕ  -- #define MONEY_MESSAGE_LIFETIME_MS 2000

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
SpecialFX_Enum_1 ::= MARKERTYPE_0 | MARKERTYPE_ARROW | MARKERTYPE_2 | MARKERTYPE_3 | MARKERTYPE_CYLINDER | NUMMARKERTYPES | MARKERTYPE_INVALID
  -- val(MARKERTYPE_0) = 0
  -- val(MARKERTYPE_INVALID) = 0x101

SpecialFX_Enum_2 ::= BRIGHTLIGHT_INVALID | BRIGHTLIGHT_TRAFFIC_GREEN | BRIGHTLIGHT_TRAFFIC_YELLOW | BRIGHTLIGHT_TRAFFIC_RED | BRIGHTLIGHT_FRONT_LONG | BRIGHTLIGHT_FRONT_SMALL | BRIGHTLIGHT_FRONT_BIG | BRIGHTLIGHT_FRONT_TALL | BRIGHTLIGHT_REAR_LONG | BRIGHTLIGHT_REAR_SMALL | BRIGHTLIGHT_REAR_BIG | BRIGHTLIGHT_REAR_TALL | BRIGHTLIGHT_SIREN | BRIGHTLIGHT_FRONT | BRIGHTLIGHT_REAR
  -- val(BRIGHTLIGHT_FRONT) = BRIGHTLIGHT_FRONT_LONG
  -- val(BRIGHTLIGHT_REAR) = BRIGHTLIGHT_REAR_LONG

SpecialFX_Enum_3 ::= SHINYTEXT_WALK | SHINYTEXT_FLAT
  -- val(SHINYTEXT_WALK) = 1

