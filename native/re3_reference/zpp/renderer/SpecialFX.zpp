schema CBulletTraces_Render
  ΔCBulletTraces
where
  -- State update: horizontalOffset' = aTraces[i].m_vecEndPos - aTraces[i].m_vecStartPos
  -- State update: start' = aTraces[i].m_vecStartPos
  -- State update: end' = aTraces[i].m_vecEndPos
  -- State update: absStartProj' = Abs(startProj)
  -- State update: absEndProj' = Abs(endProj)
  -- State update: absStartProj' = Abs(startProj)
  -- Invokes: CTimer::GetTimeInMilliseconds, horizontalOffset.Normalise, TheCamera.GetPosition, TheCamera.GetForward
  true
end

schema CBulletTraces_Update
  ΔCBulletTraces
where
  -- Deterministic transition preserving module invariants
  true
end

schema CBulletTrace_Update
  ΔCBulletTrace
where
  -- State update: m_bInUse' = false
  -- State update: diff' = m_vecCurrentPos - m_vecTargetPos
  -- State update: remaining' = diff.Magnitude()
  -- State update: m_vecCurrentPos' = m_vecTargetPos + (remaining - 0.8f) / remaining * diff
  -- State update: m_bInUse' = false
  -- State update: m_bInUse' = false
  -- Invokes: diff.Magnitude
  true
end

