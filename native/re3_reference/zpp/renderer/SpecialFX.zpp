  thickness? : ℝ
  lifeTime? : ℕ
  visibility? : ℕ
where
  -- State update: enabledCount' = 0
  -- State update: modifiedLifeTime' = lifeTime / 4
  -- State update: modifiedLifeTime' = lifeTime / 2
  -- State update: modifiedLifeTime' = lifeTime
  -- State update: nextSlot' = 0
  -- State update: m_vecStartPos' = *start
  -- Invokes: CTimer::GetTimeInMilliseconds, TheCamera.GetForward, TheCamera.GetPosition, TheCamera.GetUp, TheCamera.GetRight
