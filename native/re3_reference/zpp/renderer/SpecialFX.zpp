schema CSpecialFX_Init
  ΔCSpecialFX
where
  -- Invokes: CBulletTraces::Init, CMotionBlurStreaks::Init, CBrightLights::Init, CShinyTexts::Init, CMoneyMessages::Init
  true
end

schema CSpecialFX_AddWeaponStreak
  ΔCSpecialFX
  type? : ℤ
where
  -- State update: start' = matrix * CVector(0.02f, 0.05f, 0.07f)
  -- State update: end' = matrix * CVector(0.246f, 0.0325f, 0.796f)
  -- State update: start' = matrix * CVector(0.02f, 0.05f, 0.07f)
  -- State update: end' = matrix * CVector(-0.054f, 0.0325f, 0.796f)
  -- State update: start' = matrix * CVector(0.02f, 0.05f, 0.07f)
  -- State update: end' = matrix * CVector(0.096f, -0.0175f, 1.096f)
  -- Invokes: CMotionBlurStreaks::RegisterStreak
  true
end

schema SpecialFX_LookForBatCB
  ΔSpecialFXModuleState
  object? : Ref[RwObject]
  data? : ADDRESS
where
  -- State update: MatLTM' = CMatrix(RwFrameGetLTM(RpAtomicGetFrame((RpAtomic*)object)))
  -- State update: p1' = MatLTM * CVector(0.02f, 0.05f, 0.07f)
  -- State update: p2' = MatLTM * CVector(0.246f, 0.0325f, 0.796f)
  -- Return postcondition: result! = nil
  -- Invokes: CVisibilityPlugins::GetAtomicModelInfo, CMotionBlurStreaks::RegisterStreak
  true
end

