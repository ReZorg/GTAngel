schema CSpecialFX_Render2DFXs
  ΔCSpecialFX
where
  -- State update: posX' = CGeneral::GetRandomNumber() % (int32)SCREEN_WIDTH
  -- State update: posY' = CGeneral::GetRandomNumber() % (int32)SCREEN_HEIGHT
  -- State update: bSnapShotActive' = false
  -- State update: tmp' = (255 - 255 * CSpecialFX::SnapShotFrames / 10) * 0.65f
  -- Invokes: CFont::SetScale, CFont::SetJustifyOff, CFont::SetBackgroundOff, CFont::SetCentreSize, CFont::SetCentreOff
  true
end

