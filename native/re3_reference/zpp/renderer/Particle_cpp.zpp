schema CParticle_ReloadConfig
  ΔCParticle
where
  -- State update: m_pUnusedListHead' = gParticleArray
  -- State update: m_pNext' = ∅
  -- State update: m_pNext' = &gParticleArray[i + 1]
  -- State update: m_vecPosition' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_vecVelocity' = CVector(0.0f, 0.0f, 0.0f)
  -- State update: m_nTimeWhenWillBeDestroyed' = 0
  -- Invokes: mod_ParticleSystemManager.Initialise
  true
end

schema CParticle_Initialise
  ΔCParticle
where
  -- State update: randVal' = -1.0f
  -- State update: angle' = DEGTORAD(float(i) * float(360.0f / SIN_COS_TABLE_SIZE))
  -- State update: slot' = CTxdStore::FindTxdSlot("particle")
  -- State update: gpSmoke2Tex' = RwTextureRead("smokeII_3", ∅)
  -- State update: gpSmoke2Raster' = RwTextureGetRaster(gpSmoke2Tex)
  -- State update: gpRainDropTex' = RwTextureRead("raindrop4", ∅)
  -- Invokes: CParticleObject::Initialise, CTxdStore::FindTxdSlot, CTxdStore::PushCurrentTxd, CTxdStore::SetCurrentTxd, CTxdStore::PopCurrentTxd
  true
end

schema CParticle_Shutdown
  ΔCParticle
where
  -- State update: gpFlame1Tex' = ∅
  -- State update: gpFlame5Tex' = ∅
  -- State update: gpRainDropSmallTex' = ∅
  -- State update: gpBloodTex' = ∅
  -- State update: gpLeafTex' = ∅
  -- State update: gpCloudTex1' = ∅
  -- Invokes: CTxdStore::FindTxdSlot, CTxdStore::RemoveTxdSlot
  true
end

schema CParticle_AddParticlesAlongLine
  ΔCParticle
  type? : tParticleType
  vecStart? : CVector
  vecEnd? : CVector
  vecDir? : CVector
  fPower? : ℝ
  pEntity? : Ref[CEntity]
  fSize? : ℝ
  nRotationSpeed? : ℤ
  nRotation? : ℤ
  nCurFrame? : ℤ
  nLifeSpan? : ℤ
where
  -- State update: vecDist' = vecEnd - vecStart
  -- State update: fDist' = vecDist.Magnitude()
  -- State update: fSteps' = Max(fDist / fPower, 1.0f)
  -- State update: nSteps' = (int32)fSteps
  -- State update: vecStep' = vecDist * (1.0f / (float)nSteps)
  -- State update: vecPos' = float(i) * vecStep + vecStart
  -- Invokes: vecDist.Magnitude
  true
end

schema CParticle_AddParticlesAlongLine_2
  ΔCParticle
  type? : tParticleType
  vecStart? : CVector
  vecEnd? : CVector
  vecDir? : CVector
  fPower? : ℝ
  pEntity? : Ref[CEntity]
  fSize? : ℝ
  color? : RwRGBA
  nRotationSpeed? : ℤ
  nRotation? : ℤ
  nCurFrame? : ℤ
  nLifeSpan? : ℤ
where
  -- State update: vecDist' = vecEnd - vecStart
  -- State update: fDist' = vecDist.Magnitude()
  -- State update: fSteps' = Max(fDist / fPower, 1.0f)
  -- State update: nSteps' = (int32)fSteps
  -- State update: vecStep' = vecDist * (1.0f / (float)nSteps)
  -- State update: vecPos' = float(i) * vecStep + vecStart
  -- Invokes: vecDist.Magnitude
  true
end

schema CParticle_Update
  ΔCParticle
where
  -- State update: fFricDeccel50' = pow(0.50f, CTimer::GetTimeStep())
  -- State update: fFricDeccel80' = pow(0.80f, CTimer::GetTimeStep())
  -- State update: fFricDeccel90' = pow(0.90f, CTimer::GetTimeStep())
  -- State update: fFricDeccel95' = pow(0.95f, CTimer::GetTimeStep())
  -- State update: fFricDeccel96' = pow(0.96f, CTimer::GetTimeStep())
  -- State update: fFricDeccel99' = pow(0.99f, CTimer::GetTimeStep())
  -- Invokes: CTimer::GetIsPaused, CTimer::GetTimeStep, CParticleObject::UpdateAll, CGame::IsInInterior, vecMoveStep.Magnitude
  true
end

schema CParticle_Render
  ΔCParticle
where
  -- State update: flags' = DRAW_OPAQUE
  -- State update: prevFrame' = ∅
  -- State update: psystem' = &mod_ParticleSystemManager.m_aParticles[i]
  -- State update: particleBanned' = false
  -- State update: particle' = psystem.m_pParticles
  -- State update: frames' = psystem.m_ppRaster
  -- Invokes: CSprite::InitSpriteBuffer2D, CSprite::FlushSpriteBuffer, CDraw::GetNearClipZ, CSprite::GetFarScreenZ, CSprite::GetNearScreenZ
  true
end

schema CParticle_RemovePSystem
  ΔCParticle
  type? : tParticleType
where
  -- State update: psystemdata' = &mod_ParticleSystemManager.m_aParticles[type]
  -- State update: particle' = psystemdata.m_pParticles
  true
end

schema CParticle_RemoveParticle
  ΔCParticle
  pParticle? : Ref[CParticle]
  pPrevParticle? : Ref[CParticle]
  pPSystemData? : Ref[tParticleSystemData]
where
  -- State update: pPrevParticle.m_pNext' = pParticle.m_pNext
  -- State update: pPSystemData.m_pParticles' = pParticle.m_pNext
  -- State update: pParticle.m_pNext' = m_pUnusedListHead
  -- State update: m_pUnusedListHead' = pParticle
  true
end

