  true
end

schema CParticle_CalWindDir
  ΔCParticle
  vecDirIn? : Ref[CVector]
  vecDirOut? : Ref[CVector]
where
  -- State update: vecDirOut.x' = (Cos(128) * vecDirIn.x) + (Sin(128) * vecDirIn.y)
  true
end

