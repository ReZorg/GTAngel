schema CParticle_AddYardieDoorSmoke
  ΔCParticle
  vecPos? : CVector
  matMatrix? : CMatrix
where
  -- State update: vecBasePos' = matMatrix * (invMat * vecPos + CVector(0.0f, -1.0f, 0.5f))
  -- State update: pos' = vecBasePos
