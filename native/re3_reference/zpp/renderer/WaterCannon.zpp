-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
WATER_COLOR : ℕ  -- #define WATER_COLOR 255
WATERCANNONVERTS : ℕ  -- #define WATERCANNONVERTS 4
