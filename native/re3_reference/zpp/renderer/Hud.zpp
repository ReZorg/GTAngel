schema CHud_Draw
  ΔCHud
where
  -- State update: m_Wants_To_Draw_Hud' = !m_Wants_To_Draw_Hud
  -- State update: DrawCrossHair' = false
  -- State update: CrossHairHidesHud' = false
  -- State update: DrawCrossHairPC' = false
  -- State update: playerPed' = FindPlayerPed()
  -- State update: WeaponType' = playerPed.GetWeapon().m_eWeaponType
  -- Invokes: CPad::GetPad, CReplay::IsPlayingBack, playerPed->GetWeapon, CTimer::GetTimeInMilliseconds, CSprite::RenderOneXLUSprite
  true
end

schema CHud_DrawHealthBar
  ΔCHud
  value? : ℤ
where
  -- State update: m_ItemToFlash' = -1
