--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- AXIOMATIC CONSTANTS & MACROS
--------------------------------------------------------------------------------
FRAMECOUNTER : seq CHAR  -- #define FRAMECOUNTER CTimer::GetLogicalFrameCounter()
MONEY_X : ℝ  -- #define MONEY_X 100.0f
WEAPON_X : ℝ  -- #define WEAPON_X 91.0f
AMMO_X : ℝ  -- #define AMMO_X 59.0f
HEALTH_X : ℝ  -- #define HEALTH_X 100.0f
STARS_X : ℝ  -- #define STARS_X 49.0f
ZONE_Y : ℝ  -- #define ZONE_Y 61.0f
VEHICLE_Y : ℝ  -- #define VEHICLE_Y 81.0f
CLOCK_X : ℝ  -- #define CLOCK_X 101.0f
SUBS_Y : ℝ  -- #define SUBS_Y 83.0f
WASTEDBUSTED_Y : ℝ  -- #define WASTEDBUSTED_Y 122.0f
BIGMESSAGE_Y : ℝ  -- #define BIGMESSAGE_Y 80.0f
TIMER_RIGHT_OFFSET : ℝ  -- #define TIMER_RIGHT_OFFSET 34.0f
BIGMESSAGE_Y_OFFSET : ℝ  -- #define BIGMESSAGE_Y_OFFSET 18.0f
HELP_MSG_LENGTH : ℕ  -- #define HELP_MSG_LENGTH 256
HUD_TEXT_SCALE_X : ℝ  -- #define HUD_TEXT_SCALE_X 0.7f
HUD_TEXT_SCALE_Y : ℝ  -- #define HUD_TEXT_SCALE_Y 1.25f

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
eItems ::= ITEM_NONE | ITEM_ARMOUR | ITEM_HEALTH | ITEM_RADAR
  -- val(ITEM_NONE) = -1
  -- val(ITEM_ARMOUR) = 3
  -- val(ITEM_HEALTH) = 4
  -- val(ITEM_RADAR) = 8

DRAW_FADE_STATE ::= HUD_WANTED_FADING | HUD_ENERGY_FADING | HUD_SCORE_FADING | HUD_WEAPON_FADING
  -- val(HUD_WANTED_FADING) = 0

eFadeOperation ::= FADED_OUT | START_FADE_OUT | FADING_IN | FADING_OUT | FADE_DISABLED
  -- val(FADED_OUT) = 0
  -- val(FADE_DISABLED) = 5

eSprites ::= HUD_FIST | HUD_SITEROCKET | HUD_RADARDISC | HUD_BAR_INSIDE1DARK | HUD_BAR_INSIDE2DARK | HUD_HUDNUMBERS | HUD_BAR_INSIDE1 | HUD_BAR_INSIDE2 | HUD_BAR_OUTLINE | HUD_SITESNIPER | HUD_SITEM16 | HUD_SITELASER | HUD_LASERDOT | HUD_VIEWFINDER | HUD_BLEEDER | NUM_HUD_SPRITES | HUD_BAT | HUD_PISTOL | HUD_UZI | HUD_SHOTGUN | HUD_AK47 | HUD_M16 | HUD_SNIPER | HUD_ROCKET | HUD_FLAME | HUD_MOLOTOV | HUD_GRENADE | HUD_DETONATOR | HUD_PAGER
  -- val(HUD_SITEROCKET) = 41
  -- val(HUD_RADARDISC) = 50
  -- val(HUD_BAR_INSIDE1DARK) = 57
  -- val(NUM_HUD_SPRITES) = 70

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CHud
  Sprites : seq CSprite2d  -- bounded array [NUM_HUD_SPRITES]
  m_HelpMessage : seq CHAR
  m_LastHelpMessage : seq CHAR
  m_HelpMessageState : ℕ
  m_HelpMessageTimer : ℕ
  m_HelpMessageFadeTimer : ℤ
  m_HelpMessageToPrint : seq CHAR
  m_HelpMessageDisplayTime : ℝ
  m_HelpMessageDisplayForever : 𝔹
  m_HelpMessageQuick : 𝔹
  m_ZoneState : ℕ
  m_ZoneFadeTimer : ℤ
  m_ZoneNameTimer : ℕ
  m_pZoneName : seq CHAR
  m_pLastZoneName : seq CHAR
  m_ZoneToPrint : seq CHAR
  m_VehicleName : seq CHAR
  m_pLastVehicleName : seq CHAR
  m_pVehicleNameToPrint : seq CHAR
  m_VehicleState : ℕ
  m_VehicleFadeTimer : ℤ
  m_VehicleNameTimer : ℕ
  m_Message : seq CHAR
  m_PagerMessage : seq CHAR
  m_Wants_To_Draw_Hud : 𝔹
  m_Wants_To_Draw_3dMarkers : 𝔹
  m_ItemToFlash : ℤ
  m_HideRadar : 𝔹
  m_ClockState : ℤ
  BigMessageAlpha : seq ℝ  -- bounded array [6]
  BigMessageX : seq ℝ  -- bounded array [6]
  OddJob2OffTimer : ℝ
  CounterOnLastFrame : seq 𝔹  -- bounded array [NUMONSCREENCOUNTERS]
  OddJob2XOffset : ℝ
  CounterFlashTimer : seq ℕ  -- bounded array [NUMONSCREENCOUNTERS]
  OddJob2Timer : ℕ
  TimerOnLastFrame : 𝔹
  OddJob2On : ℤ
  TimerFlashTimer : ℕ
  PagerSoundPlayed : ℤ
  SpriteBrightness : ℤ
  PagerXOffset : ℝ
  PagerTimer : ℤ
  PagerOn : ℤ
  m_WantedFadeTimer : ℕ
  m_WantedState : ℕ
  m_WantedTimer : ℕ
  m_EnergyLostFadeTimer : ℕ
  m_EnergyLostState : ℕ
  m_EnergyLostTimer : ℕ
  m_DisplayScoreFadeTimer : ℕ
  m_DisplayScoreState : ℕ
  m_DisplayScoreTimer : ℕ
  m_WeaponFadeTimer : ℕ
  m_WeaponState : ℕ
  m_WeaponTimer : ℕ
  m_LastDisplayScore : ℕ
  m_LastWanted : ℕ
  m_LastWeapon : ℕ
  m_LastTimeEnergyLost : ℕ
  gLastPrintForeverString : seq CHAR
  m_HudAlpha : ℕ
  BigMessageInUse : seq ℝ  -- bounded array [6]
  m_pVehicleName : seq CHAR
where
  m_HelpMessageState ≥ 0
  m_HelpMessageTimer ≥ 0
  m_ZoneState ≥ 0
  m_ZoneNameTimer ≥ 0
  m_VehicleState ≥ 0
  m_VehicleNameTimer ≥ 0
  #m_Message = 256
  #m_PagerMessage = 256
  #BigMessageAlpha = 6
  #BigMessageX = 6
  OddJob2Timer ≥ 0
  TimerFlashTimer ≥ 0
  m_WantedFadeTimer ≥ 0
  m_WantedState ≥ 0
  m_WantedTimer ≥ 0
  m_EnergyLostFadeTimer ≥ 0
end

