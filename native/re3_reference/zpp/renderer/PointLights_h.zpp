  radius? : ℝ
  red? : ℝ
  green? : ℝ
  blue? : ℝ
  fogType? : ℕ
  castExtraShadows? : 𝔹
where
  -- Declared member operation CPointLights::AddLight(uint8 type, CVector coors, CVector dir, float radius, float red, float green, float blue, uint8 fogType, bool castExtraShadows)
  true
end

