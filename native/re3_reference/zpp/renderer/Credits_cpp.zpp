[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CCredits_Init
  ΔCCredits
where
  -- Deterministic transition preserving module invariants
  true
end

schema CCredits_Start
  ΔCCredits
where
  -- State update: bCreditsGoing' = true
  -- State update: CreditsStartTime' = CTimer::GetTimeInMilliseconds()
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CCredits_Stop
  ΔCCredits
where
  -- State update: bCreditsGoing' = false
  true
end

schema CCredits_PrintCreditSpace
  ΔCCredits
  space? : ℝ
  line? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CCredits_PrintCreditText
  ΔCCredits
  scaleX? : ℝ
  scaleY? : ℝ
  text? : seq CHAR
  lineoffset? : ℕ
  scrolloffset? : ℝ
where
  -- State update: bCreditsGoing' = false
  -- State update: start' = DEFAULT_SCREEN_HEIGHT + 20.0f
  -- State update: y' = lineoffset + start - scrolloffset
  -- Invokes: CPad::UpdatePads, CPad::GetPad, CFont::SetScale, CFont::SetColor, CFont::PrintString
  true
end

schema CCredits_Render
  ΔCCredits
where
  -- State update: lineoffset' = 0
  -- State update: bCreditsGoing' = false
  -- Invokes: CTimer::GetTimeInMilliseconds, CFont::SetJustifyOff, CFont::SetBackgroundOff, CFont::SetCentreSize, CFont::SetCentreOn
  true
end

schema CCredits_AreCreditsDone
  ΔCCredits
  result! : 𝔹
where
  -- Return postcondition: result! = !bCreditsGoing
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema CreditsModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 837
end
