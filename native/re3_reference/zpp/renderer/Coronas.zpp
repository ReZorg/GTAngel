schema CRegisteredCorona_Update
  ΔCRegisteredCorona
where
  -- State update: alpha' = 0
  -- State update: fadeAlpha' = Max(fadeAlpha - 15.0f*CTimer::GetTimeStep(), 0.0f)
  -- State update: fadeAlpha' = Max(fadeAlpha - 15.0f*CTimer::GetTimeStep(), 0.0f)
  -- State update: fadeAlpha' = Min(fadeAlpha + 15.0f*CTimer::GetTimeStep(), alpha)
  -- State update: fadeAlpha' = alpha
  -- State update: fadeAlpha' = Max(fadeAlpha - 15.0f*CTimer::GetTimeStep(), alpha)
  -- Invokes: CWorld::GetIsLineOfSightClear, TheCamera.GetPosition, CTimer::GetTimeStep
  true
end

