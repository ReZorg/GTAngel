--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Coronas_Enum_1 ::= SUN_CORE | SUN_CORONA
  -- val(SUN_CORE) = 1

Coronas_Enum_2 ::= TYPE_STAR | TYPE_NORMAL | TYPE_MOON | TYPE_REFLECT | TYPE_HEADLIGHT | TYPE_HEX | TYPE_CIRCLE | TYPE_RING | TYPE_STREAK

Coronas_Enum_3 ::= FLARE_NONE | FLARE_SUN | FLARE_HEADLIGHTS

Coronas_Enum_4 ::= REFLECTION_OFF | REFLECTION_ON

Coronas_Enum_5 ::= LOSCHECK_OFF | LOSCHECK_ON

Coronas_Enum_6 ::= STREAK_OFF | STREAK_ON

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema FlareDef
  position : ℝ
  size : ℝ
  red : ℤ
  green : ℤ
  blue : ℤ
  alpha : ℤ
  texture : ℤ
where
  instance_addr ∈ ADDRESS
end

schema CRegisteredCorona
  coors : CVector
  id : ℕ
  lastLOScheck : ℕ
  texture : Ref[RwTexture]
  size : ℝ
  someAngle : ℝ
  drawDist : ℝ
  nearDist : ℝ
  heightAboveRoad : ℝ
  red : ℕ
  green : ℕ
  blue : ℕ
  alpha : ℕ
  fadeAlpha : ℕ
  registeredThisFrame : 𝔹
  flareType : ℤ
  reflection : ℤ
  LOScheck : 𝔹
  offScreen : 𝔹
  firstUpdate : 𝔹
  drawStreak : 𝔹
  sightClear : 𝔹
  useNearDist : 𝔹
  renderReflection : 𝔹
  prevX : seq ℤ  -- bounded array [6]
  prevY : seq ℤ  -- bounded array [6]
  prevRed : seq ℕ  -- bounded array [6]
  prevGreen : seq ℕ  -- bounded array [6]
  prevBlue : seq ℕ  -- bounded array [6]
  hasValue : seq 𝔹  -- bounded array [6]
where
  id ≥ 0
  lastLOScheck ≥ 0
  #texture ≤ 1
  red ≥ 0
  green ≥ 0
  blue ≥ 0
  alpha ≥ 0
  fadeAlpha ≥ 0
  #LOScheck = 1
  #offScreen = 1
  #firstUpdate = 1
  #drawStreak = 1
  #sightClear = 1
  #useNearDist = 1
  #renderReflection = 1
  #prevX = 6
end

schema CRegisteredCorona_Update
  ΔCRegisteredCorona
where
  -- Declared member operation CRegisteredCorona::Update(void)
  true
end

schema CCoronas
  aCoronas : seq CRegisteredCorona  -- bounded array [NUMCORONAS]
  LightsMult : ℝ
  SunScreenY : ℝ
  SunScreenX : ℝ
  MoonSize : ℤ
  SunBlockedByClouds : 𝔹
  bChangeBrightnessImmediately : ℤ
  bSmallMoon : 𝔹
where
  instance_addr ∈ ADDRESS
end

schema CCoronas_Init
  ΔCCoronas
where
  -- Declared member operation CCoronas::Init(void)
  true
end

