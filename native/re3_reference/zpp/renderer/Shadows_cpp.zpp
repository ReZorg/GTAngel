schema CStaticShadow_Free
  ΔCStaticShadow
where
  -- State update: pFree' = CShadows::pEmptyBunchList
  -- State update: pEmptyBunchList' = m_pPolyBunch
  -- State update: pUsed' = m_pPolyBunch
  -- State update: pUsed' = pUsed.m_pNext
  -- State update: pUsed.m_pNext' = pFree
  -- State update: m_pPolyBunch' = ∅
  true
end

schema CShadows_CalcPedShadowValues
  ΔCShadows
  vecLightDir? : CVector
  pfFrontX? : ℙ ℝ
  pfFrontY? : ℙ ℝ
  pfSideX? : ℙ ℝ
  pfSideY? : ℙ ℝ
  pfDisplacementX? : ℙ ℝ
  pfDisplacementY? : ℙ ℝ
where
  -- State update: pfFrontX' = -vecLightDir.x
  -- State update: pfFrontY' = -vecLightDir.y
  -- State update: fDist' = Sqrt(*pfFrontY * *pfFrontY + *pfFrontX * *pfFrontX)
  -- State update: fMult' = (fDist + 1.0f) / fDist
  -- State update: pfSideX' = -vecLightDir.y / fDist
  -- State update: pfSideY' = vecLightDir.x / fDist
  true
end

schema CShadows_RenderExtraPlayerShadows
  ΔCShadows
where
  -- State update: pCar' = FindPlayerVehicle()
