  -- State update: nIntensity' = (int32)(nIntensity * fMult)
  -- State update: nRed' = (int32)(nRed       * fMult)
  -- State update: nGreen' = (int32)(nGreen     * fMult)
  -- State update: nBlue' = (int32)(nBlue      * fMult)
  -- Return postcondition: result! = true
  -- Return postcondition: result! = true
  -- Return postcondition: result! = aStaticShadows[nSlot].m_pPolyBunch != nil
  -- Invokes: TheCamera.GetPosition, CTimer::GetTimeInMilliseconds
  true
end

