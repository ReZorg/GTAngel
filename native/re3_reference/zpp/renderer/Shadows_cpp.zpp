schema _ProjectionParam
  at : RwV3d
  invMatrix : RwMatrix
  shadowValue : ℕ
  fade : 𝔹
  numIm3DBatch : ℕ
  entityMatrix : RwMatrix
where
  shadowValue ≥ 0
  numIm3DBatch ≥ 0
end

