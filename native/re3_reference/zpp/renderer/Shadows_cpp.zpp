  -- State update: Xaxis' = { 1.0f, 0.0f, 0.0f }
  -- State update: proj.at' = mat.at
  -- State update: radius' = RwCameraGetViewWindow(shadow.GetRwCamera()).x
  -- Invokes: pShadow->GetShadowCamera, pEntity->GetColModel, CCollision::CalculateTrianglePlanes, shadow->GetRwCamera, pEntity->GetMatrix
  true
end

