--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: Font (renderer)
-- Source File(s): renderer/Font.h
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include Sprite2d.zpp  (from "Sprite2d.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- FREE TYPES & ENUMERATIONS
--------------------------------------------------------------------------------
Font_Enum_1 ::= FONT_BANK | FONT_STANDARD | FONT_HEADING | MAX_FONTS

Font_Enum_2 ::= ALIGN_LEFT | ALIGN_CENTER | ALIGN_RIGHT

Font_Enum_3 ::= FONT_LANGSET_EFIGS | FONT_LANGSET_RUSSIAN | FONT_LANGSET_POLISH | FONT_LANGSET_JAPANESE | LANGSET_MAX

Font_Enum_4 ::= BUTTON_NONE | BUTTON_UP | BUTTON_DOWN | BUTTON_LEFT | BUTTON_RIGHT | BUTTON_CROSS | BUTTON_CIRCLE | BUTTON_SQUARE | BUTTON_TRIANGLE | BUTTON_L1 | BUTTON_L2 | BUTTON_L3 | BUTTON_R1 | BUTTON_R2 | BUTTON_R3 | BUTTON_RSTICK_UP | BUTTON_RSTICK_DOWN | BUTTON_RSTICK_LEFT | BUTTON_RSTICK_RIGHT | MAX_BUTTON_ICONS
  -- val(BUTTON_NONE) = -1

Font_Enum_5 ::= FONT_BANK | FONT_STANDARD | FONT_HEADING

Font_Enum_6 ::= FONT_BANK | FONT_PAGER | FONT_HEADING

Font_Enum_7 ::= BUTTON_NONE | BUTTON_DOWN | BUTTON_LEFT | BUTTON_RIGHT | BUTTON_CIRCLE | BUTTON_SQUARE | BUTTON_TRIANGLE | BUTTON_L1 | BUTTON_L2 | BUTTON_L3 | BUTTON_R1 | BUTTON_R2 | BUTTON_R3 | MAX_BUTTON_ICONS
  -- val(BUTTON_NONE) = -1

--------------------------------------------------------------------------------
-- STATE SCHEMAS (CLASSES & STRUCTS)
--------------------------------------------------------------------------------
schema CFontDetails
  color : CRGBA
  scaleX : ℝ
  scaleY : ℝ
  slant : ℝ
  slantRefX : ℝ
  slantRefY : ℝ
  justify : bool8
  centre : bool8
  rightJustify : bool8
  background : bool8
  backgroundOnlyText : bool8
  proportional : bool8
  bIsShadow : bool8
  bFlash : bool8
  bBold : bool8
  alphaFade : ℝ
  backgroundColor : CRGBA
  wrapX : ℝ
  centreSize : ℝ
  rightJustifyWrap : ℝ
  style : ℤ
  bFontHalfTexture : bool8
  bank : ℕ
  dropShadowPosition : ℤ
  dropColor : CRGBA
  bFlashState : bool8
  nFlashTimer : ℤ
  anonymous_23 : bool8
  anonymous_25 : ℕ
  outlineColor : CRGBA
  bOutlineOn : ℤ
  line : ℤ
where
  bank ≥ 0
  anonymous_25 ≥ 0
end

schema CFontRenderState
  anonymous_0 : ℕ
  fTextPosX : ℝ
  fTextPosY : ℝ
  scaleX : ℝ
  scaleY : ℝ
  color : CRGBA
  fExtraSpace : ℝ
  slant : ℝ
  slantRefX : ℝ
  slantRefY : ℝ
  bIsShadow : bool8
  bFontHalfTexture : bool8
  proportional : bool8
  anonymous_14 : bool8
  style : ℤ
  bOutlineOn : ℤ
  line : ℤ
  rightJustify : bool8
where
  anonymous_0 ≥ 0
end

schema CFont
  LanguageSet : ℕ
  Slot : ℤ
  Sprite : seq CSprite2d  -- bounded array [MAX_FONTS]
  Details : CFontDetails
  RenderState : CFontRenderState
  ButtonSprite : seq CSprite2d  -- bounded array [MAX_BUTTON_ICONS]
  PS2Symbol : ℤ
where
  LanguageSet ≥ 0
end

schema CFont_LoadButtons
  ΔCFont
  txdPath? : seq CHAR
where
  -- Declared member operation CFont::LoadButtons(const char *txdPath)
  true
end

schema CFont_DrawButton_2
  ΔCFont
  x? : ℝ
  y? : ℝ
where
  -- Declared member operation CFont::DrawButton(float x, float y)
  true
end

