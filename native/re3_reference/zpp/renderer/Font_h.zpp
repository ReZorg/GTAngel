--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Font_IsJapanese
  ΔFontModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = LanguageSet == FONT_LANGSET_JAPANESE
  true
end

schema Font_IsJapaneseFont
  ΔFontModuleState
  result! : 𝔹
where
  -- Return postcondition: result! = IsJapanese() && (Details.style == FONT_JAPANESE)
  true
end

schema Font_IsJapaneseFont_2
  ΔFontModuleState
  result! : 𝔹
where
  -- Deterministic transition preserving module invariants
  true
end
