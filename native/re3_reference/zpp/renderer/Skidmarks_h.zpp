schema CSkidmarks_RegisterOne_8
  ΔCSkidmarks
  id? : ℕ
  pos? : CVector
  fwdX? : ℝ
  fwdY? : ℝ
  isMuddy? : ℙ 𝔹
  isBloody? : ℙ 𝔹
where
  -- Declared member operation CSkidmarks::RegisterOne(uintptr id, CVector pos, float fwdX, float fwdY, bool *isMuddy, bool *isBloody)
