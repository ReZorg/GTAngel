schema CWindModifiers_FindWindModifier
  ΔCWindModifiers
  pos? : CVector
  x? : ℙ ℝ
  y? : ℙ ℝ
where
  -- State update: bWasWindModifierFound' = false
  -- State update: zDist' = Abs(15.0f + pos.z - Array[i].m_pos.z)
  -- State update: dist' = (pos - Array[i].m_pos).Magnitude()
  -- State update: heightFade' = 1.0f - zDist / MAX_HEIGHT_DIST
  -- State update: fade' = distFade * heightFade * 0.5f
  -- State update: dir' = (pos - Array[i].m_pos) * fade / dist
  -- Return postcondition: result! = bWasWindModifierFound
  -- Invokes: CGeneral::GetRandomNumber
  true
end

