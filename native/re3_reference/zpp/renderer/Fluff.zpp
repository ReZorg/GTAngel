schema CPlaneTrail_Init
  ΔCPlaneTrail
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlaneTrail_Render
  ΔCPlaneTrail
  visibility? : ℝ
where
  -- State update: numVerts' = 0
  -- State update: alpha' = visibility*110.0f
  -- State update: time' = CTimer::GetTimeInMilliseconds() - m_time[i]
  -- State update: fade' = (30000.0f - time) / 10000.0f
  -- State update: fade' = Min(fade, 1.0f)
  -- Invokes: TheCamera.IsSphereVisible, CTimer::GetTimeInMilliseconds
  true
end

schema CPlaneTrail_RegisterPoint
  ΔCPlaneTrail
  pos? : CVector
where
  -- State update: bNewPoint' = false
  -- State update: bNewPoint' = true
  -- Invokes: CTimer::GetTimeInMilliseconds
  true
end

schema CPlaneTrails_Init
  ΔCPlaneTrails
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlaneTrails_Update
  ΔCPlaneTrails
where
  -- State update: planePos.z' = 550.0f
  -- State update: planePos.z' = 500.0f
  -- State update: planePos.z' = 600.0f
  -- Invokes: CTimer::GetTimeInMilliseconds, CClock::GetHours, CCoronas::RegisterCorona, CCoronas::UpdateCoronaCoors
  true
end

schema CPlaneTrails_Render
  ΔCPlaneTrails
where
  -- State update: visibility' = Min(1.0f-CWeather::Foggyness, 1.0f-CWeather::CloudCoverage)
  -- State update: visibility' = Min(visibility, 1.0f-CWeather::Rain)
  -- Invokes: CTimeCycle::GetSkyTopRed, CTimeCycle::GetSkyTopGreen, CTimeCycle::GetSkyTopBlue
  true
end

schema CPlaneTrails_RegisterPoint
  ΔCPlaneTrails
  pos? : CVector
  id? : ℕ
where
  -- Deterministic transition preserving module invariants
  true
end

schema CPlaneBanner_Init
  ΔCPlaneBanner
where
  -- State update: x' = i
  -- State update: y' = 0.0f
  -- State update: z' = -60.0f
  true
end

schema CPlaneBanner_Update
  ΔCPlaneBanner
where
  -- State update: z' = Max(m_pos[0].z, -100.0f)
  -- State update: dist' = m_pos[i] - m_pos[i-1]
  -- State update: len' = dist.Magnitude()
  -- Invokes: CTimer::GetTimeStep, dist.Magnitude
  true
end

schema CPlaneBanner_Render
  ΔCPlaneBanner
where
  -- State update: camDist' = (TheCamera.GetPosition() - m_pos[0]).Magnitude()
  -- State update: TempBufferVerticesStored' = 0
  -- State update: TempBufferIndicesStored' = 0
  -- State update: TempBufferVerticesStored' = 0
  -- State update: TempBufferIndicesStored' = 0
  -- State update: CigOn' = false
  -- Return postcondition: result! = count
  -- Return postcondition: result! = String_Time
  -- Return postcondition: result! = true
  -- Invokes: TheCamera.GetPosition, TheCamera.IsSphereVisible, CPlaneBanner::RegisterPoint, CPlaneBanners::Init, CPlaneBanners::Update
  true
end

