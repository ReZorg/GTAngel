--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema Vector2D_CVector2D
  ΔVector2DModuleState
where
  -- Deterministic transition preserving module invariants
  true
end

schema Vector2D_Heading
  ΞVector2DModuleState
  result! : ℝ
where
  -- Return postcondition: result! = Atan2(-x, y)
  true
end

schema Vector2D_Magnitude
  ΞVector2DModuleState
  result! : ℝ
where
  -- Return postcondition: result! = Sqrt(x*x + y*y)
  true
end

schema Vector2D_MagnitudeSqr
  ΞVector2DModuleState
  result! : ℝ
where
  -- Return postcondition: result! = x*x + y*y
  true
end

schema Vector2D_Normalise
  ΔVector2DModuleState
where
  -- State update: sq' = MagnitudeSqr()
  -- State update: invsqrt' = RecipSqrt(sq)
  true
end

schema Vector2D_NormaliseSafe
  ΔVector2DModuleState
where
  -- State update: sq' = MagnitudeSqr()
  -- State update: invsqrt' = RecipSqrt(sq)
  -- State update: x' = 1.0f
  true
end

schema Vector2D_operator
  ΞVector2DModuleState
  rhs? : CVector2D
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(x-rhs.x, y-rhs.y)
  true
end

schema Vector2D_operator_2
  ΞVector2DModuleState
  rhs? : CVector2D
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(x+rhs.x, y+rhs.y)
  true
end

schema Vector2D_operator_3
  ΞVector2DModuleState
  t? : ℝ
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(x/t, y/t)
  true
end

schema Vector2D_operator_4
  ΞVector2DModuleState
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(-x, -y)
  true
end

schema Vector2D_DotProduct2D
  ΔVector2DModuleState
  v1? : CVector2D
  v2? : CVector2D
where
  -- Return postcondition: result! = v1.x*v2.x + v1.y*v2.y
  true
end

schema Vector2D_CrossProduct2D
  ΔVector2DModuleState
  v1? : CVector2D
  v2? : CVector2D
where
  -- Return postcondition: result! = v1.x*v2.y - v1.y*v2.x
  true
end

schema Vector2D_Distance2D
  ΔVector2DModuleState
  v? : CVector2D
  x? : ℝ
  y? : ℝ
where
  -- Return postcondition: result! = Sqrt((v.x-x)*(v.x-x) + (v.y-y)*(v.y-y))
  true
end

schema Vector2D_DistanceSqr2D
  ΔVector2DModuleState
  v? : CVector2D
  x? : ℝ
  y? : ℝ
where
  -- Return postcondition: result! = (v.x-x)*(v.x-x) + (v.y-y)*(v.y-y)
  true
end

schema Vector2D_NormalizeXY
  ΔVector2DModuleState
  x? : ℝ
  y? : ℝ
where
  -- State update: l' = Sqrt(x*x + y*y)
  -- State update: x' = 1.0f
  true
end

schema Vector2D_operator_5
  ΔVector2DModuleState
  left? : CVector2D
  right? : ℝ
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(left.x * right, left.y * right)
  true
end

schema Vector2D_operator_6
  ΔVector2DModuleState
  left? : ℝ
  right? : CVector2D
  result! : CVector2D
where
  -- Return postcondition: result! = CVector2D(left * right.x, left * right.y)
  true
end
