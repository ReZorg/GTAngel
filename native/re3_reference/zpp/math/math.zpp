--------------------------------------------------------------------------------
-- GTAngel Z++ Formal Specification: math (math)
-- Source File(s): math/math.cpp
-- Specification Language: Z++ / Object-Z
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- IMPORTED MODULE SPECIFICATIONS
--------------------------------------------------------------------------------
-- include common.zpp  (from "common.h")
-- include VuVector.zpp  (from "VuVector.h")

--------------------------------------------------------------------------------
-- BASE GIVEN TYPES
--------------------------------------------------------------------------------
[ADDRESS, HANDLE, ENTITY_REF, UNIT]
Ref[X] == ℙ X

--------------------------------------------------------------------------------
-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema math_TransformPoint
  ΔmathModuleState
  out? : CVuVector
  mat? : CMatrix
  in? : CVuVector
where
  -- State update: out' = mat * in
  true
end

schema math_TransformPoint_2
  ΔmathModuleState
  out? : CVuVector
  mat? : CMatrix
  in? : RwV3d
where
  -- State update: out' = mat * in
  true
end

schema math_TransformPoints
  ΔmathModuleState
  out? : Ref[CVuVector]
  n? : ℤ
  mat? : CMatrix
  in? : Ref[RwV3d]
  stride? : ℤ
where
  -- State update: out' = mat * *in
  -- State update: in' = (RwV3d*)((uint8*)in + stride)
  true
end

schema math_TransformPoints_2
  ΔmathModuleState
  out? : Ref[CVuVector]
  n? : ℤ
  mat? : CMatrix
  in? : Ref[CVuVector]
where
  -- State update: out' = mat * *in
  true
end

--------------------------------------------------------------------------------
-- MODULE STATE SCHEMA
--------------------------------------------------------------------------------
schema mathModuleState
  module_loaded : 𝔹
  source_lines : ℕ
where
  module_loaded = true ∧
  source_lines = 118
end
