-- OPERATION SCHEMAS (FUNCTION & METHOD DEFINITIONS)
--------------------------------------------------------------------------------
schema CMatrix_CMatrix
  ΔCMatrix
where
  -- State update: m_attachment' = ∅
  -- State update: m_hasRwMatrix' = false
  true
end

schema CMatrix_CMatrix_2
  ΔCMatrix
  m? : CMatrix
where
  -- State update: m_attachment' = ∅
  -- State update: m_hasRwMatrix' = false
  -- State update: this' = m
  true
end

schema CMatrix_CMatrix_3
  ΔCMatrix
  matrix? : Ref[RwMatrix]
  owner? : 𝔹
where
  -- State update: m_attachment' = ∅
  true
end

schema CMatrix_CMatrix_4
  ΔCMatrix
where
  -- Deterministic transition preserving module invariants
  true
end

