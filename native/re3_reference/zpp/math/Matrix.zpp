schema CMatrix
  m_attachment : Ref[RwMatrix]
  fz : ℝ
  m_hasRwMatrix : 𝔹
  uw : ℝ
  pw : ℝ
  fw : ℝ
where
  #m_attachment ≤ 1
end

schema CMatrix_CMatrix
  ΔCMatrix
  m? : CMatrix
where
  -- Declared member operation CMatrix::CMatrix(CMatrix const &m)
  true
end

