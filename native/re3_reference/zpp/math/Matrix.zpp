  ΔCMatrix
  rhs? : CMatrix
where
  -- Return postcondition: result! = *this
  -- Invokes: rhs.GetRight, rhs.GetForward, rhs.GetUp, rhs.GetPosition
  true
end

schema CMatrix_SetUnity
  ΔCMatrix
where
  -- State update: rx' = 1.0f
  -- State update: ry' = 0.0f
  -- State update: rz' = 0.0f
  -- State update: fx' = 0.0f
  -- State update: fy' = 1.0f
  -- State update: fz' = 0.0f
  true
end

