where
  -- State update: c' = Cos(angle)
  -- State update: s' = Sin(angle)
  -- State update: rx' = c
  -- State update: ry' = 0.0f
  -- State update: rz' = -s
  -- State update: fx' = 0.0f
  true
end

schema CMatrix_SetRotateZOnly
  ΔCMatrix
  angle? : ℝ
where
  -- State update: c' = Cos(angle)
  -- State update: s' = Sin(angle)
  -- State update: rx' = c
  -- State update: ry' = s
  -- State update: rz' = 0.0f
  -- State update: fx' = -s
  true
end

