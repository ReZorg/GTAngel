      "duration": 6,
      "loop": true,
      "frames": [
        { "time": 0, "pose": "neutral" },
        {
          "time": 1.5,
          "pose": "neutral",
          "overrides": {
            "ParamBreath": 0.85,
            "ParamHairSwing": 0.45,
            "ParamBodyAngleZ": 0.5
          }
        },
        {
          "time": 2.8,
          "pose": "neutral",
          "overrides": { "ParamEyeLOpen": 0.4, "ParamEyeROpen": 0.4 }
        },
        { "time": 3.1, "pose": "neutral" },
        {
          "time": 4.5,
          "pose": "neutral",
          "overrides": {
            "ParamBreath": 0.2,
            "ParamHairSwing": -0.45,
            "ParamBodyAngleZ": -0.5
          }
        },
        { "time": 6, "pose": "neutral" }
      ]
    },
    {
