        { "time": 2.8, "pose": "greet", "overrides": { "ParamWristR": 5 } },
        { "time": 4, "pose": "explore" }
      ]
    },
    {
      "id": "nod",
      "label": "Acknowledging nod",
      "duration": 2.8,
      "loop": false,
      "frames": [
        { "time": 0, "pose": "explore" },
        {
          "time": 0.55,
          "pose": "explore",
          "overrides": { "ParamAngleY": -5, "ParamAngleZ": -1.5 }
