        {
          "time": 1.2,
          "pose": "listen",
          "overrides": { "ParamAngleX": -6, "ParamEyeBallX": -0.5 }
        },
        {
          "time": 2.7,
          "pose": "explore",
          "overrides": {
            "ParamAngleX": 6,
            "ParamEyeBallX": 0.5,
            "ParamAngleZ": -2
          }
        },
        { "time": 3.6, "pose": "listen" },
        { "time": 5, "pose": "explore" }
      ]
    },
    {
      "id": "step",
      "label": "In-place weight shift",
      "duration": 4,
      "loop": true,
      "frames": [
        { "time": 0, "pose": "explore" },
        {
          "time": 1,
          "pose": "stepLeft",
          "overrides": { "ParamArmL": 1.5, "ParamArmR": -1.5 }
        },
        { "time": 2, "pose": "explore" },
        {
          "time": 3,
          "pose": "stepRight",
          "overrides": { "ParamArmL": -1.5, "ParamArmR": 1.5 }
        },
        { "time": 4, "pose": "explore" }
      ]
    },
    {
      "id": "reach",
      "label": "Reach and recover",
      "duration": 3.6,
      "loop": false,
      "frames": [
        { "time": 0, "pose": "explore" },
        { "time": 1.3, "pose": "reach" },
        { "time": 2.2, "pose": "reach", "overrides": { "ParamWristR": 2 } },
        { "time": 3.6, "pose": "explore" }
      ]
    },
    {
      "id": "present",
      "label": "Present and settle",
      "duration": 3.8,
      "loop": false,
      "frames": [
        { "time": 0, "pose": "explore" },
        { "time": 1.1, "pose": "present" },
        {
          "time": 2.2,
          "pose": "present",
          "overrides": { "ParamAngleZ": 2, "ParamMouthForm": 0.4 }
