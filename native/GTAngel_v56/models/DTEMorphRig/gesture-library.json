{
  "format": "dte-authored-morph-motion/v1",
  "description": "Authored 2D parameter-space choreography, not inferred behavior or a 3D reconstruction. ParamPoseBlend crossfades the two supplied views.",
  "poses": {
    "neutral": { "label": "Front neutral", "values": {} },
    "blink": {
      "label": "Eye closure",
      "values": { "ParamEyeLOpen": 0.25, "ParamEyeROpen": 0.25 }
    },
    "mouth": { "label": "Open mouth", "values": { "ParamMouthOpenY": 0.75 } },
    "smile": { "label": "Gentle smile", "values": { "ParamMouthForm": 0.6 } },
    "curious": {
      "label": "Curious tilt",
      "values": {
        "ParamAngleZ": 3,
        "ParamBrowLY": 0.4,
        "ParamBrowRY": 0.4,
        "ParamEyeBallY": 0.3
      }
    },
    "explore": { "label": "Explore stance", "values": { "ParamPoseBlend": 1 } },
    "greet": {
      "label": "Raised-hand greeting",
      "values": {
        "ParamPoseBlend": 1,
        "ParamArmR": 2,
        "ParamElbowR": -2,
        "ParamWristR": 4,
        "ParamMouthForm": 0.4
      }
    },
    "reach": {
      "label": "Small reach",
      "values": {
        "ParamPoseBlend": 1,
        "ParamArmR": -3,
        "ParamElbowR": 3,
        "ParamWristR": -2,
        "ParamRootX": 4
      }
    },
    "listen": {
      "label": "Listening tilt",
      "values": {
        "ParamPoseBlend": 1,
        "ParamAngleZ": 3,
        "ParamAngleY": 2,
        "ParamEyeBallX": 0.3,
        "ParamBrowLY": 0.25
      }
    },
    "stepLeft": {
      "label": "Left weight shift",
      "values": {
        "ParamPoseBlend": 1,
        "ParamHipL": 1.5,
        "ParamKneeL": 2,
        "ParamHipR": -1.5,
        "ParamRootX": -3,
        "ParamRootY": -2
      }
    },
    "stepRight": {
      "label": "Right weight shift",
      "values": {
        "ParamPoseBlend": 1,
        "ParamHipR": 1.5,
        "ParamKneeR": 2,
        "ParamHipL": -1.5,
        "ParamRootX": 3,
        "ParamRootY": -2
      }
    },
    "present": {
      "label": "Present gesture",
      "values": {
        "ParamPoseBlend": 1,
        "ParamArmR": 2,
        "ParamElbowR": 2,
        "ParamWristR": 3,
        "ParamArmL": -1
      }
    }
