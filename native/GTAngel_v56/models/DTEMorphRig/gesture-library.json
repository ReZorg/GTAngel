    {
      "id": "transition",
      "label": "Front to explore",
      "duration": 3,
      "loop": false,
      "frames": [
        { "time": 0, "pose": "neutral" },
        { "time": 1.5, "pose": "explore" },
        { "time": 3, "pose": "explore" }
      ]
    }
  ]
