<Window x:Class="GTAngel.TrainingDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GTAngel.ViewModels"
        xmlns:views="clr-namespace:GTAngel.Views"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:converters="clr-namespace:GTAngel.Converters"
        Title="AngelClaw Game World — Deep Tree Echo Training Environment"
        Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converters -->
        <converters:FloatToHeightConverter x:Key="FloatToHeight"/>

        <!-- Color brushes -->
        <SolidColorBrush x:Key="BgDarkBrush"       Color="#FF0D0D1A"/>
        <SolidColorBrush x:Key="BgMediumBrush"     Color="#FF141428"/>
        <SolidColorBrush x:Key="BgLightBrush"      Color="#FF1E1E3A"/>
        <SolidColorBrush x:Key="BgCardBrush"       Color="#FF181830"/>
        <SolidColorBrush x:Key="AccentAngelBrush"  Color="#FFFFD700"/>
        <SolidColorBrush x:Key="AccentCyanBrush"   Color="#FF00BCD4"/>
        <SolidColorBrush x:Key="AccentGreenBrush"  Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFFF9800"/>
        <SolidColorBrush x:Key="AccentRedBrush"    Color="#FFF44336"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#FF9C27B0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9E9EC8"/>
        <SolidColorBrush x:Key="HaltBrush"         Color="#FFFF5722"/>

        <!-- Converters -->
        <converters:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:InverseBoolConverter             x:Key="InvBool"/>
        <converters:ScoreToColorConverter            x:Key="ScoreToColor"/>
        <converters:StatusToColorConverter           x:Key="StatusToColor"/>

        <!-- Card border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"        Value="{StaticResource BgCardBrush}"/>
            <Setter Property="CornerRadius"      Value="8"/>
            <Setter Property="Padding"           Value="12"/>
            <Setter Property="Margin"            Value="4"/>
            <Setter Property="BorderBrush"       Value="#22FFFFFF"/>
            <Setter Property="BorderThickness"   Value="1"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>

        <!-- Metric value -->
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Metric label -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
        </Style>

        <!-- Accent button (cyan) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="Foreground"       Value="#FF0D0D1A"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="14,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF00ACC1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF444444"/>
                                <Setter Property="Foreground" Value="#FF888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success button (green) -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="14,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF43A047"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF444444"/>
                                <Setter Property="Foreground" Value="#FF888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (red) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"       Value="{StaticResource AccentRedBrush}"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="14,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE53935"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF444444"/>
                                <Setter Property="Foreground" Value="#FF888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="16,10" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F43E;" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="AngelClaw Game World" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                        <TextBlock Text="Deep Tree Echo Training Environment" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock Text="{Binding AutonomyLevelText}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <Border Background="{StaticResource BgLightBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Coherence: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding StreamCoherence, StringFormat='{}{0:F3}'}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT (TabControl) ===== -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0" Margin="8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{StaticResource BgMediumBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{StaticResource BgMediumBrush}" CornerRadius="6,6,0,0" Padding="16,8" Margin="2,0,2,0" BorderBrush="#22FFFFFF" BorderThickness="1,1,1,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgLightBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1F3460"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===== TAB 0: GAME WORLD ASSETS ===== -->
            <TabItem Header="Game World Assets">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Asset Path + Load -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Archive:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AssetArchivePath, UpdateSourceTrigger=PropertyChanged}" Background="#11FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#33FFFFFF" Padding="8,6" FontSize="12"/>
                            <Button Grid.Column="2" Content="Scan Assets" Command="{Binding LoadAssetsCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        </Grid>
                    </Border>

                    <!-- Summary Cards -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Visibility="{Binding IsAssetLoaded, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.TotalAssets}" Style="{StaticResource MetricValue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Assets" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.TotalSizeFormatted}" Style="{StaticResource MetricValue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Total Size" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.MapCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Maps" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.TextureCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentOrangeBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Textures" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.BlueprintCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Blueprints" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CatalogSummary.AudioCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Audio" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Asset List + Chart -->
                    <Grid Grid.Row="2" Visibility="{Binding IsAssetLoaded, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Asset List -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AssetSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="#11FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#33FFFFFF" Padding="8,6" FontSize="12">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding FilterAssetsCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Search" Command="{Binding FilterAssetsCommand}" Style="{StaticResource AccentButton}" Margin="4,0,0,0"/>
                                        <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource DangerButton}" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredAssets}" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                          RowBackground="#11FFFFFF" AlternatingRowBackground="#08FFFFFF"
                                          GridLinesVisibility="None" HeadersVisibility="Column" CanUserSortColumns="True"
                                          FontSize="11" RowHeight="26">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource BgLightBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="200"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                                        <DataGridTextColumn Header="Game" Binding="{Binding GameTitle}" Width="80"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="80"/>
                                        <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="70"/>
                                        <DataGridTextColumn Header="Path" Binding="{Binding FullPath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Category Breakdown + Maps -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Asset Distribution Chart -->
                            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Asset Distribution" Style="{StaticResource SectionHeader}"/>
                                    <lvc:PieChart Grid.Row="1" Series="{Binding AssetDistributionSeries}" LegendPosition="Bottom" MinHeight="200"/>
                                </Grid>
                            </Border>

                            <!-- Maps List -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" MaxHeight="200">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Game World Maps" Style="{StaticResource SectionHeader}"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Maps}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="&#x1F5FA;" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                    <TextBlock Text=" — " Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Region}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== TAB 1: DTE TRAINING DASHBOARD ===== -->
            <TabItem Header="DTE Training">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Training Controls -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Max Experiments" Style="{StaticResource MetricLabel}"/>
                                <TextBox Text="{Binding MaxExperiments}" Background="#11FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#33FFFFFF" Padding="6,4" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Spectral Radius" Style="{StaticResource MetricLabel}"/>
                                <TextBox Text="{Binding SpectralRadius, StringFormat='{}{0:F2}'}" Background="#11FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#33FFFFFF" Padding="6,4" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Leaking Rate" Style="{StaticResource MetricLabel}"/>
                                <TextBox Text="{Binding LeakingRate, StringFormat='{}{0:F2}'}" Background="#11FFFFFF" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#33FFFFFF" Padding="6,4" Width="60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,16,0">
                                <TextBlock Text="Target Level" Style="{StaticResource MetricLabel}"/>
                                <ComboBox SelectedItem="{Binding TargetAutonomyLevel}" Background="#11FFFFFF" Foreground="Black" Padding="6,4" Width="110">
                                    <ComboBoxItem Content="Reactive"/>
                                    <ComboBoxItem Content="Adaptive"/>
                                    <ComboBoxItem Content="Strategic"/>
                                    <ComboBoxItem Content="Cognitive"/>
                                    <ComboBoxItem Content="Embodied"/>
                                    <ComboBoxItem Content="Autonomous"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="5" Content="Start Autogenesis" Command="{Binding StartTrainingCommand}" Style="{StaticResource SuccessButton}" Margin="4,0" Visibility="{Binding IsTrainingRunning, Converter={StaticResource InvBoolToVis}}"/>
                            <Button Grid.Column="6" Content="Stop" Command="{Binding StopTrainingCommand}" Style="{StaticResource DangerButton}" Margin="4,0" Visibility="{Binding IsTrainingRunning, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="7" Content="Reset" Command="{Binding ResetTrainingCommand}" Style="{StaticResource AccentButton}" Margin="4,0"/>
                        </Grid>
                    </Border>

                    <!-- Dashboard Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cognitive State Card -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Cognitive State" Style="{StaticResource SectionHeader}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                        <TextBlock Text="Mode" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding CognitiveModeName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                        <TextBlock Text="Cycle Step" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}">
                                            <Run Text="{Binding CurrentCycleStep, Mode=OneWay}"/><Run Text="/11: "/><Run Text="{Binding CycleStepName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                                        <TextBlock Text="Valence" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding Valence, StringFormat='{}{0:F3}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                                        <TextBlock Text="Arousal" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding Arousal, StringFormat='{}{0:F3}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- 4E Cognition -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                                        <TextBlock Text="Embodied" Style="{StaticResource MetricLabel}"/>
                                        <ProgressBar Value="{Binding Embodied}" Maximum="1" Height="8" Foreground="{StaticResource AccentCyanBrush}" Background="#11FFFFFF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                                        <TextBlock Text="Embedded" Style="{StaticResource MetricLabel}"/>
                                        <ProgressBar Value="{Binding Embedded}" Maximum="1" Height="8" Foreground="{StaticResource AccentGreenBrush}" Background="#11FFFFFF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                                        <TextBlock Text="Enacted" Style="{StaticResource MetricLabel}"/>
                                        <ProgressBar Value="{Binding Enacted}" Maximum="1" Height="8" Foreground="{StaticResource AccentOrangeBrush}" Background="#11FFFFFF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="4">
                                        <TextBlock Text="Extended" Style="{StaticResource MetricLabel}"/>
                                        <ProgressBar Value="{Binding Extended}" Maximum="1" Height="8" Foreground="{StaticResource AccentPurpleBrush}" Background="#11FFFFFF"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                                        <TextBlock Text="Wisdom" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock Text="{Binding WisdomLevel, StringFormat='{}{0:F3}'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="4">
                                        <TextBlock Text="Autonomy Progress" Style="{StaticResource MetricLabel}"/>
                                        <ProgressBar Value="{Binding AutonomyProgress}" Maximum="1" Height="12" Foreground="{StaticResource AccentCyanBrush}" Background="#11FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Experiment Stats Card -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Autogenesis Stats" Style="{StaticResource SectionHeader}"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
