<Page x:Class="GTAngel.Views.SplashPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="GTA III - Definitive Edition"
      Background="Black">

    <!--
    Converted from: FlutterGateScreen (gate/splash screen)
    Android: ConstraintLayout with Flutter container
    WPF: Grid with centered logo and loading indicator
    -->

    <Grid>
        <!-- Background Image -->
        <Image Source="/Assets/Images/bg.horizontal.png"
               Stretch="UniformToFill"
               Opacity="0.4" />

        <!-- Dark Overlay -->
        <Rectangle Fill="{StaticResource FadeOutBrush}" />

        <!-- Center Content -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <!-- Rockstar Logo -->
            <Image Source="/Assets/Images/rockstar.png"
                   Width="80" Height="80"
                   Margin="0,0,0,20" />

            <!-- Game Logo -->
            <Image Source="/Assets/Images/logo.png"
                   Width="300"
                   Margin="0,0,0,40" />

            <!-- Loading Indicator (replaces ProgressBar indeterminate) -->
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Background="#33FFFFFF"
                         Margin="0,0,0,10" />

            <TextBlock Text="{StaticResource Loading}"
                       Style="{StaticResource SubheadingStyle}"
                       Opacity="0.7"
                       FontSize="12" />
        </StackPanel>

        <!-- Version Info (from BuildConfig) -->
        <TextBlock Text="v1.84.3"
                   Foreground="#66FFFFFF"
                   FontSize="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,10,10" />
    </Grid>
</Page>
