<Page x:Class="GTAngel.Views.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Downloading Game Data"
      Background="Black">

    <!--
    Converted from: DownloaderActivity + res/layout/downloader_progress.xml
    Android: RelativeLayout with LinearLayout children, ProgressBar, TextViews, Buttons
    WPF: Grid with StackPanel, ProgressBar, TextBlocks, Buttons
    
    Original Android hierarchy:
      RelativeLayout (match_parent)
        LinearLayout#downloaderDashboard (vertical)
          RelativeLayout (progress info)
            TextView#statusText
            TextView#progressAsFraction
            TextView#progressAsPercent
            ProgressBar#progressBar (horizontal)
            TextView#progressAverageSpeed
            TextView#progressTimeRemaining
          LinearLayout#downloaderDashboardButtons (horizontal)
            Button#pauseButton
            Button#cancelButton (gone)
        LinearLayout#approveCellular (vertical, gone)
          TextView#textPausedParagraph1
          TextView#textPausedParagraph2
          LinearLayout#buttonRow (horizontal)
            Button#resumeOverCellular
            Button#wifiSettingsButton
    -->

    <Grid>
        <Image Source="/Assets/Images/bg.horizontal.png"
               Stretch="UniformToFill"
               Opacity="0.2" />
        <Rectangle Fill="{StaticResource FadeOutBrush}" />

        <!-- Dashboard Panel (replaces #downloaderDashboard) -->
        <StackPanel x:Name="Dashboard"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="500"
                    Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisConverter}}">

            <!-- Game Icon -->
            <Image Source="/Assets/Images/icon.png"
                   Width="80" Height="80"
                   Margin="0,0,0,20" />

            <!-- Status Text (replaces #statusText) -->
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusText}"
                       Style="{StaticResource HeadingStyle}"
                       FontSize="18"
                       Margin="0,0,0,20" />

            <!-- Progress Info Grid (replaces RelativeLayout with progress widgets) -->
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Progress Fraction (replaces #progressAsFraction) -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding ProgressFraction}"
                           Foreground="White" FontSize="12"
                           Margin="0,0,0,5" />

                <!-- Progress Percent (replaces #progressAsPercent) -->
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ProgressPercent}"
                           Foreground="White" FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,5" />

                <!-- Progress Bar (replaces ProgressBar horizontal style) -->
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                             Style="{StaticResource DownloadProgressStyle}"
                             Value="{Binding ProgressValue}"
                             Maximum="100"
                             Margin="0,0,0,5" />

                <!-- Average Speed (replaces #progressAverageSpeed) -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{Binding AverageSpeed}"
                           Foreground="#AAFFFFFF" FontSize="11" />

                <!-- Time Remaining (replaces #progressTimeRemaining) -->
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding TimeRemaining}"
                           Foreground="#AAFFFFFF" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Buttons (replaces #downloaderDashboardButtons) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <!-- Pause Button (replaces #pauseButton) -->
                <Button x:Name="PauseButton"
                        Content="{Binding PauseButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="94" MinHeight="40"
                        Margin="0,0,10,0"
                        Command="{Binding PauseCommand}" />

                <!-- Cancel Button (replaces #cancelButton, initially Collapsed) -->
                <Button x:Name="CancelButton"
                        Content="{StaticResource TextButtonCancel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="94" MinHeight="40"
                        Visibility="{Binding IsCancelVisible, Converter={StaticResource BoolToVisConverter}}"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Cellular Approval Panel (replaces #approveCellular, initially Collapsed) -->
        <StackPanel x:Name="ApproveCellular"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="500"
                    Visibility="{Binding IsCellularApprovalVisible, Converter={StaticResource BoolToVisConverter}}">

            <TextBlock Text="{StaticResource TextPausedCellular}"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="10" />

            <TextBlock Text="{StaticResource TextPausedCellular2}"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="10" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <Button Content="{StaticResource TextButtonResumeCellular}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ResumeCellularCommand}" />
                <Button Content="{StaticResource TextButtonWifiSettings}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding WifiSettingsCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
