<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish Profile: Portable (Framework-Dependent)
  Creates a portable ZIP-ready deployment that requires .NET 8 runtime.
  Smaller download size, but requires user to have .NET installed.
  
  Usage:
    dotnet publish -c Release -p:PublishProfile=Portable
    
  Output: bin/Release/net8.0-windows/publish/portable/
  
  Distribute as: GTAngel-{version}-win-portable.zip
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    
    <!-- Runtime Configuration -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- Framework-dependent means smaller size -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
</Project>
