<UserControl x:Class="GTA3DE.Wpf.Views.GameRuntimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GTA3DE.Wpf.ViewModels">

    <UserControl.DataContext>
        <vm:GameRuntimeViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#AABBCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Foreground" Value="#E0F0FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="#1A2332"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#2A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="#0D4F8B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A6FBB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER: Connection Controls ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection indicator -->
                <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF4444"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#44FF44"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Value}"/>
                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="GTA3 Path: "/>
                        <Run Text="{Binding GameExecutablePath, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2" Content="Connect / Launch" Command="{Binding ConnectToGameCommand}" Style="{StaticResource ActionBtn}"/>
                <Button Grid.Column="3" Content="Start Capture" Command="{Binding StartCaptureCommand}" Style="{StaticResource ActionBtn}"/>
                <Button Grid.Column="4" Content="Stop Capture" Command="{Binding StopCaptureCommand}" Style="{StaticResource ActionBtn}"/>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Frame Preview + RL Controls -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Frame Preview -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="GAME VIEWPORT" Foreground="#00BFFF" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding CaptureStatus, StringFormat=' — {0}'}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FrameCount, StringFormat=' | Frame #{0}'}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#0A0F14" CornerRadius="4" BorderBrush="#1A3A5A" BorderThickness="2">
                            <Grid>
                                <Image Source="{Binding LatestFrame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                <!-- Placeholder when no frame -->
                                <TextBlock Text="No game frame captured.&#x0a;Click 'Connect / Launch' then 'Start Capture'&#x0a;to begin the vision pipeline."
                                           Foreground="#445566" FontSize="14" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding LatestFrame, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                <!-- Capture resolution overlay -->
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                           Foreground="#44FF44" FontFamily="Consolas" FontSize="10" Opacity="0.7">
                                    <Run Text="{Binding CaptureWidth, Mode=OneWay}"/>
                                    <Run Text="x"/>
                                    <Run Text="{Binding CaptureHeight, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RL Training Controls -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="▶ Start RL Training" Command="{Binding StartRLTrainingCommand}" Style="{StaticResource ActionBtn}" Background="#0A6B3D"/>
                            <Button Content="⏹ Stop" Command="{Binding StopRLTrainingCommand}" Style="{StaticResource ActionBtn}" Background="#8B2500"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Label}" Text="Episode: "/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RlEpisode}"/>
                            <TextBlock Style="{StaticResource Label}" Text="  Step: " Margin="12,0,0,0"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RlStep}"/>
                            <TextBlock Style="{StaticResource Label}" Text="  Reward: " Margin="12,0,0,0"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RlEpisodeReward, StringFormat=F2}" Foreground="#FFD700"/>
                            <TextBlock Style="{StaticResource Label}" Text="  Best: " Margin="12,0,0,0"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RlBestReward, StringFormat=F2}" Foreground="#44FF44"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding RlStatus}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Proprioceptive State + Log -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Proprioceptive State -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROPRIOCEPTIVE STATE" Foreground="#FF6B35" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Position X"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PlayerX, StringFormat=F1}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Position Y"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PlayerY, StringFormat=F1}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Position Z"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PlayerZ, StringFormat=F1}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Heading"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PlayerHeading, StringFormat=F2}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Velocity"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding VelocityMagnitude, StringFormat=F1}" Foreground="#00BFFF"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="Health"/>
                            <ProgressBar Grid.Row="5" Grid.Column="1" Value="{Binding PlayerHealth, Mode=OneWay}" Maximum="200" Height="14" Margin="0,2"
                                         Foreground="#44FF44" Background="#1A2A1A"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="Armor"/>
                            <ProgressBar Grid.Row="6" Grid.Column="1" Value="{Binding PlayerArmor, Mode=OneWay}" Maximum="100" Height="14" Margin="0,2"
                                         Foreground="#4488FF" Background="#1A1A2A"/>
                        </Grid>

                        <Separator Margin="0,8" Background="#2A3A4A"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Wanted Level"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Foreground="#FF4444">
                                <TextBlock.Text>
                                    <Binding Path="WantedLevel" StringFormat="★ {0}"/>
                                </TextBlock.Text>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Money"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Money, StringFormat='${0:N0}'}" Foreground="#44FF44"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="In Vehicle"/>
                            <TextBlock Grid.Row="2" Grid.Column="1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                        <Setter Property="Text" Value="On Foot"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInVehicle}" Value="True">
                                                <Setter Property="Text" Value="In Vehicle"/>
                                                <Setter Property="Foreground" Value="#FFD700"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Space -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTION SPACE (15 discrete)" Foreground="#BB86FC" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <Button Content="Fwd" Command="{Binding SendTestActionCommand}" CommandParameter="1" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Back" Command="{Binding SendTestActionCommand}" CommandParameter="3" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Left" Command="{Binding SendTestActionCommand}" CommandParameter="5" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Right" Command="{Binding SendTestActionCommand}" CommandParameter="7" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Jump" Command="{Binding SendTestActionCommand}" CommandParameter="9" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Sprint" Command="{Binding SendTestActionCommand}" CommandParameter="10" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                            <Button Content="Vehicle" Command="{Binding SendTestActionCommand}" CommandParameter="12" Style="{StaticResource ActionBtn}" FontSize="10" Padding="8,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Runtime Log -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RUNTIME LOG" Foreground="#00BFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding RuntimeLog}"
                                 Background="Transparent" Foreground="#88AACC" FontFamily="Consolas" FontSize="10"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== FOOTER: Capture Settings ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Resolution:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CaptureWidth, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" Background="#0A1520" Foreground="White" BorderBrush="#2A3A4A" Padding="4,2"/>
                <TextBlock Style="{StaticResource Label}" Text="x" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CaptureHeight, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="4,0" Background="#0A1520" Foreground="White" BorderBrush="#2A3A4A" Padding="4,2"/>

                <TextBlock Style="{StaticResource Label}" Text="  Target FPS:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox Text="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0" Background="#0A1520" Foreground="White" BorderBrush="#2A3A4A" Padding="4,2"/>

                <TextBlock Style="{StaticResource Label}" Text="  Action Space:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Style="{StaticResource Value}" Text="{Binding ActionSpaceSize}" VerticalAlignment="Center"/>
                <TextBlock Style="{StaticResource Label}" Text=" discrete actions" VerticalAlignment="Center"/>

                <TextBlock Style="{StaticResource Label}" Text="  |  Pipeline: GDI BitBlt → Resize → Normalize → ESN Reservoir → Action Selection → SendInput" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#556677"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
