<Page x:Class="GTAngel.Views.LegalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      mc:Ignorable="d"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Legal"
      Background="Black">

    <!--
    Converted from: FlutterLegalScreen
    Android: Flutter-based legal/EULA screen
    WPF: ScrollViewer with legal text + accept button
    -->

    <Grid>
        <Rectangle Fill="{StaticResource FadeOutBrush}" />

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="600"
              MaxHeight="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="End User License Agreement"
                       Style="{StaticResource HeadingStyle}"
                       FontSize="22"
                       Margin="0,0,0,20" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,20">
                <TextBlock Text="{Binding LegalText}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Content="ACCEPT"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding AcceptCommand}" />
                <Button Content="DECLINE"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DeclineCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
