<Page x:Class="GTA3DE.Wpf.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Settings"
      Background="{StaticResource PrimaryBrush}">

    <!--
    Converted from: FlutterOptionsWithProductBaseScreen
    Android: Flutter-based settings screen
    WPF: Native XAML settings with TabControl sections
    -->

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="{StaticResource SettingsTitle}"
                       Style="{StaticResource HeadingStyle}"
                       HorizontalAlignment="Left"
                       FontSize="28" />
        </StackPanel>

        <!-- Settings Tabs (replaces Flutter tab navigation) -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White">

            <!-- Graphics Settings -->
            <TabItem Header="{StaticResource SettingsGraphics}"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Resolution" Foreground="White" FontSize="14" Margin="0,0,0,5" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              SelectedIndex="{Binding SelectedResolutionIndex}">
                        <ComboBoxItem Content="1920x1080" />
                        <ComboBoxItem Content="2560x1440" />
                        <ComboBoxItem Content="3840x2160" />
                        <ComboBoxItem Content="Windowed" />
                    </ComboBox>

                    <TextBlock Text="Graphics Quality" Foreground="White" FontSize="14" Margin="0,20,0,5" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              SelectedIndex="{Binding SelectedQualityIndex}">
                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Medium" />
                        <ComboBoxItem Content="High" />
                        <ComboBoxItem Content="Very High" />
                    </ComboBox>

                    <CheckBox Content="V-Sync" Foreground="White" Margin="0,20,0,0"
                              IsChecked="{Binding IsVSyncEnabled}" />
                    <CheckBox Content="Fullscreen" Foreground="White" Margin="0,10,0,0"
                              IsChecked="{Binding IsFullscreen}" />
                </StackPanel>
            </TabItem>

            <!-- Audio Settings (replaces GCAudioLogic) -->
            <TabItem Header="{StaticResource SettingsAudio}"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Master Volume" Foreground="White" FontSize="14" Margin="0,0,0,5" />
                    <Slider Width="300" HorizontalAlignment="Left"
                            Minimum="0" Maximum="100"
                            Value="{Binding MasterVolume}" />

                    <TextBlock Text="Music Volume" Foreground="White" FontSize="14" Margin="0,20,0,5" />
                    <Slider Width="300" HorizontalAlignment="Left"
                            Minimum="0" Maximum="100"
                            Value="{Binding MusicVolume}" />

                    <TextBlock Text="SFX Volume" Foreground="White" FontSize="14" Margin="0,20,0,5" />
                    <Slider Width="300" HorizontalAlignment="Left"
                            Minimum="0" Maximum="100"
                            Value="{Binding SfxVolume}" />
                </StackPanel>
            </TabItem>

            <!-- Controls -->
            <TabItem Header="{StaticResource SettingsControls}"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Mouse Sensitivity" Foreground="White" FontSize="14" Margin="0,0,0,5" />
                    <Slider Width="300" HorizontalAlignment="Left"
                            Minimum="1" Maximum="100"
                            Value="{Binding MouseSensitivity}" />

                    <CheckBox Content="Invert Y-Axis" Foreground="White" Margin="0,20,0,0"
                              IsChecked="{Binding IsInvertY}" />

                    <TextBlock Text="Controller support is automatically detected."
                               Foreground="#AAFFFFFF" FontSize="12" Margin="0,20,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Language (replaces Lang.setLocalePriority) -->
            <TabItem Header="{StaticResource SettingsLanguage}"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Game Language" Foreground="White" FontSize="14" Margin="0,0,0,5" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage}" />
                </StackPanel>
            </TabItem>

            <!-- UE5 Engine Settings (KSM Cycle 2: P3 Boundaries, P6 Good Shape) -->
            <TabItem Header="UE5 Engine"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Unreal Engine 5 Installation"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Engine Path"
                               Foreground="#AAFFFFFF" FontSize="12"
                               Margin="0,0,0,5" />

                    <!-- Engine path row with browse button -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Ue5EnginePath, UpdateSourceTrigger=LostFocus}"
                                 Background="#1A1A2E" Foreground="White"
                                 BorderBrush="#3A3A6A" BorderThickness="1"
                                 Padding="8,6" FontFamily="Consolas" FontSize="12"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Padding="12,6"
                                Command="{Binding BrowseEnginePathCommand}" />
                    </Grid>

                    <!-- Validation status -->
                    <Border Background="#0D1117" BorderBrush="#2A2A4A" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding Ue5EngineFound, Converter={StaticResource BoolToGreenGray}}" />
                            <TextBlock Text="{Binding Ue5EngineStatus}"
                                       Foreground="#A0A0C0" FontSize="12"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                    <!-- Feature flags info -->
                    <TextBlock Text="Active UE5 Feature Flags"
                               Foreground="#AAFFFFFF" FontSize="12"
                               Margin="0,0,0,8" />
                    <Border Background="#0D1117" BorderBrush="#2A2A4A" BorderThickness="1"
                            CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="-dx12  -SM6  -lumen  -nanite  -ChaosPhysics"
                                       Foreground="#6A9A6A" FontFamily="Consolas" FontSize="11" />
                            <TextBlock Text="-WorldPartition  -EnhancedInput  -DTECognitive"
                                       Foreground="#6A9A6A" FontFamily="Consolas" FontSize="11"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="-MLResX=768  -MLResY=768  -MLVisionPipe=GTAngel_MLVision_IPC"
                                       Foreground="#9A6A9A" FontFamily="Consolas" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Changes take effect on next UE5 launch from the Avatar tab."
                               Foreground="#606080" FontSize="11" FontStyle="Italic"
                               Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Account (replaces Social Club account management) -->
            <TabItem Header="{StaticResource SettingsAccount}"
                     Background="{StaticResource PrimaryLightBrush}"
                     Foreground="White">
                <StackPanel Margin="20">
                    <TextBlock Text="Rockstar Games Social Club"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock Text="{Binding AccountStatus}"
                               Foreground="#AAFFFFFF" FontSize="14"
                               Margin="0,0,0,20" />

                    <Button Content="Sign In / Sign Out"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding ToggleLoginCommand}" />

                    <Button Content="Delete Account"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,20,0,0"
                            Foreground="#FF6666"
                            BorderBrush="#FF6666"
                            Command="{Binding DeleteAccountCommand}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
