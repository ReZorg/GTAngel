<UserControl x:Class="GTAngel.Views.AvatarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GTAngel.ViewModels"
             xmlns:conv="clr-namespace:GTAngel.Converters"
             Background="#0A0A14">
    <UserControl.DataContext>
        <vm:AvatarViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:FloatToHeightConverter x:Key="FloatToHeight"/>
        <conv:BoolToGreenGrayConverter x:Key="BoolToGreenGray"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:ProgressToWidthConverter x:Key="ProgressToWidth"/>
        <SolidColorBrush x:Key="Gold"      Color="#FFD700"/>
        <SolidColorBrush x:Key="Cyan"      Color="#00E5FF"/>
        <SolidColorBrush x:Key="Purple"    Color="#9C27B0"/>
        <SolidColorBrush x:Key="Green"     Color="#4CAF50"/>
        <SolidColorBrush x:Key="DarkPanel" Color="#12121E"/>
        <SolidColorBrush x:Key="CardBg"    Color="#1A1A2E"/>
        <SolidColorBrush x:Key="TextPri"   Color="#E0E0FF"/>
        <SolidColorBrush x:Key="TextSec"   Color="#8888AA"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#12121E" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="DTE 4E Embodied Cognition Avatar" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Gold}"/>
                        <TextBlock Text="{Binding AvatarStatusText}" FontSize="11"
                                   Foreground="{StaticResource TextSec}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A1A2E" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding AvatarStateColor}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AvatarStateText}" FontSize="11"
                                       Foreground="{StaticResource TextPri}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A1A2E" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding Ue5EngineVersion}" FontSize="11"
                                   Foreground="{StaticResource Cyan}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Content ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: UE5 Modules + Controls ──────────────────────────── -->
            <StackPanel Grid.Column="0" Margin="0,0,6,0">

                <!-- Controls -->
                <Border Background="#12121E" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="AVATAR CONTROLS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Gold}" Margin="0,0,0,8"/>
                        <Button Content="▶  START EXPLORATION"
                                Command="{Binding StartAvatarCommand}"
                                Visibility="{Binding IsAvatarNotRunning, Converter={StaticResource BoolToVis}}"
                                Background="#1B5E20" Foreground="White" BorderThickness="0"
                                Padding="0,10" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="⏹  STOP EXPLORATION"
                                Command="{Binding StopAvatarCommand}"
                                Visibility="{Binding IsAvatarRunning, Converter={StaticResource BoolToVis}}"
                                Background="#B71C1C" Foreground="White" BorderThickness="0"
                                Padding="0,10" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="📷  REQUEST ML FRAME"
                                Command="{Binding RequestMLFrameCommand}"
                                Background="#1A237E" Foreground="White" BorderThickness="0"
                                Padding="0,8" FontSize="11" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- UE5 Feature Flags -->
                <Border Background="#12121E" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="UE5 FEATURES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,8"/>
                        <CheckBox Content="Lumen Global Illumination" IsChecked="{Binding UseLumen}"
                                  Foreground="{StaticResource TextPri}" Margin="0,2"/>
                        <CheckBox Content="Nanite Virtualized Geometry" IsChecked="{Binding UseNanite}"
                                  Foreground="{StaticResource TextPri}" Margin="0,2"/>
                        <CheckBox Content="Chaos Physics" IsChecked="{Binding UseChaosPhysics}"
                                  Foreground="{StaticResource TextPri}" Margin="0,2"/>
                        <CheckBox Content="Enhanced Input System" IsChecked="{Binding UseEnhancedInput}"
                                  Foreground="{StaticResource TextPri}" Margin="0,2"/>
                        <CheckBox Content="ML Vision Capture (768×768)" IsChecked="{Binding UseMLVisionCapture}"
                                  Foreground="{StaticResource TextPri}" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- KSM Cycle 2: UE5 Launch Orchestrator Panel (P4, P8, P11, P12, P14) -->
                <Border Background="#12121E" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="UE5 LAUNCH PIPELINE" FontSize="10" FontWeight="Bold"
                                   Foreground="#FFD700" Margin="0,0,0,8"/>

                        <!-- Progress bar across 4 stages -->
                        <Grid Margin="0,0,0,6">
                            <Rectangle Height="4" Fill="#2A2A4A" RadiusX="2" RadiusY="2"/>
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                       Fill="#00E5FF">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                        <Binding Path="Ue5LaunchProgress"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Border}" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Rectangle.Width>
                            </Rectangle>
                        </Grid>

                        <!-- Stage indicators -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Validate" FontSize="9" TextAlignment="Center"
                                       Foreground="{Binding Ue5IsValidating, Converter={StaticResource BoolToGreenGray}}"/>
                            <TextBlock Grid.Column="1" Text="Build" FontSize="9" TextAlignment="Center"
                                       Foreground="{Binding Ue5IsBuilding, Converter={StaticResource BoolToGreenGray}}"/>
                            <TextBlock Grid.Column="2" Text="Launch" FontSize="9" TextAlignment="Center"
                                       Foreground="{Binding Ue5IsLaunching, Converter={StaticResource BoolToGreenGray}}"/>
                            <TextBlock Grid.Column="3" Text="Connect" FontSize="9" TextAlignment="Center"
                                       Foreground="{Binding Ue5IsConnecting, Converter={StaticResource BoolToGreenGray}}"/>
                        </Grid>

                        <!-- Stage status text -->
                        <TextBlock Text="{Binding Ue5LaunchStageText}" FontSize="10"
                                   Foreground="#A0A0C0" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                        <!-- Launch / Stop buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding Ue5LaunchButtonText}"
                                    Command="{Binding LaunchUE5Command}"
                                    IsEnabled="{Binding Ue5IsLaunching2, Converter={StaticResource InvBool}}"
                                    Background="#1A237E" Foreground="White" BorderThickness="0"
                                    Padding="0,8" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="1"
                                    Content="⏹" Command="{Binding StopUE5Command}"
                                    Visibility="{Binding Ue5IsLaunching2, Converter={StaticResource BoolToVis}}"
                                    Background="#7B1FA2" Foreground="White" BorderThickness="0"
                                    Padding="10,8" FontSize="11" Cursor="Hand" Margin="4,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Last log line -->
                        <TextBlock Text="{Binding Ue5LaunchLog}" FontSize="9"
                                   Foreground="#606080" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- UE5 Modules -->
                <Border Background="#12121E" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="UE5 COGNITIVE MODULES" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Purple}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Ue5ModulesStatus}" FontSize="10"
                                   Foreground="{StaticResource TextSec}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding UE5Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                                                 Fill="{Binding IsReady, Converter={StaticResource BoolToGreenGray}}"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="10"
                                                       Foreground="#C0C0E0"/>
                                            <TextBlock Text="{Binding UpgradeType}" FontSize="9"
                                                       Foreground="#606080"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="9"
                                                   Foreground="#808090" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Center: 4E Cognitive Dashboard ────────────────────────── -->
            <Grid Grid.Column="1" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 4E Neurochemical Gauges -->
                <Border Grid.Row="0" Background="#12121E" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="4E NEUROCHEMICAL STATE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Gold}" Margin="0,0,0,10"/>
                        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                            <!-- Curiosity -->
                            <StackPanel Margin="4,0">
                                <TextBlock Text="CURIOSITY" FontSize="9" Foreground="#8888AA"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Border Background="#0D0D1A" CornerRadius="3" Height="80" Margin="0,0,0,4">
                                    <Grid VerticalAlignment="Bottom">
                                        <Rectangle Fill="#FF9800" RadiusX="3" RadiusY="3"
                                                   Height="{Binding Curiosity, Converter={StaticResource FloatToHeight}}"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Curiosity, StringFormat={}{0:P0}}"
                                           FontSize="11" FontWeight="Bold" Foreground="#FF9800"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Endorphin -->
                            <StackPanel Margin="4,0">
                                <TextBlock Text="ENDORPHIN" FontSize="9" Foreground="#8888AA"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Border Background="#0D0D1A" CornerRadius="3" Height="80" Margin="0,0,0,4">
                                    <Grid VerticalAlignment="Bottom">
                                        <Rectangle Fill="#E91E63" RadiusX="3" RadiusY="3"
                                                   Height="{Binding Endorphin, Converter={StaticResource FloatToHeight}}"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Endorphin, StringFormat={}{0:P0}}"
                                           FontSize="11" FontWeight="Bold" Foreground="#E91E63"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Chaos -->
                            <StackPanel Margin="4,0">
                                <TextBlock Text="CHAOS" FontSize="9" Foreground="#8888AA"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Border Background="#0D0D1A" CornerRadius="3" Height="80" Margin="0,0,0,4">
                                    <Grid VerticalAlignment="Bottom">
                                        <Rectangle Fill="#9C27B0" RadiusX="3" RadiusY="3"
                                                   Height="{Binding ChaosIntensity, Converter={StaticResource FloatToHeight}}"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding ChaosIntensity, StringFormat={}{0:P0}}"
                                           FontSize="11" FontWeight="Bold" Foreground="#9C27B0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Homeostasis -->
                            <StackPanel Margin="4,0">
                                <TextBlock Text="HOMEOSTASIS" FontSize="9" Foreground="#8888AA"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Border Background="#0D0D1A" CornerRadius="3" Height="80" Margin="0,0,0,4">
                                    <Grid VerticalAlignment="Bottom">
                                        <Rectangle Fill="#4CAF50" RadiusX="3" RadiusY="3"
                                                   Height="{Binding Homeostasis, Converter={StaticResource FloatToHeight}}"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Homeostasis, StringFormat={}{0:P0}}"
                                           FontSize="11" FontWeight="Bold" Foreground="#4CAF50"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Exploration Metrics -->
                <Border Grid.Row="1" Background="#12121E" CornerRadius="6" Padding="12" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="EXPLORATION METRICS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource Cyan}" Margin="0,0,0,10"/>
                        <UniformGrid Grid.Row="1" Columns="3" Rows="2">
                            <StackPanel Margin="4,2">
                                <TextBlock Text="STEPS" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding TotalSteps}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Cyan}"/>
                            </StackPanel>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="TOTAL REWARD" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding TotalReward, StringFormat={}{0:F1}}"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                            </StackPanel>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="COVERAGE" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding CoverageText}" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Green}"/>
                            </StackPanel>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="POSITION" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding PositionText}" FontSize="11"
                                           Foreground="{StaticResource TextPri}"/>
                            </StackPanel>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="VELOCITY" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding VelocityText}" FontSize="11"
                                           Foreground="{StaticResource TextPri}"/>
                            </StackPanel>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="LAST ACTION" FontSize="9" Foreground="#8888AA"/>
                                <TextBlock Text="{Binding LastActionText}" FontSize="10"
                                           Foreground="{StaticResource TextPri}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- ML Vision Status -->
                <Border Grid.Row="2" Background="#12121E" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ML VISION CAPTURE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Purple}"/>
                            <Border Grid.Column="1" Background="#1A237E" CornerRadius="3" Padding="6,2">
                                <TextBlock Text="{Binding MlVisionResolution}" FontSize="10"
                                           Foreground="{StaticResource Cyan}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1">
                            <!-- Status + capture active indicator -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding MlVisionStatus}" FontSize="11"
                                           Foreground="{StaticResource TextSec}" TextWrapping="Wrap"/>
                                <Ellipse Grid.Column="1" Width="10" Height="10" Margin="6,0,0,0"
                                         Fill="{Binding MlCaptureActive, Converter={StaticResource BoolToGreenGray}}"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Frame counter + FPS -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="10" Foreground="#606080">
                                    <Run Text="Frames: "/>
                                    <Run Text="{Binding MlVisionFrameCount}" Foreground="{StaticResource Cyan}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#606080" HorizontalAlignment="Right">
                                    <Run Text="FPS: "/>
                                    <Run Text="{Binding MlFrameRateText}" Foreground="{StaticResource Gold}"/>
                                </TextBlock>
                            </Grid>

                            <!-- ONNX Feature Norm bar -->
                            <TextBlock Text="ONNX Feature Norm" FontSize="9" Foreground="#505070" Margin="0,4,0,2"/>
                            <Grid Height="14" Margin="0,0,0,2">
                                <Rectangle Fill="#1A1A2E" RadiusX="3" RadiusY="3"/>
                                <Rectangle HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                           Fill="{StaticResource Purple}"
                                           Width="{Binding MlLastFeatureNorm,
                                                   Converter={StaticResource FloatToHeight},
                                                   ConverterParameter=200}"/>
                                <TextBlock Text="{Binding MlFeatureNormText}" FontSize="9"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Vision frame placeholder with live overlay -->
                            <Border Background="#0A0A14" CornerRadius="4" Height="110" Margin="0,8,0,0">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center"/>
                                        <TextBlock Text="768 × 768 ML Vision" FontSize="10"
                                                   Foreground="#404060" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="ViT / CLIP / ESN Compatible" FontSize="9"
                                                   Foreground="#303050" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Live frame rate overlay -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                            Background="#80000000" CornerRadius="3" Padding="4,2" Margin="4">
                                        <TextBlock Text="{Binding MlFrameRateText}" FontSize="9"
                                                   Foreground="{StaticResource Gold}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Right: Expression / Emotion / Neuro / Personality (KSM Cycle 3) ─────── -->
            <Border Grid.Column="2" Background="#12121E" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><!-- KSM Cycle 6: PlayerAI Bridge -->
                        <RowDefinition Height="Auto"/><!-- KSM Cycle 4: Navigation -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── FACS Action Units ────────────────────────────────────────────────── -->
                    <Border Grid.Row="0" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="FACS ACTION UNITS" FontSize="9" FontWeight="Bold"
                                       Foreground="#C084FC" Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Rows="2">
                                <!-- AU: Brow Raise -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="BROW RAISE" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#C084FC"
                                                   Width="{Binding AuBrowRaise, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- AU: Brow Furrow -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="BROW FURROW" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#F87171"
                                                   Width="{Binding AuBrowFurrow, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- AU: Eye Wide -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="EYE WIDE" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#60A5FA"
                                                   Width="{Binding AuEyeWide, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- AU: Smile -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="SMILE" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#34D399"
                                                   Width="{Binding AuSmile, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- AU: Lip Press -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="LIP PRESS" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#FBBF24"
                                                   Width="{Binding AuLipPress, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- AU: Jaw Drop -->
                                <StackPanel Margin="2">
                                    <TextBlock Text="JAW DROP" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="6"
                                                   Fill="#F472B6"
                                                   Width="{Binding AuJawDrop, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── Emotional State ──────────────────────────────────────────────────────── -->
                    <Border Grid.Row="1" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="EMOTIONAL STATE (Ekman)" FontSize="9" FontWeight="Bold"
                                       Foreground="#F472B6" Margin="0,0,0,6"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="JOY" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="16" Height="{Binding EmHappiness, Converter={StaticResource FloatToHeight}, ConverterParameter=40}"
                                            Background="#34D399" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="SURP" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="16" Height="{Binding EmSurprise, Converter={StaticResource FloatToHeight}, ConverterParameter=40}"
                                            Background="#60A5FA" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="SAD" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="16" Height="{Binding EmSadness, Converter={StaticResource FloatToHeight}, ConverterParameter=40}"
                                            Background="#818CF8" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="ANGER" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="16" Height="{Binding EmAnger, Converter={StaticResource FloatToHeight}, ConverterParameter=40}"
                                            Background="#F87171" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="FEAR" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="16" Height="{Binding EmFear, Converter={StaticResource FloatToHeight}, ConverterParameter=40}"
                                            Background="#FBBF24" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── Neurochemical Readback ────────────────────────────────────────────── -->
                    <Border Grid.Row="2" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="NEUROCHEMICAL READBACK" FontSize="9" FontWeight="Bold"
                                       Foreground="#34D399" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="2">
                                    <TextBlock Text="CURIOSITY" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="5" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="5" Fill="#60A5FA"
                                                   Width="{Binding NeuroCuriosity, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="ENDORPHIN" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="5" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="5" Fill="#34D399"
                                                   Width="{Binding NeuroEndorphin, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="CHAOS" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="5" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="5" Fill="#F87171"
                                                   Width="{Binding NeuroChaos, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="2">
                                    <TextBlock Text="HOMEOSTASIS" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="5" Background="#1A1A2E" Margin="0,2">
                                        <Rectangle HorizontalAlignment="Left" Height="5" Fill="#FBBF24"
                                                   Width="{Binding NeuroHomeostasis, Converter={StaticResource FloatToHeight}, ConverterParameter=80}"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── SuperHotGirl Personality Traits ────────────────────────────────────── -->
                    <Border Grid.Row="3" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="SUPERHOT GIRL PERSONALITY" FontSize="9" FontWeight="Bold"
                                       Foreground="#F472B6" Margin="0,0,0,6"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="CONF" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="14" Height="{Binding PersonalityConfidence, Converter={StaticResource FloatToHeight}, ConverterParameter=35}"
                                            Background="#C084FC" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="CHRM" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="14" Height="{Binding PersonalityCharm, Converter={StaticResource FloatToHeight}, ConverterParameter=35}"
                                            Background="#F472B6" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="PLAY" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="14" Height="{Binding PersonalityPlayfulness, Converter={StaticResource FloatToHeight}, ConverterParameter=35}"
                                            Background="#34D399" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="WIT" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="14" Height="{Binding PersonalityWit, Converter={StaticResource FloatToHeight}, ConverterParameter=35}"
                                            Background="#60A5FA" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Margin="2" HorizontalAlignment="Center">
                                    <TextBlock Text="SASS" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Center"/>
                                    <Border Width="14" Height="{Binding PersonalitySass, Converter={StaticResource FloatToHeight}, ConverterParameter=35}"
                                            Background="#FBBF24" CornerRadius="2" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── KSM Cycle 6: Player↔AI Bridge ─────────────────────────────────────── -->
                    <Border Grid.Row="4" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="PLAYER↔AI BRIDGE (Duality)" FontSize="9" FontWeight="Bold"
                                       Foreground="#60A5FA" Margin="0,0,0,6"/>
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mode:" FontSize="10" Foreground="#8888AA" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding TogglePlayerAiModeCommand}" 
                                        Background="#1A1A2E" Foreground="{StaticResource Cyan}" BorderThickness="1" BorderBrush="#303050"
                                        Padding="8,2" FontSize="10" Content="{Binding PlayerAiMode}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI" FontSize="9" Foreground="#F472B6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding InputArbitrationScore}" 
                                             Height="6" Foreground="#60A5FA" Background="#F472B6" BorderThickness="0"/>
                                <TextBlock Grid.Column="2" Text="HUMAN" FontSize="9" Foreground="#60A5FA" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding ArbitrationModeText}" FontSize="9" Foreground="#8888AA" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <TextBlock Text="Observation Fusion Norm" FontSize="9" Foreground="#8888AA" Margin="0,0,0,2"/>
                            <Grid Height="4">
                                <Rectangle Fill="#1A1A2E" RadiusX="2" RadiusY="2"/>
                                <Rectangle HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="#34D399"
                                           Width="{Binding ObservationFusionNorm, Converter={StaticResource FloatToHeight}, ConverterParameter=100}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                      <!-- ── KSM Cycle 4: Game World Navigation ─────────────────────────────────────── -->
                    <Border Grid.Row="5" Background="#0D0D1A" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="LIBERTY CITY NAVIGATION" FontSize="9" FontWeight="Bold"
                                       Foreground="#22D3EE" Margin="0,0,0,6"/>
                            <!-- District + Mode -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DISTRICT" FontSize="8" Foreground="#6060A0"/>
                                    <TextBlock Text="{Binding CurrentDistrict}" FontSize="11"
                                               Foreground="#22D3EE" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1A1A2E" CornerRadius="3" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NavMode}" FontSize="9"
                                               Foreground="{StaticResource Gold}"/>
                                </Border>
                            </Grid>
                            <!-- Target POI + Distance -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TARGET POI" FontSize="8" Foreground="#6060A0"/>
                                    <TextBlock Text="{Binding NavTargetPOI}" FontSize="10"
                                               Foreground="{StaticResource TextPri}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="DIST" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding NavDistToTarget, StringFormat={}{0:F0}m}" FontSize="10"
                                               Foreground="{StaticResource Cyan}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <!-- Route Progress -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ROUTE" FontSize="8" Foreground="#6060A0"/>
                                    <TextBlock Text="{Binding NavRouteStatus}" FontSize="10"
                                               Foreground="{StaticResource TextSec}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="WAYPOINT" FontSize="8" Foreground="#6060A0" HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextPri}" HorizontalAlignment="Right">
                                        <Run Text="{Binding NavCurrentWaypoint, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding NavWaypointsInRoute, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <!-- POI Discovery Progress -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="POIs DISCOVERED" FontSize="8" Foreground="#6060A0"/>
                                    <Grid Height="6" Background="#1A1A2E" Margin="0,2,8,0">
                                        <Rectangle HorizontalAlignment="Left" Height="6" Fill="#22D3EE"
                                                   Width="{Binding NavDistrictCoverage, Converter={StaticResource FloatToHeight}, ConverterParameter=160}"/>
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1A237E" CornerRadius="3" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NavPOIProgress}" FontSize="9"
                                               Foreground="#22D3EE"/>
                                </Border>
                            </Grid>
                            <!-- Active indicator -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,6,0"
                                         Fill="{Binding NavIsActive, Converter={StaticResource BoolToGreenGray}}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentPOI, StringFormat=Near: {0}}"
                                           FontSize="9" Foreground="#9090B0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Exploration Log ────────────────────────────────────────────────────────── -->
                    <Border Grid.Row="5" Background="#0D0D1A" CornerRadius="4" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="EXPLORATION LOG" FontSize="9" FontWeight="Bold"
                                       Foreground="#D4AF37" Margin="0,0,0,6"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                <ItemsControl ItemsSource="{Binding ExplorationLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#9090B0"
                                                       TextWrapping="Wrap" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>