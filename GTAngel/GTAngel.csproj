<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GTAngel</RootNamespace>
    <AssemblyName>GTAngel</AssemblyName>
    <Version>1.84.3</Version>
    <FileVersion>1.84.3.0</FileVersion>
    <AssemblyVersion>1.84.3.0</AssemblyVersion>
    <InformationalVersion>1.84.3+$(SourceRevisionId)</InformationalVersion>
    <Company>ReZorg AI</Company>
    <Product>GTAngel AI Training Platform</Product>
    <Description>GTAngel — UE5 Cognitive AI Training Environment with Deep Tree Echo</Description>
    <Copyright>Copyright © ReZorg 2026</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    
    <!-- Production Publishing Configuration -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Symbol Configuration for Production -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    
    <!-- Source Link for crash analysis -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    
    <!-- Static Analysis -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Source Link package for better crash diagnostics -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc4.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2535.41" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="0.0.942" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**\*" />
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embed Archecho UE5 AI training modules into the build output -->
  <ItemGroup>
    <None Remove="..\Archecho\**\*" />
    <Content Include="..\Archecho\**\*">
      <Link>Archecho\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Embed UE5 Engine binaries and shaders into the build output -->
  <ItemGroup>
    <None Remove="..\Engine\**\*" />
    <Content Include="..\Engine\**\*">
      <Link>Engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\icon.png" />
    <Resource Include="Assets\Images\logo.png" />
    <Resource Include="Assets\Images\rockstar.png" />
    <Resource Include="Assets\Images\rockstarbg.png" />
    <Resource Include="Assets\Images\bg.horizontal.png" />
    <Resource Include="Assets\Images\bg.vertical.png" />
    <Resource Include="Assets\Images\gtapluslogo.png" />
  </ItemGroup>

  <!-- Post-publish validation: verify critical files exist in publish output -->
  <Target Name="ValidatePublishAssets" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishOutputDir>$(PublishDir)</_PublishOutputDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PublishOutputDir)appsettings.json')"
           Text="PUBLISH VALIDATION FAILED: appsettings.json missing from publish output." />
    <Error Condition="!Exists('$(_PublishOutputDir)appsettings.Production.json')"
           Text="PUBLISH VALIDATION FAILED: appsettings.Production.json missing from publish output." />
    <Message Importance="high" Text="✓ Publish asset validation passed." />
  </Target>

</Project>
