{
  "App": {
    "Name": "GTAngel AI Training Platform",
    "ShortName": "GTAngel",
    "Version": "1.84.3",
    "ApplicationId": "com.rezorg.gtangel",
    "Company": "ReZorg AI",
    "Environment": "Production"
  },
  "UE5": {
    "ProjectName": "LibertyCity",
    "IsShippingBuild": true,
    "SupportsVulkan": true,
    "DepthBufferPreference": 0,
    "EnginePath": "./Engine"
  },
  "Cognitive": {
    "ESNReservoirSize": 1000,
    "ECANAttentionDecay": 0.95,
    "ThompsonSamplingAlpha": 1.0,
    "ThompsonSamplingBeta": 1.0
  },
  "MLVision": {
    "CaptureWidth": 768,
    "CaptureHeight": 768,
    "FrameRate": 30,
    "OnnxModelPath": "./Assets/Models/feature_extractor.onnx"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "GTAngel": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/gtangel-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Telemetry": {
    "Enabled": false,
    "AnonymousUsageStats": false
  },
  "Updates": {
    "CheckOnStartup": true,
    "Channel": "Stable",
    "UpdateServerUrl": "https://github.com/ReZorg/GTAngel/releases"
  }
}
