{
  "App": {
    "Name": "GTAngel AI Training Platform",
    "ShortName": "GTAngel",
    "Version": "1.84.3",
    "ApplicationId": "com.rezorg.gtangel",
    "Company": "ReZorg AI",
    "Environment": "Development"
  },
  "UE5": {
    "ProjectName": "LibertyCity",
    "IsShippingBuild": false,
    "SupportsVulkan": true,
    "DepthBufferPreference": 0,
    "_EnginePath_Comment": "Set UE5_ENGINE_PATH environment variable or modify this value for your local setup",
    "EnginePath": "${UE5_ENGINE_PATH:-.\\Engine}"
  },
  "Cognitive": {
    "ESNReservoirSize": 500,
    "ECANAttentionDecay": 0.95,
    "ThompsonSamplingAlpha": 1.0,
    "ThompsonSamplingBeta": 1.0
  },
  "MLVision": {
    "CaptureWidth": 768,
    "CaptureHeight": 768,
    "FrameRate": 15,
    "OnnxModelPath": "./Assets/Models/feature_extractor.onnx",
    "UseMockCapture": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "GTAngel": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/gtangel-dev-.log",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": 48,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Telemetry": {
    "Enabled": false,
    "AnonymousUsageStats": false
  },
  "Updates": {
    "CheckOnStartup": false,
    "Channel": "Development",
    "UpdateServerUrl": "http://localhost:5000/releases"
  }
}
